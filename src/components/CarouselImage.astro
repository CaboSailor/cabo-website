---
// Shared "carousel-ready" image renderer.
// Reads its image list from src/data/carousels.json:
//   type="boat"     → carouselConfig.fleet[id]
//   type="activity" → carouselConfig.activities[id]
//
// Single image  → renders just the image, no carousel chrome.
// Multiple imgs → renders all slides + prev/next arrows + dots + mobile swipe-hint.
//
// To add a new image to a card later, add a path string to the relevant array
// in src/data/carousels.json — every page using this component picks it up.
//
// The supporting JS + CSS lives in src/layouts/BaseLayout.astro so any page
// rendering this component just works (it walks `.activity-carousel` on load).

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import carouselConfig from "../data/carousels.json";

interface Props {
  type: 'boat' | 'activity';
  id: string;
  alt: string;
  /** Override wrapper classes. Defaults: boat → "fleet-img-wrap w-full relative" (400px tall portrait). */
  wrapperClass?: string;
  /** Image width attr (Astro Image). Defaults vary by type. */
  width?: number;
  /** Image height attr (Astro Image). Defaults vary by type. */
  height?: number;
  /** Inline style applied to every slide image. Defaults vary by type. */
  imgStyle?: string;
  /** Override slide image classes. Defaults to "w-full h-full object-cover object-center". */
  imgClass?: string;
  /** Add hover-zoom effect (used inside `.group` parents like /tours tiles). */
  groupHoverZoom?: boolean;
}

const {
  type,
  id,
  alt,
  wrapperClass: wrapperClassOverride,
  width,
  height,
  imgStyle,
  imgClass,
  groupHoverZoom = false,
} = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

const bucket = type === 'boat'
  ? (carouselConfig.fleet as Record<string, string[]>)
  : (carouselConfig.activities as Record<string, string[]>);

const paths = bucket[id] || [];
if (!paths.length) {
  throw new Error(`CarouselImage: no images configured for ${type} "${id}" in carousels.json`);
}

const images: ImageMetadata[] = paths.map((p) => {
  const key = `../assets/images/${p}`;
  const mod = allImages[key];
  if (!mod) throw new Error(`CarouselImage: image not found ${p} (looked up as ${key})`);
  return mod.default;
});

const isMulti = images.length > 1;

// Defaults: boat cards are tall portraits (PNG, scaled), activity cards are landscape.
const defaultWidth  = type === 'boat' ? 1023 : 800;
const defaultHeight = type === 'boat' ? 1537 : 500;
const finalWidth  = width  ?? defaultWidth;
const finalHeight = height ?? defaultHeight;
const baseImgClass = imgClass ?? 'w-full h-full object-cover object-center';
const slideStyle = imgStyle ?? (type === 'boat' ? 'transform: scale(1.1);' : '');

const baseWrapper = wrapperClassOverride ?? 'fleet-img-wrap w-full relative';
const wrapperClass = [
  baseWrapper,
  isMulti ? 'activity-carousel' : '',
].filter(Boolean).join(' ');
---
<div class={wrapperClass}>
  {images.map((img, idx) => (
    <Image
      src={img}
      alt={alt}
      class={`activity-slide ${baseImgClass}${idx > 0 ? ' absolute inset-0' : ''}${groupHoverZoom ? ' group-hover:scale-105 transition-transform duration-500' : ''}`}
      style={`${slideStyle} opacity:${idx === 0 ? 1 : 0}; transition: opacity 0.5s ease-in-out;`}
      width={finalWidth}
      height={finalHeight}
      format={type === 'boat' ? 'png' : undefined}
      quality={type === 'boat' ? 100 : 80}
    />
  ))}
  {isMulti && (
    <>
      <button class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all" type="button" aria-label="Previous">
        <span class="material-symbols-outlined text-7xl font-light">chevron_left</span>
      </button>
      <button class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all" type="button" aria-label="Next">
        <span class="material-symbols-outlined text-7xl font-light">chevron_right</span>
      </button>
      <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2"></div>
      <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
        <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
          <span class="material-symbols-outlined text-2xl">arrow_back</span>
          <span class="text-[11px] uppercase tracking-widest font-bold">Swipe</span>
          <span class="material-symbols-outlined text-2xl">arrow_forward</span>
        </div>
      </div>
    </>
  )}
  <slot />
</div>
