---
// Rezdy booking modal - include on any page that needs booking functionality
---

<div id="rezdyModal" class="fixed inset-0 z-[200] hidden items-start lg:items-center justify-center bg-black/30 px-4 py-[max(env(safe-area-inset-top),1rem)]" onclick="if(event.target===this)closeRezdyModal()">
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-[340px] lg:max-w-[510px] max-h-[calc(100vh-max(env(safe-area-inset-top),1rem)-max(env(safe-area-inset-bottom),1rem)-1rem)] lg:max-h-[92vh] overflow-hidden flex flex-col">
    <div class="flex items-center justify-between px-4 py-3 border-b border-border-light bg-white">
      <span class="rezdy-modal-title text-navy font-bold text-sm uppercase tracking-[0.15em]">Check Availability</span>
      <button type="button" onclick="closeRezdyModal()" aria-label="Close" class="w-8 h-8 rounded-full flex items-center justify-center text-navy hover:bg-light-grey">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="flex-1 overflow-auto bg-white">
      <iframe id="rezdyIframe" title="Booking availability calendar" seamless="" width="300" height="1000" frameborder="0" class="rezdy block mx-auto lg:!w-full" src=""></iframe>
    </div>
  </div>
</div>

<script is:inline>
var _rezdyPrices=null;
var _rezdyPluginLoaded=false;
fetch('/data/prices.json?v='+Date.now()).then(function(r){return r.json()}).then(function(d){_rezdyPrices=d}).catch(function(){});
function _rezdyResolvePromo(explicitId){
  if(!_rezdyPrices)return '';
  var ids=[];
  if(explicitId)ids.push(explicitId);
  if(window.__pageActivityId)ids.push(window.__pageActivityId);
  for(var i=0;i<ids.length;i++){
    var pid=ids[i];
    if(_rezdyPrices.activities&&_rezdyPrices.activities[pid]&&_rezdyPrices.activities[pid].promoCode)return _rezdyPrices.activities[pid].promoCode;
    if(_rezdyPrices.boats&&_rezdyPrices.boats[pid]&&_rezdyPrices.boats[pid].promoCode)return _rezdyPrices.boats[pid].promoCode;
  }
  return _rezdyPrices.promoCode||'';
}
function _loadRezdyPlugin(){
  if(_rezdyPluginLoaded)return;
  _rezdyPluginLoaded=true;
  var s=document.createElement('script');
  s.src='https://cabosailing.rezdy.com/pluginJs';
  s.async=true;
  document.head.appendChild(s);
}
function openRezdyModal(widgetId, type, productId){
  _loadRezdyPlugin();
  type = type || 'calendarWidget';
  // Auto-detect product/boat id from the click target's closest [data-boat] ancestor
  if(!productId){
    try{
      var ev=window.event;
      var src=ev&&(ev.target||ev.srcElement);
      if(src&&src.closest){
        var boatEl=src.closest('[data-boat]');
        if(boatEl)productId=boatEl.dataset.boat;
      }
    }catch(_){}
  }
  var modal=document.getElementById('rezdyModal');
  var iframe=document.getElementById('rezdyIframe');
  var card=modal.firstElementChild;
  var titleEl=modal.querySelector('.rezdy-modal-title');
  var promo=_rezdyResolvePromo(productId);
  if(promo){titleEl.innerHTML='Check Availability <span class="inline-block ml-3 text-[11px] lg:text-xs font-bold normal-case tracking-normal text-white bg-gold px-2 py-0.5 rounded-full">Use code: <span class="text-[13px] lg:text-sm font-extrabold">'+promo+'</span></span>';}else{titleEl.textContent='Check Availability';}
  iframe.src='https://cabosailing.rezdy.com/'+type+'/'+widgetId+'?iframe=true';
  if(type==='productsCalendar'){
    card.classList.remove('max-w-[340px]','lg:max-w-[510px]');
    card.classList.add('max-w-lg');
    iframe.setAttribute('width','100%');
    iframe.classList.remove('mx-auto','lg:!w-full');
  } else {
    card.classList.remove('max-w-lg');
    card.classList.add('max-w-[340px]','lg:max-w-[510px]');
    iframe.setAttribute('width','300');
    iframe.classList.add('mx-auto','lg:!w-full');
  }
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  var scrollY=window.scrollY||window.pageYOffset||0;
  document.body.dataset.rezdyScrollY=scrollY;
  document.body.style.position='fixed';
  document.body.style.top='-'+scrollY+'px';
  document.body.style.left='0';
  document.body.style.right='0';
  document.body.style.width='100%';
}
function closeRezdyModal(){
  var modal=document.getElementById('rezdyModal');
  var iframe=document.getElementById('rezdyIframe');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
  iframe.src='';
  var scrollY=parseInt(document.body.dataset.rezdyScrollY||'0',10);
  document.body.style.position='';
  document.body.style.top='';
  document.body.style.left='';
  document.body.style.right='';
  document.body.style.width='';
  delete document.body.dataset.rezdyScrollY;
  window.scrollTo(0,scrollY);
}
document.addEventListener('keydown',function(e){
  var modal=document.getElementById('rezdyModal');
  if(e.key==='Escape'&&modal&&!modal.classList.contains('hidden'))closeRezdyModal();
});
</script>
