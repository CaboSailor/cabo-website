---
import { getLangFromUrl, getLocalePath, t } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const contactHref = getLocalePath(lang, '/contact');
const label = t(lang, 'nav.contact');
---

<a
  href={contactHref}
  id="floating-cta"
  aria-label={label}
  class="bg-gold hover:bg-gold/90 shadow-xl rounded-l-xl py-3 px-2 lg:py-4 lg:px-2.5 group"
>
  <span class="text-navy font-bold text-[10px] lg:text-xs uppercase tracking-[0.2em] group-hover:text-navy transition-colors">{label}</span>
</a>

<style>
  #floating-cta {
    position: fixed;
    right: 0;
    bottom: 33vh;
    z-index: 50;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transition: background-color 0.2s ease;
  }
</style>
