---
import { Image } from 'astro:assets';
import logo from '../assets/images/cabo-sailing-logo.png';
import { getLangFromUrl, getLocalePath, getAlternateLang, t } from '../i18n/utils';

interface Props {
  variant?: 'home' | 'subpage';
  activePage?: string;
}

const { variant = 'subpage', activePage = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const altLang = getAlternateLang(lang);
const currentPath = Astro.url.pathname;
const switchUrl = getLocalePath(altLang, currentPath.replace(/^\/es(\/|$)/, '/'));
const lp = (path: string) => getLocalePath(lang, path);

const tourDropdown = [
  { group: t(lang, 'nav.tourDropdown.snorkeling'), items: [
    { href: lp('/tours/private-snorkeling'), label: t(lang, 'nav.tourDropdown.privateSnorkeling') },
    { href: lp('/tours/snorkeling-cruise'), label: t(lang, 'nav.tourDropdown.sharedSnorkeling') },
  ]},
  { group: t(lang, 'nav.tourDropdown.sunset'), items: [
    { href: lp('/tours/private-sunset'), label: t(lang, 'nav.tourDropdown.privateSunset') },
    { href: lp('/tours/sunset-sailing'), label: t(lang, 'nav.tourDropdown.sharedSunset') },
  ]},
  { group: null, items: [
    { href: lp('/tours/whale-watching'), label: t(lang, 'nav.tourDropdown.whaleWatching') },
    { href: lp('/tours/bachelorette'), label: t(lang, 'nav.tourDropdown.bachelorette') },
    { href: lp('/tours/scuba-diving'), label: t(lang, 'nav.tourDropdown.scubaDiving') },
  ]},
];

const fleetDropdown = [
  { group: null, items: [
    { href: lp('/yacht-charter-cabo'), label: t(lang, 'nav.fleetDropdown.luxuryYachts') },
    { href: lp('/sailing-cabo-san-lucas'), label: t(lang, 'nav.fleetDropdown.luxurySailboats') },
  ]},
];

const navLinks = [
  { href: lp('/'), label: t(lang, 'nav.home'), key: 'home' },
  { href: lp('/tours'), label: t(lang, 'nav.tours'), key: 'tours', hasDropdown: true, dropdownData: tourDropdown },
  { href: lp('/yacht-charter-cabo'), label: t(lang, 'nav.fleet'), key: 'fleet', hasDropdown: true, dropdownData: fleetDropdown },
  { href: lp('/travel-guide'), label: t(lang, 'nav.travelGuide'), key: 'travel-guide' },
  { href: lp('/special-offers'), label: t(lang, 'nav.specialOffers'), key: 'special-offers' },
];
---

{variant === 'home' ? (
  <header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-border-light/50 transition-all duration-300">
    <!-- Mobile header (home) -->
    <div class="mobile-only flex items-center justify-between px-6 py-3">
      <div class="flex items-center gap-2 -ml-2">
        <a href="https://wa.me/526241916997?text=hi%2C%20I'm%20sending%20you%20a%20message%20from%20cabosailing.com" target="_blank" aria-label="Chat on WhatsApp" class="flex items-center justify-center w-10 h-10 bg-[#25D366] rounded-full text-white active:scale-95 transition-transform shadow-md">
          <i class="fa-brands fa-whatsapp text-2xl"></i>
        </a>
        <div class="relative">
          <button type="button" id="phone-toggle" aria-label="Call us" class="flex items-center justify-center w-10 h-10 bg-navy rounded-full text-white active:scale-95 transition-transform shadow-md">
            <span class="material-symbols-outlined text-xl">call</span>
          </button>
          <div id="phone-dropdown" class="hidden absolute left-0 top-full mt-2 bg-white rounded-xl shadow-xl border border-border-light min-w-[210px] z-50 overflow-hidden">
            <a href="tel:+526241438485" class="flex items-center gap-3 px-4 py-3 text-sm text-navy hover:bg-light-grey transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-widest bg-navy text-white px-2 py-0.5 rounded">MX</span>
              <span class="font-semibold">+52 624 143 8485</span>
            </a>
            <div class="h-px bg-border-light"></div>
            <a href="tel:+16197842745" class="flex items-center gap-3 px-4 py-3 text-sm text-navy hover:bg-light-grey transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-widest bg-navy text-white px-2 py-0.5 rounded">US</span>
              <span class="font-semibold">+1 619 784 2745</span>
            </a>
          </div>
        </div>
      </div>
      <div class="flex-shrink-0 flex items-center justify-center">
        <a href={lp('/')}><Image src={logo} alt="Cabo Sailing" class="h-10 w-auto object-contain" width={301} height={69} /></a>
      </div>
      <div class="flex items-center gap-2 -mr-2">
        <a href={switchUrl} class="text-[10px] font-bold uppercase tracking-widest text-navy border border-border-light rounded-full px-2 py-1">{altLang === 'es' ? 'ES' : 'EN'}</a>
        <button id="menu-open" aria-label="Open menu" class="flex flex-col gap-1 items-center justify-center w-10 h-10 text-navy active:scale-95 transition-transform">
          <div class="w-6 h-[2.5px] bg-navy rounded-full"></div>
          <div class="w-6 h-[2.5px] bg-navy rounded-full"></div>
          <div class="w-6 h-[2.5px] bg-navy rounded-full"></div>
        </button>
      </div>
    </div>
    <!-- Desktop header -->
    <div class="desktop-only items-center justify-between px-10 py-3 max-w-[1400px] mx-auto">
      <a href={lp('/')} class="flex-shrink-0">
        <Image src={logo} alt="Cabo Sailing" class="h-12 w-auto object-contain" width={301} height={69} />
      </a>
      <nav class="flex items-center gap-8">
        {navLinks.map(link => (
          link.hasDropdown ? (
            <div class="relative group">
              <a href={link.href} class={`text-sm font-semibold uppercase tracking-widest hover:text-gold transition-colors flex items-center gap-1 ${activePage === link.key ? 'text-gold' : 'text-navy'}`}>{link.label} <span class="material-symbols-outlined text-sm">expand_more</span></a>
              <div class="absolute top-full left-0 mt-2 bg-white rounded-xl shadow-xl border border-border-light py-3 min-w-[220px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                {link.dropdownData.map((section, idx) => (
                  <>
                    {idx > 0 && <div class="h-px bg-border-light my-2"></div>}
                    {section.group && <p class="px-4 py-1 text-[10px] font-bold text-slate-500 uppercase tracking-widest">{section.group}</p>}
                    {section.items.map(item => (
                      <a href={item.href} class="block px-4 py-2 text-sm text-navy hover:bg-light-grey hover:text-gold transition-colors">{item.label}</a>
                    ))}
                  </>
                ))}
              </div>
            </div>
          ) : (
            <a href={link.href} class={`text-sm font-semibold uppercase tracking-widest hover:text-gold transition-colors ${activePage === link.key ? 'text-gold' : 'text-navy'}`}>{link.label}</a>
          )
        ))}
      </nav>
      <div class="flex items-center gap-4">
        <a href="https://wa.me/526241916997?text=hi%2C%20I'm%20sending%20you%20a%20message%20from%20cabosailing.com" target="_blank" aria-label="Chat on WhatsApp" class="flex items-center justify-center w-10 h-10 bg-[#25D366] rounded-full text-white hover:scale-105 transition-transform shadow-md">
          <i class="fa-brands fa-whatsapp text-xl"></i>
        </a>
        <a href={switchUrl} class="text-sm font-bold uppercase tracking-widest text-navy hover:text-gold transition-colors border border-border-light rounded-full px-3 py-1.5">{altLang === 'es' ? 'ES' : 'EN'}</a>
      </div>
    </div>
  </header>
) : (
  <>
    <!-- Mobile header (subpage) -->
    <div class="lg:hidden fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-3 bg-white/80 backdrop-blur-md border-b border-border-light/50">
      <div class="flex items-center gap-2 -ml-2">
        <a href="https://wa.me/526241916997?text=hi%2C%20I'm%20sending%20you%20a%20message%20from%20cabosailing.com" target="_blank" aria-label="Chat on WhatsApp" class="flex items-center justify-center w-10 h-10 bg-[#25D366] rounded-full text-white active:scale-95 transition-transform shadow-md">
          <i class="fa-brands fa-whatsapp text-2xl"></i>
        </a>
        <div class="relative">
          <button type="button" id="phone-toggle" aria-label="Call us" class="flex items-center justify-center w-10 h-10 bg-navy rounded-full text-white active:scale-95 transition-transform shadow-md">
            <span class="material-symbols-outlined text-xl">call</span>
          </button>
          <div id="phone-dropdown" class="hidden absolute left-0 top-full mt-2 bg-white rounded-xl shadow-xl border border-border-light min-w-[210px] z-50 overflow-hidden">
            <a href="tel:+526241438485" class="flex items-center gap-3 px-4 py-3 text-sm text-navy hover:bg-light-grey transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-widest bg-navy text-white px-2 py-0.5 rounded">MX</span>
              <span class="font-semibold">+52 624 143 8485</span>
            </a>
            <div class="h-px bg-border-light"></div>
            <a href="tel:+16197842745" class="flex items-center gap-3 px-4 py-3 text-sm text-navy hover:bg-light-grey transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-widest bg-navy text-white px-2 py-0.5 rounded">US</span>
              <span class="font-semibold">+1 619 784 2745</span>
            </a>
          </div>
        </div>
      </div>
      <div class="flex-shrink-0 flex items-center justify-center">
        <a href={lp('/')}><Image src={logo} alt="Cabo Sailing" class="h-10 w-auto object-contain" width={301} height={69} /></a>
      </div>
      <div class="flex items-center gap-2 -mr-2">
        <a href={switchUrl} class="text-[10px] font-bold uppercase tracking-widest text-navy border border-border-light rounded-full px-2 py-1">{altLang === 'es' ? 'ES' : 'EN'}</a>
        <button id="menu-open" aria-label="Open menu" class="flex flex-col gap-1 items-center justify-center w-10 h-10 text-navy active:scale-95 transition-transform">
          <div class="w-6 h-[2.5px] bg-navy rounded-full"></div>
          <div class="w-6 h-[2.5px] bg-navy rounded-full"></div>
          <div class="w-6 h-[2.5px] bg-navy rounded-full"></div>
        </button>
      </div>
    </div>
    <!-- Desktop header (subpage) -->
    <header class="hidden lg:block fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-border-light/50 transition-all duration-300">
      <div class="flex items-center justify-between px-10 py-3 max-w-[1400px] mx-auto">
        <a href={lp('/')} class="flex-shrink-0">
          <Image src={logo} alt="Cabo Sailing" class="h-12 w-auto object-contain" width={301} height={69} />
        </a>
        <nav class="flex items-center gap-8">
          {navLinks.map(link => (
            link.hasDropdown ? (
              <div class="relative group">
                <a href={link.href} class={`text-sm font-semibold uppercase tracking-widest hover:text-gold transition-colors flex items-center gap-1 ${activePage === link.key ? 'text-gold' : 'text-navy'}`}>{link.label} <span class="material-symbols-outlined text-sm">expand_more</span></a>
                <div class="absolute top-full left-0 mt-2 bg-white rounded-xl shadow-xl border border-border-light py-3 min-w-[220px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  {link.dropdownData.map((section, idx) => (
                    <>
                      {idx > 0 && <div class="h-px bg-border-light my-2"></div>}
                      {section.group && <p class="px-4 py-1 text-[10px] font-bold text-slate-500 uppercase tracking-widest">{section.group}</p>}
                      {section.items.map(item => (
                        <a href={item.href} class="block px-4 py-2 text-sm text-navy hover:bg-light-grey hover:text-gold transition-colors">{item.label}</a>
                      ))}
                    </>
                  ))}
                </div>
              </div>
            ) : (
              <a href={link.href} class={`text-sm font-semibold uppercase tracking-widest hover:text-gold transition-colors ${activePage === link.key ? 'text-gold' : 'text-navy'}`}>{link.label}</a>
            )
          ))}
        </nav>
        <div class="flex items-center gap-4">
            <a href="https://wa.me/526241916997?text=hi%2C%20I'm%20sending%20you%20a%20message%20from%20cabosailing.com" target="_blank" aria-label="Chat on WhatsApp" class="flex items-center justify-center w-10 h-10 bg-[#25D366] rounded-full text-white hover:scale-105 transition-transform shadow-md">
            <i class="fa-brands fa-whatsapp text-xl"></i>
          </a>
          <a href={switchUrl} class="text-sm font-bold uppercase tracking-widest text-navy hover:text-gold transition-colors border border-border-light rounded-full px-3 py-1.5">{altLang === 'es' ? 'ES' : 'EN'}</a>
        </div>
      </div>
    </header>
  </>
)}

<script is:inline>
  document.addEventListener('click', function(e) {
    var toggle = document.getElementById('phone-toggle');
    var dropdown = document.getElementById('phone-dropdown');
    if (!toggle || !dropdown) return;
    if (toggle.contains(e.target)) {
      dropdown.classList.toggle('hidden');
    } else if (!dropdown.contains(e.target)) {
      dropdown.classList.add('hidden');
    }
  });
</script>
