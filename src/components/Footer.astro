---
import { Image } from 'astro:assets';
import logo from '../assets/images/cabo-sailing-logo.png';
---

<footer class="bg-navy text-white mt-16">
  <div class="max-w-[1400px] mx-auto px-5 lg:px-10 py-16">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <div>
        <Image src={logo} alt="Cabo Sailing" class="h-12 brightness-0 invert mb-6" width={192} height={48} />
        <p class="text-white/60 text-sm leading-relaxed">Premium yacht and sailing charters in Cabo San Lucas. Creating unforgettable experiences on the Sea of Cortez.</p>
      </div>
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-widest mb-4">Tours</h4>
        <div class="space-y-2 text-white/60 text-sm">
          <a href="/private-snorkeling" class="block hover:text-white transition-colors">Private Snorkeling</a>
          <a href="/shared-snorkeling" class="block hover:text-white transition-colors">Shared Snorkeling</a>
          <a href="/private-sunset" class="block hover:text-white transition-colors">Private Sunset</a>
          <a href="/shared-sunset" class="block hover:text-white transition-colors">Shared Sunset</a>
          <a href="/whale-watching" class="block hover:text-white transition-colors">Whale Watching</a>
          <a href="/bachelorette" class="block hover:text-white transition-colors">Bachelorette Party</a>
          <a href="/scuba-diving" class="block hover:text-white transition-colors">Scuba Diving</a>
        </div>
      </div>
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-widest mb-4">Company</h4>
        <div class="space-y-2 text-white/60 text-sm">
          <a href="/fleet" class="block hover:text-white transition-colors">Our Fleet</a>
          <a href="/shuttle-service" class="block hover:text-white transition-colors">Shuttle Service</a>
          <a href="/travel-guide" class="block hover:text-white transition-colors">Travel Guide</a>
          <a href="#" class="block hover:text-white transition-colors">About Our Crew</a>
        </div>
      </div>
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-widest mb-4">Contact</h4>
        <div class="space-y-3 text-white/60 text-sm">
          <a href="https://wa.me/526241916997" target="_blank" class="flex items-center gap-2 hover:text-white transition-colors"><i class="fa-brands fa-whatsapp text-[#25D366]"></i> +52 624 191 6997</a>
          <a href="tel:+526241438485" class="flex items-center gap-2 hover:text-white transition-colors"><span class="material-symbols-outlined text-sm">call</span> +52 624 143 8485</a>
          <a href="mailto:info@cabosailing.com" class="flex items-center gap-2 hover:text-white transition-colors"><span class="material-symbols-outlined text-sm">email</span> info@cabosailing.com</a>
          <div class="flex items-center gap-2 mt-1"><span class="material-symbols-outlined text-gold text-base">mail</span><a href="/contact" class="text-white font-bold hover:text-gold transition-colors">Contact Us Now</a></div>
        </div>
      </div>
    </div>
    <div class="border-t border-white/10 mt-12 pt-6 flex justify-between items-center">
      <p class="text-white/30 text-sm">&copy; 2026 Cabo Sailing. All rights reserved.</p>
      <p class="text-white/30 text-sm">Cabo San Lucas, Mexico</p>
    </div>
  </div>
</footer>
