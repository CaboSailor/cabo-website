---
import { Image } from 'astro:assets';
import logo from '../assets/images/cabo-sailing-logo.png';
import { getLangFromUrl, getLocalePath, t } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const lp = (path: string) => getLocalePath(lang, path);
---

<footer class="bg-navy text-white mt-16">
  <div class="max-w-[1400px] mx-auto px-5 lg:px-10 py-16">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <div>
        <Image src={logo} alt="Cabo Sailing" class="h-12 w-auto object-contain brightness-0 invert mb-6" width={301} height={69} />
        <p class="text-white/60 text-sm leading-relaxed">{t(lang, 'footer.tagline')}</p>
      </div>
      <div>
        <p class="font-semibold text-sm uppercase tracking-widest mb-4">{t(lang, 'footer.tours')}</p>
        <div class="space-y-2 text-white/60 text-sm">
          <a href={lp('/tours/private-snorkeling')} class="block hover:text-white transition-colors">{t(lang, 'nav.tourDropdown.privateSnorkeling')}</a>
          <a href={lp('/tours/snorkeling-cruise')} class="block hover:text-white transition-colors">{t(lang, 'nav.tourDropdown.sharedSnorkeling')}</a>
          <a href={lp('/tours/private-sunset')} class="block hover:text-white transition-colors">{t(lang, 'nav.tourDropdown.privateSunset')}</a>
          <a href={lp('/tours/sunset-sailing')} class="block hover:text-white transition-colors">{t(lang, 'nav.tourDropdown.sharedSunset')}</a>
          <a href={lp('/tours/whale-watching')} class="block hover:text-white transition-colors">{t(lang, 'nav.tourDropdown.whaleWatching')}</a>
          <a href={lp('/tours/bachelorette')} class="block hover:text-white transition-colors">{t(lang, 'footer.bachelorette')}</a>
          <a href={lp('/tours/scuba-diving')} class="block hover:text-white transition-colors">{t(lang, 'nav.tourDropdown.scubaDiving')}</a>
        </div>
      </div>
      <div>
        <p class="font-semibold text-sm uppercase tracking-widest mb-4">{t(lang, 'footer.company')}</p>
        <div class="space-y-2 text-white/60 text-sm">
          <a href={lp('/shuttle-service')} class="block hover:text-white transition-colors">{t(lang, 'nav.shuttleService')}</a>
          <a href={lp('/travel-guide')} class="block hover:text-white transition-colors">{t(lang, 'nav.travelGuide')}</a>
          <a href={lp('/about-us')} class="block hover:text-white transition-colors">{t(lang, 'footer.aboutUs')}</a>
          <a href={lp('/policies')} class="block hover:text-white transition-colors">{t(lang, 'footer.policies')}</a>
          <a href={lp('/sitemap')} class="block hover:text-white transition-colors">{t(lang, 'footer.sitemap')}</a>
        </div>
      </div>
      <div>
        <p class="font-semibold text-sm uppercase tracking-widest mb-4">{t(lang, 'footer.contact')}</p>
        <div class="space-y-3 text-white/60 text-sm">
          <a href="https://wa.me/526241916997" target="_blank" class="flex items-center gap-2 hover:text-white transition-colors"><i class="fa-brands fa-whatsapp text-[#25D366]"></i> +52 624 191 6997</a>
          <a href="tel:+526241438485" class="flex items-center gap-2 hover:text-white transition-colors"><span class="material-symbols-outlined text-sm">call</span> +52 624 143 8485</a>
          <a href="mailto:info@cabosailing.com" class="flex items-center gap-2 hover:text-white transition-colors"><span class="material-symbols-outlined text-sm">email</span> info@cabosailing.com</a>
          <div class="flex items-center gap-2 mt-1"><span class="material-symbols-outlined text-gold text-base">mail</span><a href={lp('/contact')} class="text-white font-bold hover:text-gold transition-colors">{t(lang, 'footer.contactNow')}</a></div>
          <div class="flex items-center gap-3 mt-4">
            <a href="https://www.instagram.com/cabosailing/" target="_blank" rel="noopener" aria-label="Instagram" class="text-white/60 hover:text-white transition-colors"><i class="fa-brands fa-instagram text-lg"></i></a>
            <a href="https://www.facebook.com/CaboSailing/" target="_blank" rel="noopener" aria-label="Facebook" class="text-white/60 hover:text-white transition-colors"><i class="fa-brands fa-facebook text-lg"></i></a>
            <a href="https://www.youtube.com/@cabosailing4394/featured" target="_blank" rel="noopener" aria-label="YouTube" class="text-white/60 hover:text-white transition-colors"><i class="fa-brands fa-youtube text-lg"></i></a>
          </div>
        </div>
      </div>
    </div>
    <div class="border-t border-white/10 mt-12 pt-6 flex justify-between items-center">
      <p class="text-white/60 text-sm">&copy; 2026 Cabo Sailing. {t(lang, 'footer.rights')}</p>
      <p class="text-white/60 text-sm">{t(lang, 'footer.location')}</p>
    </div>
  </div>
</footer>
