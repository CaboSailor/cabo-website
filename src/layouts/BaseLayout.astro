---
import MobileMenu from '../components/MobileMenu.astro';
import { getLangFromUrl, getLocalePath } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  ogImage?: string;
  ogImageAlt?: string;
  hreflangs?: { en: string; es: string };
}

const {
  title = "Cabo San Lucas Boat Tours & Sailing Charters | Cabo Sailing",
  description = "Book the best boat tours in Cabo San Lucas. Private & shared sailing charters, snorkeling at Pelican's Rock, sunset cruises & whale watching. Open bar included. Save 30% online.",
  bodyClass = "bg-bg-light font-display text-navy antialiased min-h-screen flex flex-col relative",
  ogImage = "/og/home.jpg",
  ogImageAlt,
  hreflangs,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const siteUrl = 'https://cabosailing.com';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = `${siteUrl}${canonicalPath}`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt ?? title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl} />
  {hreflangs && (
    <>
      <link rel="alternate" hreflang="en" href={`${siteUrl}${hreflangs.en}`} />
      <link rel="alternate" hreflang="es" href={`${siteUrl}${hreflangs.es}`} />
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}${hreflangs.en}`} />
    </>
  )}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />

  <!-- Google Fonts — non-blocking load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" /></noscript>

  <!-- Font Awesome — non-blocking load -->
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" /></noscript>

  <!-- Global Styles -->
  <style is:inline>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .material-symbols-outlined.filled {
      font-variation-settings: 'FILL' 1;
    }
    .safe-area-pb { padding-bottom: env(safe-area-inset-bottom); }
    .hero-video-wrap iframe {
      width: 100vw; height: 56.25vw; min-height: 100%; min-width: 177.78vh;
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    }
    .gold-divider {
      background: linear-gradient(to right, transparent, #b38e5d, transparent);
    }
    .font-serif-italic {
      font-family: 'Playfair Display', serif;
      font-style: italic;
    }
    @media (min-width: 1024px) {
      .mobile-only { display: none !important; }
      .desktop-only { display: flex !important; }
    }
    @media (max-width: 1023px) {
      .desktop-only { display: none !important; }
    }
    .group:hover .activity-carousel img,
    .group:hover .activity-slide { transform: scale(1.05); }
    .activity-carousel img,
    .activity-slide { transition: transform 0.5s ease; }
    .fleet-img-wrap img { }
    .fleet-img-wrap:hover img { }
    .fleet-img-wrap {
      height: 400px; width: 100%; overflow: hidden;
      border-radius: 2.5rem 2.5rem 0 0;
    }
    .fleet-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .fleet-img-wrap .boat-slide { border-radius: 2.5rem 2.5rem 0 0; }
    .fleet-img-wrap .boat-hero { object-position: center 60%; }
    .fleet-arrow {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
      width: 28px; height: 80px; border-radius: 6px; border: none;
      background: none; color: rgba(255,255,255,0.5); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.2s; padding: 0;
    }
    .fleet-arrow:hover { color: rgba(255,255,255,0.85); }
    .fleet-arrow.left { left: 10px; }
    .fleet-arrow.right { right: 10px; }
    .fleet-arrow .material-symbols-outlined { font-size: 36px; line-height: 1; font-weight: 300; }
  </style>
  <style is:inline>
    html, body { overflow-x: hidden; overscroll-behavior-x: none; }
    body { min-height: max(884px, 100dvh); }
  </style>

  <!-- Per-page head content (tracking scripts, extra styles, etc.) -->
  <slot name="head" />
</head>
<body class={bodyClass}>
  <slot />
  <MobileMenu />

  <!-- Global scripts -->
  <script is:inline src="/js/prices.js" defer></script>
  <script is:inline src="/js/boat-swipe.js"></script>
</body>
</html>
