---
import MobileMenu from '../components/MobileMenu.astro';
import { getLangFromUrl, getLocalePath } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  ogImage?: string;
  ogImageAlt?: string;
  hreflangs?: { en: string; es: string };
  noindex?: boolean;
}

const {
  title = "Cabo San Lucas Boat Tours & Sailing Charters | Cabo Sailing",
  description = "Book the best boat tours in Cabo San Lucas. Private & shared sailing charters, snorkeling at Pelican's Rock, sunset cruises & whale watching. Open bar included. Save 30% online.",
  bodyClass = "bg-bg-light font-display text-navy antialiased min-h-screen flex flex-col relative",
  ogImage = "/og/home.jpg",
  ogImageAlt,
  hreflangs,
  noindex = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const siteUrl = 'https://cabosailing.com';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = `${siteUrl}${canonicalPath}`;

const travelAgencySchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "@id": "https://cabosailing.com/#organization",
  "name": "Cabo Sailing Ocean Adventures",
  "url": "https://cabosailing.com",
  "logo": "https://cabosailing.com/og/home.jpg",
  "image": "https://cabosailing.com/og/home.jpg",
  "telephone": "+52-624-143-8485",
  "priceRange": "$$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "F Dock, Centro, Marina",
    "postalCode": "23450",
    "addressLocality": "Cabo San Lucas",
    "addressRegion": "Baja California Sur",
    "addressCountry": "MX"
  },
  "openingHours": "Mo-Su 07:30-20:00",
  "sameAs": [
    "https://www.facebook.com/CaboSailing/",
    "https://www.instagram.com/cabosailing/",
    "https://www.youtube.com/@cabosailing4394/"
  ]
});
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Tag Manager (suppressed on new.cabosailing.com staging) -->
  <script is:inline>(function(w,d,s,l,i){
  if(location.hostname==='new.cabosailing.com')return;
  w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-WLNZ3W7');</script>
  <!-- End Google Tag Manager -->

  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt ?? title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <title>{title}</title>
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <script type="application/ld+json" set:html={travelAgencySchema} />}
  <link rel="canonical" href={canonicalUrl} />
  {hreflangs && (
    <>
      <link rel="alternate" hreflang="en" href={`${siteUrl}${hreflangs.en}`} />
      <link rel="alternate" hreflang="es" href={`${siteUrl}${hreflangs.es}`} />
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}${hreflangs.en}`} />
    </>
  )}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico?v=2" />
  <link rel="shortcut icon" href="/favicon.ico?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
  <meta name="generator" content={Astro.generator} />

  <!-- Google Fonts — non-blocking load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;500;600;700&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" /></noscript>

  <!-- Material Symbols — subsetted to icons actually used (~10KB instead of 1.1MB) -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&icon_names=account_circle,add,airport_shuttle,anchor,arrow_back,arrow_forward,auto_awesome,auto_stories,backpack,badge,bakery_dining,block,cake,calendar_today,call,celebration,check,check_circle,checkroom,chevron_left,chevron_right,close,credit_card,deck,diamond,directions_car,dry_cleaning,eco,email,error,event_available,expand_more,explore,family_restroom,favorite,flight,forum,group,groups,handshake,health_and_safety,home,info,inventory_2,ios_share,language,lightbulb,liquor,local_bar,local_offer,location_on,lock,mail,mark_email_read,menu_book,mood,music_note,payments,person,person_add,person_off,pets,photo_camera,pin_drop,play_circle,pool,recommend,restaurant,room_service,sailing,savings,schedule,scuba_diving,security,settings_input_antenna,social_leaderboard,square_foot,star,stars,support_agent,surfing,tour,trending_down,verified,visibility,water,water_drop,waves,wb_sunny,wb_twilight,wifi,wine_bar&display=block" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&icon_names=account_circle,add,airport_shuttle,anchor,arrow_back,arrow_forward,auto_awesome,auto_stories,backpack,badge,bakery_dining,block,cake,calendar_today,call,celebration,check,check_circle,checkroom,chevron_left,chevron_right,close,credit_card,deck,diamond,directions_car,dry_cleaning,eco,email,error,event_available,expand_more,explore,family_restroom,favorite,flight,forum,group,groups,handshake,health_and_safety,home,info,inventory_2,ios_share,language,lightbulb,liquor,local_bar,local_offer,location_on,lock,mail,mark_email_read,menu_book,mood,music_note,payments,person,person_add,person_off,pets,photo_camera,pin_drop,play_circle,pool,recommend,restaurant,room_service,sailing,savings,schedule,scuba_diving,security,settings_input_antenna,social_leaderboard,square_foot,star,stars,support_agent,surfing,tour,trending_down,verified,visibility,water,water_drop,waves,wb_sunny,wb_twilight,wifi,wine_bar&display=block" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&icon_names=account_circle,add,airport_shuttle,anchor,arrow_back,arrow_forward,auto_awesome,auto_stories,backpack,badge,bakery_dining,block,cake,calendar_today,call,celebration,check,check_circle,checkroom,chevron_left,chevron_right,close,credit_card,deck,diamond,directions_car,dry_cleaning,eco,email,error,event_available,expand_more,explore,family_restroom,favorite,flight,forum,group,groups,handshake,health_and_safety,home,info,inventory_2,ios_share,language,lightbulb,liquor,local_bar,local_offer,location_on,lock,mail,mark_email_read,menu_book,mood,music_note,payments,person,person_add,person_off,pets,photo_camera,pin_drop,play_circle,pool,recommend,restaurant,room_service,sailing,savings,schedule,scuba_diving,security,settings_input_antenna,social_leaderboard,square_foot,star,stars,support_agent,surfing,tour,trending_down,verified,visibility,water,water_drop,waves,wb_sunny,wb_twilight,wifi,wine_bar&display=block" rel="stylesheet" /></noscript>

  <!-- Font Awesome — non-blocking load -->
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" /></noscript>

  <!-- Global Styles -->
  <style is:inline>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .material-symbols-outlined.filled {
      font-variation-settings: 'FILL' 1;
    }
    .safe-area-pb { padding-bottom: env(safe-area-inset-bottom); }
    .hero-video-wrap iframe {
      width: 100vw; height: 56.25vw; min-height: 100%; min-width: 177.78vh;
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    }
    .gold-divider {
      background: linear-gradient(to right, transparent, #b38e5d, transparent);
    }
    .font-serif-italic {
      font-family: 'Playfair Display', serif;
      font-style: italic;
    }
    @media (min-width: 1024px) {
      .mobile-only { display: none !important; }
      .desktop-only { display: flex !important; }
    }
    @media (max-width: 1023px) {
      .desktop-only { display: none !important; }
    }
    .group:hover .activity-carousel img,
    .group:hover .activity-slide { transform: scale(1.05); }
    .activity-carousel img,
    .activity-slide { transition: transform 0.5s ease; }
    .activity-slide {
      transform: scale(1);
      transform-origin: center center;
      will-change: transform, opacity;
      transition: opacity 0.6s ease-in-out, transform 0.7s ease-in-out;
      backface-visibility: hidden;
    }
    @media (hover: hover) {
      .activity-carousel:hover .activity-slide,
      .group:hover .activity-slide { transform: scale(1.05); }
    }
    .swipe-hint { opacity: 0; }
    .swipe-hint.active { animation: swipeHintShow 2.6s ease-in-out forwards; }
    .swipe-hint.dismissed {
      opacity: 0 !important;
      animation: none !important;
      transition: opacity 0.25s ease-out;
    }
    @keyframes swipeHintShow {
      0%   { opacity: 0; transform: translateY(6px); }
      15%  { opacity: 1; transform: translateY(0); }
      70%  { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(0); }
    }
    .fleet-img-wrap img { }
    .fleet-img-wrap:hover img { }
    .fleet-img-wrap {
      height: 400px; width: 100%; overflow: hidden;
      border-radius: 2.5rem 2.5rem 0 0;
    }
    .fleet-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .fleet-img-wrap .boat-slide { border-radius: 2.5rem 2.5rem 0 0; }
    .fleet-img-wrap .boat-hero { object-position: center 60%; }
    .fleet-arrow {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
      width: 28px; height: 80px; border-radius: 6px; border: none;
      background: none; color: rgba(255,255,255,0.5); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.2s; padding: 0;
    }
    .fleet-arrow:hover { color: rgba(255,255,255,0.85); }
    .fleet-arrow.left { left: 10px; }
    .fleet-arrow.right { right: 10px; }
    .fleet-arrow .material-symbols-outlined { font-size: 36px; line-height: 1; font-weight: 300; }
  </style>
  <style is:inline>
    html, body { overflow-x: hidden; overscroll-behavior-x: none; }
    html { touch-action: pan-y; }
    body { min-height: max(884px, 100dvh); touch-action: pan-y; }
    [class*="overflow-x-auto"], [class*="overflow-x-scroll"], .no-scrollbar { touch-action: pan-x; }
  </style>

  <!-- Per-page head content (tracking scripts, extra styles, etc.) -->
  <slot name="head" />
</head>
<body class={bodyClass}>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WLNZ3W7"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <slot />
  <MobileMenu />

  <!-- Global scripts -->
  <script is:inline src="/js/prices.js" defer></script>
  <script is:inline src="/js/boat-swipe.js"></script>

  <!-- Activity-carousel initializer (powers <CarouselImage>) -->
  <script is:inline>
    (function() {
      function initActivityCarousels() {
        document.querySelectorAll('.activity-carousel').forEach(function(carousel) {
          if (carousel.dataset.carouselReady === '1') return;
          var slides = carousel.querySelectorAll('.activity-slide');
          if (slides.length < 2) return;
          carousel.dataset.carouselReady = '1';
          var current = 0;
          var dotsWrap = carousel.querySelector('.carousel-dots');

          if (dotsWrap && !dotsWrap.children.length) {
            slides.forEach(function(_, i) {
              var dot = document.createElement('button');
              dot.type = 'button';
              dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
              dot.className = 'w-6 h-6 flex items-center justify-center';
              var inner = document.createElement('span');
              inner.className = 'block w-2 h-2 rounded-full transition-all ' + (i === 0 ? 'bg-white scale-125' : 'bg-white/50');
              dot.appendChild(inner);
              dot.addEventListener('click', function() { goTo(i); });
              dotsWrap.appendChild(dot);
            });
          }

          function goTo(idx) {
            slides[current].style.opacity = '0';
            current = ((idx % slides.length) + slides.length) % slides.length;
            slides[current].style.opacity = '1';
            if (dotsWrap) {
              dotsWrap.querySelectorAll('button > span').forEach(function(s, i) {
                s.className = 'block w-2 h-2 rounded-full transition-all ' + (i === current ? 'bg-white scale-125' : 'bg-white/50');
              });
            }
          }

          var prev = carousel.querySelector('.carousel-prev');
          var next = carousel.querySelector('.carousel-next');
          if (prev) prev.addEventListener('click', function() { goTo(current - 1); });
          if (next) next.addEventListener('click', function() { goTo(current + 1); });

          var startX = 0;
          carousel.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
          carousel.addEventListener('touchend', function(e) {
            var diff = startX - e.changedTouches[0].clientX;
            if (Math.abs(diff) > 40) goTo(current + (diff > 0 ? 1 : -1));
          });
        });
      }

      function initSwipeHints() {
        var hints = document.querySelectorAll('.swipe-hint');
        if (!hints.length || !('IntersectionObserver' in window)) return;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });
        hints.forEach(function(hint) {
          var carousel = hint.closest('.activity-carousel');
          if (carousel) {
            carousel.addEventListener('touchstart', function() { hint.classList.add('dismissed'); }, { passive: true, once: true });
          }
          observer.observe(hint);
        });
      }

      function init() { initActivityCarousels(); initSwipeHints(); }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>

  <!-- CallPage widget (EN/ES split by URL) -->
  <script is:inline define:vars={{ cpId: Astro.url.pathname.startsWith('/es/') ? 'q0C2to4d4CuA5RnSlqnPlvgeDhIIiUqZ_2RgAkGsujs' : 'j2KO2_ebrGGrb3YivxZQCjn01aVqS5U2n-NN9_8HorQ' }}>
    (function () {
      if (window.callpage) { console.warn('CallPage already loaded'); return; }
      var __cp = { id: cpId, version: '1.1' };
      window.callpage = function (method) {
        if (method === '__getQueue') return this.methods;
        if (method) {
          if (typeof window.callpage.execute === 'function') return window.callpage.execute.apply(this, arguments);
          (this.methods = this.methods || []).push({ arguments: arguments });
        }
      };
      window.callpage.__cp = __cp;
      window.callpage('api.button.autoshow');
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://cdn-widget.callpage.io/build/js/callpage.js?v=' + new Date().toISOString().split('T')[0].replace(/-/g, '');
      document.head.appendChild(s);
    })();
  </script>
</body>
</html>
