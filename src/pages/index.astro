---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import RezdyModal from '../components/RezdyModal.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { Image } from 'astro:assets';

// Hero slides
import heroSlide1 from "../assets/images/guests-on-sailboats/cabo-sailboat-guests-snorkeling-01.jpg";
import heroSlide2 from "../assets/images/guests-on-yachts/cabo-yacht-charter-guests-01-copy.png";
import heroSlide3 from "../assets/images/boats/sailing-38/cabo-sailing-38-el-arco-arch.png";
import heroSlide4 from "../assets/images/bachelorette/cabo-bachelorette-party.jpg";

// Activity section images
import actPrivateSnorkeling from "../assets/images/guests-on-sailboats/cabo-private-snorkeling-ocean-view.jpeg";
import actPrivateSunset from "../assets/images/guests-on-yachts/cabo-private-sunset-cruise-guests.jpg";
import actWhaleWatching from "../assets/images/whales/cabo-whale-watching-breaching.jpg";
import actBachelorette from "../assets/images/bachelorette/cabo-bachelorette-party-el-arco.png";
import actSharedSnorkeling from "../assets/images/guests-on-sailboats/cabo-sailboat-guests-snorkeling-02.jpg";
import actSharedSunset from "../assets/images/guests-on-sailboats/cabo-shared-sunset-sailing.jpg";

// Fleet: Yacht 51'
import yacht51Img from "../assets/images/boats/yacht-51/cabo-luxury-yacht-51-charter.png";

// Fleet: Yacht 45'
import yacht45Img from "../assets/images/boats/yacht-45/cabo-private-yacht-45-charter.png";

// Fleet: Yacht 42'
import yacht42_1 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-aerial.jpg";
import yacht42_2 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-bow.jpg";
import yacht42_3 from "../assets/images/guests-on-yachts/cabo-yacht-guests-relaxing.jpg";
import yacht42_4 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-aerial-wide.jpg";

// Fleet: Sailing 42'
import sailing42_2 from "../assets/images/guests-on-sailboats/cabo-sailing-guests-waving.jpg";
import sailing42_3 from "../assets/images/boats/sailing-42/cabo-sailing-42-interior.png";
import sailing42_5 from "../assets/images/guests-on-sailboats/cabo-sailing-42-guests-deck.jpg";

// Fleet: Sailing 38'
import sailing38_1 from "../assets/images/boats/sailing-38/cabo-sailing-38-el-arco.png";
import sailing38_2 from "../assets/images/boats/sailing-38/cabo-sailing-38-party-deck.png";
import sailing38_3 from "../assets/images/boats/sailing-38/cabo-sailing-38-interior.png";
import sailing38_4 from "../assets/images/guests-on-sailboats/cabo-sailing-38-guests-enjoying.jpg";

// Fleet: Shared Sailing
import sharedSailing1 from "../assets/images/boats/sailing-42/cabo-sailing-42-sailing-view.jpg";
import sharedSailing2 from "../assets/images/boats/sailing-42/cabo-sailing-42-aerial.jpg";
import sharedSailing3 from "../assets/images/boats/sailing-42/cabo-sailing-42-exterior-01.jpg";

// Reviews background
import reviewsBg from "../assets/images/boats/sailing-42/cabo-sailing-42-guests-on-deck.jpeg";

// Icons
import iconSnorkel from '../assets/icons/snorkel1.png';
import iconPaddleboard from '../assets/icons/paddle-board-clean.png';
---

<BaseLayout>

<Header variant="home" activePage="home" />


<main class="flex-1 w-full overflow-x-hidden pt-[72px]">

<!-- Hero Section -->
<div class="relative w-full h-[72vh] lg:h-[85vh] min-h-[560px] overflow-hidden" style="margin-bottom:-1px">
  <Image src={heroSlide1} alt="Luxury Yacht 51' in Cabo San Lucas" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-100 transition-opacity duration-1000" width={1920} height={1080} loading="eager" />
  <Image src={heroSlide2} alt="Luxury Yacht 51' cruising" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide3} alt="Sailing 38' at the Arch in Cabo San Lucas" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide4} alt="Cabo bachelorette party on a boat" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-transparent"></div>
  <div class="absolute inset-0 flex items-end lg:items-center px-6 lg:px-20 pb-24 lg:pb-0">
    <div class="max-w-3xl text-left">
      <h1 class="font-serif font-semibold text-white text-4xl sm:text-5xl lg:text-7xl leading-[1.08] drop-shadow-2xl">
        Luxury Sailing &amp;<br/>Yacht Cruises in<br/><span style="color:#f5e0b8">Cabo San Lucas</span>
      </h1>
      <p class="text-white/85 text-sm lg:text-lg mt-4 max-w-xl leading-relaxed">Small groups. Premium service. Smooth sailing.</p>
    </div>
  </div>
  <!-- Review Strip -->
  <div class="absolute bottom-0 left-0 right-0 bg-navy/50 backdrop-blur-sm py-5 px-6 lg:px-10 z-10">
    <div class="max-w-[1400px] mx-auto flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2">
          <p class="text-white text-xl lg:text-2xl font-serif font-semibold leading-snug">"The best experience in Cabo"</p>
          <div class="flex items-center gap-0.5 lg:hidden">
            <span class="material-symbols-outlined text-gold filled text-sm">star</span>
            <span class="material-symbols-outlined text-gold filled text-sm">star</span>
            <span class="material-symbols-outlined text-gold filled text-sm">star</span>
            <span class="material-symbols-outlined text-gold filled text-sm">star</span>
            <span class="material-symbols-outlined text-gold filled text-sm">star</span>
          </div>
        </div>
        <p class="text-white/70 text-sm leading-relaxed max-w-[480px] hidden lg:block">The crew was amazing, the boat was beautiful, and the views were absolutely unforgettable.</p>
        <p class="text-white/40 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
      </div>
      <div class="hidden lg:flex items-center gap-6 lg:gap-8 flex-shrink-0">
        <div class="flex flex-col items-center gap-1">
          <div class="flex items-center gap-1">
            <span class="text-white font-bold text-lg">4.9</span>
            <div class="flex items-center gap-0.5">
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
            </div>
          </div>
          <span class="text-white/40 text-[10px] uppercase tracking-widest font-bold">TripAdvisor</span>
        </div>
        <div class="flex flex-col items-center gap-1">
          <div class="flex items-center gap-1">
            <span class="text-white font-bold text-lg">4.9</span>
            <div class="flex items-center gap-0.5">
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
            </div>
          </div>
          <span class="text-white/40 text-[10px] uppercase tracking-widest font-bold">Google</span>
        </div>
        <div class="flex flex-col items-center gap-1">
          <div class="flex items-center gap-1">
            <span class="text-white font-bold text-lg">4.8</span>
            <div class="flex items-center gap-0.5">
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
              <span class="material-symbols-outlined text-gold filled text-sm">star</span>
            </div>
          </div>
          <span class="text-white/40 text-[10px] uppercase tracking-widest font-bold">Yelp</span>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    (function(){
      const slides = document.querySelectorAll('.hero-slide');
      let i = 0;
      setInterval(() => {
        slides[i].style.opacity = '0';
        i = (i + 1) % slides.length;
        slides[i].style.opacity = '1';
      }, 5000);
    })();
  </script>
</div>

<!-- Experience Heading -->
<div class="px-6 relative z-20 pt-8 mb-8 lg:max-w-[800px] lg:mx-auto text-center">
  <h2 class="text-xl md:text-2xl lg:text-3xl font-serif text-navy font-semibold leading-tight">Choose Your Perfect Cruise</h2>
  <p class="text-navy/60 text-sm mt-2 max-w-[400px] mx-auto">Private luxury or shared experience — both designed for comfort, not crowds.</p>
  <div class="flex items-center justify-center gap-1 mt-6 bg-light-grey rounded-full p-1 max-w-[360px] mx-auto border border-border-light">
    <button id="toggle-private" onclick="document.getElementById('section-private').scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('toggle-private').classList.add('bg-navy','text-white','shadow-md');document.getElementById('toggle-private').classList.remove('text-navy/60');document.getElementById('toggle-shared').classList.remove('bg-navy','text-white','shadow-md');document.getElementById('toggle-shared').classList.add('text-navy/60')" class="flex-1 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all bg-navy text-white shadow-md">Private Cruises</button>
    <button id="toggle-shared" onclick="document.getElementById('section-shared').scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('toggle-shared').classList.add('bg-navy','text-white','shadow-md');document.getElementById('toggle-shared').classList.remove('text-navy/60');document.getElementById('toggle-private').classList.remove('bg-navy','text-white','shadow-md');document.getElementById('toggle-private').classList.add('text-navy/60')" class="flex-1 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all text-navy/60">Shared Cruises</button>
  </div>
</div>

<!-- PRIVATE EXPERIENCES -->
<section id="section-private" class="py-16 lg:py-24 bg-white scroll-mt-[80px]">
<div class="max-w-screen-2xl mx-auto px-6 lg:px-10 space-y-32 lg:space-y-40">

<!-- Activity 1: Private Snorkeling -->
<div data-activity="private-snorkeling" class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
  <div class="md:col-span-7 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Most Popular</div>
    <div class="absolute top-6 right-6 z-30 bg-red-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">20% Off</div>
    <div class="aspect-[4/5] md:aspect-[16/10] overflow-hidden rounded-lg shadow-2xl">
      <Image src={actPrivateSnorkeling} alt="Private Snorkeling" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width={1200} height={750} />
    </div>
    <div class="absolute -bottom-10 -right-4 md:-right-10 bg-navy p-8 md:p-12 max-w-[280px] md:max-w-xs shadow-2xl z-20 border-b-4 border-accent-gold rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-accent-gold-light font-serif-italic text-2xl md:text-3xl mb-4">Sea It Your Way</h3>
      <p class="text-sky-100 text-xs md:text-sm leading-relaxed">Calm bays, clear water, no crowds — just your private charter.</p>
    </div>
  </div>
  <div class="md:col-span-5 space-y-8 pt-16 md:pt-0">
    <div class="space-y-4">
      <span class="text-accent-gold font-bold text-xs tracking-widest uppercase block">Private Charter</span>
      <h2 class="text-4xl lg:text-5xl font-serif-italic text-navy leading-tight">Private Snorkeling Cruise <span class="text-2xl lg:text-3xl text-navy/60">(Yacht or Sailboat)</span></h2>
      <p class="text-accent-gold/80 text-[11px] font-bold tracking-widest uppercase">Trusted by hundreds of guests every month</p>
    </div>
    <p class="text-navy/70 text-base lg:text-lg leading-relaxed">A private cruise to Cabo's best snorkeling spots with time to swim, relax, and enjoy food and drinks onboard.<br/>Perfect for families, couples, or groups who want a fun, flexible experience at their own pace.<br/>No crowds, more time in the water, and a crew focused entirely on your group.</p>
    <ul class="space-y-3 pt-2">
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">groups</span> Up to 18 guests</li>
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">local_bar</span> Open bar &amp; food</li>
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">pool</span> Snorkeling gear &amp; towels included</li>
    </ul>
    <div class="border-t border-border-light pt-6 space-y-4">
      <a href="/private-snorkeling" class="block text-center bg-transparent text-navy border border-navy w-full py-4 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">More Info</a>
    </div>
  </div>
</div>

<!-- Activity 2: Private Sunset Cruise -->
<div data-activity="private-sunset" class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
  <div class="md:col-span-7 order-1 md:order-2 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl bg-opacity-80 backdrop-blur-sm">Premium</div>
    <div class="absolute top-6 right-6 z-30 bg-red-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">20% Off</div>
    <div class="aspect-[4/5] md:aspect-[16/10] overflow-hidden rounded-lg shadow-2xl">
      <Image src={actPrivateSunset} alt="Private Sunset Cruise" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width={1200} height={750} />
    </div>
    <div class="absolute -bottom-10 -left-4 md:-left-10 bg-accent-gold p-8 md:p-12 max-w-[280px] md:max-w-xs shadow-2xl z-20 border-b-4 border-amber-300 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-white font-serif-italic text-2xl md:text-3xl mb-4">Golden Hour Magic</h3>
      <p class="text-amber-50 text-xs md:text-sm leading-relaxed">Sip an ice-cold, freshly-made margarita as the Baja sky transforms into a canvas of gold and violet.</p>
    </div>
  </div>
  <div class="md:col-span-5 order-2 md:order-1 space-y-8 pt-16 md:pt-0">
    <div class="space-y-4">
      <span class="text-accent-gold font-bold text-xs tracking-widest uppercase block">Exclusive Experience</span>
      <h2 class="text-4xl lg:text-5xl font-serif-italic text-navy leading-tight">Private Sunset Cruise <span class="text-2xl lg:text-3xl text-navy/60">(Yacht or Sailboat)</span></h2>
      <p class="text-accent-gold/80 text-[11px] font-bold tracking-widest uppercase">Favorite choice for couples</p>
    </div>
    <p class="text-navy/70 text-base lg:text-lg leading-relaxed">A private evening cruise past Cabo's Arch with drinks, light bites, and unforgettable sunset views.<br/>Ideal for couples, celebrations, or anyone looking for a relaxed and memorable experience.<br/>More intimate, smoother, and far less crowded than typical sunset tours.</p>
    <ul class="space-y-3 pt-2">
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">groups</span> Up to 18 guests</li>
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">local_bar</span> Open bar &amp; food</li>
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">pool</span> Snorkeling gear &amp; towels included</li>
    </ul>
    <div class="border-t border-border-light pt-6 space-y-4">
      <a href="/private-sunset" class="block text-center bg-transparent text-navy border border-navy w-full py-4 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">More Info</a>
    </div>
  </div>
</div>

<!-- Activity 3: Whale Watching -->
<div data-activity="whale-watching" class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
  <div class="md:col-span-7 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Sells Out Fast</div>
    <div class="absolute top-6 right-6 z-30 bg-red-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">20% Off</div>
    <div class="aspect-[4/5] md:aspect-[16/10] overflow-hidden rounded-lg shadow-2xl">
      <Image src={actWhaleWatching} alt="Whale Watching" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width={1200} height={750} />
    </div>
    <div class="absolute -bottom-10 -right-4 md:-right-10 bg-teal-900 p-8 md:p-12 max-w-[280px] md:max-w-xs shadow-2xl z-20 border-b-4 border-teal-400 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-teal-200 font-serif-italic text-2xl md:text-3xl mb-4">Ocean Giants</h3>
      <p class="text-teal-50/70 text-xs md:text-sm leading-relaxed">A front-row seat to the most majestic migration on the planet.</p>
    </div>
  </div>
  <div class="md:col-span-5 space-y-8 pt-16 md:pt-0">
    <div class="space-y-4">
      <span class="text-accent-gold font-bold text-xs tracking-widest uppercase block">Seasonal Wonder</span>
      <h2 class="text-4xl lg:text-5xl font-serif-italic text-navy leading-tight">Private Whale Watching Cruise <span class="text-2xl lg:text-3xl text-navy/60">(Yacht or Sailboat)</span></h2>
      <p class="text-accent-gold/80 text-[11px] font-bold tracking-widest uppercase">Last month's best seller</p>
    </div>
    <p class="text-navy/70 text-base lg:text-lg leading-relaxed">A private cruise to see Cabo's whales up close, guided by an experienced crew in their natural habitat.<br/>Perfect for families, couples, or small groups looking for a more personal and comfortable wildlife experience.<br/>Closer encounters, no crowds, and the flexibility to follow the whales at your own pace.</p>
    <ul class="space-y-3 pt-2">
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">groups</span> Up to 18 guests</li>
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">local_bar</span> Open bar &amp; food</li>
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">pool</span> Snorkeling gear &amp; towels included</li>
    </ul>
    <div class="border-t border-border-light pt-6 space-y-4">
      <a href="/whale-watching" class="block text-center bg-transparent text-navy border border-navy w-full py-4 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">More Info</a>
    </div>
  </div>
</div>

<!-- Activity 4: Bachelorette Party -->
<div data-activity="bachelorette-party" class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
  <div class="md:col-span-7 order-1 md:order-2 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">VIP Experience</div>
    <div class="absolute top-6 right-6 z-30 bg-red-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">20% Off</div>
    <div class="aspect-[4/5] md:aspect-[16/10] overflow-hidden rounded-lg shadow-2xl">
      <Image src={actBachelorette} alt="Bachelorette Party" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width={1200} height={750} />
    </div>
    <div class="absolute -bottom-10 -left-4 md:-left-10 bg-indigo-900 p-8 md:p-12 max-w-[280px] md:max-w-xs shadow-2xl z-20 border-b-4 border-pink-400 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-indigo-100 font-serif-italic text-2xl md:text-3xl mb-4">Ultimate Soir&eacute;e</h3>
      <p class="text-indigo-200 text-xs md:text-sm leading-relaxed">Custom themes and cocktails for a celebration she will never forget.</p>
    </div>
  </div>
  <div class="md:col-span-5 order-2 md:order-1 space-y-8 pt-16 md:pt-0">
    <div class="space-y-4">
      <span class="text-accent-gold font-bold text-xs tracking-widest uppercase block">Celebrations</span>
      <h2 class="text-4xl lg:text-5xl font-serif-italic text-navy leading-tight">Private Bachelorette Party Cruise <span class="text-2xl lg:text-3xl text-navy/60">(Yacht or Sailboat)</span></h2>
      <p class="text-accent-gold/80 text-[11px] font-bold tracking-widest uppercase">Trusted event experts</p>
    </div>
    <p class="text-navy/70 text-base lg:text-lg leading-relaxed">A private cruise designed for celebrating—music, drinks, great views, and plenty of time to relax and have fun with your group.<br/>Perfect for bachelorette parties looking for a stylish, fun, and stress-free experience on the water.<br/>Your own space, no crowds, and a crew that takes care of everything so you can focus on celebrating.</p>
    <ul class="space-y-3 pt-2">
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">groups</span> Up to 18 guests</li>
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">local_bar</span> Open bar &amp; food</li>
      <li class="flex items-center gap-3 text-navy/70 font-medium text-sm"><span class="material-symbols-outlined text-accent-gold text-lg">pool</span> Snorkeling gear &amp; towels included</li>
    </ul>
    <div class="border-t border-border-light pt-6 space-y-4">
      <a href="/bachelorette-party" class="block text-center bg-transparent text-navy border border-navy w-full py-4 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">More Info</a>
    </div>
  </div>
</div>

</div>
</section>

<!-- SHARED EXPERIENCES -->
<section id="section-shared" class="py-16 lg:py-24 bg-[#f5f3ef] border-y border-border-light/50 scroll-mt-[80px]">
