<script is:inline>
  function fleetNav(btn, dir) {
    var wrap = btn.closest('.fleet-img-wrap');
    var slides = wrap.querySelectorAll('.boat-slide');
    var current = 0;
    slides.forEach(function(s, i) { if (s.style.opacity === '1' || s.classList.contains('opacity-100')) current = i; });
    slides[current].style.opacity = '0';
    slides[current].classList.remove('opacity-100');
    var next = (current + dir + slides.length) % slides.length;
    slides[next].style.opacity = '1';
  }

  (function() {
    document.querySelectorAll('.activity-carousel').forEach(function(carousel) {
      var slides = carousel.querySelectorAll('.activity-slide');
      if (slides.length < 2) return;
      var current = 0;
      var dotsWrap = carousel.querySelector('.carousel-dots');

      // Build dots
      if (dotsWrap) {
        slides.forEach(function(_, i) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.className = 'w-6 h-6 flex items-center justify-center';
          var inner = document.createElement('span');
          inner.className = 'block w-2 h-2 rounded-full transition-all ' + (i === 0 ? 'bg-white scale-125' : 'bg-white/50');
          dot.appendChild(inner);
          dot.addEventListener('click', function() { goTo(i); });
          dotsWrap.appendChild(dot);
        });
      }

      function goTo(idx) {
        slides[current].style.opacity = '0';
        current = ((idx % slides.length) + slides.length) % slides.length;
        slides[current].style.opacity = '1';
        if (dotsWrap) {
          dotsWrap.querySelectorAll('button > span').forEach(function(s, i) {
            s.className = 'block w-2 h-2 rounded-full transition-all ' + (i === current ? 'bg-white scale-125' : 'bg-white/50');
          });
        }
      }

      // Arrow buttons
      var prev = carousel.querySelector('.carousel-prev');
      var next = carousel.querySelector('.carousel-next');
      if (prev) prev.addEventListener('click', function() { goTo(current - 1); });
      if (next) next.addEventListener('click', function() { goTo(current + 1); });

      // Touch swipe
      var startX = 0;
      carousel.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
      carousel.addEventListener('touchend', function(e) {
        var diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) goTo(current + (diff > 0 ? 1 : -1));
      });
    });
  })();

  // Mobile swipe hint — fades in when carousel scrolls into view, then fades out
  (function() {
    var hints = document.querySelectorAll('.swipe-hint');
    if (!hints.length || !('IntersectionObserver' in window)) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    hints.forEach(function(hint) {
      // Hide instantly on first user touch on its carousel
      var carousel = hint.closest('.activity-carousel');
      if (carousel) {
        carousel.addEventListener('touchstart', function() { hint.classList.add('dismissed'); }, { passive: true, once: true });
      }
      observer.observe(hint);
    });
  })();

  var reviewsPage = 0;
  function scrollReviews(dir) {
    reviewsPage = Math.max(0, Math.min(1, reviewsPage + dir));
    var container = document.getElementById('reviews-carousel');
    var card = container.children[0];
    var gap = 24;
    var scrollAmount = (card.offsetWidth + gap) * 3 * reviewsPage;
    container.scrollTo({ left: scrollAmount, behavior: 'smooth' });
    updateReviewDots();
  }
  function goToReviewPage(page) {
    reviewsPage = page;
    var container = document.getElementById('reviews-carousel');
    var card = container.children[0];
    var gap = 24;
    var scrollAmount = (card.offsetWidth + gap) * 3 * page;
    container.scrollTo({ left: scrollAmount, behavior: 'smooth' });
    updateReviewDots();
  }
  function updateReviewDots() {
    var dots = document.querySelectorAll('.review-dot');
    dots.forEach(function(dot, i) {
      dot.className = 'review-dot w-2.5 h-2.5 rounded-full transition-colors ' + (i === reviewsPage ? 'bg-accent-gold' : 'bg-navy/20');
    });
  }
</script>

<style>
  .activity-slide {
    transform: scale(1);
    transform-origin: center center;
    will-change: transform, opacity;
    transition: opacity 0.6s ease-in-out, transform 0.7s ease-in-out;
    backface-visibility: hidden;
  }
  @media (hover: hover) {
    .activity-carousel:hover .activity-slide,
    .group:hover .activity-slide {
      transform: scale(1.05);
    }
  }
  .swipe-hint {
    opacity: 0;
  }
  .swipe-hint.active {
    animation: swipeHintShow 2.6s ease-in-out forwards;
  }
  .swipe-hint.dismissed {
    opacity: 0 !important;
    animation: none !important;
    transition: opacity 0.25s ease-out;
  }
  @keyframes swipeHintShow {
    0%   { opacity: 0; transform: translateY(6px); }
    15%  { opacity: 1; transform: translateY(0); }
    70%  { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(0); }
  }
</style>

