---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import RezdyModal from '../components/RezdyModal.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import CarouselImage from '../components/CarouselImage.astro';
import { Image } from 'astro:assets';

// Hero slides
import heroSlide1 from "../assets/images/guests-on-sailboats/luxury-sailboat-in-tropical-waters.png";
import heroSlide2 from "../assets/images/guests-on-yachts/relaxing-day-on-a-luxury-boat.png";
import heroSlide3 from "../assets/images/guests-on-sailboats/sailing-through-cabo's-vibrant-waters.png";
import heroSlide4 from "../assets/images/guests-on-yachts/cabo-yacht-charter-guests-01-copy.png";

// Carousel config
import carouselConfig from "../data/carousels.json";

// Images still used directly (not in carousels)
import yacht42_1 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-aerial.jpg";
import yacht42_2 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-bow.jpg";
import yacht42_3 from "../assets/images/guests-on-yachts/cabo-yacht-guests-relaxing.jpg";
import yacht42_4 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-aerial-wide.jpg";
import sailing42_2 from "../assets/images/guests-on-sailboats/cabo-sailing-guests-waving.jpg";
import sailing42_3 from "../assets/images/boats/sailing-42/cabo-sailing-42-interior.png";
import sailing42_5 from "../assets/images/guests-on-sailboats/cabo-sailing-42-guests-deck.jpg";
import sailing38_1 from "../assets/images/boats/sailing-38/cabo-sailing-38-el-arco.png";
import sailing38_2 from "../assets/images/boats/sailing-38/cabo-sailing-38-party-deck.png";
import sailing38_3 from "../assets/images/boats/sailing-38/cabo-sailing-38-interior.png";
import sailing38_4 from "../assets/images/guests-on-sailboats/cabo-sailing-38-guests-enjoying.jpg";
import sharedSailing1 from "../assets/images/boats/sailing-42/cabo-sailing-42-sailing-view.jpg";
import sharedSailing2 from "../assets/images/boats/sailing-42/cabo-sailing-42-aerial.jpg";
import sharedSailing3 from "../assets/images/boats/sailing-42/cabo-sailing-42-exterior-01.jpg";
import reviewsBg from "../assets/images/boats/sailing-42/cabo-sailing-42-guests-on-deck.webp";

// Glob all images so we can look them up by path from the JSON
const allImages = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{jpg,jpeg,png,webp}', { eager: true });

function getImage(relativePath: string): ImageMetadata {
  const key = `../assets/images/${relativePath}`;
  const mod = allImages[key];
  if (!mod) throw new Error(`Image not found: ${relativePath} (looked up as ${key})`);
  return mod.default;
}

function getImages(paths: string[]): ImageMetadata[] {
  return paths.map(getImage);
}

const activityImages: Record<string, ImageMetadata[]> = {};
for (const [key, paths] of Object.entries(carouselConfig.activities)) {
  activityImages[key] = getImages(paths as string[]);
}
const fleetImages: Record<string, ImageMetadata[]> = {};
for (const [key, paths] of Object.entries(carouselConfig.fleet)) {
  fleetImages[key] = getImages(paths as string[]);
}

---

<BaseLayout title="Private Yacht & Sailboat Charters in Cabo San Lucas | Cabo Sailing" description="Private yacht and sailboat charters in Cabo San Lucas — sunset cruises, snorkeling, whale watching and bachelorettes. Crew, drinks and gear included." ogImage="/og/home.jpg" ogImageAlt="Cabo Sailing luxury yacht in Cabo San Lucas" hreflangs={{ en: '/', es: '/es/' }}>

<Header variant="home" activePage="home" />


<main class="flex-1 w-full overflow-x-hidden pt-[72px]">

<!-- Hero Section -->
<div class="relative w-full h-[72vh] lg:h-[85vh] min-h-[560px] overflow-hidden" style="margin-bottom:-1px">
  <Image src={heroSlide1} alt="Luxury sailboat in tropical waters" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-100 transition-opacity duration-1000" width={1920} height={1080} loading="eager" fetchpriority="high" />
  <Image src={heroSlide2} alt="Relaxing day on a luxury boat" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide3} alt="Sailing through Cabo's vibrant waters" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide4} alt="Guests enjoying a Cabo yacht charter" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <div class="absolute inset-0 bg-gradient-to-r from-black/15 via-black/30 to-transparent"></div>
  <div class="absolute inset-0 flex items-end lg:items-center px-6 lg:px-20 pb-24 lg:pb-0">
    <div class="max-w-3xl text-left">
      <h1 class="font-serif font-semibold text-white text-4xl sm:text-5xl lg:text-7xl leading-[1.08] drop-shadow-2xl">
        Luxury Sailing &amp;<br/>Yacht Cruises in<br/><span style="color:#f5e0b8">Cabo San Lucas</span>
      </h1>
      <p class="text-white/85 text-sm lg:text-lg mt-4 max-w-xl leading-relaxed">Small groups. Premium service. Smooth sailing.</p>
      <!-- Review (inline on mobile, absolute on desktop) -->
      <div class="mt-6 lg:hidden">
        <div class="flex items-center gap-1 mb-2">
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
        </div>
        <p class="text-white text-lg font-semibold leading-snug">"Amazing crew, beautiful boat, unforgettable views."</p>
        <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
      </div>
    </div>
  </div>
  <!-- Review Card (desktop only) -->
  <div class="absolute bottom-10 left-10 z-10 max-w-[420px] hidden lg:block">
    <div class="flex items-center gap-1 mb-2">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-lg leading-snug">"Amazing crew, beautiful boat, unforgettable views."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
  </div>
  <!-- TripAdvisor Travelers' Choice -->
  <div class="absolute bottom-6 right-6 lg:bottom-10 lg:right-10 z-10 hidden md:block">
    <img src="https://static.tacdn.com/img2/travelers_choice/widgets/tchotel_2024_L.png" alt="TripAdvisor Travelers' Choice 2024" class="h-24 lg:h-32 w-auto drop-shadow-2xl opacity-70" />
  </div>
  <script is:inline>
    (function(){
      const slides = document.querySelectorAll('.hero-slide');
      let i = 0;
      setInterval(() => {
        slides[i].style.opacity = '0';
        i = (i + 1) % slides.length;
        slides[i].style.opacity = '1';
      }, 5000);
    })();
  </script>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Save up to 40% off &mdash; Limited Time</p>
</div>

<!-- Experience Heading -->
<div class="px-6 relative z-20 pt-8 mb-8 lg:max-w-[800px] lg:mx-auto text-center">
  <h2 class="text-xl md:text-2xl lg:text-3xl font-serif text-navy font-semibold leading-tight">Find Your Perfect Cruise</h2>
  <p class="text-navy/70 text-sm mt-2 max-w-[400px] mx-auto">Private or small-group — designed for comfort, space, and unforgettable moments.</p>
  <div class="flex items-center justify-center gap-1 mt-6 bg-light-grey rounded-full p-1 max-w-[360px] mx-auto border border-border-light">
    <button id="toggle-private" onclick="document.getElementById('section-private').scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('toggle-private').classList.add('bg-navy','text-white','shadow-md');document.getElementById('toggle-private').classList.remove('text-navy/70');document.getElementById('toggle-shared').classList.remove('bg-navy','text-white','shadow-md');document.getElementById('toggle-shared').classList.add('text-navy/70')" class="flex-1 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all bg-navy text-white shadow-md">Private Cruises</button>
    <button id="toggle-shared" onclick="document.getElementById('section-shared').scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('toggle-shared').classList.add('bg-navy','text-white','shadow-md');document.getElementById('toggle-shared').classList.remove('text-navy/70');document.getElementById('toggle-private').classList.remove('bg-navy','text-white','shadow-md');document.getElementById('toggle-private').classList.add('text-navy/70')" class="flex-1 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all text-navy/70">Shared Cruises</button>
  </div>
</div>

<!-- PRIVATE EXPERIENCES -->
<section id="section-private" class="pt-8 pb-16 lg:pt-12 lg:pb-24 bg-white scroll-mt-[80px]">
<div class="max-w-screen-2xl mx-auto px-6 lg:px-10 space-y-12 lg:space-y-20">

<!-- Activity 1: Private Snorkeling -->
<div data-activity="private-snorkeling" class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
  <div class="md:col-span-7 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold-dark text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Most Popular</div>

    <div class={`aspect-[4/3] md:aspect-[16/9] overflow-hidden rounded-lg shadow-2xl ${activityImages['private-snorkeling'].length > 1 ? 'activity-carousel' : ''} relative`}>
      {activityImages['private-snorkeling'].map((img, idx) => (
        <Image src={img} alt="Private Snorkeling" class="activity-slide absolute inset-0 w-full h-full object-cover" style={`opacity:${idx === 0 ? 1 : 0};`} width={1200} height={750} />
      ))}
      {activityImages['private-snorkeling'].length > 1 && (
        <><button type="button" aria-label="Previous slide" class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_left</span></button>
        <button type="button" aria-label="Next slide" class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_right</span></button>
        <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2"></div>
        <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
          <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-2xl">arrow_back</span>
            <span class="text-[11px] uppercase tracking-widest font-bold">Swipe</span>
            <span class="material-symbols-outlined text-2xl">arrow_forward</span>
          </div>
        </div></>
      )}
    </div>
    <div class="absolute -bottom-4 right-2 md:-right-10 bg-navy p-3 md:p-8 max-w-[260px] md:max-w-[280px] shadow-2xl z-20 border-b-4 border-accent-gold rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-accent-gold-light font-serif-italic text-2xl md:text-3xl mb-0 md:mb-4">Sea It Your Way</h3>
      <p class="text-sky-100 hidden md:block text-xs md:text-sm leading-relaxed">Calm bays, clear water, no crowds — just your private charter.</p>
    </div>
  </div>

  <div class="md:col-span-5 space-y-3 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-3xl lg:text-4xl font-serif-italic text-navy leading-tight">Private Snorkeling Cruise <span class="text-xl lg:text-2xl text-navy/70">(Yacht or Sailboat)</span></h2>
      <p class="text-accent-gold-dark text-[11px] font-bold tracking-widest uppercase">Trusted by hundreds of guests every month</p>
      <p class="text-navy/70 text-sm font-medium flex items-center gap-1.5"><span class="material-symbols-outlined text-base">schedule</span> 3 Hours</p>
    </div>
    <p class="text-navy/70 text-sm lg:text-base leading-relaxed">A private cruise to Cabo's best snorkeling spots with time to swim, relax, and enjoy food and drinks onboard.<br/>Perfect for families, couples, or groups who want a fun, flexible experience at their own pace.<br/>No crowds, more time in the water, and a crew focused entirely on your group.</p>
    <ul class="space-y-2">
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Your Own Private Yacht or Sailboat – No crowds, just your group on a premium vessel.</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Sightseeing &amp; Snorkeling – Visit Land's End and the Arch, then dive into Cabo's best reefs.</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> All-Inclusive Service – Premium open bar and fresh local food included.</li>
    </ul>
    <div class="pt-2 space-y-4">
      <a href="/private-snorkeling/" class="block text-center bg-transparent text-navy border border-navy w-full py-3 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">Private Snorkeling Details</a>
    </div>
    <div class="md:hidden border-b border-border-light mt-8"></div>
  </div>
</div>

<!-- Activity 2: Private Sunset Cruise -->
<div data-activity="private-sunset" class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
  <div class="md:col-span-7 order-1 md:order-2 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold-dark text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl bg-opacity-80 backdrop-blur-sm">Premium</div>

    <div class={`aspect-[4/3] md:aspect-[16/9] overflow-hidden rounded-lg shadow-2xl ${activityImages['private-sunset'].length > 1 ? 'activity-carousel' : ''} relative`}>
      {activityImages['private-sunset'].map((img, idx) => (
        <Image src={img} alt="Private Sunset Cruise" class="activity-slide absolute inset-0 w-full h-full object-cover" style={`opacity:${idx === 0 ? 1 : 0};`} width={1200} height={750} />
      ))}
      {activityImages['private-sunset'].length > 1 && (
        <><button type="button" aria-label="Previous slide" class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_left</span></button>
        <button type="button" aria-label="Next slide" class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_right</span></button>
        <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2"></div>
        <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
          <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-2xl">arrow_back</span>
            <span class="text-[11px] uppercase tracking-widest font-bold">Swipe</span>
            <span class="material-symbols-outlined text-2xl">arrow_forward</span>
          </div>
        </div></>
      )}
    </div>
    <div class="absolute -bottom-4 left-2 md:-left-10 bg-accent-gold p-3 md:p-8 max-w-[260px] md:max-w-[280px] shadow-2xl z-20 border-b-4 border-amber-300 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-white font-serif-italic text-2xl md:text-3xl mb-0 md:mb-4">Golden Hour Magic</h3>
      <p class="text-white hidden md:block text-xs md:text-sm leading-relaxed">Sip an ice-cold, freshly-made margarita as the Baja sky transforms into a canvas of gold and violet.</p>
    </div>
  </div>

  <div class="md:col-span-5 order-2 md:order-1 space-y-3 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-3xl lg:text-4xl font-serif-italic text-navy leading-tight">Private Sunset Cruise <span class="text-xl lg:text-2xl text-navy/70">(Yacht or Sailboat)</span></h2>
      <p class="text-accent-gold-dark text-[11px] font-bold tracking-widest uppercase">Favorite choice for couples</p>
      <p class="text-navy/70 text-sm font-medium flex items-center gap-1.5"><span class="material-symbols-outlined text-base">schedule</span> 3 Hours</p>
    </div>
    <p class="text-navy/70 text-sm lg:text-base leading-relaxed">A private evening cruise past Cabo's Arch with drinks, light bites, and unforgettable sunset views.<br/>Ideal for couples, celebrations, or anyone looking for a relaxed and memorable experience.<br/>More intimate, smoother, and far less crowded than typical sunset tours.</p>
    <ul class="space-y-2">
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Spotless, luxurious yacht or sailboat</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> All-inclusive service — premium open bar &amp; fresh local bites</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Private sunset experience — Cabo's most iconic views, just for you</li>
    </ul>
    <div class="pt-2 space-y-4">
      <a href="/private-sunset/" class="block text-center bg-transparent text-navy border border-navy w-full py-3 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">Private Sunset Details</a>
    </div>
    <div class="md:hidden border-b border-border-light mt-8"></div>
  </div>
</div>

<!-- Activity 3: Whale Watching -->
<div data-activity="whale-watching" class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
  <div class="md:col-span-7 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold-dark text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Sells Out Fast</div>

    <div class={`aspect-[4/3] md:aspect-[16/9] overflow-hidden rounded-lg shadow-2xl ${activityImages['whale-watching'].length > 1 ? 'activity-carousel' : ''} relative`}>
      {activityImages['whale-watching'].map((img, idx) => (
        <Image src={img} alt="Whale Watching" class="activity-slide absolute inset-0 w-full h-full object-cover" style={`opacity:${idx === 0 ? 1 : 0};`} width={1200} height={750} />
      ))}
      {activityImages['whale-watching'].length > 1 && (
        <><button type="button" aria-label="Previous slide" class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_left</span></button>
        <button type="button" aria-label="Next slide" class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_right</span></button>
        <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2"></div>
        <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
          <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-2xl">arrow_back</span>
            <span class="text-[11px] uppercase tracking-widest font-bold">Swipe</span>
            <span class="material-symbols-outlined text-2xl">arrow_forward</span>
          </div>
        </div></>
      )}
    </div>
    <div class="absolute -bottom-4 right-2 md:-right-10 bg-teal-900 p-3 md:p-8 max-w-[260px] md:max-w-[280px] shadow-2xl z-20 border-b-4 border-teal-400 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-teal-200 font-serif-italic text-2xl md:text-3xl mb-0 md:mb-4">Ocean Giants</h3>
      <p class="text-teal-50/70 hidden md:block text-xs md:text-sm leading-relaxed">A front-row seat to the most majestic migration on the planet.</p>
    </div>
  </div>

  <div class="md:col-span-5 space-y-3 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-3xl lg:text-4xl font-serif-italic text-navy leading-tight">Private Whale Watching Cruise <span class="text-xl lg:text-2xl text-navy/70">(Yacht or Sailboat)</span></h2>
      <p class="text-accent-gold-dark text-[11px] font-bold tracking-widest uppercase">Last month's best seller</p>
      <p class="text-navy/70 text-sm font-medium flex items-center gap-1.5"><span class="material-symbols-outlined text-base">schedule</span> 3 Hours</p>
    </div>
    <p class="text-navy/70 text-sm lg:text-base leading-relaxed">A private cruise to see Cabo's whales up close, guided by an experienced crew in their natural habitat.<br/>Perfect for families, couples, or small groups looking for a more personal and comfortable wildlife experience.<br/>Closer encounters, no crowds, and the flexibility to follow the whales at your own pace.</p>
    <ul class="space-y-2">
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Your own private yacht or sailboat</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Up-close whale encounters — front-row views in their natural habitat</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> All-inclusive experience — drinks, snacks, and expert crew</li>
    </ul>
    <div class="pt-2 space-y-4">
      <a href="/whale-watching/" class="block text-center bg-transparent text-navy border border-navy w-full py-3 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">Whale Watching Details</a>
    </div>
    <div class="md:hidden border-b border-border-light mt-8"></div>
