---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import RezdyModal from '../components/RezdyModal.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import CarouselImage from '../components/CarouselImage.astro';
import { Image } from 'astro:assets';

// Hero slides
import heroSlide1 from "../assets/images/guests-on-sailboats/luxury-sailboat-in-tropical-waters.png";
import heroSlide2 from "../assets/images/guests-on-yachts/relaxing-day-on-a-luxury-boat.png";
import heroSlide3 from "../assets/images/guests-on-sailboats/sailing-through-cabo's-vibrant-waters.png";
import heroSlide4 from "../assets/images/guests-on-yachts/cabo-yacht-charter-guests-01-copy.png";

// Carousel config
import carouselConfig from "../data/carousels.json";

// Activity card images
import imgSnorkelCruise from "../assets/images/guests-on-sailboats/snorkeler-exploring-underwater-paradise.png";
import imgPrivateSnorkeling from "../assets/images/guests-on-yachts/paddleboarding-in-sunny-cabo-waters.png";
import imgSunsetSailing from "../assets/images/guests-on-sailboats/relaxing_on_a_sailboat_at_sea.png";
import imgPrivateSunset from "../assets/images/guests-on-yachts/sunset-boat-ride-with-a-view.png";
import imgBachelorette from "../assets/images/bachelorette/cabo-bachelorette-party-el-arco.png";
import imgWhale from "../assets/images/whales/cabo-whale-watching-close-up.png";
import imgScuba from "../assets/images/scuba-diving/scuba-divers-preparing-near-the-boat.png";

import reviewsBg from "../assets/images/boats/sailing-42/cabo-sailing-42-guests-on-deck.webp";

// Glob all images so we can look them up by path from the JSON
const allImages = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{jpg,jpeg,png,webp}', { eager: true });

function getImage(relativePath: string): ImageMetadata {
  const key = `../assets/images/${relativePath}`;
  const mod = allImages[key];
  if (!mod) throw new Error(`Image not found: ${relativePath} (looked up as ${key})`);
  return mod.default;
}

function getImages(paths: (string | { src: string })[]): ImageMetadata[] {
  return paths.map((p) => getImage(typeof p === 'string' ? p : p.src));
}

const activities = [
  { title: "Snorkeling Cruise", href: "/tours/snorkeling-cruise/", image: imgSnorkelCruise, alt: "Snorkeling cruise in Cabo San Lucas", imgClass: "", imgPos: "center" },
  { title: "Private Snorkeling", href: "/tours/private-snorkeling/", image: imgPrivateSnorkeling, alt: "Private snorkeling cruise in Cabo San Lucas", imgClass: "", imgPos: "center 60%" },
  { title: "Sunset Sailing", href: "/tours/sunset-sailing/", image: imgSunsetSailing, alt: "Sunset sailing cruise in Cabo San Lucas", imgClass: "", imgPos: "center" },
  { title: "Private Sunset", href: "/tours/private-sunset/", image: imgPrivateSunset, alt: "Private sunset cruise in Cabo San Lucas", imgClass: "", imgPos: "center 40%" },
  { title: "Bachelorette Cruise", href: "/tours/bachelorette/", image: imgBachelorette, alt: "Bachelorette party cruise in Cabo", imgClass: "", imgPos: "center" },
  { title: "Scuba Diving", href: "/tours/scuba-diving/", image: imgScuba, alt: "Scuba diving in Cabo San Lucas", imgClass: "", imgPos: "center" },
  { title: "Whale Watching", href: "/tours/whale-watching/", image: imgWhale, alt: "Private whale watching cruise in Cabo San Lucas", imgClass: "", imgPos: "center" },
];

const fleetImages: Record<string, ImageMetadata[]> = {};
for (const [key, paths] of Object.entries(carouselConfig.fleet)) {
  fleetImages[key] = getImages(paths as string[]);
}

// FAQ schema — mirrors the on-page FAQ section below
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the best private yacht cruise in Cabo?",
      "acceptedAnswer": { "@type": "Answer", "text": "Cabo Sailing offers private yacht cruises in Cabo San Lucas for couples, families, and groups. Cruises include an open bar, food, snorkeling gear, towels, paddleboards, crew, and sightseeing at Land's End, the Arch, Lover's Beach, and nearby snorkeling bays." }
    },
    {
      "@type": "Question",
      "name": "What's included in the cruise?",
      "acceptedAnswer": { "@type": "Answer", "text": "All cruises include crew, open bar, snorkeling gear, and light food or snacks. Private charters can be customized based on your preferences." }
    },
    {
      "@type": "Question",
      "name": "Is the cruise private or a group sailing cruise?",
      "acceptedAnswer": { "@type": "Answer", "text": "We offer both options. Private charters are exclusively for your group, while sailing cruises are limited to small groups (max 12 guests) for a more comfortable experience." }
    },
    {
      "@type": "Question",
      "name": "How many people are on board?",
      "acceptedAnswer": { "@type": "Answer", "text": "Private cruises vary by your group (up to 18–20 guests depending on the yacht). Sailing cruises are intentionally limited to 12 guests to avoid crowds." }
    },
    {
      "@type": "Question",
      "name": "What is your cancellation policy?",
      "acceptedAnswer": { "@type": "Answer", "text": "Free cancellation or changes up to 48 hours before departure. 50% refund between 48–24 hours. No refund within 24 hours or for no-shows." }
    },
    {
      "@type": "Question",
      "name": "What happens in case of bad weather?",
      "acceptedAnswer": { "@type": "Answer", "text": "Safety comes first. If conditions are not suitable, we'll reschedule your cruise or provide a full refund." }
    },
    {
      "@type": "Question",
      "name": "Why choose you over other Cabo cruises?",
      "acceptedAnswer": { "@type": "Answer", "text": "We operate our own fleet, limit group sizes, and focus on personalized service—offering a more comfortable and premium experience than typical crowded tours." }
    }
  ]
});

---

<BaseLayout title="Private Yacht & Sailboat Charters in Cabo San Lucas | Cabo Sailing" description="Private yacht and sailboat charters in Cabo San Lucas — sunset cruises, snorkeling, whale watching and bachelorettes. Crew, drinks and gear included." ogImage="/og/home.jpg" ogImageAlt="Cabo Sailing luxury yacht in Cabo San Lucas" hreflangs={{ en: '/', es: '/es/' }}>

<script slot="head" type="application/ld+json" set:html={faqSchema} />

<Header variant="home" activePage="home" />


<main class="flex-1 w-full overflow-x-hidden pt-[72px]">

<!-- Hero Section -->
<div class="relative w-full h-[72vh] lg:h-[85vh] min-h-[560px] overflow-hidden" style="margin-bottom:-1px">
  <Image src={heroSlide1} alt="Luxury sailboat in tropical waters" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-100 transition-opacity duration-1000" width={1920} height={1080} loading="eager" fetchpriority="high" />
  <Image src={heroSlide2} alt="Relaxing day on a luxury boat" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide3} alt="Sailing through Cabo's vibrant waters" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide4} alt="Guests enjoying a Cabo yacht charter" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <div class="absolute inset-0 bg-gradient-to-r from-black/15 via-black/30 to-transparent"></div>
  <div class="absolute inset-0 flex items-end lg:items-center px-6 lg:px-20 pb-24 lg:pb-0">
    <div class="max-w-3xl text-left">
      <h1 class="font-serif font-semibold text-white text-4xl sm:text-5xl lg:text-7xl leading-[1.08] drop-shadow-2xl">
        Luxury Sailing &amp;<br/>Yacht Cruises in<br/><span style="color:#f5e0b8">Cabo San Lucas</span>
      </h1>
      <p class="text-white/85 text-sm lg:text-lg mt-4 max-w-xl leading-relaxed">Small groups. Premium service. Smooth sailing.</p>
      <!-- Review (inline on mobile, absolute on desktop) -->
      <div class="mt-6 lg:hidden">
        <div class="flex items-center gap-1 mb-2">
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
        </div>
        <p class="text-white text-lg font-semibold leading-snug">"Amazing crew, beautiful boat, unforgettable views."</p>
        <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
      </div>
    </div>
  </div>
  <!-- Review Card (desktop only) -->
  <div class="absolute bottom-10 left-10 z-10 max-w-[420px] hidden lg:block">
    <div class="flex items-center gap-1 mb-2">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-lg leading-snug">"Amazing crew, beautiful boat, unforgettable views."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
  </div>
  <!-- TripAdvisor Travelers' Choice -->
  <div class="absolute bottom-6 right-6 lg:bottom-10 lg:right-10 z-10 hidden md:block">
    <img src="https://static.tacdn.com/img2/travelers_choice/widgets/tchotel_2024_L.png" alt="TripAdvisor Travelers' Choice 2024" class="h-24 lg:h-32 w-auto drop-shadow-2xl opacity-70" />
  </div>
  <script is:inline>
    (function(){
      const slides = document.querySelectorAll('.hero-slide');
      let i = 0;
      setInterval(() => {
        slides[i].style.opacity = '0';
        i = (i + 1) % slides.length;
        slides[i].style.opacity = '1';
      }, 5000);
    })();
  </script>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest" data-max-discount="site">Save up to 40% off &mdash; Limited Time</p>
</div>

<!-- Activity Cards -->
<section class="bg-[#f5f3ef] py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 lg:px-10">
    <div class="text-center mb-10">
      <h2 class="text-xl md:text-2xl lg:text-3xl font-serif text-navy font-semibold leading-tight"><span class="font-body" style="font-variant-numeric: lining-nums;">7</span> Ways to Experience Cabo from the Water</h2>
      <p class="text-navy/70 text-sm mt-2 max-w-[400px] mx-auto">All-inclusive luxury cruises for every group size, style, and occasion.</p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {activities.slice(0, 4).map((a) => (
        <a href={a.href} class="group relative rounded-xl overflow-hidden aspect-[3/4]">
          <Image src={a.image} alt={a.alt} class={`absolute inset-0 w-full h-full object-cover brightness-110 transition-transform duration-500 group-hover:scale-105 ${a.imgClass}`} style={`object-position: ${a.imgPos}`} width={560} height={700} />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-3 md:p-5">
            <h3 class="text-white font-heading text-sm sm:text-lg md:text-2xl tracking-wider uppercase leading-tight text-center">{a.title}</h3>
          </div>
        </a>
      ))}
    </div>
    <div class="grid grid-cols-2 gap-4 mt-4 lg:flex lg:justify-center">
      {activities.slice(4).map((a) => (
        <a href={a.href} class="group relative rounded-xl overflow-hidden aspect-[3/4] lg:w-full lg:max-w-[calc(25%-0.75rem)]">
          <Image src={a.image} alt={a.alt} class={`absolute inset-0 w-full h-full object-cover brightness-110 transition-transform duration-500 group-hover:scale-105 ${a.imgClass}`} style={`object-position: ${a.imgPos}`} width={560} height={700} />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-3 md:p-5">
            <h3 class="text-white font-heading text-sm sm:text-lg md:text-2xl tracking-wider uppercase leading-tight text-center">{a.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Welcome paragraph -->
<div class="max-w-3xl mx-auto px-6 py-12 text-center">
  <p class="text-navy/70 text-sm lg:text-base leading-relaxed"><strong class="text-navy">Welcome to Cabo Sailing</strong> — the most trusted sailing and yacht charter in Cabo San Lucas. We own and operate every boat in our fleet, keep groups small, and include everything onboard — crew, open bar, fresh food, and all the gear. Whether you're here for a sunset, snorkeling, or a private celebration, our crew makes sure every detail is taken care of so you can just enjoy the ride.</p>
</div>

<!-- Our Fleet -->
<div class="bg-surface-light pt-12 pb-8 border-t border-border-light/50">
<div class="px-6 flex justify-between items-end mb-8 lg:max-w-[1400px] lg:mx-auto lg:px-10">
  <div>
    <h2 class="text-lg lg:text-xl font-serif text-navy mb-1 font-semibold">Scroll our boats — find a perfect fit for your unique experience.</h2>
  </div>
</div>
<div class="px-6 lg:max-w-[1400px] lg:mx-auto lg:px-10">
  <div class="flex items-center gap-4 mb-4 mt-8"><h3 class="text-base lg:text-2xl font-serif text-navy">Private Yachts</h3><div class="flex-1 h-px bg-gradient-to-r from-gold/30 to-transparent"></div></div>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-6 pb-8 lg:max-w-[1100px] lg:mx-auto">

    <!-- 51' Luxury Yacht -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-51">
      <div class={`fleet-img-wrap w-full relative ${fleetImages['yacht-51'].length > 1 ? 'activity-carousel' : ''}`}>
        {fleetImages['yacht-51'].map((img, idx) => (
          <Image src={img} alt="Luxury Yacht 51' private charter in Cabo San Lucas" class={`activity-slide w-full h-full object-cover object-center ${idx > 0 ? 'absolute inset-0' : ''}`} style={`transform: scale(1.1); opacity:${idx === 0 ? 1 : 0}; transition: opacity 0.5s ease-in-out;`} width={1023} height={1537} format="png" quality={100} />
        ))}
        {fleetImages['yacht-51'].length > 1 && (
          <><button type="button" aria-label="Previous slide" class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_left</span></button>
          <button type="button" aria-label="Next slide" class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_right</span></button>
          <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2"></div>
        <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
          <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-2xl">arrow_back</span>
            <span class="text-[11px] uppercase tracking-widest font-bold">Swipe</span>
            <span class="material-symbols-outlined text-2xl">arrow_forward</span>
          </div>
        </div></>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h4 class="text-white text-lg lg:text-xl">Luxury Yacht 51'</h4>
          <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs lg:text-[10px] mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-sm lg:text-base">group</span><span>Up to 20 Guests</span></div>
        </div>
        <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[9px] font-bold px-2.5 py-1 lg:px-3 lg:py-1 rounded-full uppercase tracking-widest">Most Spacious</div>
        <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
      </div>
      <div class="p-4 space-y-4 lg:p-4 lg:space-y-4">
        <div class="space-y-4">
          <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-accent-gold line-through decoration-1 text-[1.1rem] lg:text-[1.25rem] font-semibold">$1,690</span><div class="flex items-baseline gap-2"><span class="text-slate-500 text-[11px] font-medium uppercase">from</span><span class="text-navy font-bold text-2xl lg:text-2xl">$1,436</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ 1-4 guests</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Extra guests</span><div class="flex items-baseline gap-1"><span class="text-accent-gold line-through text-[14px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-500 text-[9px] font-medium">/pp</span></div></div></div>
        </div>
        <button type="button" onclick="openRezdyModal('165509',null,'yacht-51')" class="block w-full bg-navy text-white font-bold text-[11px] lg:text-[10px] py-3.5 lg:py-3 rounded-xl uppercase tracking-[0.1em] lg:tracking-[0.15em] text-center shadow-lg">Check Availability</button>
      </div>
    </div>

    <!-- 45' Luxury Yacht -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-45">
      <div class={`fleet-img-wrap w-full relative ${fleetImages['yacht-45'].length > 1 ? 'activity-carousel' : ''}`}>
        {fleetImages['yacht-45'].map((img, idx) => (
          <Image src={img} alt="Luxury Yacht 45' private charter in Cabo San Lucas" class={`activity-slide w-full h-full object-cover object-center ${idx > 0 ? 'absolute inset-0' : ''}`} style={`transform: none !important; opacity:${idx === 0 ? 1 : 0}; transition: opacity 0.5s ease-in-out;`} width={1023} height={1537} format="png" quality={100} />
        ))}
        {fleetImages['yacht-45'].length > 1 && (
          <><button type="button" aria-label="Previous slide" class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_left</span></button>
          <button type="button" aria-label="Next slide" class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_right</span></button>
          <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2"></div>
        <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
          <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-2xl">arrow_back</span>
            <span class="text-[11px] uppercase tracking-widest font-bold">Swipe</span>
            <span class="material-symbols-outlined text-2xl">arrow_forward</span>
          </div>
        </div></>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h4 class="text-white text-lg lg:text-xl">Luxury Yacht 45'</h4>
          <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs lg:text-[10px] mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-sm lg:text-base">group</span><span>Up to 12 Guests</span></div>
        </div>
        <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[9px] font-bold px-2.5 py-1 lg:px-3 lg:py-1 rounded-full uppercase tracking-widest">Most Popular</div>
        <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
      </div>
      <div class="p-4 space-y-4 lg:p-4 lg:space-y-4">
        <div class="space-y-4">
          <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-accent-gold line-through decoration-1 text-[1.1rem] lg:text-[1.25rem] font-semibold">$1,520</span><div class="flex items-baseline gap-2"><span class="text-slate-500 text-[11px] font-medium uppercase">from</span><span class="text-navy font-bold text-2xl lg:text-2xl">$1,292</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ 1-4 guests</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Extra guests</span><div class="flex items-baseline gap-1"><span class="text-accent-gold line-through text-[14px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-500 text-[9px] font-medium">/pp</span></div></div></div>
        </div>
        <button type="button" onclick="openRezdyModal('528988',null,'yacht-45')" class="block w-full bg-navy text-white font-bold text-[11px] lg:text-[10px] py-3.5 lg:py-3 rounded-xl uppercase tracking-[0.1em] lg:tracking-[0.15em] text-center shadow-lg">Check Availability</button>
      </div>
    </div>

    <!-- 42' Luxury Yacht -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-42">
      <div class={`fleet-img-wrap w-full relative ${fleetImages['yacht-42'].length > 1 ? 'activity-carousel' : ''}`}>
        {fleetImages['yacht-42'].map((img, idx) => (
          <Image src={img} alt="Luxury Yacht 42' private charter in Cabo San Lucas" class={`activity-slide w-full h-full object-cover object-center ${idx > 0 ? 'absolute inset-0' : ''}`} style={`transform: scale(1.1); opacity:${idx === 0 ? 1 : 0}; transition: opacity 0.5s ease-in-out;`} width={1023} height={1537} format="png" quality={100} />
        ))}
        {fleetImages['yacht-42'].length > 1 && (
