---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import { Image } from 'astro:assets';

import DSC_0107_2 from "../assets/images/bachelorette/cabo-bachelorette-boat-party-01.jpg";
import frame_grabs_yacht_30 from "../assets/images/guests-on-yachts/cabo-yacht-charter-guests-03.jpg";
import DSC_0307_2 from "../assets/images/bachelorette/cabo-bachelorette-boat-party-02.jpg";
import Boat_Day_10_copy from "../assets/images/bachelorette/cabo-bachelorette-boat-day.jpg";
import img_4k_01_41_40_08_Still129 from "../assets/images/guests-on-sailboats/cabo-sailboat-party-fun.jpg";
import img_9_Yacht_51 from "../assets/images/boats/yacht-51/cabo-luxury-yacht-51-ocean-view.jpg";
import img_2_Yacht_51 from "../assets/images/boats/yacht-51/cabo-luxury-yacht-51-exterior-01.jpg";
import img_7_Yacht_51 from "../assets/images/boats/yacht-51/cabo-luxury-yacht-51-exterior-03.jpg";
import img_1_Yacht_45 from "../assets/images/boats/yacht-45/cabo-private-yacht-45-exterior-01.jpg";
import img_5_Yacht_45 from "../assets/images/boats/yacht-45/cabo-private-yacht-45-exterior-03.jpg";
import img_6_Yacht_45 from "../assets/images/boats/yacht-45/cabo-private-yacht-45-bow.jpg";
import img_3_Yacht_42 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-exterior-02.jpg";
import img_2_Yacht_42 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-exterior-01.jpg";
import img_5_Yacht_42 from "../assets/images/boats/yacht-42/cabo-private-yacht-42-exterior-03.jpg";
import img_10_Sailing_42 from "../assets/images/boats/sailing-42/cabo-sailing-42-exterior-01.jpg";
import img_17_Sailing_42 from "../assets/images/boats/sailing-42/cabo-sailing-42-sailing-view.jpg";
import img_12_Sailing_42 from "../assets/images/boats/sailing-42/cabo-sailing-42-exterior-02.jpg";
import img_6_Sailing_38 from "../assets/images/boats/sailing-38/cabo-sailing-38-exterior-02.jpg";
import img_8_Sailing_38 from "../assets/images/boats/sailing-38/cabo-sailing-38-exterior-03.jpg";
import img_5_Sailing_38 from "../assets/images/boats/sailing-38/cabo-sailing-38-exterior-01.jpg";
import DSC_3713 from "../assets/images/bachelorette/cabo-bachelorette-celebration.jpg";
import DSC_4259_copy from "../assets/images/bachelorette/cabo-bachelorette-group-photo.jpg";
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Private Bachelorette Party Cruise in Cabo | Cabo Sailing" description="Private Bachelorette Party Cruise in Cabo. Your boat. Your music. Your moment. Open bar, great food, iconic Arch views — no crowds, no stress.">
  <Header variant="subpage" activePage="tours" />


  <style is:inline type="text/tailwindcss">
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
    #rezdyModal .rezdy-modal-title .bg-gold { background-color: #E8789A !important; }
    @keyframes float-up { 0% { transform: translateY(0) rotate(0deg); opacity:0.7; } 100% { transform: translateY(-100px) rotate(360deg); opacity:0; } }
    .confetti-dot { position:absolute; border-radius:50%; animation: float-up 4s infinite; }
    .festive-divider { background: linear-gradient(90deg, transparent, #E8789A 20%, #C5A059 50%, #E8789A 80%, transparent); height: 2px; }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">


  <!-- ========== HERO ========== -->
  <div class="relative w-full h-[45vh] lg:hidden overflow-hidden">
    <div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
      <div class="flex-shrink-0 w-full h-full snap-center relative">
        <Image src={DSC_0107_2} alt="Five women on yacht bow in Cabo" class="w-full h-full object-cover" width={800} height={500} />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
      </div>
      <div class="flex-shrink-0 w-full h-full snap-center"><Image src={frame_grabs_yacht_30} alt="Woman sunbathing on yacht deck" class="w-full h-full object-cover" width={800} height={500} /></div>
      <div class="flex-shrink-0 w-full h-full snap-center"><Image src={DSC_0307_2} alt="Bride and squad arms raised" class="w-full h-full object-cover" width={800} height={500} /></div>
      <div class="flex-shrink-0 w-full h-full snap-center"><Image src={Boat_Day_10_copy} alt="Champagne toast at El Arco" class="w-full h-full object-cover" width={800} height={500} /></div>
      <div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_4k_01_41_40_08_Still129} alt="Large group celebrating near Arch" class="w-full h-full object-cover" width={800} height={500} /></div>
    </div>
    <div class="absolute top-4 left-4 text-white text-base font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Bachelorette Party</div>
    <button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
    <button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
  </div>

  <!-- Decorative festive ribbon divider -->
  <div class="festive-divider w-full"></div>
  <div class="flex items-center justify-center py-2 bg-white text-base text-slate-400 font-medium tracking-widest gap-2 text-center">
    <span class="text-base">🥂</span>
    <span class="text-base uppercase font-bold tracking-[0.2em]" style="color:#E8789A;">Private · Celebration · Cabo San Lucas</span>
    <span class="text-base">🥂</span>
  </div>
  <div class="festive-divider w-full"></div>

  <!-- ========== MOBILE LAYOUT ========== -->
  <div class="lg:hidden relative z-10 -mt-4 px-5">
    <div class="bg-white rounded-3xl p-6 shadow-xl shadow-navy/5 border border-border-light">
      <nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span>Tours</span>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">Bachelorette</span>
      </nav>
      <div class="flex flex-col gap-1 mb-6">
        <div class="flex justify-between items-start">
          <h1 class="text-2xl text-navy leading-tight">Private Bachelorette Party Cruise in Cabo</h1>
          <div class="flex items-center gap-1 bg-gold/10 px-2 py-1 rounded text-gold text-sm font-bold">
            <span class="material-symbols-outlined text-[14px] filled">star</span> 5.0
          </div>
        </div>
        <!-- Pink pill badge -->
        <div class="mt-2 text-center">
          <span class="inline-block text-white text-base font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Most Popular Celebration</span>
        </div>
        <p class="text-slate-400 text-sm font-medium flex items-center gap-1 mt-2 uppercase tracking-widest">
          <span class="material-symbols-outlined text-base">location_on</span> Cabo Marina, Dock F
        </p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-light-grey rounded-2xl p-3 flex flex-col items-center text-center border border-border-light">
          <span class="material-symbols-outlined text-gold mb-1">schedule</span>
          <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-0.5">Duration</p>
          <p class="text-sm font-bold text-navy">3 Hours</p>
        </div>
        <div class="bg-light-grey rounded-2xl p-3 flex flex-col items-center text-center border border-border-light">
          <span class="material-symbols-outlined mb-1" style="color:#E8789A;">celebration</span>
          <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-0.5">Group</p>
          <p class="text-sm font-bold text-navy">Private Charter</p>
        </div>
        <div class="bg-light-grey rounded-2xl p-3 flex flex-col items-center text-center border border-border-light">
          <span class="material-symbols-outlined text-gold mb-1">groups</span>
          <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-0.5">Capacity</p>
          <p class="text-sm font-bold text-navy">Up to 14</p>
        </div>
        <div class="bg-light-grey rounded-2xl p-3 flex flex-col items-center text-center border border-border-light">
          <span class="material-symbols-outlined text-gold filled mb-1">star</span>
          <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-0.5">Rating</p>
          <p class="text-sm font-bold text-navy">5.0 / 5.0</p>
        </div>
      </div>
      <div class="mt-6 pt-6 border-t border-border-light">
        <input class="hidden" id="highlights-toggle" type="checkbox"/>
        <label class="flex items-center justify-between cursor-pointer group" for="highlights-toggle">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-full" style="background-color:#E8789A20;"><span class="material-symbols-outlined text-xl" style="color:#E8789A;">celebration</span></div>
            <span class="text-base font-semibold text-navy">Choose Your Vibe</span>
          </div>
          <span class="material-symbols-outlined text-slate-300 chevron-icon transition-transform">chevron_right</span>
        </label>
        <div class="max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-in-out" id="highlights-content">
          <div class="space-y-4">
            <div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">🎉 The Party Cruise</h4><p class="text-sm text-slate-500 leading-relaxed">Louder music, high energy, dancing, drinks flowing. Perfect if your group wants a fun, lively celebration.</p></div>
            <div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">🌅 The Sunset Vibe</h4><p class="text-sm text-slate-500 leading-relaxed">Golden hour, relaxed energy, incredible photos. Ideal for a more elevated, beautiful experience.</p></div>
            <div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">🥂 The Chill Luxury Day</h4><p class="text-sm text-slate-500 leading-relaxed">Swim, float, paddleboard, sip, and unwind. Great mix of fun + relaxation.</p></div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <h3 class="text-lg text-navy mb-3">Why This Is The One</h3>
      <p class="text-slate-500 leading-relaxed text-base font-semibold mb-3" style="color:#E8789A;">This isn't just a boat ride — it's your main event.</p>
      <p class="text-slate-500 leading-relaxed text-base">Picture this: music playing, drinks flowing, your group laughing on deck… the Arch in the background, champagne in hand, and zero stress about logistics. We take care of everything — you just show up and enjoy.</p>
    </div>

    <div class="mt-10">
      <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 rounded-full" style="background-color:#E8789A;"></div><h3 class="text-lg text-navy">What's Included</h3></div>
      <div class="grid grid-cols-1 gap-5 pl-1">
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Private boat (no other guests)</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Open bar (cocktails, beer, tequila, soft drinks)</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Food (light lunch or snacks)</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Snorkeling gear &amp; paddleboard</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Towels</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Bluetooth sound system</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Experienced bilingual crew</span></div>
      </div>
    </div>

    <div class="mt-10 rounded-3xl p-6 border border-border-light" style="background:linear-gradient(135deg,#0A1D37,#1a3a6b);">
      <div class="flex items-center gap-3 mb-4"><span class="material-symbols-outlined text-gold text-2xl">pin_drop</span><h3 class="text-lg text-white">Meeting Point</h3></div>
      <p class="text-white/70 text-base leading-relaxed">Cabo Marina, Dock F. Look for the Cabo Sailing team in gold shirts. Please arrive 15 minutes before departure.</p>
      <div class="mt-4 flex items-center gap-2 text-sm font-bold uppercase tracking-widest" style="color:#C5A059;"><span class="material-symbols-outlined text-base">schedule</span>Departures: 10:00 AM or 4:00 PM daily</div>
    </div>

    <div class="mt-12 px-0">
      <div class="flex items-center gap-3 mb-8"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg lg:text-2xl text-navy">Scroll our boats — find a perfect fit for your unique bachelorette experience</h3></div>
      <div class="flex flex-col gap-5 lg:grid lg:grid-cols-3 pb-8">
        <!-- Yacht 51' -->
        <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-51">
          <div class="h-[280px] w-full relative">
            <div class="boat-carousel relative w-full h-full">
<Image src={img_9_Yacht_51} alt="Luxury Yacht 51'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-100 transition-opacity duration-700" width={800} height={500} />
<Image src={img_2_Yacht_51} alt="Luxury Yacht 51'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" width={800} height={500} />
<Image src={img_7_Yacht_51} alt="Luxury Yacht 51'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" width={800} height={500} />
</div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
            <div class="absolute bottom-5 left-6"><h4 class="text-white text-lg lg:text-xl">Luxury Yacht 51'</h4><div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 20 Guests</span></div></div>
            <div class="absolute top-4 right-4 text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Most Spacious</div>

          <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
          <button class="fleet-arrow left" onclick="fleetNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
          <button class="fleet-arrow right" onclick="fleetNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
          <div class="p-4 space-y-4">
      <p class="text-slate-500 text-sm italic text-center pb-3 border-b border-border-light/50">Best for large groups &amp; maximum space</p>
            <div class="space-y-4">
              <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-2 text-[0.9rem] lg:text-[1.05rem] font-semibold">$1,690</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$1,436</span><span class="text-slate-400 text-[11px] font-medium uppercase">/ 1-4 guests</span></div></div><div class="flex flex-col items-end"><span class="text-slate-400 text-[11px] font-medium">Extra guests</span><div class="flex items-baseline gap-1"><span class="text-gold line-through text-[12px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-400 text-[11px] font-medium">/pp</span></div></div></div>
            </div>
            <button type="button" onclick="openRezdyModal('165509')" class="block w-full text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer" style="background-color:#E8789A;">Check Availability</button>
          </div>
        </div>
        <!-- Yacht 45' -->
        <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-45">
          <div class="h-[280px] w-full relative">
            <div class="boat-carousel relative w-full h-full">
<Image src={img_1_Yacht_45} alt="Luxury Yacht 45'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-100 transition-opacity duration-700" width={800} height={500} />
<Image src={img_5_Yacht_45} alt="Luxury Yacht 45'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" width={800} height={500} />
<Image src={img_6_Yacht_45} alt="Luxury Yacht 45'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" width={800} height={500} />
</div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
            <div class="absolute bottom-5 left-6"><h4 class="text-white text-lg lg:text-xl">Luxury Yacht 45'</h4><div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 12 Guests</span></div></div>
            <div class="absolute top-4 right-4 text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Most Popular</div>

          <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
          <button class="fleet-arrow left" onclick="fleetNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
          <button class="fleet-arrow right" onclick="fleetNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
          <div class="p-4 space-y-4">
      <p class="text-slate-500 text-sm italic text-center pb-3 border-b border-border-light/50">Newest vessel, sleek &amp; modern luxury</p>
            <div class="space-y-4">
              <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-2 text-[0.9rem] lg:text-[1.05rem] font-semibold">$1,520</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$1,292</span><span class="text-slate-400 text-[11px] font-medium uppercase">/ 1-4 guests</span></div></div><div class="flex flex-col items-end"><span class="text-slate-400 text-[11px] font-medium">Extra guests</span><div class="flex items-baseline gap-1"><span class="text-gold line-through text-[12px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-400 text-[11px] font-medium">/pp</span></div></div></div>
            </div>
            <button type="button" onclick="openRezdyModal('528988')" class="block w-full text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer" style="background-color:#E8789A;">Check Availability</button>
          </div>
        </div>
        <!-- Yacht 42' -->
        <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-42">
          <div class="h-[280px] w-full relative">
            <div class="boat-carousel relative w-full h-full">
<Image src={img_3_Yacht_42} alt="Luxury Yacht 42'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-100 transition-opacity duration-700" width={800} height={500} />
<Image src={img_2_Yacht_42} alt="Luxury Yacht 42'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" width={800} height={500} />
<Image src={img_5_Yacht_42} alt="Luxury Yacht 42'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" width={800} height={500} />
</div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
            <div class="absolute bottom-5 left-6"><h4 class="text-white text-lg lg:text-xl">Luxury Yacht 42'</h4><div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 18 Guests</span></div></div>
            <div class="absolute top-4 right-4 text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Best Value</div>

          <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
          <button class="fleet-arrow left" onclick="fleetNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
          <button class="fleet-arrow right" onclick="fleetNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
          <div class="p-4 space-y-4">
