    <div class="mt-10">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-6 bg-gold rounded-full"></div>
        <h3 class="text-2xl text-navy">What's Included</h3>
      </div>
      <div class="grid grid-cols-2 gap-5 pl-1">
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">local_bar</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Open bar</span>
            <p class="text-slate-400 text-sm">Enjoy refreshing drinks throughout the cruise</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">restaurant</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Light lunch onboard</span>
            <p class="text-slate-400 text-sm">Fresh snacks served after snorkeling</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
