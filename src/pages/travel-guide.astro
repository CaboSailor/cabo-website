---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { Image } from 'astro:assets';
---

<BaseLayout title="Travel Guide Blog | Cabo Sailing" description="Your complete Cabo San Lucas travel guide. Discover the best activities, attractions, food, beaches, whale watching, snorkeling spots, sunset views, and more in Los Cabos.">
  <Header variant="subpage" activePage="travel-guide" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Hero Section -->
    <div class="relative w-full h-[40vh] min-h-[300px] lg:h-[50vh]">
      <img alt="Cabo San Lucas coastline aerial view" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2019/10/morning-activities-cabo.jpg"/>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/40 to-transparent"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-end z-10 text-center px-8 pb-10">
        <div class="flex flex-col items-center gap-3">
          <nav class="flex items-center gap-1.5 text-xs text-white/60 mb-2" aria-label="Breadcrumb">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-white font-semibold">Travel Guide</span>
          </nav>
          <p class="text-white/80 text-xs uppercase tracking-[0.3em] font-bold">Your Complete Resource</p>
          <h1 class="text-3xl md:text-5xl font-serif text-white uppercase tracking-[0.15em] leading-tight drop-shadow-lg font-light">
            Travel Guide <span class="block font-script text-4xl md:text-5xl normal-case tracking-normal my-1">Blog</span>
          </h1>
          <div class="w-12 h-[1px] bg-accent-gold-light"></div>
          <p class="text-white/90 text-sm max-w-[400px] leading-relaxed">Activities, attractions, food, culture, and everything you need for the perfect Cabo trip.</p>
        </div>
      </div>
    </div>

    <!-- Horizontal Sub-Menu -->
    <div class="sticky top-[60px] z-40 bg-white border-b border-border-light/50 shadow-sm">
      <div class="max-w-5xl mx-auto">
        <nav class="flex overflow-x-auto no-scrollbar">
          <a href="/travel-guide" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-accent-gold text-navy transition-colors">Home</a>
          <a href="/travel-guide-activities" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/50 hover:text-navy hover:border-accent-gold/50 transition-colors">Activities</a>
          <a href="/travel-guide-attractions" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/50 hover:text-navy hover:border-accent-gold/50 transition-colors">Attractions</a>
          <a href="/travel-guide-traveling" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/50 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Traveling to Cabo</a>
          <a href="/travel-guide-culture" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/50 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Culture &amp; Food</a>
        </nav>
      </div>
    </div>

    <!-- Intro -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto pt-10 pb-6">
      <p class="font-display text-warm-yellow text-base lg:text-lg font-medium leading-relaxed max-w-[600px] mx-auto text-center">
        Cabo is a stunning coastal destination boasting over 300 days of sunshine, warm waters, and unforgettable experiences. Whether you're here for adventure, relaxation, or celebration — this guide has you covered.
      </p>
    </div>

    <!-- Category Cards Grid -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto pb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 lg:gap-8">

        <!-- Activities Card -->
        <a href="/travel-guide-activities" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[260px] overflow-hidden">
            <img alt="Fun activities in Cabo San Lucas" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-accent-gold text-lg">surfing</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy font-semibold">Activities</h3>
            </div>
            <p class="text-navy/60 text-sm leading-relaxed mb-3">Sport fishing, sailing, ATV tours, parasailing, and more — discover the most exciting things to do in Cabo San Lucas.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Explore <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Attractions Card -->
        <a href="/travel-guide-attractions" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[260px] overflow-hidden">
            <img alt="Tourist spots Baja California" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/02/baja-california-sur.png.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-accent-gold text-lg">photo_camera</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy font-semibold">Attractions</h3>
            </div>
            <p class="text-navy/60 text-sm leading-relaxed mb-3">From Land's End to hidden beaches, historic landmarks, and Instagram-worthy spots — the must-see destinations in Los Cabos.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Explore <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Traveling to Cabo Card -->
        <a href="/travel-guide-traveling" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[260px] overflow-hidden">
            <img alt="Los Cabos International Airport" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2019/08/los-cabos-international-airport-featured-image.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-accent-gold text-lg">flight</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy font-semibold">Traveling to Cabo</h3>
            </div>
            <p class="text-navy/60 text-sm leading-relaxed mb-3">Flights, driving routes, best time to visit, and everything you need to plan your trip to Cabo San Lucas.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Explore <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Culture & Food Card -->
        <a href="/travel-guide-culture" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[260px] overflow-hidden">
            <img alt="Traditional Mexican food Cabo" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/10/cabofood-1080x675.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-accent-gold text-lg">restaurant</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy font-semibold">Culture &amp; Food</h3>
            </div>
            <p class="text-navy/60 text-sm leading-relaxed mb-3">Fine dining, street food, museums, local history, and the vibrant culture that makes Cabo truly special.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Explore <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

      </div>
    </div>

    <!-- CTA Section -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto mb-12">
      <div class="bg-navy rounded-[2rem] p-8 text-center">
        <h2 class="text-xl font-serif text-white mb-3 font-semibold">Ready to Experience Cabo?</h2>
        <p class="text-white/70 text-sm mb-6 leading-relaxed">Book your sailing charter, snorkeling tour, or sunset cruise with us. We'll make your Cabo trip unforgettable.</p>
        <a href="https://wa.me/526241916997?text=hi%2C%20I'm%20sending%20you%20a%20message%20from%20cabosailing.com" target="_blank" class="inline-flex items-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-xl font-bold text-sm uppercase tracking-widest active:scale-95 transition-transform shadow-lg">
          <i class="fa-brands fa-whatsapp text-lg"></i> Message Us on WhatsApp
        </a>
        <div class="mt-4">
          <a href="tel:+526241438485" class="text-white/60 text-sm hover:text-white transition-colors">Or call +52 624 143 8485</a>
        </div>
      </div>
    </div>

  </main>

  <Footer />
  <FloatingCTA />
</BaseLayout>

<style>
  .guide-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .guide-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.12);
  }
  .guide-card:active {
    transform: scale(0.98);
  }
  .section-anchor {
    scroll-margin-top: 80px;
  }
  .submenu-active {
    color: #0a1d37;
    border-bottom-color: #b38e5d;
  }
</style>
