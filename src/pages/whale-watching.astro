<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Private Whale Watching in Cabo San Lucas (Dec–Apr) | Cabo Sailing" description="Private whale watching charters during humpback season (Dec–Apr). See humpbacks and grays up close from your own yacht or sailboat in Cabo San Lucas." ogImage="/og/whale-watching-sailing.jpg" ogImageAlt="Whale watching in Cabo San Lucas" hreflangs={{ en: '/whale-watching', es: '/es/whale-watching' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
