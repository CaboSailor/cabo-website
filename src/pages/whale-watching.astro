---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import CarouselImage from '../components/CarouselImage.astro';
import { Image } from 'astro:assets';

import { whaleWatching as feb_15_56 } from "../data/tour-heroes";
import IGP5740 from "../assets/images/whales/whale-breaching-near-yacht-in-daylight.png";
import Cabo_Sailing_Ocean_adventures_5 from "../assets/images/whales/sailing-with-a-whale-in-view.png";
import family_on_board from "../assets/images/whales/cabo-whale-watching-family.jpg";
import IGP5743 from "../assets/images/whales/cabo-whale-watching-close-up.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Private Whale Watching in Cabo San Lucas",
  "description": "Private whale watching charters during humpback season (Dec\u2013Apr). See humpbacks and grays up close from your own yacht or sailboat in Cabo San Lucas.",
  "touristType": "Families, Nature Lovers, Couples",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/whale-watching/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Private Whale Watching" }
  ]
});
