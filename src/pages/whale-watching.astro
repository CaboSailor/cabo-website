        <div class="bg-light-grey rounded-xl p-3 text-center border border-border-light"><p class="text-navy font-bold text-lg">3 hr</p><p class="text-[10px] text-slate-500 uppercase font-bold tracking-wider mt-1">Cruise</p></div>
