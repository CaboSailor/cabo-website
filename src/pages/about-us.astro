---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import heroCaptain from '../assets/images/boats/yacht-51/cabo-luxury-yacht-51-captain.jpg';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "About Us" }
  ]
});
---

<BaseLayout title="About Us | Cabo Sailing" description="Meet Cabo Sailing — a locally owned sailing and yacht charter company offering private and shared cruises in Cabo San Lucas. Learn about our crew, fleet, and the values behind our 5-star service." hreflangs={{ en: '/about-us', es: '/es/about-us' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Hero (wider than content column) -->
    <div class="max-w-[1075px] mx-auto px-5 lg:px-8 pt-10 lg:pt-16">
      <Image src={heroCaptain} alt="Captain aboard our 51' luxury sailing yacht in Cabo San Lucas" class="w-full h-auto rounded-2xl" width={2880} height={1920} />
    </div>

    <div class="max-w-[860px] mx-auto px-5 lg:px-8 pt-6 lg:pt-8 pb-10 lg:pb-16">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">About Us</span>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <h1 class="text-3xl lg:text-4xl text-navy font-serif mb-3">About Us</h1>
        <p class="text-slate-500 text-base lg:text-lg leading-relaxed">Cabo Sailing is a locally owned charter company offering private and shared sailing, snorkeling, sunset, whale watching, and bachelorette cruises on the Sea of Cortez. We&rsquo;re a small, hands-on team involved in every part of your experience, dedicated to creating unforgettable moments in Cabo.</p>
      </header>

      <!-- Our Story -->
      <section id="our-story" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">Our Story</h2>
        </div>
        <p class="text-slate-600 text-base leading-relaxed mb-4">Cabo Sailing was born from a simple idea: to create ocean experiences centered around the guest, not rushed itineraries. After years of seeing other operators work with large groups and fast-paced tours, our founders decided to offer something different &mdash; smaller groups, personalized service, and a carefully maintained, privately owned fleet.</p>
        <p class="text-slate-600 text-base leading-relaxed mb-4">Today, we operate one of the highest-rated sailing fleets in Cabo San Lucas, with hundreds of 5-star reviews on TripAdvisor and Google. Over the years, we&rsquo;ve welcomed everyone from couples celebrating anniversaries and <a href="/bachelorette" class="text-accent-gold font-semibold hover:underline">bachelorette parties</a> to families enjoying snorkeling tours and unforgettable <a href="/whale-watching" class="text-accent-gold font-semibold hover:underline">whale watching experiences</a>.</p>
        <p class="text-slate-600 text-base leading-relaxed">No matter the occasion, we continue to treat every experience with the same care and attention to detail that inspired us from day one.</p>
      </section>

      <!-- What Makes Us Different -->
      <section id="what-makes-us-different" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">What Makes Us Different</h2>
        </div>
        <ul class="space-y-3 text-base text-slate-600">
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">sailing</span><span><strong class="text-navy">Owned &amp; managed in-house</strong> &mdash; our 38&rsquo; to 51&rsquo; luxury sailing boats and spacious yachts are maintained by our own team, not subcontracted out.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">groups</span><span><strong class="text-navy">Small groups</strong> &mdash; shared cruises stay intimate, and private charters are truly private. No surprise add-ons.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">verified</span><span><strong class="text-navy">All-inclusive pricing</strong> &mdash; premium open bar, food, snorkel gear, and amenities. No hidden fees.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">support_agent</span><span><strong class="text-navy">Direct booking</strong> &mdash; you talk to us, not a call center. We answer WhatsApp messages within minutes during office hours.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">recommend</span><span><strong class="text-navy">5-star rated</strong> &mdash; hundreds of verified reviews on TripAdvisor and Google. The reviews are the business plan.</span></li>
        </ul>
      </section>

      <!-- Our Crew -->
      <section id="our-crew" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">Our Crew</h2>
        </div>
        <p class="text-slate-600 text-base leading-relaxed mb-4">Every cruise runs with a bilingual captain and a dedicated host. Our captains have <strong class="text-navy">10+ years sailing Cabo&rsquo;s waters</strong> &mdash; they know where the whales are in season, the <a href="/private-snorkeling" class="text-accent-gold font-semibold hover:underline">calmest snorkeling spots</a> when the wind picks up, and the best angles on the Arch for your photos.</p>
        <p class="text-slate-600 text-base leading-relaxed">Our hosts handle the food, drinks, music, and the small details that make a cruise feel special. They&rsquo;re trained in safety and first aid, and they&rsquo;re the reason so many of our reviews mention staff by name.</p>
      </section>

      <!-- Our Values -->
      <section id="our-values" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">Our Values</h2>
        </div>
        <ul class="space-y-3 text-base text-slate-600">
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-green text-base mt-0.5">health_and_safety</span><span><strong class="text-navy">Safety first.</strong> Coast Guard&ndash;compliant safety equipment, captains licensed by Mexico&rsquo;s SCT, and a strict <a href="/policies" class="text-accent-gold font-semibold hover:underline">weather policy</a> &mdash; if it isn&rsquo;t safe to sail, we reschedule or refund.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-green text-base mt-0.5">eco</span><span><strong class="text-navy">Respect for the Sea of Cortez.</strong> We follow marine wildlife guidelines, keep distance from whales and sea lions, and avoid single-use plastics on board where we can.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-green text-base mt-0.5">handshake</span><span><strong class="text-navy">Honest pricing.</strong> What you see is what you pay. No hidden charges are tacked onto the bill.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-green text-base mt-0.5">favorite</span><span><strong class="text-navy">Hospitality.</strong> Every cruise is somebody&rsquo;s big day &mdash; a honeymoon, a milestone birthday, a long-awaited family trip. We treat it that way.</span></li>
        </ul>
      </section>

      <!-- By the Numbers -->
      <section id="by-the-numbers" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">By the Numbers</h2>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="text-center bg-surface-light border border-border-light rounded-xl p-5">
            <div class="text-3xl font-serif text-navy font-semibold mb-1">20+</div>
            <div class="text-xs uppercase tracking-widest text-slate-500">Years sailing Cabo</div>
          </div>
          <div class="text-center bg-surface-light border border-border-light rounded-xl p-5">
            <div class="text-3xl font-serif text-navy font-semibold mb-1">5&#9733;</div>
            <div class="text-xs uppercase tracking-widest text-slate-500">TripAdvisor rating</div>
          </div>
          <div class="text-center bg-surface-light border border-border-light rounded-xl p-5">
            <div class="text-3xl font-serif text-navy font-semibold mb-1">38&ndash;51&rsquo;</div>
            <div class="text-xs uppercase tracking-widest text-slate-500">Yacht size range</div>
          </div>
          <div class="text-center bg-surface-light border border-border-light rounded-xl p-5">
            <div class="text-3xl font-serif text-navy font-semibold mb-1">100%</div>
            <div class="text-xs uppercase tracking-widest text-slate-500">Bilingual crew</div>
          </div>
        </div>
      </section>

      <!-- Contact CTA -->
      <div class="bg-navy rounded-2xl p-6 lg:p-8 text-center text-white">
        <h2 class="text-xl lg:text-2xl text-white mb-2 font-serif">Ready to sail with us?</h2>
        <p class="text-white/70 text-base mb-6">Tell us what you have in mind &mdash; we&rsquo;ll help you pick the right cruise and answer any questions.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://wa.me/526241916997" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20c55e] text-white font-bold px-6 py-3 rounded-xl uppercase tracking-widest text-sm transition-colors">
            <i class="fa-brands fa-whatsapp text-lg"></i> WhatsApp
          </a>
          <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white font-bold px-6 py-3 rounded-xl uppercase tracking-widest text-sm transition-colors border border-white/30">
            <span class="material-symbols-outlined text-base">mail</span> Contact Form
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
  <FloatingCTA />
  <RezdyModal />
</BaseLayout>
