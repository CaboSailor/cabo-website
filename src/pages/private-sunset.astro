---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import { Image } from 'astro:assets';
import CarouselImage from '../components/CarouselImage.astro';

import { privateSunset as heroRomanticSunset } from "../data/tour-heroes";
import yachtGuestsRelaxing from "../assets/images/guests-on-yachts/cabo-yacht-guests-relaxing.jpg";
import familyYachtEscape from "../assets/images/guests-on-yachts/family-enjoying-a-yacht-escape.png";
import relaxingSunnyYacht from "../assets/images/guests-on-yachts/relaxing-on-a-sunny-yacht.png";
import familyFunSunnySailboat from "../assets/images/guests-on-sailboats/family-fun-on-a-sunny-sailboat.png";
import landsEndGoldenHour from "../assets/images/guests-on-yachts/luxury-yacht-cruising-on-sunny-waters.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Private Sunset Cruise in Cabo San Lucas",
  "description": "Private sunset cruise for up to 12 guests on our yacht or sailboat. Open bar, snacks and front-row views of the Arch of Cabo San Lucas.",
  "touristType": "Couples, Groups, Celebrations",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/private-sunset/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Private Sunset Cruise" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Private Sunset Cruise in Cabo San Lucas | Cabo Sailing" description="Private sunset cruise for up to 12 guests on our yacht or sailboat. Open bar, snacks and front-row views of the Arch of Cabo San Lucas." ogImage="/og/private-sunset.jpg" ogImageAlt="Private sunset sailing at the Arch of Cabo San Lucas" hreflangs={{ en: '/private-sunset', es: '/es/private-sunset' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar" id="hero-scroll">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={heroRomanticSunset} alt="Romantic sunset on a private yacht in Cabo" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={yachtGuestsRelaxing} alt="Yacht guests relaxing on the bow" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={familyYachtEscape} alt="Family enjoying a yacht escape near El Arco" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={relaxingSunnyYacht} alt="Guests relaxing on a sunny yacht" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={familyFunSunnySailboat} alt="Family having fun on a sunny sailboat" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/20 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"The sunset was unreal. Drinks flowing, perfect vibes — our favorite night in Cabo."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Lauren &amp; Jake M. &mdash; Denver, CO</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={heroRomanticSunset} alt="Romantic sunset on a private yacht in Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={yachtGuestsRelaxing} alt="Yacht guests relaxing on the bow" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={familyYachtEscape} alt="Family enjoying a yacht escape near El Arco" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={relaxingSunnyYacht} alt="Guests relaxing on a sunny yacht" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={familyFunSunnySailboat} alt="Family having fun on a sunny sailboat" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"The sunset was unreal. Drinks flowing, perfect vibes — our favorite night in Cabo."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Lauren &amp; Jake M. &mdash; Denver, CO</p>
    </div>
  </div>
</div>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold mt-4 lg:mt-6">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Save up to 40% off &mdash; Limited Time</p>
</div>

<!-- DESKTOP: Full-width layout -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-gold transition-colors">Home</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span>Tours</span>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Private Sunset</span>
  </nav>
  <h1 class="text-4xl text-navy leading-tight">Private Sunset Sailing Cruise in Cabo</h1>
  <p class="text-slate-700 text-lg leading-relaxed mt-2">A relaxed, beautiful way to experience Cabo at golden hour &mdash; sail past Land's End on your own private yacht or sailboat.</p>

  <!-- Icons row -->
  <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">3 Hours</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">wb_twilight</span>
      <p class="text-sm font-semibold text-navy">Sunset Cruise</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">event_available</span>
      <p class="text-sm font-semibold text-navy">Free Cancellation</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">favorite</span>
      <p class="text-sm font-semibold text-navy">Romantic Vibes</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">add</span>
      <p class="text-sm font-semibold text-navy">Extra Time Available</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">pin_drop</span>
      <p class="text-sm font-semibold text-navy">Cabo Marina, Dock F</p>
    </div>
    <div class="flex items-center gap-2 col-span-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">DEPARTURES 4:00 PM (WINTER) &amp; 4:15 PM (SUMMER) DAILY</p>
    </div>
  </div>

  <!-- About this experience -->
  <div class="mt-12">
    <h3 class="text-2xl text-navy mb-4">About this experience</h3>
    <p class="text-slate-700 leading-relaxed text-base">
      Experience the magic of golden hour on the Pacific with a private sunset sailing charter. Cruise along the stunning coastline of Cabo San Lucas as the sky erupts in brilliant oranges and pinks &mdash; the perfect backdrop for romance, celebration, or simply unwinding in style.
    </p>
  </div>

  <!-- Suggested Itinerary timeline -->
  <div class="mt-10">
    <div class="flex items-center gap-3 mb-5">
      <div class="w-1 h-6 bg-gold rounded-full"></div>
      <h3 class="text-sm font-bold text-navy uppercase tracking-widest">Suggested Itinerary</h3>
    </div>
    <ol class="relative border-l-2 border-gold/30 ml-2 space-y-5 pl-6">
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-base">Meet at the marina</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-base">Cruise past Cabo's highlights (Arch, sea lions, beaches)</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-base">Settle into the best views as the sun begins to drop</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-base">Enjoy the golden hour with drinks and light bites</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-base">Watch the sunset over the Pacific, then cruise back along the coastline</span></li>
    </ol>
    <p class="mt-5 text-slate-700 italic text-sm">No rush. No fixed script. Just a relaxed, beautiful time on the water.</p>
  </div>
</div>


<!-- MOBILE: Title + intro -->
<div class="lg:hidden mt-6 px-5">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-gold transition-colors">Home</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span>Tours</span>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Private Sunset</span>
  </nav>
  <h1 class="text-2xl text-navy leading-tight">Private Sunset Sailing Cruise in Cabo</h1>
  <p class="text-slate-700 text-base leading-relaxed mt-2">A relaxed, beautiful way to experience Cabo at golden hour &mdash; sail past Land's End on your own private yacht or sailboat.</p>
</div>

<!-- MOBILE: Icons row -->
<div class="lg:hidden mt-5 px-5">
  <div class="grid grid-cols-2 gap-x-3 gap-y-3">
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-gold text-lg">schedule</span>
      <p class="text-xs font-semibold text-navy">3 Hours</p>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-gold text-lg">wb_twilight</span>
      <p class="text-xs font-semibold text-navy">Sunset Cruise</p>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-gold text-lg">event_available</span>
      <p class="text-xs font-semibold text-navy">Free Cancellation</p>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-gold text-lg">favorite</span>
      <p class="text-xs font-semibold text-navy">Romantic Vibes</p>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-gold text-lg">add</span>
      <p class="text-xs font-semibold text-navy">Extra Time Available</p>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="material-symbols-outlined text-gold text-lg">pin_drop</span>
      <p class="text-xs font-semibold text-navy">Cabo Marina, Dock F</p>
    </div>
    <div class="flex items-center gap-1.5 col-span-2">
      <span class="material-symbols-outlined text-gold text-lg">schedule</span>
      <p class="text-xs font-semibold text-navy">DEPARTURES 4:00 PM (WINTER) &amp; 4:15 PM (SUMMER) DAILY</p>
    </div>
  </div>
</div>

<!-- MOBILE: About + Suggested Itinerary -->
<div class="lg:hidden mt-8 px-5">
  <h3 class="text-lg text-navy mb-3">About this experience</h3>
  <p class="text-slate-700 leading-relaxed text-base">Experience the magic of golden hour on the Pacific with a private sunset sailing charter. Cruise along the stunning coastline of Cabo San Lucas as the sky erupts in brilliant oranges and pinks &mdash; the perfect backdrop for romance, celebration, or simply unwinding in style.</p>

  <div class="mt-7 faq-item border border-border-light rounded-2xl overflow-hidden bg-white">
    <input class="hidden" id="mobile-itinerary" type="checkbox"/>
    <label class="flex items-center justify-between p-4 cursor-pointer" for="mobile-itinerary">
      <span class="flex items-center gap-3">
        <div class="w-1 h-5 bg-gold rounded-full"></div>
        <span class="text-xs font-bold text-navy uppercase tracking-widest">Suggested Itinerary</span>
      </span>
      <span class="material-symbols-outlined text-slate-500 faq-chevron transition-transform duration-300">expand_more</span>
    </label>
    <div class="faq-answer max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-in-out px-4 pb-4">
      <ol class="relative border-l-2 border-gold/30 ml-2 space-y-4 pl-5 mt-2">
        <li class="relative"><span class="absolute -left-[29px] top-0 w-5 h-5 rounded-full bg-navy text-white text-[10px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-sm">Meet at the marina</span></li>
        <li class="relative"><span class="absolute -left-[29px] top-0 w-5 h-5 rounded-full bg-navy text-white text-[10px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-sm">Cruise past Cabo's highlights (Arch, sea lions, beaches)</span></li>
        <li class="relative"><span class="absolute -left-[29px] top-0 w-5 h-5 rounded-full bg-navy text-white text-[10px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-sm">Settle into the best views as the sun begins to drop</span></li>
        <li class="relative"><span class="absolute -left-[29px] top-0 w-5 h-5 rounded-full bg-navy text-white text-[10px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-sm">Enjoy the golden hour with drinks and light bites</span></li>
        <li class="relative"><span class="absolute -left-[29px] top-0 w-5 h-5 rounded-full bg-navy text-white text-[10px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-sm">Watch the sunset over the Pacific, then cruise back along the coastline</span></li>
      </ol>
      <p class="mt-4 text-slate-700 italic text-xs">No rush. No fixed script. Just a relaxed, beautiful time on the water.</p>
