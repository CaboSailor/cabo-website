import img_8_Sailing_38 from "../assets/images/boats/sailing-38/cabo-sailing-38-exterior-03.jpg";
import img_5_Sailing_38 from "../assets/images/boats/sailing-38/cabo-sailing-38-exterior-01.jpg";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Private Sunset Cruise in Cabo San Lucas",
  "description": "Private sunset cruise for up to 12 guests on our yacht or sailboat. Open bar, snacks and front-row views of the Arch of Cabo San Lucas.",
  "touristType": "Couples, Groups, Celebrations",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/private-sunset/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Private Sunset Cruise" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Private Sunset Cruise in Cabo San Lucas | Cabo Sailing" description="Private sunset cruise for up to 12 guests on our yacht or sailboat. Open bar, snacks and front-row views of the Arch of Cabo San Lucas." ogImage="/og/private-sunset.jpg" ogImageAlt="Private sunset sailing at the Arch of Cabo San Lucas" hreflangs={{ en: '/private-sunset', es: '/es/private-sunset' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar" id="hero-scroll">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_35mm_226_topaz_sharpen_exposure} alt="Guests toasting at sunset near El Arco" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_4k_01_49_05_19_Still141} alt="Happy guests at golden hour" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_20mm_483_topaz_sharpen_exposure} alt="Motor yacht at golden hour" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={Header_Sunset_3} alt="Couples with Cabo Arch at sunset" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_20_Sailing_42} alt="Couple watching sunset on sailboat" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"The sunset was unreal. Drinks flowing, perfect vibes — our favorite night in Cabo."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Lauren &amp; Jake M. &mdash; Denver, CO</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_35mm_226_topaz_sharpen_exposure} alt="Guests toasting at sunset near El Arco" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={img_4k_01_49_05_19_Still141} alt="Happy guests at golden hour" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_20mm_33_topaz_sharpen_exposure} alt="Woman at bow with El Arco" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={Header_Sunset_3} alt="Couples with Cabo Arch at sunset" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={img_20_Sailing_42} alt="Couple watching sunset on sailboat" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"The sunset was unreal. Drinks flowing, perfect vibes — our favorite night in Cabo."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Lauren &amp; Jake M. &mdash; Denver, CO</p>
    </div>
  </div>
</div>
</div>

<!-- DESKTOP: Full-width layout -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <div>
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gold transition-colors">Home</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span>Tours</span>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-navy font-semibold">Private Sunset</span>
    </nav>
    <div class="mb-2">
      <h1 class="text-4xl text-navy leading-tight">Private Sunset Sailing Cruise in Cabo</h1>
    </div>
    <p class="text-slate-500 text-base leading-relaxed mt-4">A relaxed, beautiful way to experience Cabo at its best.</p>
    <p class="text-slate-500 text-sm font-medium flex items-center gap-1 mt-3 uppercase tracking-widest">
      <span class="material-symbols-outlined text-base">location_on</span> Land's End, Cabo San Lucas
    </p>

    <!-- Badges row -->
    <div class="flex gap-4 mt-8">
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">schedule</span>
        <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-1">Duration</p>
        <p class="text-base font-bold text-navy">3 Hours</p>
        <p class="text-xs text-slate-500 mt-0.5">Extra time available</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">wb_twilight</span>
        <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-1">Type</p>
        <p class="text-base font-bold text-navy">Sunset</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">favorite</span>
        <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-1">Occasion</p>
        <p class="text-base font-bold text-navy">Romantic</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">event_available</span>
        <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-1">Free Cancellation</p>
        <p class="text-base font-bold text-navy">Up to 24h</p>
      </div>
    </div>

    <!-- About + What's Included (left) / Meeting Point (right) -->
    <div class="mt-10 flex gap-12">
      <!-- Left column: About + What's Included stacked -->
      <div class="flex-1">
        <h3 class="text-2xl text-navy mb-4">About this experience</h3>
        <p class="text-slate-500 leading-relaxed text-base">
          Experience the magic of golden hour on the Pacific with a private sunset sailing charter. Cruise along the stunning coastline of Cabo San Lucas as the sky erupts in brilliant oranges and pinks — the perfect backdrop for romance, celebration, or simply unwinding in style.
        </p>

        <!-- The Experience timeline -->
        <div class="mt-8">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-1 h-6 bg-gold rounded-full"></div>
            <h3 class="text-sm font-bold text-navy uppercase tracking-widest">The Experience</h3>
          </div>
          <ol class="relative border-l-2 border-gold/30 ml-2 space-y-5 pl-6">
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-base">Meet at the marina</span></li>
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-base">Cruise past Cabo's highlights (Arch, sea lions, beaches)</span></li>
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-base">Settle into the best views as the sun begins to drop</span></li>
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-base">Enjoy the golden hour with drinks and light bites</span></li>
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-base">Watch the sunset over the Pacific, then cruise back along the coastline</span></li>
          </ol>
          <p class="mt-5 text-slate-500 italic text-sm">No rush. No fixed script. Just a relaxed, beautiful time on the water.</p>
        </div>

        <!-- What's Included -->
        <div class="mt-10">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1 h-6 bg-gold rounded-full"></div>
            <h3 class="text-2xl text-navy">What's Included</h3>
          </div>
          <div class="grid grid-cols-2 gap-5 pl-1">
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">local_bar</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Open bar</span>
                <p class="text-slate-500 text-sm">Premium drinks served throughout your cruise</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">restaurant</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Light bites onboard</span>
                <p class="text-slate-500 text-sm">Fresh snacks to enjoy as the sun sets</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">wb_twilight</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Private sunset experience</span>
                <p class="text-slate-500 text-sm">Front-row views of Cabo's most iconic sunset</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">sailing</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Private yacht or sailboat</span>
                <p class="text-slate-500 text-sm">Only your group onboard — no sharing</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">music_note</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Bluetooth music system</span>
                <p class="text-slate-500 text-sm">Set your own vibe for the evening</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">person</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Experienced bilingual crew</span>
                <p class="text-slate-500 text-sm">Professional, friendly, and safety-first</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right column: Meeting Point -->
      <div class="w-[380px] flex-shrink-0">
        <div class="sticky top-[90px] bg-light-grey rounded-2xl p-8 border border-border-light">
          <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-outlined text-gold text-2xl">pin_drop</span>
            <h3 class="text-lg font-bold text-navy uppercase tracking-wider">Meeting Point</h3>
          </div>
          <p class="text-lg font-semibold text-navy mb-1">Cabo San Lucas Marina, Dock F</p>
          <p class="text-sm text-slate-500 leading-relaxed mb-4">Look for the Cabo Sailing team in black polo shirts with our logo. Please arrive 15 minutes before departure.</p>
          <div class="flex items-center gap-2 text-sm text-slate-500">
            <span class="material-symbols-outlined text-gold text-base">schedule</span>
            <span class="font-semibold text-navy">DEPARTURES: 4:00 PM (Winter) &amp; 4:30 PM (Summer) DAILY</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MOBILE: Original card layout -->
<div class="lg:hidden relative z-10 -mt-4 px-5">
<div class="bg-white rounded-3xl p-6 shadow-xl shadow-navy/5 border border-border-light">
