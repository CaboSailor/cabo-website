---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import CarouselImage from '../components/CarouselImage.astro';
import { Image } from 'astro:assets';

import heroYachtCharter from "../assets/images/guests-on-yachts/cabo-yacht-charter-guests-01.jpg";
import yachtCoastline from "../assets/images/guests-on-yachts/luxury-yacht-cruising-on-sunny-coastline.png";
import familyYachtEscape from "../assets/images/guests-on-yachts/family-enjoying-a-yacht-escape.png";
import cheersYachtRetreat from "../assets/images/guests-on-yachts/cheers-on-a-sunny-yacht-retreat.png";
import paddleboardingCabo from "../assets/images/guests-on-yachts/paddleboarding-in-sunny-cabo-waters.png";

import romanticSunset from "../assets/images/guests-on-yachts/romantic-sunset-on-the-boat.png";
import celebrationYacht from "../assets/images/bachelorette/celebration-on-a-sunny-yacht-party.png";
import yachtAtArch from "../assets/images/boats/yacht-45/cruising-along-the-arch.jpg";
import snorkelIcon from "../assets/icons/Snorkel 2.png";
import sunFilledBoatDay from "../assets/images/guests-on-yachts/sun-filled-boat-day-with-friends.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Private Yacht Charter & Rental in Cabo San Lucas",
  "description": "Private yacht charter and luxury yacht rental in Cabo San Lucas for families, celebrations and groups. Choose from 3 luxury yachts, fully crewed and all-inclusive — bar, food, snorkel gear and paddleboards.",
  "touristType": "Families, Couples, Groups, Celebrations",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/yacht-charter-cabo/",
    "priceCurrency": "USD",
    "lowPrice": "1148",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Yacht Charter in Cabo" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Yacht Charter Cabo San Lucas — Private Luxury Yacht Rental | Cabo Sailing" description="Private yacht charter & luxury yacht rental in Cabo San Lucas. 3 luxury yachts, fully crewed, all-inclusive bar, food, snorkel gear & paddleboards. From $1,148." ogImage="/og/yacht-charter-cabo.jpg" ogImageAlt="Private yacht charter and luxury yacht rental in Cabo San Lucas" hreflangs={{ en: '/yacht-charter-cabo', es: '/es/yacht-charter-cabo' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />

  <style is:inline>
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={heroYachtCharter} alt="Guests enjoying a private yacht charter in Cabo San Lucas" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={yachtCoastline} alt="Luxury yacht rental Cabo San Lucas cruising the coastline" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={familyYachtEscape} alt="Family enjoying a private yacht rental in Cabo" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={cheersYachtRetreat} alt="Guests celebrating on a luxury yacht charter in Cabo San Lucas" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={paddleboardingCabo} alt="Paddleboarding in sunny Cabo waters" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"Booked the yacht for my parents' 40th anniversary. Every detail was perfect — best decision of the trip."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Daniel R. &mdash; Denver, CO</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6 relative">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={heroYachtCharter} alt="Guests enjoying a private yacht charter in Cabo San Lucas" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={yachtCoastline} alt="Luxury yacht rental Cabo San Lucas cruising the coastline" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={familyYachtEscape} alt="Family enjoying a private yacht rental in Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={cheersYachtRetreat} alt="Guests celebrating on a luxury yacht charter in Cabo San Lucas" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={paddleboardingCabo} alt="Paddleboarding in sunny Cabo waters" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"Booked the yacht for my parents' 40th anniversary. Every detail was perfect &mdash; best decision of the trip."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Daniel R. &mdash; Denver, CO</p>
    </div>
  </div>
</div>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold mt-4 lg:mt-6">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Save up to 40% off &mdash; Limited Time</p>
</div>

<!-- DESKTOP: Title + intro -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-gold transition-colors">Home</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span>Tours</span>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Yacht Charter in Cabo</span>
  </nav>
  <h1 class="text-4xl text-navy leading-tight">Private Yacht Charter &amp; Rental in Cabo San Lucas</h1>
  <p class="text-slate-700 text-lg leading-relaxed mt-2">Charter a private yacht or sailboat for your group &mdash; family days, celebrations, anniversaries, and group getaways. All-inclusive, fully crewed, and designed around you.</p>

  <!-- Icons row -->
  <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">3 Hours</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">add</span>
      <p class="text-sm font-semibold text-navy">Extra Time Available</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">celebration</span>
      <p class="text-sm font-semibold text-navy">Private Charter</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">groups</span>
      <p class="text-sm font-semibold text-navy">Up to 20 Guests</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">family_restroom</span>
      <p class="text-sm font-semibold text-navy">Family Friendly</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">local_bar</span>
      <p class="text-sm font-semibold text-navy">All-Inclusive</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">event_available</span>
      <p class="text-sm font-semibold text-navy">Free Cancellation</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">pin_drop</span>
      <p class="text-sm font-semibold text-navy">Cabo Marina, Dock F</p>
    </div>
  </div>

  <!-- About this experience -->
  <div class="mt-12">
    <h3 class="text-2xl text-navy mb-4">About this experience</h3>
    <p class="text-slate-700 leading-relaxed text-base">
      A private yacht charter in Cabo San Lucas is the most flexible, comfortable way to experience the Sea of Cortez. Pick the yacht that fits your group, tell us what you want to do, and we&rsquo;ll build the day around you &mdash; snorkel at Chileno or Santa Mar&iacute;a Bay, cruise to the Arch, swim and paddleboard in a quiet cove, or celebrate a milestone on the water. Crew, fuel, premium open bar, food, snorkel gear, paddleboards, towels, and Bluetooth speakers are all included. You just step onboard.
    </p>
  </div>
</div>

<!-- MOBILE: Title + intro -->
<div class="lg:hidden mt-6 px-5">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-gold transition-colors">Home</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span>Tours</span>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Yacht Charter</span>
  </nav>
  <h1 class="text-2xl text-navy leading-tight">Private Yacht Charter &amp; Rental in Cabo San Lucas</h1>
  <p class="text-slate-700 text-base leading-relaxed mt-2">Charter a private yacht or sailboat for your group &mdash; family days, celebrations, anniversaries, and group getaways. All-inclusive, fully crewed, and designed around you.</p>
</div>

<!-- MOBILE: Icons row -->
<div class="lg:hidden mt-5 px-5">
  <div class="grid grid-cols-2 gap-x-3 gap-y-3">
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">schedule</span><p class="text-xs font-semibold text-navy">3 Hours</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">add</span><p class="text-xs font-semibold text-navy">Extra Time Available</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">celebration</span><p class="text-xs font-semibold text-navy">Private Charter</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">groups</span><p class="text-xs font-semibold text-navy">Up to 20 Guests</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">family_restroom</span><p class="text-xs font-semibold text-navy">Family Friendly</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">local_bar</span><p class="text-xs font-semibold text-navy">All-Inclusive</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">event_available</span><p class="text-xs font-semibold text-navy">Free Cancellation</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">pin_drop</span><p class="text-xs font-semibold text-navy">Cabo Marina, Dock F</p></div>
  </div>
</div>

<!-- MOBILE: About -->
<div class="lg:hidden mt-8 px-5">
  <h3 class="text-lg text-navy mb-3">About this experience</h3>
  <p class="text-slate-700 leading-relaxed text-base">A private yacht charter in Cabo San Lucas is the most flexible, comfortable way to experience the Sea of Cortez. Pick the yacht that fits your group, tell us what you want to do, and we&rsquo;ll build the day around you &mdash; snorkel at Chileno or Santa Mar&iacute;a Bay, cruise to the Arch, swim and paddleboard in a quiet cove, or celebrate a milestone on the water.</p>
</div>

<!-- ===== UNIQUE BLOCK #1: Charter for any occasion ===== -->
<div class="mt-12 lg:max-w-[1400px] lg:mx-auto lg:px-10 px-5">
  <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-3xl text-navy">Charter for any occasion</h2></div>
  <p class="text-slate-700 text-base lg:text-lg leading-relaxed mb-8 lg:max-w-3xl">Every charter is built around your group. Here&rsquo;s how guests use the boat most often &mdash; pick the one that fits and we&rsquo;ll handle the rest.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <a href="/private-snorkeling" class="group bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5 hover:shadow-xl transition-shadow">
      <div class="h-44 overflow-hidden"><Image src={familyYachtEscape} alt="Family yacht charter day in Cabo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
      <div class="p-5">
        <h3 class="text-base font-bold text-navy mb-2">Family Day</h3>
        <p class="text-sm text-slate-600 leading-relaxed">Calm bays, easy snorkeling, kid-friendly crew. Perfect for kids and grandparents alike.</p>
        <p class="text-xs text-accent-gold font-semibold uppercase tracking-widest mt-3 group-hover:underline">Explore family snorkeling &rarr;</p>
      </div>
    </a>
    <a href="/bachelorette" class="group bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5 hover:shadow-xl transition-shadow">
      <div class="h-44 overflow-hidden"><Image src={celebrationYacht} alt="Birthday and anniversary yacht charter celebration" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
      <div class="p-5">
        <h3 class="text-base font-bold text-navy mb-2">Celebration</h3>
        <p class="text-sm text-slate-600 leading-relaxed">Birthdays, anniversaries, bachelor &amp; bachelorette parties, family reunions. Custom playlist, your call.</p>
        <p class="text-xs text-accent-gold font-semibold uppercase tracking-widest mt-3 group-hover:underline">See celebration charters &rarr;</p>
      </div>
    </a>
    <a href="/private-sunset" class="group bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5 hover:shadow-xl transition-shadow">
      <div class="h-44 overflow-hidden"><Image src={romanticSunset} alt="Romantic sunset yacht charter for couples" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
      <div class="p-5">
        <h3 class="text-base font-bold text-navy mb-2">Romance</h3>
        <p class="text-sm text-slate-600 leading-relaxed">Couples, honeymoons, proposals. Champagne, golden-hour light, and Cabo&rsquo;s most photogenic backdrop.</p>
        <p class="text-xs text-accent-gold font-semibold uppercase tracking-widest mt-3 group-hover:underline">Explore sunset cruises &rarr;</p>
      </div>
    </a>
    <a href="#choose-your-yacht" class="group bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5 hover:shadow-xl transition-shadow">
      <div class="h-44 overflow-hidden"><Image src={sunFilledBoatDay} alt="Group of friends on a private yacht in Cabo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
      <div class="p-5">
        <h3 class="text-base font-bold text-navy mb-2">Group Getaway</h3>
        <p class="text-sm text-slate-600 leading-relaxed">Friend trips, corporate retreats, milestone weekends. Up to 20 guests on our largest yacht.</p>
        <p class="text-xs text-accent-gold font-semibold uppercase tracking-widest mt-3 group-hover:underline">Pick your yacht &rarr;</p>
      </div>
    </a>
  </div>
</div>

<!-- ===== Choose Your Yacht ===== -->
<div id="choose-your-yacht" class="mt-14 lg:max-w-[1400px] lg:mx-auto lg:px-10 lg:py-8 px-5">
  <div class="flex items-center gap-3 mb-8"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-2xl text-navy">Choose your yacht &mdash; built for any group size</h2></div>

  <!-- Luxury yachts -->
  <div class="flex flex-col gap-5 lg:grid lg:grid-cols-3 lg:max-w-[1100px] lg:mx-auto pb-8">
    <!-- Yacht 51' — Most Spacious -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-51">
      <CarouselImage type="boat" id="yacht-51" alt="Luxury Yacht 51' private charter in Cabo">
        <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h3 class="text-white text-lg lg:text-xl">Luxury Yacht 51'</h3>
          <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 20 Guests</span></div>
        </div>
        <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Most Spacious</div>
        <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
      </CarouselImage>
      <div class="p-4 space-y-4">
        <p class="text-slate-700 text-sm italic text-center pb-3 border-b border-border-light/50">Best for large groups &amp; maximum space</p>
        <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-2 text-[0.9rem] lg:text-[1.05rem] font-semibold">$1,690</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$1,436</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ 1-4 guests</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Extra guests</span><div class="flex items-baseline gap-1"><span class="text-gold line-through text-[12px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-500 text-[11px] font-medium">/pp</span></div></div></div>
        <button type="button" onclick="openRezdyModal('165509')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer">Check Availability</button>
      </div>
    </div>
    <!-- Yacht 45' — Most Popular -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-45">
      <CarouselImage type="boat" id="yacht-45" alt="Luxury Yacht 45' private charter in Cabo" imgStyle="transform: none;">
        <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h3 class="text-white text-lg lg:text-xl">Luxury Yacht 45'</h3>
          <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 12 Guests</span></div>
        </div>
        <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Most Popular</div>
        <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
      </CarouselImage>
      <div class="p-4 space-y-4">
        <p class="text-slate-700 text-sm italic text-center pb-3 border-b border-border-light/50">Newest vessel, sleek &amp; modern luxury</p>
        <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-2 text-[0.9rem] lg:text-[1.05rem] font-semibold">$1,520</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$1,292</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ 1-4 guests</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Extra guests</span><div class="flex items-baseline gap-1"><span class="text-gold line-through text-[12px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-500 text-[11px] font-medium">/pp</span></div></div></div>
        <button type="button" onclick="openRezdyModal('528988')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer">Check Availability</button>
      </div>
