  <style is:inline>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .material-symbols-outlined.filled { font-variation-settings: 'FILL' 1; }
    .fleet-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: none;
      background: rgba(255,255,255,0.25);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      color: white;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
      padding: 0;
    }
    .fleet-arrow:hover { background: rgba(255,255,255,0.45); }
    .fleet-arrow.left { left: 10px; }
    .fleet-arrow.right { right: 10px; }
    .fleet-arrow .material-symbols-outlined { font-size: 20px; line-height: 1; }
  </style>

  <script is:inline>
    var shuttlePage = 0;
    function scrollShuttleReviews(dir) {
      shuttlePage = Math.max(0, Math.min(1, shuttlePage + dir));
      var container = document.getElementById('m-carousel');
      var card = container.children[0];
      var gap = 24;
      container.scrollTo({ left: (card.offsetWidth + gap) * 3 * shuttlePage, behavior: 'smooth' });
      document.querySelectorAll('.shuttle-review-dot').forEach(function(dot, i) {
        dot.className = 'shuttle-review-dot w-2.5 h-2.5 rounded-full transition-colors ' + (i === shuttlePage ? 'bg-navy' : 'bg-border-light');
      });
    }
    function goToShuttlePage(page) { shuttlePage = page; scrollShuttleReviews(0); }

    function heroNav(btn, dir) {
      var wrap = btn.closest('.overflow-hidden').querySelector('.snap-x');
      if (!wrap) return;
      wrap.scrollBy({ left: dir * wrap.offsetWidth, behavior: 'smooth' });
    }
  </script>
