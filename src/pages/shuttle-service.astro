---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import { Image } from 'astro:assets';

// Images
import vanImg from "../assets/images/cabo-airport-shuttle-van.png";
import yacht45_5 from "../assets/images/boats/yacht-45/cabo-private-yacht-45-exterior-03.jpg";
import sailing42_10 from "../assets/images/boats/sailing-42/cabo-sailing-42-exterior-01.jpg";
import guestsImg from "../assets/images/guests/cabo-charter-guests-smiling.jpg";
import guestsYachtImg from "../assets/images/guests-on-yachts/cabo-yacht-charter-guests-04.jpg";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Shuttle Service" }
  ]
});
---

<BaseLayout title="Los Cabos Airport Shuttle & Transfer Service | Cabo Sailing" description="Reliable airport shuttle and transfer service in Los Cabos. Air-conditioned vehicles, bilingual drivers, door-to-door service from SJD Airport to Cabo San Lucas.">
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="shuttle" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- ========== MOBILE LAYOUT ========== -->
    <div class="lg:hidden">
      <div class="relative w-full h-[45vh] overflow-hidden">
        <div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
          <div class="flex-shrink-0 w-full h-full snap-center relative">
            <Image alt="Cabo Sailing shuttle van" class="w-full h-full object-cover" src={vanImg} width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/40 to-transparent"></div>
            <div class="absolute bottom-12 left-0 right-0 px-6">
              <h1 class="text-3xl text-white mb-2 leading-tight font-serif">Seamless Shuttle to Your Cruise &amp; Back</h1>
              <p class="text-white/80 text-base font-medium tracking-wide uppercase">Private Door-to-Door Service</p>
            </div>
          </div>
          <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Yacht 45 in Cabo" class="w-full h-full object-cover" src={yacht45_5} width={800} height={500} /></div>
          <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Sailing 42 with guests" class="w-full h-full object-cover" src={sailing42_10} width={800} height={500} /></div>
          <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Happy guests on sailboat" class="w-full h-full object-cover" src={guestsImg} width={800} height={500} /></div>
          <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Guests toasting on yacht" class="w-full h-full object-cover" src={guestsYachtImg} width={800} height={500} /></div>
        </div>
        <button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
        <button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
      </div>
      <div class="px-5 -mt-8 relative z-10">
        <div class="bg-white rounded-3xl p-6 shadow-xl shadow-navy/5 border border-border-light">
          <nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
            <a href="/" class="hover:text-gold transition-colors">Home</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-navy font-semibold">Shuttle Service</span>
          </nav>
          <p class="text-navy font-bold text-center mb-6 leading-relaxed text-lg">Why use our service?</p>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-cabo-blue text-base">security</span>
              </div>
              <span class="text-base font-medium text-slate-600">Safety is our #1 priority!</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-cabo-blue text-base">language</span>
              </div>
              <span class="text-base font-medium text-slate-600">Professional bilingual drivers</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-cabo-blue text-base">payments</span>
              </div>
              <span class="text-base font-medium text-slate-600">Competitive Prices</span>
            </div>
          </div>
        </div>
      </div>
      <div class="px-5 mt-8 space-y-3">
        <button class="w-full bg-cabo-yellow hover:bg-yellow-500 text-navy font-bold py-4 rounded-2xl shadow-md transition-all active:scale-[0.98] text-base uppercase tracking-wider">Airport Transportation Form</button>
        <button class="w-full bg-cabo-yellow hover:bg-yellow-500 text-navy font-bold py-4 rounded-2xl shadow-md transition-all active:scale-[0.98] text-base uppercase tracking-wider">Cruise Pick Up Form</button>
      </div>

      <!-- MOBILE: Seamless Shuttle Section -->
      <div class="px-5 pt-8 pb-6">
        <div class="flex items-center gap-3 mb-4"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">Seamless Shuttle to Your Cruise &amp; Back</h3></div>
        <Image src={vanImg} alt="Cabo Sailing shuttle" class="w-full h-48 object-cover rounded-2xl mb-4" width={600} height={200} />
        <p class="text-base text-slate-500 leading-relaxed mb-3">Getting to the marina for your sailing charter should be the easiest part of your day. Our private shuttle picks you up right at your hotel, resort, or vacation rental and takes you directly to the Cabo San Lucas Marina — and brings you back when your cruise is over.</p>
        <p class="text-base text-slate-500 leading-relaxed">No waiting for taxis, no navigating unfamiliar streets. Just step in, relax, and let us handle the ride so you can focus on the adventure ahead.</p>
        <div class="flex gap-6 mt-6">
          <div><p class="text-xl font-bold text-navy font-serif">All Day</p><p class="text-xs text-slate-400 uppercase tracking-widest font-bold mt-1">Available</p></div>
          <div class="w-px bg-border-light"></div>
          <div><p class="text-xl font-bold text-navy font-serif">Private</p><p class="text-xs text-slate-400 uppercase tracking-widest font-bold mt-1">Vehicle</p></div>
          <div class="w-px bg-border-light"></div>
          <div><p class="text-xl font-bold text-navy font-serif">Door-to-Door</p><p class="text-xs text-slate-400 uppercase tracking-widest font-bold mt-1">Service</p></div>
        </div>
      </div>

      <!-- Mobile: Hotel & Residential -->
      <div class="mt-12 px-5">
        <div class="text-center mb-8">
          <h2 class="text-2xl text-navy mb-2">Hotel &amp; Residential to Marina</h2>
          <p class="text-slate-500 text-sm px-4">Can be booked during your cruise booking process or separately.</p>
        </div>
        <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
          <div class="bg-navy py-4 px-6 text-center">
            <h3 class="text-white text-sm font-bold uppercase tracking-widest">Hotel &amp; Residential Cruise Transfers</h3>
          </div>
          <div class="p-6 space-y-6">
            <div>
              <h4 class="text-navy text-sm font-bold uppercase mb-3 border-b border-slate-100 pb-2">Cabo San Lucas to Palmilla Bridge</h4>
              <div class="flex justify-between items-center text-base mb-2">
                <span class="text-slate-600">One way (1-10 guests)</span>
                <span class="font-bold text-navy">$70 USD</span>
              </div>
              <div class="flex justify-between items-center text-base">
                <span class="text-slate-600">Round trip (1-10 guests)</span>
                <span class="font-bold text-navy">$120 USD</span>
              </div>
            </div>
            <div>
              <h4 class="text-navy text-sm font-bold uppercase mb-3 border-b border-slate-100 pb-2">Palmilla to Puerto Los Cabos</h4>
              <div class="flex justify-between items-center text-base mb-2">
                <span class="text-slate-600">One way (1-10 guests)</span>
                <span class="font-bold text-navy">$80 USD</span>
              </div>
              <div class="flex justify-between items-center text-base">
                <span class="text-slate-600">Round trip (1-10 guests)</span>
                <span class="font-bold text-navy">$145 USD</span>
              </div>
            </div>
            <p class="text-base text-center text-slate-400 font-bold uppercase pt-2">Extra guest (11th &amp; more): $10 USD per guest</p>
          </div>
        </div>
      </div>

      <!-- Mobile: Airport Private Service -->
      <div class="mt-16 px-5">
        <div class="text-center mb-8">
          <h2 class="text-2xl text-navy mb-2">Airport Private Service</h2>
          <p class="text-slate-400 text-base uppercase tracking-[0.2em] font-bold">Official Transfers</p>
        </div>
        <div class="space-y-6">
          <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
            <div class="bg-cabo-blue py-3 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Airport to San Jose Del Cabo</h3>
            </div>
            <div class="p-6 text-center">
              <p class="text-slate-500 text-sm mb-2">To San Jose hotels zone and residential area</p>
              <div class="flex justify-center items-baseline gap-1">
                <span class="text-navy font-bold text-3xl">$75</span>
                <span class="text-navy/60 text-base font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-400 mt-2 font-bold uppercase tracking-wider">1 to 10 Guests</p>
            </div>
          </div>
          <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
            <div class="bg-cabo-orange py-3 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Airport to Puerto Los Cabos</h3>
            </div>
            <div class="p-6 text-center">
              <p class="text-slate-500 text-sm mb-2">To the Los Cabos Corridor area (between SJD &amp; CSL)</p>
              <div class="flex justify-center items-baseline gap-1">
                <span class="text-navy font-bold text-3xl">$95</span>
                <span class="text-navy/60 text-base font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-400 mt-2 font-bold uppercase tracking-wider">1 to 10 Guests</p>
            </div>
          </div>
          <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
            <div class="bg-cabo-green py-3 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Airport to Diamante Area</h3>
            </div>
            <div class="p-6 text-center">
              <p class="text-slate-500 text-sm mb-2">To Cabo San Lucas hotels zone and residential area</p>
              <div class="flex justify-center items-baseline gap-1">
                <span class="text-navy font-bold text-3xl">$120</span>
                <span class="text-navy/60 text-base font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-400 mt-2 font-bold uppercase tracking-wider">1 to 10 Guests</p>
            </div>
          </div>
        </div>
        <p class="mt-6 text-center italic text-slate-400 text-base px-4">*5% discount on AIRPORT DROP OFF if booked a cruise with us during your stay.</p>
      </div>

      <!-- Mobile: CTA -->
      <div class="mt-16 px-5 py-12 bg-light-grey">
        <h3 class="text-center text-navy font-bold italic mb-8">Inquire for Service Now!</h3>
        <div class="space-y-3">
          <button class="w-full bg-cabo-yellow hover:bg-yellow-500 text-navy font-bold py-4 rounded-2xl shadow-md transition-all active:scale-[0.98] text-base uppercase tracking-wider">Cruise Pick Up Form</button>
          <button class="w-full bg-white border border-border-light hover:bg-light-grey text-navy font-bold py-4 rounded-2xl shadow-md transition-all active:scale-[0.98] text-base uppercase tracking-wider">Airport Transportation Form</button>
        </div>
      </div>
    </div><!-- end mobile -->

    <!-- ========== DESKTOP LAYOUT ========== -->
    <div class="hidden lg:block">

      <!-- Hero Gallery -->
      <div class="max-w-[1400px] mx-auto px-10 pt-10">
        <div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
          <div class="col-span-2 row-span-2 rounded-2xl overflow-hidden relative">
            <Image alt="Cabo Sailing shuttle van" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={vanImg} width={1200} height={800} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent rounded-2xl"></div>
            <div class="absolute bottom-6 left-6">
              <span class="bg-cabo-blue text-white text-sm font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-3 inline-block">Door-to-Door Service</span>
              <h1 class="text-4xl text-white leading-tight">Seamless Shuttle to<br/>Your Cruise &amp; Back</h1>
            </div>
          </div>
          <div class="rounded-2xl overflow-hidden"><Image alt="Yacht 45 in Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={yacht45_5} width={600} height={400} /></div>
          <div class="rounded-2xl overflow-hidden"><Image alt="Sailing 42 with guests" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={sailing42_10} width={600} height={400} /></div>
          <div class="rounded-2xl overflow-hidden"><Image alt="Happy guests on sailboat" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={guestsImg} width={600} height={400} /></div>
          <div class="rounded-2xl overflow-hidden"><Image alt="Guests toasting on yacht" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={guestsYachtImg} width={600} height={400} /></div>
        </div>
      </div>

      <!-- Breadcrumb -->
      <div class="max-w-[1400px] mx-auto px-10 pt-8">
        <nav class="flex items-center gap-1.5 text-xs text-slate-400" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold transition-colors">Home</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-navy font-semibold">Shuttle Service</span>
        </nav>
      </div>

      <!-- Why Choose Us -->
      <div class="max-w-[1400px] mx-auto px-10 py-16">
        <div class="grid grid-cols-3 gap-8 mb-16">
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">security</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Safety First</h3>
            <p class="text-slate-500 text-base">Licensed, insured vehicles with professionally trained drivers. Your safety is our #1 priority.</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">language</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Bilingual Drivers</h3>
            <p class="text-slate-500 text-base">Professional English and Spanish-speaking drivers who know Los Cabos inside and out.</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">payments</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Competitive Prices</h3>
            <p class="text-slate-500 text-base">Transparent pricing with no hidden fees. Book direct and save compared to hotel transfers.</p>
          </div>
        </div>

        <!-- About Section -->
        <div class="flex gap-16 items-center mb-20">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-6"><div class="w-1 h-8 bg-gold rounded-full"></div><h2 class="text-3xl text-navy">Seamless Shuttle to Your Cruise &amp; Back</h2></div>
            <p class="text-slate-500 text-lg leading-relaxed mb-4">Getting to the marina for your sailing charter should be the easiest part of your day. Our private shuttle picks you up right at your hotel, resort, or vacation rental and takes you directly to the Cabo San Lucas Marina — and brings you back when your cruise is over.</p>
            <p class="text-slate-500 text-lg leading-relaxed mb-8">No waiting for taxis, no navigating unfamiliar streets. Just step in, relax, and let us handle the ride so you can focus on the adventure ahead.</p>
            <div class="flex gap-10">
              <div><p class="text-2xl font-bold text-navy font-serif">All Day</p><p class="text-xs text-slate-400 uppercase tracking-widest font-bold mt-1">Available</p></div>
              <div class="w-px bg-border-light"></div>
              <div><p class="text-2xl font-bold text-navy font-serif">Private</p><p class="text-xs text-slate-400 uppercase tracking-widest font-bold mt-1">Vehicle</p></div>
              <div class="w-px bg-border-light"></div>
              <div><p class="text-2xl font-bold text-navy font-serif">Door-to-Door</p><p class="text-xs text-slate-400 uppercase tracking-widest font-bold mt-1">Service</p></div>
            </div>
          </div>
          <div class="w-[400px] h-[300px] rounded-3xl overflow-hidden flex-shrink-0">
            <Image alt="Cabo Sailing shuttle van" class="w-full h-full object-cover" src={vanImg} width={400} height={300} />
          </div>
        </div>
      </div>

      <!-- Hotel & Residential Transfers -->
      <div class="bg-light-grey py-20">
        <div class="max-w-[1400px] mx-auto px-10">
          <div class="text-center mb-10">
            <h2 class="text-3xl text-navy mb-2">Hotel &amp; Residential to Marina</h2>
            <p class="text-slate-500 text-base">Can be booked during your cruise booking process or separately.</p>
          </div>
          <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm">
              <div class="bg-navy py-4 px-8 text-center">
                <h3 class="text-white text-sm font-bold uppercase tracking-widest">Hotel &amp; Residential Cruise Transfers</h3>
              </div>
              <div class="p-8">
                <div class="grid grid-cols-3 gap-8 text-center mb-6">
                  <div></div>
                  <div class="text-sm font-bold text-slate-400 uppercase tracking-widest">One Way</div>
                  <div class="text-sm font-bold text-slate-400 uppercase tracking-widest">Round Trip</div>
                </div>
                <div class="grid grid-cols-3 gap-8 items-center py-4 border-b border-border-light">
                  <div class="text-navy font-bold">Cabo San Lucas to Palmilla Bridge</div>
                  <div class="text-center text-lg font-bold text-navy">$70 <span class="text-sm text-navy/60">USD</span></div>
                  <div class="text-center text-lg font-bold text-navy">$120 <span class="text-sm text-navy/60">USD</span></div>
                </div>
                <div class="grid grid-cols-3 gap-8 items-center py-4 border-b border-border-light">
                  <div class="text-navy font-bold">Palmilla to Puerto Los Cabos</div>
                  <div class="text-center text-lg font-bold text-navy">$80 <span class="text-sm text-navy/60">USD</span></div>
                  <div class="text-center text-lg font-bold text-navy">$145 <span class="text-sm text-navy/60">USD</span></div>
                </div>
                <p class="text-sm text-center text-slate-400 font-bold uppercase pt-6">Extra guest (11th &amp; more): $10 USD per guest</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="max-w-[1400px] mx-auto px-10 py-20">
        <div class="bg-navy rounded-3xl p-12 text-center">
          <h2 class="text-3xl text-white mb-3 font-serif">Ready to Book Your Transfer?</h2>
          <p class="text-white/70 text-lg mb-8 max-w-2xl mx-auto">Start your Cabo vacation stress-free. Book your private cruise shuttle or airport pickup today.</p>
          <div class="flex justify-center gap-4">
            <button class="bg-cabo-yellow hover:bg-yellow-500 text-navy font-bold px-10 py-4 rounded-full uppercase tracking-widest text-sm transition-colors shadow-lg">Cruise Pick Up Form</button>
            <button class="bg-white/20 text-white font-bold px-10 py-4 rounded-full uppercase tracking-widest text-sm hover:bg-white/30 transition-colors border border-white/40">Airport Transportation Form</button>
          </div>
        </div>
      </div>

      <!-- Airport Transfers -->
      <div class="max-w-[1400px] mx-auto px-10 pb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl text-navy mb-2">Airport Private Service</h2>
          <p class="text-slate-400 text-base uppercase tracking-[0.2em] font-bold">Official Transfers</p>
        </div>
        <div class="grid grid-cols-3 gap-8">
          <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm hover:shadow-lg transition-shadow">
            <div class="bg-cabo-blue py-4 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Airport to San Jose Del Cabo</h3>
            </div>
            <div class="p-8 text-center">
              <p class="text-slate-500 text-sm mb-4">To San Jose hotels zone and residential area</p>
              <div class="flex justify-center items-baseline gap-1 mb-2">
                <span class="text-navy font-bold text-5xl">$75</span>
                <span class="text-navy/60 text-lg font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-400 font-bold uppercase tracking-wider">1 to 10 Guests</p>
            </div>
          </div>
          <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm hover:shadow-lg transition-shadow">
            <div class="bg-cabo-orange py-4 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Airport to Puerto Los Cabos</h3>
            </div>
            <div class="p-8 text-center">
              <p class="text-slate-500 text-sm mb-4">To the Los Cabos Corridor area (between SJD &amp; CSL)</p>
              <div class="flex justify-center items-baseline gap-1 mb-2">
                <span class="text-navy font-bold text-5xl">$95</span>
                <span class="text-navy/60 text-lg font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-400 font-bold uppercase tracking-wider">1 to 10 Guests</p>
            </div>
          </div>
          <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm hover:shadow-lg transition-shadow">
            <div class="bg-cabo-green py-4 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Airport to Diamante Area</h3>
            </div>
            <div class="p-8 text-center">
              <p class="text-slate-500 text-sm mb-4">To Cabo San Lucas hotels zone and residential area</p>
              <div class="flex justify-center items-baseline gap-1 mb-2">
                <span class="text-navy font-bold text-5xl">$120</span>
