---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import { Image } from 'astro:assets';

// Images
import vanDesertImg from "../assets/images/blog/van-shuttle-in-the-desert.png";
import rocksImg from "../assets/images/blog/relaxing-in-front-of-the-rocks.jpg";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Shuttle Service" }
  ]
});

const faqs = [
  { q: "How do I book shuttle service?", a: "During the booking process you'll be asked if you would like to include private shuttle service for your cruise." },
  { q: "I just want more information. How do I contact you?", a: "You can click the Contact Us button, send us a message on WhatsApp, or give us a call. We'll be happy to help you confirm availability, pricing, and pickup details." },
  { q: "Can I book my cruise first and decide about transportation later?", a: "Absolutely. You can reserve your cruise first and add shuttle service later, subject to availability." },
  { q: "How far does your shuttle service operate?", a: "We offer shuttle service throughout Cabo San Lucas and San José del Cabo. For longer-distance areas such as East Cape, La Ribera, Pescadero, or Todos Santos, we'll be happy to send you a custom quote." },
  { q: "Is the shuttle private or shared?", a: "All of our shuttle services are private. The van is reserved only for your group." },
  { q: "Can I book one-way transportation only?", a: "Absolutely. You can choose round-trip or one-way transportation. Please see the pricing table above for details." },
  { q: "Can you pick up guests from multiple locations?", a: "In most cases, yes. Some routes or pickup combinations may require extra time or an additional charge. We'll confirm this with you before finalizing the service." },
  { q: "Does the driver speak English?", a: "Yes. Our drivers speak both English and Spanish." },
  { q: "What kind of van will pick us up?", a: "We operate modern, air-conditioned Toyota vans. Each van seats up to 11 guests comfortably and safely." }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});
---

<BaseLayout title="Los Cabos Airport Shuttle & Transfer Service | Cabo Sailing" description="Reliable airport shuttle and transfer service in Los Cabos. Air-conditioned vehicles, bilingual drivers, door-to-door service from SJD Airport to Cabo San Lucas." hreflangs={{ en: '/shuttle-service', es: '/es/shuttle-service' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <Header variant="subpage" activePage="shuttle" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- ========== MOBILE LAYOUT ========== -->
    <div class="lg:hidden">
      <div class="relative w-full h-[45vh] overflow-hidden">
        <Image alt="Cabo Sailing shuttle van in the desert" class="w-full h-full object-cover" src={vanDesertImg} width={800} height={500} />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/40 to-transparent"></div>
        <div class="absolute bottom-12 left-0 right-0 px-6">
          <h1 class="text-3xl text-white mb-2 leading-tight font-serif">Seamless Shuttle to Your Cruise &amp; Back</h1>
          <p class="text-white/80 text-base font-medium tracking-wide uppercase">Private Door-to-Door Service</p>
        </div>
      </div>
      <div class="px-5 pt-5">
        <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold transition-colors">Home</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-navy font-semibold">Shuttle Service</span>
        </nav>
        <p class="text-navy font-bold mb-4 text-lg">Why use our service?</p>
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-cabo-blue text-base">security</span>
            </div>
            <span class="text-base font-medium text-slate-600">Safety is our #1 priority!</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-cabo-blue text-base">language</span>
            </div>
            <span class="text-base font-medium text-slate-600">Professional bilingual drivers</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-cabo-blue text-base">payments</span>
            </div>
            <span class="text-base font-medium text-slate-600">Competitive Prices</span>
          </div>
        </div>
      </div>

      <!-- MOBILE: Seamless Shuttle Section -->
      <div class="px-5 pt-8 pb-6">
        <div class="flex items-center gap-3 mb-4"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">Seamless Shuttle to Your Cruise &amp; Back</h3></div>
        <Image src={rocksImg} alt="Guests relaxing in front of the rocks" class="w-full h-48 object-cover rounded-2xl mb-4" width={600} height={200} />
        <p class="text-base text-slate-500 leading-relaxed mb-3">Getting to the marina for your sailing charter should be the easiest part of your day. Our private shuttle picks you up right at your lodging and takes you directly to the Cabo San Lucas Marina — and brings you back when your cruise is over.</p>
        <p class="text-base text-slate-500 leading-relaxed">No waiting for taxis, no navigating unfamiliar streets. Just step in, relax, and let us handle the ride so you can focus on the adventure ahead.</p>
        <div class="flex gap-6 mt-6">
          <div><p class="text-xl font-bold text-navy font-serif">All Day</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Available</p></div>
          <div class="w-px bg-border-light"></div>
          <div><p class="text-xl font-bold text-navy font-serif">Private</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Vehicle</p></div>
          <div class="w-px bg-border-light"></div>
          <div><p class="text-xl font-bold text-navy font-serif">Door-to-Door</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Service</p></div>
        </div>
      </div>

      <!-- Mobile: Hotel & Residential -->
      <div class="mt-12 px-5">
        <div class="text-center mb-8">
          <h2 class="text-2xl text-navy mb-2">Transportation Service</h2>
          <p class="text-slate-500 text-sm px-4">Can be booked during your cruise booking process or separately.</p>
        </div>
        <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
          <div class="bg-navy py-4 px-6 text-center">
            <h3 class="text-white text-sm font-bold uppercase tracking-widest">Hotel &amp; Residential Cruise Transfers</h3>
          </div>
          <div class="p-6 space-y-6">
            <div>
              <h4 class="text-navy text-sm font-bold uppercase mb-3 border-b border-slate-100 pb-2">Cabo San Lucas to Palmilla Bridge</h4>
              <div class="flex justify-between items-center text-base mb-2">
                <span class="text-slate-600">One way (1-10 guests)</span>
                <span class="font-bold text-navy">$70 USD</span>
              </div>
              <div class="flex justify-between items-center text-base">
                <span class="text-slate-600">Round trip (1-10 guests)</span>
                <span class="font-bold text-navy">$120 USD</span>
              </div>
            </div>
            <div>
              <h4 class="text-navy text-sm font-bold uppercase mb-3 border-b border-slate-100 pb-2">Palmilla to Puerto Los Cabos</h4>
              <div class="flex justify-between items-center text-base mb-2">
                <span class="text-slate-600">One way (1-10 guests)</span>
                <span class="font-bold text-navy">$80 USD</span>
              </div>
              <div class="flex justify-between items-center text-base">
                <span class="text-slate-600">Round trip (1-10 guests)</span>
                <span class="font-bold text-navy">$145 USD</span>
              </div>
            </div>
            <p class="text-base text-center text-slate-500 font-bold uppercase pt-2">Extra guest (11th &amp; more): $10 USD per guest</p>
          </div>
        </div>
      </div>

    </div><!-- end mobile -->

    <!-- ========== DESKTOP LAYOUT ========== -->
    <div class="hidden lg:block">

      <!-- Hero Gallery -->
      <div class="max-w-[1400px] mx-auto px-10 pt-6">
        <div class="rounded-2xl overflow-hidden relative h-[55vh]">
          <Image alt="Cabo Sailing shuttle van in the desert" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={vanDesertImg} width={1400} height={800} />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent rounded-2xl"></div>
          <div class="absolute bottom-6 left-6">
            <span class="bg-cabo-blue text-white text-sm font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-3 inline-block">Door-to-Door Service</span>
            <h1 class="text-4xl text-white leading-tight">Seamless Shuttle to<br/>Your Cruise &amp; Back</h1>
          </div>
        </div>
      </div>

      <!-- Breadcrumb -->
      <div class="max-w-[1400px] mx-auto px-10 pt-5">
        <nav class="flex items-center gap-1.5 text-xs text-slate-500" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold transition-colors">Home</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-navy font-semibold">Shuttle Service</span>
        </nav>
      </div>

      <!-- Why Choose Us -->
      <div class="max-w-[1400px] mx-auto px-10 py-10">
        <div class="grid grid-cols-3 gap-6 mb-10">
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">security</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Safety First</h3>
            <p class="text-slate-500 text-base">Licensed, insured vehicles with professionally trained drivers. Your safety is our #1 priority.</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">language</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Bilingual Drivers</h3>
            <p class="text-slate-500 text-base">Professional English and Spanish-speaking drivers who know Los Cabos inside and out.</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">payments</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Competitive Prices</h3>
            <p class="text-slate-500 text-base">Transparent pricing with no hidden fees. Book direct and save compared to hotel transfers.</p>
          </div>
        </div>

        <!-- About Section -->
        <div class="flex gap-12 items-center">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4"><div class="w-1 h-8 bg-gold rounded-full"></div><h2 class="text-3xl text-navy">Seamless Shuttle to Your Cruise &amp; Back</h2></div>
            <p class="text-slate-500 text-lg leading-relaxed mb-4">Getting to the marina for your sailing charter should be the easiest part of your day. Our private shuttle picks you up right at your lodging and takes you directly to the Cabo San Lucas Marina — and brings you back when your cruise is over.</p>
            <p class="text-slate-500 text-lg leading-relaxed mb-6">No waiting for taxis, no navigating unfamiliar streets. Just step in, relax, and let us handle the ride so you can focus on the adventure ahead.</p>
            <div class="flex gap-10">
              <div><p class="text-2xl font-bold text-navy font-serif">All Day</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Available</p></div>
              <div class="w-px bg-border-light"></div>
              <div><p class="text-2xl font-bold text-navy font-serif">Private</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Vehicle</p></div>
              <div class="w-px bg-border-light"></div>
              <div><p class="text-2xl font-bold text-navy font-serif">Door-to-Door</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Service</p></div>
            </div>
          </div>
          <div class="w-[400px] h-[300px] rounded-3xl overflow-hidden flex-shrink-0">
            <Image alt="Guests relaxing in front of the rocks" class="w-full h-full object-cover" src={rocksImg} width={400} height={300} />
          </div>
        </div>
      </div>

      <!-- Hotel & Residential Transfers -->
      <div class="bg-light-grey py-12">
        <div class="max-w-[1400px] mx-auto px-10">
          <div class="text-center mb-8">
            <h2 class="text-3xl text-navy mb-2">Transportation Service</h2>
            <p class="text-slate-500 text-base">Can be booked during your cruise booking process or separately.</p>
          </div>
          <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm">
              <div class="bg-navy py-4 px-8 text-center">
                <h3 class="text-white text-sm font-bold uppercase tracking-widest">Hotel &amp; Residential Cruise Transfers</h3>
              </div>
              <div class="p-8">
                <div class="grid grid-cols-3 gap-8 text-center mb-6">
                  <div></div>
                  <div class="text-sm font-bold text-slate-500 uppercase tracking-widest">One Way</div>
                  <div class="text-sm font-bold text-slate-500 uppercase tracking-widest">Round Trip</div>
                </div>
                <div class="grid grid-cols-3 gap-8 items-center py-4 border-b border-border-light">
                  <div class="text-navy font-bold">Cabo San Lucas to Palmilla Bridge</div>
                  <div class="text-center text-lg font-bold text-navy">$70 <span class="text-sm text-navy/60">USD</span></div>
                  <div class="text-center text-lg font-bold text-navy">$120 <span class="text-sm text-navy/60">USD</span></div>
                </div>
                <div class="grid grid-cols-3 gap-8 items-center py-4 border-b border-border-light">
                  <div class="text-navy font-bold">Palmilla to Puerto Los Cabos</div>
                  <div class="text-center text-lg font-bold text-navy">$80 <span class="text-sm text-navy/60">USD</span></div>
                  <div class="text-center text-lg font-bold text-navy">$145 <span class="text-sm text-navy/60">USD</span></div>
                </div>
                <p class="text-sm text-center text-slate-500 font-bold uppercase pt-6">Extra guest (11th &amp; more): $10 USD per guest</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div><!-- end desktop layout -->

    <!-- FAQ Section -->
    <section class="px-5 pt-12 pb-8 lg:max-w-4xl lg:mx-auto lg:px-10 lg:pt-12 lg:pb-8">
      <div class="text-center mb-8 lg:mb-12">
        <h2 class="text-2xl lg:text-3xl text-navy mb-2">Frequently Asked Questions</h2>
        <p class="text-slate-500 text-base">Everything you need to know about our shuttle service.</p>
      </div>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-white border border-border-light rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 lg:p-6 cursor-pointer list-none">
              <span class="text-navy font-bold text-base lg:text-lg">{faq.q}</span>
              <span class="material-symbols-outlined text-cabo-blue flex-shrink-0 transition-transform duration-200 group-open:rotate-45">add</span>
            </summary>
            <div class="px-5 pb-5 lg:px-6 lg:pb-6 -mt-1">
              <p class="text-slate-500 text-base leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Guest Reviews Carousel -->
    <div class="px-5 pb-12 lg:max-w-[1400px] lg:mx-auto lg:px-10 lg:pt-4 lg:pb-12">
      <div class="flex items-center gap-3 mb-4 lg:mb-8"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg lg:text-3xl text-navy">What Our Guests Say</h3></div>
      <div class="relative">
        <div id="m-carousel" class="flex overflow-x-auto gap-4 lg:gap-6 no-scrollbar snap-x snap-mandatory pb-4 lg:overflow-hidden">
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Our driver was waiting at arrivals with a sign — so professional. The van was spotless and air-conditioned. After a 5-hour flight it was exactly what we needed. Highly recommend!"</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-navy flex items-center justify-center text-white text-sm font-bold">PH</div><div><p class="text-sm font-bold text-navy">Patricia H.</p><p class="text-base text-slate-500">Dallas, TX</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"We used the shuttle for a group of 8 for both arrival and departure. Perfectly on time both ways. Our driver gave us great local tips on the way to the resort. Great value!"</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center text-white text-sm font-bold">BN</div><div><p class="text-sm font-bold text-navy">Brian N.</p><p class="text-base text-slate-500">Chicago, IL</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Stress-free from start to finish. I messaged via WhatsApp the night before and everything was confirmed instantly. The driver knew every shortcut and we made it to the marina with time to spare."</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-navy/70 flex items-center justify-center text-white text-sm font-bold">KL</div><div><p class="text-sm font-bold text-navy">Karen L.</p><p class="text-base text-slate-500">Los Angeles, CA</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Late night flight and our driver was still there waiting with a smile. Cold water bottles in the van, comfortable seats, and a smooth ride to the hotel. Started our vacation perfectly."</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-navy flex items-center justify-center text-white text-sm font-bold">MT</div><div><p class="text-sm font-bold text-navy">Mark T.</p><p class="text-base text-slate-500">New York, NY</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Used the shuttle to get to the marina for our snorkeling trip. Driver was friendly and the booking through WhatsApp was so easy. Way better than trying to figure out a taxi at the airport."</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center text-white text-sm font-bold">SR</div><div><p class="text-sm font-bold text-navy">Sandra R.</p><p class="text-base text-slate-500">Miami, FL</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Third trip to Cabo and we always book the shuttle through Cabo Sailing now. Reliable, professional, and affordable. They even accommodate our early morning flights without any extra charge."</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-navy/70 flex items-center justify-center text-white text-sm font-bold">DW</div><div><p class="text-sm font-bold text-navy">Dan W.</p><p class="text-base text-slate-500">Denver, CO</p></div></div>
          </div>
        </div>
        <button onclick="scrollShuttleReviews(-1)" class="hidden lg:flex absolute left-[-20px] top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-border-light shadow-md items-center justify-center hover:bg-light-grey transition-colors z-10"><span class="material-symbols-outlined text-navy text-xl">chevron_left</span></button>
        <button onclick="scrollShuttleReviews(1)" class="hidden lg:flex absolute right-[-20px] top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-border-light shadow-md items-center justify-center hover:bg-light-grey transition-colors z-10"><span class="material-symbols-outlined text-navy text-xl">chevron_right</span></button>
        <div class="hidden lg:flex justify-center gap-2 mt-4">
          <button onclick="goToShuttlePage(0)" class="shuttle-review-dot w-2.5 h-2.5 rounded-full bg-navy transition-colors"></button>
          <button onclick="goToShuttlePage(1)" class="shuttle-review-dot w-2.5 h-2.5 rounded-full bg-border-light transition-colors"></button>
        </div>
      </div>
    </div>

  </main>

  <Footer />
  <FloatingCTA />
  <RezdyModal />

  <style is:inline>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .material-symbols-outlined.filled { font-variation-settings: 'FILL' 1; }
  </style>

  <script is:inline>
    var shuttlePage = 0;
    function scrollShuttleReviews(dir) {
      shuttlePage = Math.max(0, Math.min(1, shuttlePage + dir));
      var container = document.getElementById('m-carousel');
      var card = container.children[0];
      var gap = 24;
      container.scrollTo({ left: (card.offsetWidth + gap) * 3 * shuttlePage, behavior: 'smooth' });
      document.querySelectorAll('.shuttle-review-dot').forEach(function(dot, i) {
        dot.className = 'shuttle-review-dot w-2.5 h-2.5 rounded-full transition-colors ' + (i === shuttlePage ? 'bg-navy' : 'bg-border-light');
      });
    }
    function goToShuttlePage(page) { shuttlePage = page; scrollShuttleReviews(0); }
  </script>
</BaseLayout>
