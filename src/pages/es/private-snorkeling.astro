<div class="flex-shrink-0 w-full h-full snap-center"><Image src={Cabo_Sailing_1} alt="Woman jumping off bow into turquoise water" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_20mm_51_topaz_sharpen_exposure} alt="Happy guests with mimosas and El Arco" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_3_Yacht_42} alt="Yacht at El Arco with guests" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
