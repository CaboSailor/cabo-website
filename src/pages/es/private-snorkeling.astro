---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import CarouselImage from '../../components/CarouselImage.astro';
import { Image } from 'astro:assets';

import { privateSnorkeling as heroSunnyYachtCruise } from "../../data/tour-heroes";
import sunnySailboatAdventure from "../../assets/images/guests-on-yachts/sunny-day-sailboat-adventure-on-the-coast.png";
import relaxingLuxuryBoat from "../../assets/images/guests-on-yachts/relaxing-day-on-a-luxury-boat.png";
import sailingGuestsWaving from "../../assets/images/guests-on-sailboats/cabo-sailing-guests-waving.jpg";
import cheersCoastalAdventure from "../../assets/images/guests-on-sailboats/cheers-on-a-sunny-coastal-adventure.png";
import Chileno from "../../assets/images/blog/chileno-bay-cabo-snorkeling.jpg";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Snorkel Privado" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Tour Privado de Snorkel en Cabo San Lucas | Cabo Sailing" description="Tour privado de snorkel a Pelican Rock y el Arco de Cabo San Lucas. Equipo, bebidas y snacks incluidos. Hasta 12 personas en barco privado." ogImage="/og/private-snorkeling.jpg" ogImageAlt="Private snorkeling tour at Pelican Rock, Cabo San Lucas" hreflangs={{ en: '/private-snorkeling', es: '/es/private-snorkeling' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={heroSunnyYachtCruise} alt="Crucero soleado en yate por mar abierto" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sunnySailboatAdventure} alt="Aventura en velero un día soleado en la costa" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={relaxingLuxuryBoat} alt="Día relajante en un yate de lujo" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sailingGuestsWaving} alt="Huéspedes saludando desde el velero" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={cheersCoastalAdventure} alt="Brindis en una aventura costera soleada" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-sm">star</span>
      <span class="material-symbols-outlined text-gold filled text-sm">star</span>
      <span class="material-symbols-outlined text-gold filled text-sm">star</span>
      <span class="material-symbols-outlined text-gold filled text-sm">star</span>
      <span class="material-symbols-outlined text-gold filled text-sm">star</span>
    </div>
    <p class="text-white text-base leading-snug">"Sin duda el mejor tour de snorkel que hemos hecho. La tripulacion lo hizo muy especial."</p>
    <p class="text-white/50 text-[10px] uppercase tracking-widest font-bold mt-2">Mike &amp; Sarah T. &mdash; Austin, TX</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6 relative">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]" id="hero-desktop-grid">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={heroSunnyYachtCruise} alt="Crucero soleado en yate por mar abierto" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={sunnySailboatAdventure} alt="Aventura en velero un día soleado en la costa" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={relaxingLuxuryBoat} alt="Día relajante en un yate de lujo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={sailingGuestsWaving} alt="Huéspedes saludando desde el velero" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={cheersCoastalAdventure} alt="Brindis en una aventura costera soleada" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"Sin duda el mejor tour de snorkel que hemos hecho. La tripulacion lo hizo muy especial."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Mike &amp; Sarah T. &mdash; Austin, TX</p>
    </div>
  </div>
</div>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold mt-4 lg:mt-6">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Ahorra hasta 40% off &mdash; Tiempo Limitado</p>
</div>

<!-- DESKTOP: Full-width layout -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span>Tours</span>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Snorkel Privado</span>
  </nav>
  <h1 class="text-4xl text-navy leading-tight">Tu Propio Crucero Privado de Snorkel en Cabo</h1>
  <p class="text-slate-700 text-lg leading-relaxed mt-2">Tu propio yate o velero privado a los mejores puntos de snorkel de Cabo.</p>

  <!-- Icons row -->
  <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">3 Horas</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">family_restroom</span>
      <p class="text-sm font-semibold text-navy">Apto para Familias</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">event_available</span>
      <p class="text-sm font-semibold text-navy">Cancelaci&oacute;n Gratuita</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">groups</span>
      <p class="text-sm font-semibold text-navy">Grupos Peque&ntilde;os</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">add</span>
      <p class="text-sm font-semibold text-navy">Tiempo Extra Disponible</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">pin_drop</span>
      <p class="text-sm font-semibold text-navy">Cabo Marina, Muelle F</p>
    </div>
    <div class="flex items-center gap-2 col-span-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">SALIDAS 9:00 AM Y 12:30 PM DIARIO</p>
    </div>
  </div>

  <!-- Sobre esta experiencia -->
  <div class="mt-12">
    <h3 class="text-2xl text-navy mb-4">Sobre esta experiencia</h3>
    <p class="text-slate-700 leading-relaxed text-base">
      Disfruta de una aventura privada de snorkel en Cabo San Lucas a bordo de tu propio velero de lujo o yate privado. Navega por la impresionante costa, relajate con bebidas y snacks, y admira los famosos puntos de referencia de Cabo, incluyendo el Arco y Playa del Amor. Los veleros generalmente hacen snorkel en Pelican Rock cerca de Land's End, mientras que los yates privados navegan a las hermosas bahias de Chileno o Santa Maria, conocidas por sus aguas cristalinas y su vibrante vida marina. Esta experiencia exclusiva ofrece comodidad, privacidad y momentos inolvidables en el Mar de Cortes.
    </p>
  </div>

  <!-- Itinerario Sugerido timeline -->
  <div class="mt-10">
    <div class="flex items-center gap-3 mb-5">
      <div class="w-1 h-6 bg-gold rounded-full"></div>
      <h3 class="text-sm font-bold text-navy uppercase tracking-widest">Itinerario Sugerido</h3>
    </div>
    <ol class="relative border-l-2 border-gold/30 ml-2 space-y-5 pl-6">
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-base">Encuentro en la marina</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-base">Navega por los puntos destacados de Cabo (Arco, lobos marinos, playas)</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-base">Rumbo a la zona de snorkel</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-base">Snorkel con equipo incluido</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-base">Relajate a bordo con bebidas, comida y vistas increibles</span></li>
    </ol>
    <p class="mt-5 text-slate-700 italic text-sm">Personaliza tu experiencia y disfruta Cabo a tu ritmo.</p>
  </div>
</div>


