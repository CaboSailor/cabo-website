---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RezdyModal from '../../components/RezdyModal.astro';
---

<BaseLayout title="Página No Encontrada — Cabo Sailing" description="La página que buscas se salió de rumbo. Explora nuestros tours más populares o escríbenos — te ayudamos a encontrar lo que necesitas.">
  <Header variant="subpage" activePage="" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">
    <div class="max-w-[860px] mx-auto px-5 lg:px-8 py-12 lg:py-20">

      <!-- Hero -->
      <div class="text-center mb-12">
        <div class="w-20 h-20 rounded-full bg-light-grey flex items-center justify-center mx-auto mb-6">
          <span class="material-symbols-outlined text-navy text-5xl">sailing</span>
        </div>
        <p class="text-accent-gold font-bold text-sm uppercase tracking-[0.2em] mb-3">404 &mdash; Fuera de Rumbo</p>
        <h1 class="text-3xl lg:text-5xl text-navy mb-4 font-serif">Esta página zarpó sin nosotros</h1>
        <p class="text-slate-600 text-base lg:text-lg leading-relaxed max-w-xl mx-auto">El enlace puede estar roto o la página pudo haberse movido. Te ayudamos a regresar al mar.</p>
      </div>

      <!-- Popular destinations -->
      <div class="mb-10">
        <h2 class="text-sm font-bold text-navy uppercase tracking-widest mb-5 text-center">Destinos Populares</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4">
          <a href="/es/" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border-light hover:border-accent-gold hover:shadow-md transition-all p-5 text-center group">
            <span class="material-symbols-outlined text-navy text-3xl mb-2 group-hover:text-accent-gold transition-colors">home</span>
            <span class="text-navy font-semibold text-sm">Inicio</span>
          </a>
          <a href="/es/tours/" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border-light hover:border-accent-gold hover:shadow-md transition-all p-5 text-center group">
            <span class="material-symbols-outlined text-navy text-3xl mb-2 group-hover:text-accent-gold transition-colors">tour</span>
            <span class="text-navy font-semibold text-sm">Todos los Tours</span>
          </a>
          <a href="/es/tours/shared-snorkeling/" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border-light hover:border-accent-gold hover:shadow-md transition-all p-5 text-center group">
            <span class="material-symbols-outlined text-navy text-3xl mb-2 group-hover:text-accent-gold transition-colors">scuba_diving</span>
            <span class="text-navy font-semibold text-sm">Snorkel</span>
          </a>
          <a href="/es/tours/shared-sunset/" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border-light hover:border-accent-gold hover:shadow-md transition-all p-5 text-center group">
            <span class="material-symbols-outlined text-navy text-3xl mb-2 group-hover:text-accent-gold transition-colors">wb_twilight</span>
            <span class="text-navy font-semibold text-sm">Atardecer</span>
          </a>
          <a href="/es/tours/whale-watching/" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border-light hover:border-accent-gold hover:shadow-md transition-all p-5 text-center group">
            <span class="material-symbols-outlined text-navy text-3xl mb-2 group-hover:text-accent-gold transition-colors">water</span>
            <span class="text-navy font-semibold text-sm">Avistamiento de Ballenas</span>
          </a>
          <a href="/es/special-offers/" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border-light hover:border-accent-gold hover:shadow-md transition-all p-5 text-center group">
            <span class="material-symbols-outlined text-navy text-3xl mb-2 group-hover:text-accent-gold transition-colors">local_offer</span>
            <span class="text-navy font-semibold text-sm">Ofertas Especiales</span>
          </a>
          <a href="/es/travel-guide/" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border-light hover:border-accent-gold hover:shadow-md transition-all p-5 text-center group">
            <span class="material-symbols-outlined text-navy text-3xl mb-2 group-hover:text-accent-gold transition-colors">menu_book</span>
            <span class="text-navy font-semibold text-sm">Guía de Viaje</span>
          </a>
          <a href="/es/contact/" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border-light hover:border-accent-gold hover:shadow-md transition-all p-5 text-center group">
            <span class="material-symbols-outlined text-navy text-3xl mb-2 group-hover:text-accent-gold transition-colors">mail</span>
            <span class="text-navy font-semibold text-sm">Contacto</span>
          </a>
        </div>
      </div>

      <!-- Need help CTA -->
      <div class="bg-navy rounded-2xl p-6 lg:p-8 text-center text-white">
        <p class="text-white/85 text-base lg:text-lg leading-relaxed mb-2">¿Necesitas ayuda para encontrar algo?</p>
        <p class="text-white/70 text-sm lg:text-base mb-6">Nuestro equipo con gusto te ayuda a reservar el tour ideal.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://wa.me/526241916997" target="_blank" class="flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20c55e] text-white font-bold text-base py-3.5 px-6 rounded-xl uppercase tracking-[0.1em] shadow-lg transition-colors">
            <i class="fa-brands fa-whatsapp text-xl"></i> <span>Escríbenos por WhatsApp</span>
          </a>
          <a href="tel:+526241438485" class="flex items-center justify-center gap-3 bg-white/10 hover:bg-white/20 border border-white/30 text-white font-bold text-base py-3.5 px-6 rounded-xl uppercase tracking-[0.1em] transition-colors">
            <span class="material-symbols-outlined text-xl">call</span> <span>Llamar +52 624 143 8485</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
  <RezdyModal />
</BaseLayout>
