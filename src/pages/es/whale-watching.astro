---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import CarouselImage from '../../components/CarouselImage.astro';
import { Image } from 'astro:assets';

import { whaleWatching as feb_15_56 } from "../../data/tour-heroes";
import IGP5740 from "../../assets/images/whales/whale-breaching-near-yacht-in-daylight.png";
import Cabo_Sailing_Ocean_adventures_5 from "../../assets/images/whales/sailing-with-a-whale-in-view.png";
import family_on_board from "../../assets/images/whales/cabo-whale-watching-family.jpg";
import IGP5743 from "../../assets/images/whales/cabo-whale-watching-close-up.png";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Avistamiento de Ballenas" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Avistamiento de Ballenas Privado en Cabo San Lucas (Dic–Abr)" description="Tour privado de avistamiento de ballenas en Cabo San Lucas, diciembre a abril. Observa ballenas jorobadas y grises desde tu propio yate o velero." ogImage="/og/whale-watching-sailing.jpg" ogImageAlt="Whale watching in Cabo San Lucas" hreflangs={{ en: '/whale-watching', es: '/es/whale-watching' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={feb_15_56} alt="Humpback whale breaching" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={IGP5740} alt="Ballena jorobada saltando cerca de un yate de Cabo Sailing" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={Cabo_Sailing_Ocean_adventures_5} alt="Whale watching from sailboat" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={family_on_board} alt="Family on board whale watching" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={IGP5743} alt="Whale spotting in Cabo" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<!-- Hero discount headline -->
<div class="absolute top-5 left-4 right-4 pointer-events-none flex items-center gap-3">
  <h1 class="text-gold text-2xl font-bold leading-tight whitespace-nowrap">Ahorra hasta 40% off</h1>
  <svg class="flex-1 text-gold" viewBox="0 0 200 20" preserveAspectRatio="none" height="18" aria-hidden="true">
    <path d="M0 5 Q 12.5 1 25 5 T 50 5 T 75 5 T 100 5 T 125 5 T 150 5 T 175 5 T 200 5" stroke="currentColor" stroke-width="1.25" fill="none" stroke-linecap="round" />
    <path d="M0 15 Q 12.5 11 25 15 T 50 15 T 75 15 T 100 15 T 125 15 T 150 15 T 175 15 T 200 15" stroke="currentColor" stroke-width="1.25" fill="none" stroke-linecap="round" />
  </svg>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"Vimos ballenas saltando a pocos metros. Los ninos todavia hablan de eso."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">David &amp; Lisa M. &mdash; Chicago, IL</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6 relative">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden relative">
  <Image src={feb_15_56} alt="Humpback whale breaching" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} />
  <div class="absolute top-8 left-8 right-8 pointer-events-none flex items-center gap-4">
    <h1 class="text-gold text-3xl xl:text-4xl font-semibold leading-tight whitespace-nowrap">Ahorra hasta 40% off</h1>
    <svg class="flex-1 text-gold" viewBox="0 0 200 20" preserveAspectRatio="none" height="24" aria-hidden="true">
      <path d="M0 5 Q 12.5 1 25 5 T 50 5 T 75 5 T 100 5 T 125 5 T 150 5 T 175 5 T 200 5" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round" />
      <path d="M0 15 Q 12.5 11 25 15 T 50 15 T 75 15 T 100 15 T 125 15 T 150 15 T 175 15 T 200 15" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round" />
    </svg>
  </div>
</div>
<div class="rounded-2xl overflow-hidden"><Image src={IGP5740} alt="Ballena jorobada saltando cerca de un yate de Cabo Sailing" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={Cabo_Sailing_Ocean_adventures_5} alt="Whale watching from sailboat" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={family_on_board} alt="Family on board whale watching" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={IGP5743} alt="Whale spotting in Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"Vimos ballenas saltando a pocos metros. Los ninos todavia hablan de eso."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">David &amp; Lisa M. &mdash; Chicago, IL</p>
    </div>
  </div>
</div>
</div>

<!-- DESKTOP: Full-width layout -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span>Tours</span>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Avistamiento de Ballenas</span>
  </nav>
  <h2 class="text-3xl text-navy leading-tight">Cabo Sailing &amp; Whale Watching</h2>
  <p class="text-slate-700 text-lg leading-relaxed mt-2">Observa de cerca ballenas jorobadas y grises en tu propio barco privado con una tripulacion naturalista experta.</p>

  <!-- Icons row -->
  <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">3 Horas</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">water</span>
      <p class="text-sm font-semibold text-navy">Temporada Dic&ndash;Abr</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">event_available</span>
      <p class="text-sm font-semibold text-navy">Cancelaci&oacute;n Gratuita</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">family_restroom</span>
      <p class="text-sm font-semibold text-navy">Apto para Familias</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">add</span>
      <p class="text-sm font-semibold text-navy">Tiempo Extra Disponible</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">pin_drop</span>
      <p class="text-sm font-semibold text-navy">Cabo Marina, Muelle F</p>
    </div>
    <div class="flex items-center gap-2 col-span-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">MED-DIC A MED-ABR &middot; SALIDAS FLEXIBLES</p>
    </div>
  </div>

  <!-- Sobre esta experiencia -->
  <div class="mt-12">
    <h3 class="text-2xl text-navy mb-4">Sobre esta experiencia</h3>
    <p class="text-slate-700 leading-relaxed text-base">
      Cada invierno, miles de ballenas jorobadas y grises migran a las calidas aguas frente a Cabo San Lucas &mdash; y nuestros charters privados te colocan justo en su camino. Observa con asombro como estos gentiles gigantes saltan, golpean sus colas y emergen a pocos metros de la embarcaci&oacute;n. Nuestra experimentada tripulacion naturalista sabe exactamente donde encontrarlas y sigue practicas responsables de avistamiento para mantener cada encuentro seguro y respetuoso.
    </p>
  </div>

  <!-- Itinerario Sugerido timeline -->
  <div class="mt-10">
    <div class="flex items-center gap-3 mb-5">
      <div class="w-1 h-6 bg-gold rounded-full"></div>
      <h3 class="text-sm font-bold text-navy uppercase tracking-widest">Itinerario Sugerido</h3>
    </div>
    <ol class="relative border-l-2 border-gold/30 ml-2 space-y-5 pl-6">
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-base">Encuentro en la marina y aborda tu barco privado</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-base">Navega junto al Arco y la colonia de lobos marinos</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-base">Rumbo al territorio de ballenas con tu guia naturalista</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-base">Observa ballenas jorobadas y grises respirando profundamente, saltando y golpeando sus colas</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-base">Relajate a bordo con bebidas, almuerzo y vistas increibles</span></li>
    </ol>
    <p class="mt-5 text-slate-700 italic text-sm">Sin prisas. Sin guion fijo. Solo un gran momento en el agua con las ballenas.</p>
  </div>
</div>


