        <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Este fue nuestro tercer crucero compartido al atardecer con Cabo Sailing y se ha vuelto tradición cada enero. Calidad consistente cada vez. El precio es inmejorable por lo que ofrecen."</p>
        <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-navy/70 flex items-center justify-center text-white text-sm font-bold">RB</div><div><p class="text-sm font-bold text-navy">Robert B.</p><p class="text-base text-slate-500">Dallas, TX</p></div></div>
      </div>
    </div>
    <button onclick="scrollMReviews(-1)" class="hidden lg:flex absolute left-[-20px] top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-border-light shadow-md items-center justify-center hover:bg-light-grey transition-colors z-10"><span class="material-symbols-outlined text-navy text-xl">chevron_left</span></button>
    <button onclick="scrollMReviews(1)" class="hidden lg:flex absolute right-[-20px] top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border border-border-light shadow-md items-center justify-center hover:bg-light-grey transition-colors z-10"><span class="material-symbols-outlined text-navy text-xl">chevron_right</span></button>
    <div class="hidden lg:flex justify-center gap-2 mt-4">
      <button onclick="goToMPage(0)" class="m-review-dot w-2.5 h-2.5 rounded-full bg-navy transition-colors"></button>
      <button onclick="goToMPage(1)" class="m-review-dot w-2.5 h-2.5 rounded-full bg-border-light transition-colors"></button>
    </div>
  </div>
</div>


  </main>

  <Footer />
  <FloatingCTA />
  <RezdyModal />

  <script is:inline>

  function heroNav(btn, dir) {
    var wrap = btn.closest('.overflow-hidden').querySelector('.snap-x');
    if (!wrap) return;
    wrap.scrollBy({ left: dir * wrap.offsetWidth, behavior: 'smooth' });
  }

  var mPage = 0;
  function scrollMReviews(dir) {
    mPage = Math.max(0, Math.min(1, mPage + dir));
    var container = document.getElementById('m-carousel');
    var card = container.children[0];
    var gap = 24;
    container.scrollTo({ left: (card.offsetWidth + gap) * 3 * mPage, behavior: 'smooth' });
    document.querySelectorAll('.m-review-dot').forEach(function(dot, i) {
      dot.className = 'm-review-dot w-2.5 h-2.5 rounded-full transition-colors ' + (i === mPage ? 'bg-navy' : 'bg-border-light');
    });
  }
  function goToMPage(page) { mPage = page; scrollMReviews(0); }

  function fleetNav(btn, dir) {
    var wrap = btn.closest('[class*="h-["]');
    if (!wrap) wrap = btn.parentElement;
    var slides = wrap.querySelectorAll('.boat-slide');
    var current = 0;
    slides.forEach(function(s, i) { if (s.style.opacity === '1' || s.classList.contains('opacity-100')) current = i; });
    slides[current].style.opacity = '0';
    slides[current].classList.remove('opacity-100');
    var next = (current + dir + slides.length) % slides.length;
    slides[next].style.opacity = '1';
  }
  </script>
</BaseLayout>
