---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import CarouselImage from '../../components/CarouselImage.astro';
import { Image } from 'astro:assets';

import heroYachtCharter from "../../assets/images/guests-on-yachts/cabo-yacht-charter-guests-01.jpg";
import yachtCoastline from "../../assets/images/guests-on-yachts/luxury-yacht-cruising-on-sunny-coastline.png";
import familyYachtEscape from "../../assets/images/guests-on-yachts/family-enjoying-a-yacht-escape.png";
import cheersYachtRetreat from "../../assets/images/guests-on-yachts/cheers-on-a-sunny-yacht-retreat.png";
import paddleboardingCabo from "../../assets/images/guests-on-yachts/paddleboarding-in-sunny-cabo-waters.png";

import romanticSunset from "../../assets/images/guests-on-yachts/romantic-sunset-on-the-boat.png";
import celebrationYacht from "../../assets/images/bachelorette/celebration-on-a-sunny-yacht-party.png";
import yachtAtArch from "../../assets/images/boats/yacht-45/cruising-along-the-arch.jpg";
import snorkelIcon from "../../assets/icons/Snorkel 2.png";
import sunFilledBoatDay from "../../assets/images/guests-on-yachts/sun-filled-boat-day-with-friends.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Charter de Yate Privado y Renta en Cabo San Lucas",
  "description": "Charter de yate privado y renta de yate de lujo en Cabo San Lucas para familias, celebraciones y grupos. Elige entre 3 yates de lujo, con tripulación y todo incluido — bar, comida, equipo de snorkel y paddleboards.",
  "touristType": "Familias, Parejas, Grupos, Celebraciones",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/es/yacht-charter-cabo/",
    "priceCurrency": "USD",
    "lowPrice": "1148",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Renta de Yates", "item": "https://cabosailing.com/es/yacht-charter-cabo/" },
    { "@type": "ListItem", "position": 3, "name": "Charter de Yate en Cabo" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Charter de Yate en Cabo San Lucas — Renta de Yate Privado de Lujo | Cabo Sailing" description="Charter de yate privado y renta de yate de lujo en Cabo San Lucas. 3 yates de lujo, con tripulación, todo incluido — bar, comida, equipo de snorkel y paddleboards. Desde $1,148." ogImage="/og/yacht-charter-cabo.jpg" ogImageAlt="Charter de yate privado y renta de yate de lujo en Cabo San Lucas" hreflangs={{ en: '/yacht-charter-cabo', es: '/es/yacht-charter-cabo' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="fleet" />

  <style is:inline>
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={heroYachtCharter} alt="Invitados disfrutando un charter de yate privado en Cabo San Lucas" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={yachtCoastline} alt="Renta de yate de lujo en Cabo San Lucas navegando la costa" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={familyYachtEscape} alt="Familia disfrutando una renta de yate privado en Cabo" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={cheersYachtRetreat} alt="Invitados celebrando en un charter de yate de lujo en Cabo San Lucas" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={paddleboardingCabo} alt="Paddleboard en las aguas soleadas de Cabo" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"Reservamos el yate para el aniversario 40 de mis padres. Cada detalle fue perfecto — la mejor decisión del viaje."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Daniel R. &mdash; Denver, CO</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6 relative">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={heroYachtCharter} alt="Invitados disfrutando un charter de yate privado en Cabo San Lucas" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={yachtCoastline} alt="Renta de yate de lujo en Cabo San Lucas navegando la costa" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={familyYachtEscape} alt="Familia disfrutando una renta de yate privado en Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={cheersYachtRetreat} alt="Invitados celebrando en un charter de yate de lujo en Cabo San Lucas" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={paddleboardingCabo} alt="Paddleboard en las aguas soleadas de Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"Reservamos el yate para el aniversario 40 de mis padres. Cada detalle fue perfecto &mdash; la mejor decisión del viaje."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Daniel R. &mdash; Denver, CO</p>
    </div>
  </div>
</div>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold mt-4 lg:mt-6">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Ahorra hasta 40% &mdash; Tiempo Limitado</p>
</div>

<!-- DESKTOP: Title + intro -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a href="/es/yacht-charter-cabo/" class="hover:text-gold transition-colors">Renta de Yates</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Charter de Yate en Cabo</span>
  </nav>
  <h1 class="text-4xl text-navy leading-tight">Charter &amp; Renta de Yate Privado en Cabo San Lucas</h1>
  <p class="text-slate-700 text-lg leading-relaxed mt-2">Renta un yate privado o velero para tu grupo &mdash; días en familia, celebraciones, aniversarios y escapadas de grupo. Todo incluido, con tripulación, y diseñado a tu medida.</p>

  <!-- Icons row -->
  <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">3 Horas</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">add</span>
      <p class="text-sm font-semibold text-navy">Tiempo Extra Disponible</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">celebration</span>
      <p class="text-sm font-semibold text-navy">Charter Privado</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">groups</span>
      <p class="text-sm font-semibold text-navy">Hasta 20 Invitados</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">family_restroom</span>
      <p class="text-sm font-semibold text-navy">Apto para Familias</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">local_bar</span>
      <p class="text-sm font-semibold text-navy">Todo Incluido</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">event_available</span>
      <p class="text-sm font-semibold text-navy">Cancelación Gratis</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">pin_drop</span>
      <p class="text-sm font-semibold text-navy">Marina Cabo, Muelle F</p>
    </div>
  </div>

  <!-- About this experience -->
  <div class="mt-12">
    <h3 class="text-2xl text-navy mb-4">Sobre esta experiencia</h3>
    <p class="text-slate-700 leading-relaxed text-base">
      Un charter de yate privado en Cabo San Lucas es la forma más flexible y cómoda de experimentar el Mar de Cortés. Elige el yate ideal para tu grupo, dinos qué quieres hacer, y construiremos el día a tu alrededor &mdash; snorkel en Chileno o Santa Mar&iacute;a, navegar al Arco, nadar y hacer paddleboard en una cala tranquila, o celebrar un momento especial en el agua. Tripulación, combustible, barra libre premium, comida, equipo de snorkel, paddleboards, toallas y bocinas Bluetooth — todo está incluido. Solo necesitas subir a bordo.
    </p>
  </div>
</div>

<!-- MOBILE: Title + intro -->
<div class="lg:hidden mt-6 px-5">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a href="/es/yacht-charter-cabo/" class="hover:text-gold transition-colors">Renta de Yates</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Charter de Yate</span>
  </nav>
  <h1 class="text-2xl text-navy leading-tight">Charter &amp; Renta de Yate Privado en Cabo San Lucas</h1>
  <p class="text-slate-700 text-base leading-relaxed mt-2">Renta un yate privado o velero para tu grupo &mdash; días en familia, celebraciones, aniversarios y escapadas de grupo. Todo incluido, con tripulación, y diseñado a tu medida.</p>
</div>

<!-- MOBILE: Icons row -->
<div class="lg:hidden mt-5 px-5">
  <div class="grid grid-cols-2 gap-x-3 gap-y-3">
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">schedule</span><p class="text-xs font-semibold text-navy">3 Horas</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">add</span><p class="text-xs font-semibold text-navy">Tiempo Extra Disponible</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">celebration</span><p class="text-xs font-semibold text-navy">Charter Privado</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">groups</span><p class="text-xs font-semibold text-navy">Hasta 20 Invitados</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">family_restroom</span><p class="text-xs font-semibold text-navy">Apto para Familias</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">local_bar</span><p class="text-xs font-semibold text-navy">Todo Incluido</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">event_available</span><p class="text-xs font-semibold text-navy">Cancelación Gratis</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">pin_drop</span><p class="text-xs font-semibold text-navy">Marina Cabo, Muelle F</p></div>
  </div>
</div>

<!-- MOBILE: About -->
<div class="lg:hidden mt-8 px-5">
  <h3 class="text-lg text-navy mb-3">Sobre esta experiencia</h3>
  <p class="text-slate-700 leading-relaxed text-base">Un charter de yate privado en Cabo San Lucas es la forma más flexible y cómoda de experimentar el Mar de Cortés. Elige el yate ideal para tu grupo, dinos qué quieres hacer, y construiremos el día a tu alrededor &mdash; snorkel en Chileno o Santa Mar&iacute;a, navegar al Arco, nadar y hacer paddleboard en una cala tranquila, o celebrar un momento especial en el agua.</p>
</div>

<!-- ===== UNIQUE BLOCK #1: Charter for any occasion ===== -->
<div class="mt-12 lg:max-w-[1400px] lg:mx-auto lg:px-10 px-5">
  <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-3xl text-navy">Charter para cualquier ocasión</h2></div>
  <p class="text-slate-700 text-base lg:text-lg leading-relaxed mb-8 lg:max-w-3xl">Cada charter se construye alrededor de tu grupo. Así es como los invitados usan el barco con más frecuencia &mdash; elige la opción que te quede mejor y nosotros nos encargamos del resto.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <a href="/es/private-snorkeling" class="group bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5 hover:shadow-xl transition-shadow">
      <div class="h-44 overflow-hidden"><Image src={familyYachtEscape} alt="Día familiar de charter de yate en Cabo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
      <div class="p-5">
        <h3 class="text-base font-bold text-navy mb-2">Día Familiar</h3>
        <p class="text-sm text-slate-600 leading-relaxed">Bahías tranquilas, snorkel sencillo, tripulación amable con niños. Perfecto para niños y abuelos por igual.</p>
        <p class="text-xs text-accent-gold font-semibold uppercase tracking-widest mt-3 group-hover:underline">Explora snorkel familiar &rarr;</p>
      </div>
    </a>
    <a href="/es/bachelorette" class="group bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5 hover:shadow-xl transition-shadow">
      <div class="h-44 overflow-hidden"><Image src={celebrationYacht} alt="Celebración de cumpleaños y aniversario en charter de yate" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
      <div class="p-5">
        <h3 class="text-base font-bold text-navy mb-2">Celebración</h3>
        <p class="text-sm text-slate-600 leading-relaxed">Cumpleaños, aniversarios, despedidas de soltera y soltero, reuniones familiares. Tu playlist, tu decisión.</p>
        <p class="text-xs text-accent-gold font-semibold uppercase tracking-widest mt-3 group-hover:underline">Ver charters de celebración &rarr;</p>
      </div>
    </a>
    <a href="/es/private-sunset" class="group bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5 hover:shadow-xl transition-shadow">
      <div class="h-44 overflow-hidden"><Image src={romanticSunset} alt="Charter de yate al atardecer romántico para parejas" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
      <div class="p-5">
        <h3 class="text-base font-bold text-navy mb-2">Romance</h3>
        <p class="text-sm text-slate-600 leading-relaxed">Parejas, lunas de miel, propuestas. Champaña, luz de la hora dorada, y el fondo más fotogénico de Cabo.</p>
        <p class="text-xs text-accent-gold font-semibold uppercase tracking-widest mt-3 group-hover:underline">Explora cruceros al atardecer &rarr;</p>
      </div>
    </a>
    <a href="#choose-your-yacht" class="group bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5 hover:shadow-xl transition-shadow">
      <div class="h-44 overflow-hidden"><Image src={sunFilledBoatDay} alt="Grupo de amigos en un yate privado en Cabo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
      <div class="p-5">
        <h3 class="text-base font-bold text-navy mb-2">Escapada de Grupo</h3>
        <p class="text-sm text-slate-600 leading-relaxed">Viajes con amigos, retiros corporativos, fines de semana especiales. Hasta 20 invitados en nuestro yate más grande.</p>
        <p class="text-xs text-accent-gold font-semibold uppercase tracking-widest mt-3 group-hover:underline">Elige tu yate &rarr;</p>
      </div>
    </a>
  </div>
</div>

<!-- ===== Choose Your Yacht ===== -->
<div id="choose-your-yacht" class="mt-14 lg:max-w-[1400px] lg:mx-auto lg:px-10 lg:py-8 px-5">
  <div class="flex items-center gap-3 mb-8"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-2xl text-navy">Elige tu yate &mdash; listo para cualquier tamaño de grupo</h2></div>

  <!-- Luxury yachts -->
  <div class="flex flex-col gap-5 lg:grid lg:grid-cols-3 lg:max-w-[1100px] lg:mx-auto pb-8">
    <!-- Yacht 51' — Most Spacious -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-51">
      <CarouselImage type="boat" id="yacht-51" alt="Yate de Lujo 51' charter privado en Cabo">
        <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h3 class="text-white text-lg lg:text-xl">Yate de Lujo 51'</h3>
          <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Hasta 20 Invitados</span></div>
        </div>
        <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Más Espacioso</div>
        <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
      </CarouselImage>
      <div class="p-4 space-y-4">
        <p class="text-slate-700 text-sm italic text-center pb-3 border-b border-border-light/50">Ideal para grupos grandes y máximo espacio</p>
        <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-2 text-[0.9rem] lg:text-[1.05rem] font-semibold">$1,690</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$1,436</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ 1-4 invitados</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Invitados extra</span><div class="flex items-baseline gap-1"><span class="text-gold line-through text-[12px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-500 text-[11px] font-medium">/pp</span></div></div></div>
        <button type="button" onclick="openRezdyModal('165509')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer">Ver Disponibilidad</button>
      </div>
    </div>
    <!-- Yacht 45' — Most Popular -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-45">
      <CarouselImage type="boat" id="yacht-45" alt="Yate de Lujo 45' charter privado en Cabo" imgStyle="transform: none;">
        <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h3 class="text-white text-lg lg:text-xl">Yate de Lujo 45'</h3>
