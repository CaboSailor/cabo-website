---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import CarouselImage from '../../components/CarouselImage.astro';
import { Image } from 'astro:assets';

import DSC_0107_2 from "../../assets/images/bachelorette/cabo-bachelorette-boat-party-01.jpg";
import frame_grabs_yacht_30 from "../../assets/images/guests-on-yachts/cabo-yacht-charter-guests-03.jpg";
import DSC_0307_2 from "../../assets/images/bachelorette/cabo-bachelorette-boat-party-02.jpg";
import img_4k_01_41_40_08_Still129 from "../../assets/images/guests-on-sailboats/cabo-sailing-adventure-guests.jpg";
import { bachelorette as heroSunnyYachtFun } from "../../data/tour-heroes";
import celebrationSunnyYacht from "../../assets/images/bachelorette/celebration-on-a-sunny-yacht-party.png";
import funInSunAtSea from "../../assets/images/bachelorette/fun-in-the-sun-at-sea.png";
import sunshineCelebrationYacht from "../../assets/images/guests-on-sailboats/sunshine-and-celebration-on-the-yacht.png";
import joyfulSailboatAdventure from "../../assets/images/guests-on-sailboats/joyful-sailboat-adventure-by-the-coast.png";
import DSC_3713 from "../../assets/images/bachelorette/relaxing-boat-day-by-the-coast.png";
import DSC_4259_copy from "../../assets/images/bachelorette/cabo-bachelorette-group-photo.jpg";
import caboSailingLogo from "../../assets/images/cabo-sailing-logo.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Despedida de Soltera en Yate en Cabo San Lucas",
  "description": "Charters privados de yate y velero para despedidas de soltera en Cabo. Decoración personalizada, barra libre, parada de snorkel y opción al atardecer — un fin de semana inolvidable en el agua.",
  "touristType": "Despedidas de Soltera, Grupos, Celebraciones",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/es/bachelorette/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/es/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Despedida de Soltera" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Despedida de Soltera Privada en Cabo San Lucas | Cabo Sailing" description="Charters privados de yate y velero para despedidas de soltera en Cabo. Decoración personalizada, barra libre, parada de snorkel y opción al atardecer — un fin de semana inolvidable en el agua." ogImage="/og/bachelorette.jpg" ogImageAlt="Despedida de soltera en yate en Cabo San Lucas" hreflangs={{ en: '/bachelorette', es: '/es/bachelorette' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
    #rezdyModal .rezdy-modal-title .bg-gold { background-color: #E8789A !important; }
    @keyframes float-up { 0% { transform: translateY(0) rotate(0deg); opacity:0.7; } 100% { transform: translateY(-100px) rotate(360deg); opacity:0; } }
    .confetti-dot { position:absolute; border-radius:50%; animation: float-up 4s infinite; }
    .festive-divider { background: linear-gradient(90deg, transparent, #E8789A 20%, #C5A059 50%, #E8789A 80%, transparent); height: 2px; }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">


  <!-- ========== HERO ========== -->
  <div class="relative w-full h-[45vh] lg:hidden overflow-hidden">
    <div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
      <div class="flex-shrink-0 w-full h-full snap-center relative">
        <Image src={heroSunnyYachtFun} alt="Amigas divirtiéndose en un yate soleado en Cabo" class="w-full h-full object-cover" width={1200} height={750} format="png" quality={90} />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
      </div>
      <div class="flex-shrink-0 w-full h-full snap-center"><Image src={celebrationSunnyYacht} alt="Celebración en una fiesta soleada en yate en Cabo" class="w-full h-full object-cover" width={800} height={500} format="png" quality={90} /></div>
      <div class="flex-shrink-0 w-full h-full snap-center"><Image src={funInSunAtSea} alt="Diversión bajo el sol en el mar en Cabo" class="w-full h-full object-cover" width={800} height={500} format="png" quality={90} /></div>
      <div class="flex-shrink-0 w-full h-full snap-center"><Image src={sunshineCelebrationYacht} alt="Sol y celebración en el yate en Cabo" class="w-full h-full object-cover" width={800} height={500} format="png" quality={90} /></div>
      <div class="flex-shrink-0 w-full h-full snap-center"><Image src={joyfulSailboatAdventure} alt="Aventura alegre en velero por la costa de Cabo" class="w-full h-full object-cover" width={800} height={500} format="png" quality={90} /></div>
    </div>
    <div class="absolute top-4 left-4 text-white text-base font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Despedida de Soltera</div>
    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
      <div class="max-w-[360px] mx-auto text-center">
        <div class="flex items-center justify-center gap-0.5 mb-1.5">
          <span class="material-symbols-outlined text-gold filled text-lg">star</span>
          <span class="material-symbols-outlined text-gold filled text-lg">star</span>
          <span class="material-symbols-outlined text-gold filled text-lg">star</span>
          <span class="material-symbols-outlined text-gold filled text-lg">star</span>
          <span class="material-symbols-outlined text-gold filled text-lg">star</span>
        </div>
        <p class="text-white text-base leading-snug">"A las chicas les encantó cada segundo — música, tragos, vibras perfectas. La mejor fiesta de todas."</p>
        <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Amanda K. &mdash; Los Angeles, CA</p>
      </div>
    </div>
    <button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
    <button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
  </div>

  <!-- Decorative festive ribbon divider -->
  <div class="festive-divider w-full"></div>
  <div class="flex items-center justify-center py-2 bg-white text-base text-slate-500 font-medium tracking-widest gap-2 text-center">
    <span class="text-base">🥂</span>
    <span class="text-base uppercase font-bold tracking-[0.2em]" style="color:#E8789A;">Privado · Celebración · Cabo San Lucas</span>
    <span class="text-base">🥂</span>
  </div>
  <div class="festive-divider w-full"></div>

  <!-- ========== MOBILE LAYOUT ========== -->
  <div class="lg:hidden relative z-10 -mt-4 px-5">
    <div class="bg-white rounded-3xl p-6 shadow-xl shadow-navy/5 border border-border-light">
      <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
        <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span>Tours</span>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">Despedida de Soltera</span>
      </nav>
      <div class="flex flex-col gap-1 mb-6">
        <div class="flex justify-between items-start">
          <h1 class="text-2xl text-navy leading-tight">Crucero Privado de Despedida de Soltera en Cabo</h1>
          <div class="flex items-center gap-1 bg-gold/10 px-2 py-1 rounded text-gold text-sm font-bold">
            <span class="material-symbols-outlined text-[14px] filled">star</span> 5.0
          </div>
        </div>
        <!-- Pink pill badge -->
        <div class="mt-2 text-center">
          <span class="inline-block text-white text-base font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Celebración Más Popular</span>
        </div>
        <p class="text-slate-500 text-sm font-medium flex items-center gap-1 mt-2 uppercase tracking-widest">
          <span class="material-symbols-outlined text-base">location_on</span> Cabo Marina, Muelle F
        </p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-light-grey rounded-2xl p-3 flex flex-col items-center text-center border border-border-light">
          <span class="material-symbols-outlined text-gold mb-1">schedule</span>
          <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-0.5">Duración</p>
          <p class="text-sm font-bold text-navy">3 Horas</p>
        </div>
        <div class="bg-light-grey rounded-2xl p-3 flex flex-col items-center text-center border border-border-light">
          <span class="material-symbols-outlined mb-1" style="color:#E8789A;">celebration</span>
          <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-0.5">Grupo</p>
          <p class="text-sm font-bold text-navy">Charter Privado</p>
        </div>
        <div class="bg-light-grey rounded-2xl p-3 flex flex-col items-center text-center border border-border-light">
          <span class="material-symbols-outlined text-gold mb-1">groups</span>
          <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-0.5">Capacidad</p>
          <p class="text-sm font-bold text-navy">Hasta 14</p>
        </div>
        <div class="bg-light-grey rounded-2xl p-3 flex flex-col items-center text-center border border-border-light">
          <span class="material-symbols-outlined text-gold filled mb-1">star</span>
          <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-0.5">Calificación</p>
          <p class="text-sm font-bold text-navy">5.0 / 5.0</p>
        </div>
      </div>
      <div class="mt-6 pt-6 border-t border-border-light">
        <input class="hidden" id="highlights-toggle" type="checkbox"/>
        <label class="flex items-center justify-between cursor-pointer group" for="highlights-toggle">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-full" style="background-color:#E8789A20;"><span class="material-symbols-outlined text-xl" style="color:#E8789A;">celebration</span></div>
            <span class="text-base font-semibold text-navy">Elige Tu Vibra</span>
          </div>
          <span class="material-symbols-outlined text-slate-300 chevron-icon transition-transform">chevron_right</span>
        </label>
        <div class="max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-in-out" id="highlights-content">
          <div class="space-y-4">
            <div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">🎉 El Crucero Fiesta</h3><p class="text-sm text-slate-500 leading-relaxed">Música fuerte, mucha energía, baile y bebidas sin parar. Perfecto si tu grupo quiere una celebración divertida y animada.</p></div>
            <div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">🌅 La Vibra del Atardecer</h3><p class="text-sm text-slate-500 leading-relaxed">Hora dorada, energía relajada, fotos increíbles. Ideal para una experiencia más elegante y hermosa.</p></div>
            <div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">🥂 El Día Chill de Lujo</h3><p class="text-sm text-slate-500 leading-relaxed">Nada, flota, paddleboard, saborea y relájate. Gran mezcla de diversión y relax.</p></div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <h3 class="text-lg text-navy mb-3">Por Qué Esta Es La Indicada</h3>
      <p class="text-slate-500 leading-relaxed text-base font-semibold mb-3" style="color:#E8789A;">Esto no es solo un paseo en barco — es tu evento principal.</p>
      <p class="text-slate-500 leading-relaxed text-base">Imagina esto: música sonando, bebidas fluyendo, tu grupo riendo en cubierta… el Arco de fondo, tu coctel favorito en mano, y cero estrés por la logística. Celebra a la futura novia en un yate privado con barra libre, excelente comida y las vistas más icónicas de Cabo. Sin multitudes, sin estrés, solo tu grupo y un día perfecto en el agua. Nosotros nos encargamos de todo — tú solo llegas y disfrutas.</p>
    </div>

    <div class="mt-10">
      <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 rounded-full" style="background-color:#E8789A;"></div><h3 class="text-lg text-navy">Qué Incluye</h3></div>
      <div class="grid grid-cols-1 gap-5 pl-1">
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Tu propio barco privado</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Coordinador de crucero dedicado</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Comida deliciosa y snacks</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Toallas</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Tripulación bilingüe con experiencia</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Barra libre (cocteles, cerveza, tequila)</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Equipo de snorkel y paddleboard</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Tapete acuático (en yates)</span></div>
        <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8789A;"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Sistema de sonido Bluetooth</span></div>
      </div>
    </div>

    <div class="mt-10 rounded-3xl p-6 border border-border-light" style="background:linear-gradient(135deg,#0A1D37,#1a3a6b);">
      <div class="flex items-center gap-3 mb-4"><span class="material-symbols-outlined text-gold text-2xl">pin_drop</span><h3 class="text-lg text-white">Punto de Encuentro</h3></div>
      <p class="text-white/70 text-base leading-relaxed">Cabo Marina, Muelle F. Busca al equipo de Cabo Sailing con camisas doradas. Por favor llega 15 minutos antes de la salida.</p>
      <div class="mt-4 flex items-center gap-2 text-sm font-bold uppercase tracking-widest" style="color:#C5A059;"><span class="material-symbols-outlined text-base">schedule</span>Salidas: 10:00 AM o 4:00 PM diario</div>
    </div>

    <div class="mt-12 px-0">
      <div class="flex items-center gap-3 mb-8"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg lg:text-2xl text-navy">Explora nuestros barcos — encuentra el ideal para tu experiencia única de despedida de soltera</h3></div>
      <div class="flex flex-col gap-5 lg:grid lg:grid-cols-3 lg:max-w-[1100px] lg:mx-auto pb-8">
        <!-- Yacht 51' -->
        <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-51">
          <CarouselImage type="boat" id="yacht-51" alt="Yate de Lujo 51' charter privado de despedida de soltera">
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
            <div class="absolute bottom-5 left-6"><h3 class="text-white text-lg lg:text-xl">Yate de Lujo 51'</h3><div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Hasta 20 Invitadas</span></div></div>
            <div class="absolute top-4 right-4 text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Espacioso</div>

          <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
</CarouselImage>
          <div class="p-4 space-y-4">
      <p class="text-slate-500 text-sm italic text-center pb-3 border-b border-border-light/50">Ideal para grupos grandes y máximo espacio</p>
            <div class="space-y-4">
              <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-1 text-[0.9rem] lg:text-[1.05rem] font-semibold">$1,690</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$1,436</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ 1-4 invitadas</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Invitadas extra</span><div class="flex items-baseline gap-1"><span class="text-gold line-through text-[12px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-500 text-[11px] font-medium">/pp</span></div></div></div>
            </div>
            <button type="button" onclick="openRezdyModal('165509')" class="block w-full text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer" style="background-color:#E8789A;">Consultar Disponibilidad</button>
          </div>
        </div>
        <!-- Yacht 45' -->
        <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-45">
          <CarouselImage type="boat" id="yacht-45" alt="Yate de Lujo 45' charter privado de despedida de soltera" imgStyle="transform: none;">
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
            <div class="absolute bottom-5 left-6"><h3 class="text-white text-lg lg:text-xl">Yate de Lujo 45'</h3><div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Hasta 12 Invitadas</span></div></div>
            <div class="absolute top-4 right-4 text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest" style="background-color:#E8789A;">Popular</div>

          <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
</CarouselImage>
          <div class="p-4 space-y-4">
      <p class="text-slate-500 text-sm italic text-center pb-3 border-b border-border-light/50">Diseño moderno y experiencia cómoda en el mar.</p>
            <div class="space-y-4">
              <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-1 text-[0.9rem] lg:text-[1.05rem] font-semibold">$1,520</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$1,292</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ 1-4 invitadas</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Invitadas extra</span><div class="flex items-baseline gap-1"><span class="text-gold line-through text-[12px]">$100</span><span class="text-navy font-bold text-base">$85</span><span class="text-slate-500 text-[11px] font-medium">/pp</span></div></div></div>
            </div>
            <button type="button" onclick="openRezdyModal('528988')" class="block w-full text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer" style="background-color:#E8789A;">Consultar Disponibilidad</button>
          </div>
        </div>
        <!-- Yacht 42' -->
        <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-42">
          <CarouselImage type="boat" id="yacht-42" alt="Yate de Lujo 42' charter privado de despedida de soltera">
