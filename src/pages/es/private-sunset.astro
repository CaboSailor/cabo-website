---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Crucero Privado al Atardecer en Cabo San Lucas | Cabo Sailing" description="Crucero privado al atardecer en yate o velero, hasta 12 personas. Barra libre, snacks y vista al Arco de Cabo San Lucas." ogImage="/og/private-sunset.jpg" ogImageAlt="Private sunset sailing at the Arch of Cabo San Lucas" hreflangs={{ en: '/private-sunset', es: '/es/private-sunset' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar" id="hero-scroll">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_35mm_226_topaz_sharpen_exposure} alt="Guests toasting at sunset near El Arco" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_4k_01_49_05_19_Still141} alt="Happy guests at golden hour" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_20mm_483_topaz_sharpen_exposure} alt="Motor yacht at golden hour" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={Header_Sunset_3} alt="Couples with Cabo Arch at sunset" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_20_Sailing_42} alt="Couple watching sunset on sailboat" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"The sunset was unreal. Drinks flowing, perfect vibes — our favorite night in Cabo."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Lauren &amp; Jake M. &mdash; Denver, CO</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_35mm_226_topaz_sharpen_exposure} alt="Guests toasting at sunset near El Arco" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={img_4k_01_49_05_19_Still141} alt="Happy guests at golden hour" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={img_31_03_25_Gil_airbnb_shoot_photos_20mm_33_topaz_sharpen_exposure} alt="Woman at bow with El Arco" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={Header_Sunset_3} alt="Couples with Cabo Arch at sunset" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={img_20_Sailing_42} alt="Couple watching sunset on sailboat" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"The sunset was unreal. Drinks flowing, perfect vibes — our favorite night in Cabo."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Lauren &amp; Jake M. &mdash; Denver, CO</p>
    </div>
  </div>
</div>
</div>

<!-- DESKTOP: Full-width layout -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <div>
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
      <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span>Tours</span>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-navy font-semibold">Atardecer Privado</span>
    </nav>
    <div class="mb-2">
      <h1 class="text-4xl text-navy leading-tight">Crucero Privado al Atardecer en Cabo</h1>
    </div>
    <p class="text-slate-500 text-base leading-relaxed mt-4">Una forma relajada y hermosa de experimentar lo mejor de Cabo.</p>
    <p class="text-slate-500 text-sm font-medium flex items-center gap-1 mt-3 uppercase tracking-widest">
      <span class="material-symbols-outlined text-base">location_on</span> Land's End, Cabo San Lucas
    </p>

    <!-- Badges row -->
    <div class="flex gap-4 mt-8">
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">schedule</span>
        <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-1">Duracion</p>
        <p class="text-base font-bold text-navy">3 Horas</p>
        <p class="text-xs text-slate-500 mt-0.5">Tiempo extra disponible</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">wb_twilight</span>
        <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-1">Tipo</p>
        <p class="text-base font-bold text-navy">Atardecer</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">favorite</span>
        <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-1">Ocasion</p>
        <p class="text-base font-bold text-navy">Romantico</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">event_available</span>
        <p class="text-xs text-slate-500 uppercase font-bold tracking-widest mb-1">Cancelacion Gratuita</p>
        <p class="text-base font-bold text-navy">Hasta 24h</p>
      </div>
    </div>

    <!-- About + Que Incluye (left) / Punto de Encuentro (right) -->
    <div class="mt-10 flex gap-12">
      <!-- Left column: About + Que Incluye stacked -->
      <div class="flex-1">
        <h3 class="text-2xl text-navy mb-4">Sobre esta experiencia</h3>
        <p class="text-slate-500 leading-relaxed text-base">
          Vive la magia de la hora dorada en el Pacifico con un charter privado al atardecer. Navega por la impresionante costa de Cabo San Lucas mientras el cielo se ilumina en brillantes naranjas y rosas — el escenario perfecto para el romance, la celebracion o simplemente relajarse con estilo.
        </p>

        <!-- La Experiencia timeline -->
        <div class="mt-8">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-1 h-6 bg-gold rounded-full"></div>
            <h3 class="text-sm font-bold text-navy uppercase tracking-widest">La Experiencia</h3>
          </div>
          <ol class="relative border-l-2 border-gold/30 ml-2 space-y-5 pl-6">
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-base">Encuentro en la marina</span></li>
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-base">Navega por los puntos destacados de Cabo (Arco, lobos marinos, playas)</span></li>
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-base">Acomodate para las mejores vistas mientras el sol comienza a bajar</span></li>
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-base">Disfruta la hora dorada con bebidas y aperitivos</span></li>
            <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-base">Contempla el atardecer sobre el Pacifico, luego regresa navegando por la costa</span></li>
          </ol>
          <p class="mt-5 text-slate-500 italic text-sm">Sin prisas. Sin guion fijo. Solo un momento relajado y hermoso en el agua.</p>
        </div>

        <!-- Que Incluye -->
        <div class="mt-10">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1 h-6 bg-gold rounded-full"></div>
            <h3 class="text-2xl text-navy">Que Incluye</h3>
          </div>
          <div class="grid grid-cols-2 gap-5 pl-1">
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">local_bar</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Barra libre</span>
                <p class="text-slate-500 text-sm">Bebidas premium durante todo el crucero</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">restaurant</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Aperitivos a bordo</span>
                <p class="text-slate-500 text-sm">Snacks frescos para disfrutar mientras cae el sol</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">wb_twilight</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Experiencia privada al atardecer</span>
                <p class="text-slate-500 text-sm">Vistas de primera fila del atardecer mas iconico de Cabo</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">sailing</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Yate o velero privado</span>
                <p class="text-slate-500 text-sm">Solo tu grupo a bordo — sin compartir</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">music_note</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Sistema de musica Bluetooth</span>
                <p class="text-slate-500 text-sm">Pon tu propia musica para la velada</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-white text-[14px]">person</span>
              </div>
              <div>
                <span class="text-slate-600 text-base font-medium">Tripulacion bilingue con experiencia</span>
                <p class="text-slate-500 text-sm">Profesional, amigable y con seguridad ante todo</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right column: Punto de Encuentro -->
      <div class="w-[380px] flex-shrink-0">
        <div class="sticky top-[90px] bg-light-grey rounded-2xl p-8 border border-border-light">
          <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-outlined text-gold text-2xl">pin_drop</span>
            <h3 class="text-lg font-bold text-navy uppercase tracking-wider">Punto de Encuentro</h3>
          </div>
          <p class="text-lg font-semibold text-navy mb-1">Cabo San Lucas Marina, Dock F</p>
          <p class="text-sm text-slate-500 leading-relaxed mb-4">Busca al equipo de Cabo Sailing con polos negros y nuestro logo. Por favor llega 15 minutos antes de la salida.</p>
          <div class="flex items-center gap-2 text-sm text-slate-500">
            <span class="material-symbols-outlined text-gold text-base">schedule</span>
            <span class="font-semibold text-navy">SALIDAS: 4:00 PM (Invierno) y 4:30 PM (Verano) DIARIO</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MOBILE: Original card layout -->
