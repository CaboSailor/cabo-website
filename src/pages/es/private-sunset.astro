---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import CarouselImage from '../../components/CarouselImage.astro';
import { Image } from 'astro:assets';

import { privateSunset as heroRomanticSunset } from "../../data/tour-heroes";
import yachtGuestsRelaxing from "../../assets/images/guests-on-yachts/cabo-yacht-guests-relaxing.jpg";
import familyYachtEscape from "../../assets/images/guests-on-yachts/family-enjoying-a-yacht-escape.png";
import relaxingSunnyYacht from "../../assets/images/guests-on-yachts/relaxing-on-a-sunny-yacht.png";
import familyFunSunnySailboat from "../../assets/images/guests-on-sailboats/family-fun-on-a-sunny-sailboat.png";
import landsEndGoldenHour from "../../assets/images/guests-on-yachts/luxury-yacht-cruising-on-sunny-waters.png";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Crucero Privado al Atardecer" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Crucero Privado al Atardecer en Cabo San Lucas | Cabo Sailing" description="Crucero privado al atardecer en yate o velero, hasta 12 personas. Barra libre, snacks y vista al Arco de Cabo San Lucas." ogImage="/og/private-sunset.jpg" ogImageAlt="Private sunset sailing at the Arch of Cabo San Lucas" hreflangs={{ en: '/private-sunset', es: '/es/private-sunset' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar" id="hero-scroll">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={heroRomanticSunset} alt="Atardecer romántico en yate privado en Cabo" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={yachtGuestsRelaxing} alt="Huéspedes relajándose en la proa del yate" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={familyYachtEscape} alt="Familia disfrutando de una escapada en yate cerca de El Arco" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={relaxingSunnyYacht} alt="Huéspedes relajándose en un yate soleado" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={familyFunSunnySailboat} alt="Familia divirtiéndose en un velero soleado" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"El atardecer fue irreal. Bebidas sin parar, ambiente perfecto — nuestra noche favorita en Cabo."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Lauren &amp; Jake M. &mdash; Denver, CO</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={heroRomanticSunset} alt="Atardecer romántico en yate privado en Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={yachtGuestsRelaxing} alt="Huéspedes relajándose en la proa del yate" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={familyYachtEscape} alt="Familia disfrutando de una escapada en yate cerca de El Arco" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={relaxingSunnyYacht} alt="Huéspedes relajándose en un yate soleado" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={familyFunSunnySailboat} alt="Familia divirtiéndose en un velero soleado" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"El atardecer fue irreal. Bebidas sin parar, ambiente perfecto — nuestra noche favorita en Cabo."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Lauren &amp; Jake M. &mdash; Denver, CO</p>
    </div>
  </div>
</div>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold mt-4 lg:mt-6">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Ahorra hasta 40% off &mdash; Tiempo Limitado</p>
</div>

<!-- DESKTOP: Full-width layout -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span>Tours</span>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Atardecer Privado</span>
  </nav>
  <h1 class="text-4xl text-navy leading-tight">Crucero Privado al Atardecer en Cabo</h1>
  <p class="text-slate-700 text-lg leading-relaxed mt-2">Una forma relajada y hermosa de experimentar Cabo en la hora dorada &mdash; navega por Land's End en tu propio yate o velero privado.</p>

  <!-- Icons row -->
  <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">3 Horas</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">wb_twilight</span>
      <p class="text-sm font-semibold text-navy">Crucero al Atardecer</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">event_available</span>
      <p class="text-sm font-semibold text-navy">Cancelaci&oacute;n Gratuita</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">favorite</span>
      <p class="text-sm font-semibold text-navy">Vibras Rom&aacute;nticas</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">add</span>
      <p class="text-sm font-semibold text-navy">Tiempo Extra Disponible</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">pin_drop</span>
      <p class="text-sm font-semibold text-navy">Cabo Marina, Muelle F</p>
    </div>
    <div class="flex items-center gap-2 col-span-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">SALIDAS 4:00 PM (INVIERNO) Y 4:15 PM (VERANO) DIARIO</p>
    </div>
  </div>

  <!-- Sobre esta experiencia -->
  <div class="mt-12">
    <h3 class="text-2xl text-navy mb-4">Sobre esta experiencia</h3>
    <p class="text-slate-700 leading-relaxed text-base">
      Vive la magia de la hora dorada en el Pacifico con un charter privado al atardecer. Navega por la impresionante costa de Cabo San Lucas mientras el cielo se ilumina en brillantes naranjas y rosas &mdash; el escenario perfecto para el romance, la celebracion o simplemente relajarse con estilo.
    </p>
  </div>

  <!-- Itinerario Sugerido timeline -->
  <div class="mt-10">
    <div class="flex items-center gap-3 mb-5">
      <div class="w-1 h-6 bg-gold rounded-full"></div>
      <h3 class="text-sm font-bold text-navy uppercase tracking-widest">Itinerario Sugerido</h3>
    </div>
    <ol class="relative border-l-2 border-gold/30 ml-2 space-y-5 pl-6">
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-base">Encuentro en la marina</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-base">Navega por los puntos destacados de Cabo (Arco, lobos marinos, playas)</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-base">Acomodate para las mejores vistas mientras el sol comienza a bajar</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-base">Disfruta la hora dorada con bebidas y aperitivos</span></li>
      <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-base">Contempla el atardecer sobre el Pacifico, luego regresa navegando por la costa</span></li>
    </ol>
    <p class="mt-5 text-slate-700 italic text-sm">Sin prisas. Sin guion fijo. Solo un momento relajado y hermoso en el agua.</p>
  </div>
</div>


