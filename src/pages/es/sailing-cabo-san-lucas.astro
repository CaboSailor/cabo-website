---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import CarouselImage from '../../components/CarouselImage.astro';
import WhaleFlukeIcon from '../../components/WhaleFlukeIcon.astro';
import Video from '../../components/Video.astro';
import { Image, getImage } from 'astro:assets';

import sailingPosterSource from "../../assets/images/guests-on-sailboats/luxury-sailboat-in-tropical-waters.png";

import heroSailingCoastline from "../../assets/images/guests-on-sailboats/sailing-near-cabos-rocky-coastline.png";
import sailingCalmWaters from "../../assets/images/guests-on-sailboats/sailing-on-the-calm-ocean-waters.png";
import goldenHourSailing from "../../assets/images/guests-on-sailboats/golden-hour-sailing-with-friends.png";
import sailingHorizon from "../../assets/images/guests-on-sailboats/sailing-into-the-sunny-horizon.png";
import sailingSnorkelTour from "../../assets/images/guests-on-sailboats/cabo-sailing-snorkeling-tour.jpg";

import sailboatsPelicansRock from "../../assets/images/blog/sailboats-passing-by-pelicans-rock.png";
import snorkelIcon from "../../assets/icons/Snorkel 2.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Navegar en Cabo San Lucas — Cruceros en Velero y Charters Privados",
  "description": "Navegación real en Cabo San Lucas — cruceros en velero compartidos desde $102 por persona y charters de velero privados desde $701. Barra libre, comida, equipo de snorkel, salidas diarias desde Marina Cabo.",
  "touristType": "Parejas, Familias, Viajeros Solos, Grupos",
  "provider": {
    "@type": "TravelAgency",
    "@id": "https://cabosailing.com/#organization"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/es/sailing-cabo-san-lucas/",
    "priceCurrency": "USD",
    "lowPrice": "102",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Renta de Yates", "item": "https://cabosailing.com/es/yacht-charter-cabo/" },
    { "@type": "ListItem", "position": 3, "name": "Navegar en Cabo San Lucas" }
  ]
});

const sailingPoster = await getImage({
  src: sailingPosterSource,
  width: 1280,
  format: 'webp',
  quality: 80,
});
const sailingPosterAbsUrl = new URL(sailingPoster.src, Astro.site).href;

const videoSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Navegación Real en Cabo San Lucas — Cruceros en Velero Compartidos y Privados",
  "description": "Navegación real en Cabo San Lucas a bordo de nuestros veleros de 38' y 42'. Cruceros compartidos desde $102 por persona y charters privados desde $701 — salidas diarias desde Marina Cabo.",
  "thumbnailUrl": sailingPosterAbsUrl,
  "uploadDate": "2026-05-24",
  "duration": "PT1M8S",
  "contentUrl": "https://www.youtube.com/watch?v=Zx7KO9vSCEs",
  "embedUrl": "https://www.youtube.com/embed/Zx7KO9vSCEs",
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "Cabo Sailing Ocean Adventures",
    "logo": { "@type": "ImageObject", "url": "https://cabosailing.com/og/home.jpg" }
  }
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Navegar en Cabo San Lucas — Cruceros en Velero | Cabo Sailing" description="Navegar en Cabo San Lucas — cruceros en velero compartidos desde $102/persona y charters privados desde $701. Navegación real, todo incluido, salidas diarias desde Marina Cabo." ogImage="/og/sailing-cabo-san-lucas.jpg" ogImageAlt="Navegar en Cabo San Lucas — cruceros en velero y charters privados" hreflangs={{ en: '/sailing-cabo-san-lucas', es: '/es/sailing-cabo-san-lucas' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <script slot="head" type="application/ld+json" set:html={videoSchema} />
  <Header variant="subpage" activePage="fleet" />

  <style is:inline>
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={heroSailingCoastline} alt="Navegando en Cabo San Lucas por la costa rocosa" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sailingCalmWaters} alt="Navegando en aguas tranquilas de Cabo San Lucas" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={goldenHourSailing} alt="Navegación al atardecer en Cabo San Lucas — hora dorada con amigos" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sailingHorizon} alt="Navegando hacia el horizonte soleado de Cabo" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sailingSnorkelTour} alt="Snorkel y navegación en Cabo San Lucas — invitados haciendo snorkel desde el velero" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/20 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"La noche más mágica de nuestro viaje a Cabo. Velas arriba, el sol bajando, sin ruido de motor — solo el viento y el agua."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Laura &amp; Mark T. &mdash; Vancouver, BC</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6 relative">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={heroSailingCoastline} alt="Navegando en Cabo San Lucas por la costa rocosa" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={sailingCalmWaters} alt="Navegando en aguas tranquilas de Cabo San Lucas" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={goldenHourSailing} alt="Navegación al atardecer en Cabo San Lucas — hora dorada con amigos" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={sailingHorizon} alt="Navegando hacia el horizonte soleado de Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={sailingSnorkelTour} alt="Snorkel y navegación en Cabo San Lucas — invitados haciendo snorkel desde el velero" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"La noche más mágica de nuestro viaje a Cabo. Velas arriba, el sol bajando, sin ruido de motor &mdash; solo el viento y el agua."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Laura &amp; Mark T. &mdash; Vancouver, BC</p>
    </div>
  </div>
</div>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold mt-4 lg:mt-6">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Ahorra hasta 40% &mdash; Tiempo Limitado</p>
</div>

<!-- DESKTOP: Title + intro -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a href="/es/yacht-charter-cabo/" class="hover:text-gold transition-colors">Renta de Yates</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Navegar en Cabo San Lucas</span>
  </nav>
  <h1 class="text-4xl text-navy leading-tight">Navegar en Cabo San Lucas &mdash; Cruceros en Velero y Charters Privados</h1>
  <p class="text-slate-700 text-lg leading-relaxed mt-2">Navegación real en veleros de verdad &mdash; cruceros compartidos con nuevos amigos o charters privados donde el barco es tuyo. Todo incluido, salidas diarias desde Marina Cabo.</p>

  <!-- Icons row -->
  <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">3 Horas</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">wb_sunny</span>
      <p class="text-sm font-semibold text-navy">Salidas en la Mañana, Mediodía y Atardecer</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">sailing</span>
      <p class="text-sm font-semibold text-navy">Navegación Real</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">groups</span>
      <p class="text-sm font-semibold text-navy">Hasta 14 Invitados</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">family_restroom</span>
      <p class="text-sm font-semibold text-navy">Apto para Familias</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">local_bar</span>
      <p class="text-sm font-semibold text-navy">Todo Incluido</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">event_available</span>
      <p class="text-sm font-semibold text-navy">Cancelación Gratis</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">pin_drop</span>
      <p class="text-sm font-semibold text-navy">Marina Cabo, Muelle F</p>
    </div>
  </div>

  <!-- About this experience -->
  <div class="mt-12">
    <h3 class="text-2xl text-navy mb-4">Sobre esta experiencia</h3>
    <p class="text-slate-700 leading-relaxed text-base">
      Navegar en Cabo San Lucas es un día diferente en el agua. El motor está apagado. Las velas están arriba. Escuchas el viento y el agua, no un diésel. Operamos la flota de veleros de Cabo con tres formas de subir a bordo &mdash; un crucero compartido en velero para viajeros solos y grupos pequeños, y dos veleros privados (42' y 38') para grupos que quieren todo el barco. Cada viaje navega por Land's End y el Arco, hace snorkel en Pelican Rock, e incluye barra libre, comida fresca, equipo de snorkel, toallas, bocinas Bluetooth y una tripulación bilingüe. Tres horas estándar; extiende por hora para un día más largo.
    </p>
  </div>
</div>

<!-- MOBILE: Title + intro -->
<div class="lg:hidden mt-6 px-5">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a href="/es/yacht-charter-cabo/" class="hover:text-gold transition-colors">Renta de Yates</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Navegar en Cabo</span>
  </nav>
  <h1 class="text-2xl text-navy leading-tight">Navegar en Cabo San Lucas &mdash; Cruceros en Velero y Charters Privados</h1>
  <p class="text-slate-700 text-base leading-relaxed mt-2">Navegación real en veleros de verdad &mdash; cruceros compartidos con nuevos amigos o charters privados donde el barco es tuyo. Todo incluido, salidas diarias desde Marina Cabo.</p>
</div>

<!-- MOBILE: Icons row -->
<div class="lg:hidden mt-5 px-5">
  <div class="grid grid-cols-2 gap-x-3 gap-y-3">
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">schedule</span><p class="text-xs font-semibold text-navy">3 Horas</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">wb_sunny</span><p class="text-xs font-semibold text-navy">Salidas en la Mañana, Mediodía y Atardecer</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">sailing</span><p class="text-xs font-semibold text-navy">Navegación Real</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">groups</span><p class="text-xs font-semibold text-navy">Hasta 14 Invitados</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">family_restroom</span><p class="text-xs font-semibold text-navy">Apto para Familias</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">local_bar</span><p class="text-xs font-semibold text-navy">Todo Incluido</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">event_available</span><p class="text-xs font-semibold text-navy">Cancelación Gratis</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">pin_drop</span><p class="text-xs font-semibold text-navy">Marina Cabo, Muelle F</p></div>
  </div>
</div>

<!-- MOBILE: About -->
<div class="lg:hidden mt-8 px-5">
  <h3 class="text-lg text-navy mb-3">Sobre esta experiencia</h3>
  <p class="text-slate-700 leading-relaxed text-base">Navegar en Cabo San Lucas es un día diferente en el agua. El motor está apagado. Las velas están arriba. Escuchas el viento y el agua, no un diésel. Operamos la flota de veleros de Cabo con tres formas de subir a bordo &mdash; un crucero compartido en velero para viajeros solos y grupos pequeños, y dos veleros privados (42' y 38') para grupos que quieren todo el barco.</p>
</div>

<!-- ===== UNIQUE BLOCK #1: Why sail instead of motor ===== -->
<div class="mt-12 lg:max-w-[1400px] lg:mx-auto lg:px-10 px-5">
  <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-3xl text-navy">Por qué navegar en velero y no en motor</h2></div>
  <p class="text-slate-700 text-base lg:text-lg leading-relaxed mb-8 lg:max-w-3xl">Un velero no es un yate a motor con un mástil decorativo. Cabo Sailing es una verdadera flota de veleros &mdash; aquí está por qué los invitados nos eligen sobre un charter a motor.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-light-grey rounded-2xl p-6 border border-border-light">
      <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center mb-4"><span class="material-symbols-outlined text-white text-2xl">volume_off</span></div>
      <h3 class="text-base font-bold text-navy mb-2">Silencioso</h3>
      <p class="text-sm text-slate-600 leading-relaxed">Sin zumbido del motor. Escucha el océano, el viento y tu grupo &mdash; la forma en que Cabo debe experimentarse.</p>
    </div>
    <div class="bg-light-grey rounded-2xl p-6 border border-border-light">
      <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center mb-4"><span class="material-symbols-outlined text-white text-2xl">eco</span></div>
      <h3 class="text-base font-bold text-navy mb-2">Ecológico</h3>
      <p class="text-sm text-slate-600 leading-relaxed">Cuando el viento coopera, navegamos solo con velas. Cero emisiones, cero ruido, cero combustible.</p>
    </div>
    <div class="bg-light-grey rounded-2xl p-6 border border-border-light">
      <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center mb-4"><span class="material-symbols-outlined text-white text-2xl">sailing</span></div>
      <h3 class="text-base font-bold text-navy mb-2">Navegación real</h3>
      <p class="text-sm text-slate-600 leading-relaxed">Veleros auténticos y tripulación de navegantes reales &mdash; no lanchas a motor con velas decorativas. El viento hace el trabajo.</p>
    </div>
    <div class="bg-light-grey rounded-2xl p-6 border border-border-light">
      <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center mb-4"><span class="material-symbols-outlined text-white text-2xl">favorite</span></div>
      <h3 class="text-base font-bold text-navy mb-2">Romántico</h3>
      <p class="text-sm text-slate-600 leading-relaxed">Ritmo más lento, luz dorada, el barco inclinándose suavemente. Lunas de miel, aniversarios, momentos tranquilos.</p>
    </div>
  </div>
</div>

<!-- ===== Video promocional ===== -->
<section class="mt-14 px-5 lg:max-w-[1100px] lg:mx-auto lg:px-10">
  <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-3xl text-navy">Mira cómo se vive navegar en Cabo</h2></div>
  <Video
    videoId="Zx7KO9vSCEs"
    title="Navegación Real en Cabo San Lucas — Cruceros en Velero Compartidos y Privados"
    poster={sailingPoster.src}
  />
  <p class="text-sm text-slate-500 text-center mt-3 italic">Filmado a bordo de nuestros veleros de 38' y 42' frente a Cabo San Lucas.</p>
</section>

<!-- ===== Choose your sailing experience ===== -->
<div id="choose-your-sailing" class="mt-14 lg:max-w-[1400px] lg:mx-auto lg:px-10 lg:py-8 px-5">
  <div class="flex items-center gap-3 mb-8"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-2xl text-navy">Elige tu experiencia en velero</h2></div>

  <div class="flex flex-col gap-5 lg:grid lg:grid-cols-3 lg:max-w-[1100px] lg:mx-auto pb-8">
    <!-- Shared Sailing Cruise -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="shared-sailing">
      <CarouselImage type="boat" id="shared-sailing" alt="Crucero compartido en velero en Cabo San Lucas">
        <div class="absolute inset-0 bg-gradient-to-t from-navy/25 via-navy/5 to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h3 class="text-white text-lg lg:text-xl">Crucero Compartido en Velero</h3>
          <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Grupo mixto, hasta 14</span></div>
        </div>
        <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Mejor Valor</div>
        <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-15%</div>
      </CarouselImage>
      <div class="p-4 space-y-4">
        <p class="text-slate-700 text-sm italic text-center pb-3 border-b border-border-light/50">Ambiente social &mdash; viajeros solos y grupos pequeños</p>
        <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-2 text-[0.9rem] lg:text-[1.05rem] font-semibold">$120</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$102</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ persona</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Salidas</span><span class="text-navy font-bold text-sm">9:00 AM diario</span></div></div>
        <button type="button" onclick="openRezdyModal('744011')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer">Ver Disponibilidad</button>
      </div>
    </div>
    <!-- Private Sailing 42' -->
