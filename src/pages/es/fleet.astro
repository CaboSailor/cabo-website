  <script is:inline>
    function switchTab(tab) {
      var isPrivate = tab === 'private';
      document.getElementById('toggle-indicator').style.left = isPrivate ? '4px' : '50%';
      document.getElementById('btn-private').className = 'flex-1 relative z-10 py-3 text-center font-bold text-sm uppercase tracking-wide ' + (isPrivate ? 'text-white' : 'text-navy/60 font-semibold');
      document.getElementById('btn-shared').className = 'flex-1 relative z-10 py-3 text-center font-bold text-sm uppercase tracking-wide ' + (!isPrivate ? 'text-white' : 'text-navy/60 font-semibold');
      document.getElementById('private-content').classList.toggle('hidden', !isPrivate);
      document.getElementById('shared-content').classList.toggle('hidden', isPrivate);
    }

    // Fleet boat card arrow navigation
    function fleetNav(btn, dir) {
      var wrap = btn.parentElement.querySelector('.boat-carousel');
      if (!wrap) {
        wrap = btn.closest('.h-\\[480px\\]') || btn.closest('[class*="h-["]');
        if (!wrap) wrap = btn.parentElement;
      }
      var slides = wrap.querySelectorAll('.boat-slide');
      var current = 0;
      slides.forEach(function(s, i) { if (s.style.opacity === '1' || s.classList.contains('opacity-100')) current = i; });
      slides[current].style.opacity = '0';
      slides[current].classList.remove('opacity-100');
      var next = (current + dir + slides.length) % slides.length;
      slides[next].style.opacity = '1';
    }

    // Touch swipe support for boat carousels
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.boat-carousel').forEach(function(carousel) {
        var startX = 0;
        carousel.addEventListener('touchstart', function(e) {
          startX = e.touches[0].clientX;
        }, { passive: true });
        carousel.addEventListener('touchend', function(e) {
          var diff = startX - e.changedTouches[0].clientX;
          if (Math.abs(diff) > 50) {
            var card = carousel.closest('[class*="h-["]');
            if (!card) return;
            var btn = card.querySelector('.fleet-arrow.right');
            if (diff < 0) btn = card.querySelector('.fleet-arrow.left');
            if (btn) btn.click();
          }
        }, { passive: true });
      });
    });
  </script>
