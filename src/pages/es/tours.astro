---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import { Image } from 'astro:assets';

// Tour card images
import {
  privateSnorkeling as privateSnorkelingImg,
  privateSunset as privateSunsetImg,
  sharedSnorkeling as sharedSnorkelingImg,
  sharedSunset as sharedSunsetImg,
  whaleWatching as whaleWatchingImg,
  bachelorette as bacheloretteImg,
  scubaDiving as scubaDivingImg,
} from '../../data/tour-heroes';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Tours" }
  ]
});
---

<BaseLayout title="Tours — Cabo Sailing | Tours en Barco en Cabo San Lucas" description="Explora todos los tours en barco en Cabo San Lucas. Snorkel privado y compartido, cruceros al atardecer, avistamiento de ballenas, despedidas de soltera y buceo." hreflangs={{ en: '/tours', es: '/es/tours' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Page heading -->
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 pt-8 lg:pt-12 pb-6 text-center">
      <nav class="flex items-center justify-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
        <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">Tours</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-serif text-navy mb-3">Nuestros Tours</h1>
      <p class="text-slate-500 text-sm lg:text-base max-w-md mx-auto">Elige tu experiencia perfecta en el agua en Cabo San Lucas.</p>
    </div>

    <!-- Tour grid -->
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 pb-16">
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">

        <!-- Snorkel Privado -->
        <a href="/es/private-snorkeling" class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
          <div class="relative h-[180px] lg:h-[220px] overflow-hidden">
            <Image src={privateSnorkelingImg} alt="Snorkel Privado" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
          </div>
          <div class="p-4 text-center">
            <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">Snorkel Privado</h3>
          </div>
        </a>

        <!-- Atardecer Privado -->
        <a href="/es/private-sunset" class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
          <div class="relative h-[180px] lg:h-[220px] overflow-hidden">
            <Image src={privateSunsetImg} alt="Atardecer Privado" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
          </div>
          <div class="p-4 text-center">
            <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">Atardecer Privado</h3>
          </div>
        </a>

        <!-- Snorkel Compartido -->
        <a href="/es/shared-snorkeling" class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
          <div class="relative h-[180px] lg:h-[220px] overflow-hidden">
            <Image src={sharedSnorkelingImg} alt="Snorkel Compartido" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
          </div>
          <div class="p-4 text-center">
            <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">Snorkel Compartido</h3>
          </div>
        </a>

        <!-- Atardecer Compartido -->
        <a href="/es/shared-sunset" class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
          <div class="relative h-[180px] lg:h-[220px] overflow-hidden">
            <Image src={sharedSunsetImg} alt="Atardecer Compartido" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
          </div>
          <div class="p-4 text-center">
            <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">Atardecer Compartido</h3>
          </div>
        </a>

        <!-- Avistamiento de Ballenas Privado -->
        <a href="/es/whale-watching" class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
          <div class="relative h-[180px] lg:h-[220px] overflow-hidden">
            <Image src={whaleWatchingImg} alt="Avistamiento de Ballenas Privado" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
          </div>
          <div class="p-4 text-center">
            <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">Avistamiento de Ballenas</h3>
          </div>
        </a>

        <!-- Despedida de Soltera -->
        <a href="/es/bachelorette" class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
          <div class="relative h-[180px] lg:h-[220px] overflow-hidden">
            <Image src={bacheloretteImg} alt="Despedida de Soltera" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
          </div>
          <div class="p-4 text-center">
            <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">Despedida de Soltera</h3>
          </div>
        </a>

        <!-- Buceo -->
        <a href="/es/scuba-diving" class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
          <div class="relative h-[180px] lg:h-[220px] overflow-hidden">
            <Image src={scubaDivingImg} alt="Buceo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
          </div>
          <div class="p-4 text-center">
            <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">Buceo</h3>
          </div>
        </a>

      </div>
    </div>

  </main>

  <Footer />
  <FloatingCTA />
</BaseLayout>
