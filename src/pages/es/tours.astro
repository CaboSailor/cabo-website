---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import CarouselImage from '../../components/CarouselImage.astro';

const tiles = [
  { href: '/es/private-snorkeling', id: 'private-snorkeling', label: 'Snorkel Privado',           alt: 'Snorkel Privado' },
  { href: '/es/private-sunset',     id: 'private-sunset',     label: 'Atardecer Privado',         alt: 'Atardecer Privado' },
  { href: '/es/shared-snorkeling',  id: 'shared-snorkeling',  label: 'Snorkel Compartido',        alt: 'Snorkel Compartido' },
  { href: '/es/shared-sunset',      id: 'shared-sunset',      label: 'Atardecer Compartido',      alt: 'Atardecer Compartido' },
  { href: '/es/whale-watching',     id: 'whale-watching',     label: 'Avistamiento de Ballenas',  alt: 'Avistamiento de Ballenas Privado' },
  { href: '/es/bachelorette',       id: 'bachelorette-party', label: 'Despedida de Soltera',      alt: 'Despedida de Soltera' },
  { href: '/es/scuba-diving',       id: 'scuba-diving',       label: 'Buceo',                     alt: 'Buceo' },
];

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Tours" }
  ]
});
---

<BaseLayout title="Tours — Cabo Sailing | Tours en Barco en Cabo San Lucas" description="Explora todos los tours en barco en Cabo San Lucas. Snorkel privado y compartido, cruceros al atardecer, avistamiento de ballenas, despedidas de soltera y buceo." hreflangs={{ en: '/tours', es: '/es/tours' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Page heading -->
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 pt-8 lg:pt-12 pb-6 text-center">
      <nav class="flex items-center justify-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
        <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">Tours</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-serif text-navy mb-3">Nuestros Tours</h1>
      <p class="text-slate-500 text-sm lg:text-base max-w-md mx-auto">Elige tu experiencia perfecta en el agua en Cabo San Lucas.</p>
    </div>

    <!-- Tour grid -->
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 pb-16">
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">

        {tiles.map((t) => (
          <a href={t.href} class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
            <CarouselImage type="activity" id={t.id} alt={t.alt} groupHoverZoom wrapperClass="relative h-[180px] lg:h-[220px] overflow-hidden w-full">
              <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
            </CarouselImage>
            <div class="p-4 text-center">
              <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">{t.label}</h3>
            </div>
          </a>
        ))}

      </div>
    </div>

  </main>

  <Footer />
  <FloatingCTA />
</BaseLayout>
