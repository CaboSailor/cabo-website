---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import heroCaptain from '../../assets/images/boats/yacht-51/cabo-luxury-yacht-51-captain.jpg';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Sobre Nosotros" }
  ]
});
---

<BaseLayout title="Sobre Nosotros | Cabo Sailing" description="Conoce a Cabo Sailing — una empresa local de charters de veleros y yates con cruceros privados y compartidos en Cabo San Lucas. Conoce a nuestra tripulación, flota y los valores detrás de nuestro servicio 5 estrellas." hreflangs={{ en: '/about-us', es: '/es/about-us' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Hero (shuttle-service style: full-bleed mobile, contained desktop, gradient overlay + title) -->
    <div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
      <Image src={heroCaptain} alt="Capitán a bordo de nuestro yate de vela de lujo de 51&rsquo; en Cabo San Lucas" class="w-full h-full object-cover" width={2880} height={1920} />
      <div class="absolute inset-0 bg-gradient-to-t from-navy/30 via-navy/10 to-transparent"></div>
      <div class="absolute bottom-12 left-0 right-0 px-6">
        <span class="bg-accent-gold text-navy text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest mb-3 inline-block">Charter Local 5 Estrellas</span>
        <h1 class="text-3xl text-white mb-2 leading-tight font-serif">Sobre Nosotros</h1>
      </div>
    </div>

    <div class="hidden lg:block max-w-[1400px] mx-auto px-10 pt-6">
      <div class="rounded-2xl overflow-hidden relative h-[55vh]">
        <Image src={heroCaptain} alt="Capitán a bordo de nuestro yate de vela de lujo de 51&rsquo; en Cabo San Lucas" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={2880} height={1920} />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent rounded-2xl"></div>
        <div class="absolute bottom-6 left-6 right-6 max-w-3xl">
          <span class="bg-accent-gold text-navy text-sm font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-3 inline-block">Charter Local 5 Estrellas</span>
          <h1 class="text-4xl text-white leading-tight font-serif">Sobre Nosotros</h1>
        </div>
      </div>
    </div>

    <div class="max-w-[860px] mx-auto px-5 lg:px-8 pt-6 lg:pt-8 pb-10 lg:pb-16">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">Sobre Nosotros</span>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <p class="text-slate-500 text-base lg:text-lg leading-relaxed">Cabo Sailing es una empresa local de charters que ofrece cruceros privados y compartidos de vela, snorkel, atardecer, avistamiento de ballenas y despedidas de soltera en el Mar de Cortés. Somos un equipo pequeño y comprometido, involucrado en cada parte de tu experiencia, dedicados a crear momentos inolvidables en Cabo.</p>
      </header>

      <!-- Nuestra Historia -->
      <section id="nuestra-historia" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">Nuestra Historia</h2>
        </div>
        <p class="text-slate-600 text-base leading-relaxed mb-4">Cabo Sailing nació de una idea sencilla: crear experiencias en el mar centradas en el huésped, no en itinerarios apresurados. Después de años viendo cómo otros operadores trabajaban con grupos grandes y recorridos acelerados, nuestros fundadores decidieron ofrecer algo diferente: grupos pequeños, servicio personalizado y una flota propia cuidadosamente mantenida.</p>
        <p class="text-slate-600 text-base leading-relaxed">Hoy operamos una de las flotas de veleros mejor calificadas de Cabo San Lucas, con cientos de reseñas de 5 estrellas en TripAdvisor y Google. A lo largo de los años hemos recibido desde parejas celebrando aniversarios y <a href="/es/bachelorette/" class="text-accent-gold font-semibold hover:underline">despedidas de soltera</a>, hasta familias disfrutando tours de snorkel y <a href="/es/whale-watching/" class="text-accent-gold font-semibold hover:underline">experiencias inolvidables de avistamiento de ballenas</a>. Sin importar la ocasión, seguimos tratando cada experiencia con el mismo cuidado y atención al detalle que desde el primer día.</p>
      </section>

      <!-- Lo Que Nos Hace Diferentes -->
      <section id="lo-que-nos-hace-diferentes" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">Lo Que Nos Hace Diferentes</h2>
        </div>
        <ul class="space-y-3 text-base text-slate-600">
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">sailing</span><span><strong class="text-navy">Propios y administrados internamente</strong> &mdash; nuestros veleros y Yates de lujo de 38&rsquo; a 51&rsquo; los mantiene nuestro propio equipo, no se subcontrata.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">groups</span><span><strong class="text-navy">Grupos pequeños</strong> &mdash; los cruceros compartidos se mantienen íntimos y los charters privados son verdaderamente privados. Sin sorpresas.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">verified</span><span><strong class="text-navy">Precio todo incluido</strong> &mdash; barra libre premium, comida, equipo de snorkel. Lo que ves es lo que pagas. Sin recargos añadidas a la cuenta.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">support_agent</span><span><strong class="text-navy">Reserva directa</strong> &mdash; hablas con nosotros, no con intermediarios. Respondemos WhatsApp en minutos durante horario de oficina.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-blue text-base mt-0.5">recommend</span><span><strong class="text-navy">Calificación 5 estrellas</strong> &mdash; cientos de reseñas verificadas en TripAdvisor y Google. Las reseñas son nuestro plan de negocio.</span></li>
        </ul>
      </section>

      <!-- Nuestra Tripulación -->
      <section id="nuestra-tripulacion" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">Nuestra Tripulación</h2>
        </div>
        <p class="text-slate-600 text-base leading-relaxed mb-4">Cada crucero opera con un capitán bilingüe y un anfitrión dedicado. Nuestros capitanes tienen <strong class="text-navy">más de 10 años navegando las aguas de Cabo</strong> &mdash; saben dónde están las ballenas en temporada, los <a href="/es/private-snorkeling/" class="text-accent-gold font-semibold hover:underline">puntos de snorkel más tranquilos</a> cuando sube el viento y los mejores ángulos del Arco para tus fotos.</p>
        <p class="text-slate-600 text-base leading-relaxed">Nuestros anfitriones se encargan de la comida, las bebidas, la música y los pequeños detalles que hacen que un crucero se sienta especial. Están capacitados en seguridad y primeros auxilios, y son la razón por la que tantas reseñas mencionan a nuestro personal por su nombre.</p>
      </section>

      <!-- Nuestros Valores -->
      <section id="nuestros-valores" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">Nuestros Valores</h2>
        </div>
        <ul class="space-y-3 text-base text-slate-600">
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-green text-base mt-0.5">health_and_safety</span><span><strong class="text-navy">Seguridad ante todo.</strong> Equipo de seguridad conforme a la Guardia Costera, capitanes con licencia de la SCT en México y una <a href="/es/policies/" class="text-accent-gold font-semibold hover:underline">política estricta de clima</a> &mdash; si no es seguro navegar, reprogramamos o reembolsamos.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-green text-base mt-0.5">eco</span><span><strong class="text-navy">Respeto por el Mar de Cortés.</strong> Seguimos las pautas de vida marina, mantenemos distancia de ballenas y lobos marinos y evitamos los plásticos de un solo uso a bordo cuando es posible.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-green text-base mt-0.5">handshake</span><span><strong class="text-navy">Precios honestos.</strong> Lo que ves es lo que pagas. Sin recargos añadidas a la cuenta en el muelle.</span></li>
          <li class="flex items-start gap-3"><span class="material-symbols-outlined text-cabo-green text-base mt-0.5">favorite</span><span><strong class="text-navy">Hospitalidad.</strong> Cada crucero es el día especial de alguien &mdash; una luna de miel, un cumpleaños importante, un viaje familiar muy esperado. Lo tratamos así.</span></li>
        </ul>
      </section>

      <!-- En Números -->
      <section id="en-numeros" class="mb-10 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">En Números</h2>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="text-center bg-surface-light border border-border-light rounded-xl p-5">
            <div class="text-3xl font-serif text-navy font-semibold mb-1">20+</div>
            <div class="text-xs uppercase tracking-widest text-slate-500">Años navegando Cabo</div>
          </div>
          <div class="text-center bg-surface-light border border-border-light rounded-xl p-5">
            <div class="text-3xl font-serif text-navy font-semibold mb-1">5&#9733;</div>
            <div class="text-xs uppercase tracking-widest text-slate-500">Calificación TripAdvisor</div>
          </div>
          <div class="text-center bg-surface-light border border-border-light rounded-xl p-5">
            <div class="text-3xl font-serif text-navy font-semibold mb-1">38&ndash;51&rsquo;</div>
            <div class="text-xs uppercase tracking-widest text-slate-500">Tamaño de yates</div>
          </div>
          <div class="text-center bg-surface-light border border-border-light rounded-xl p-5">
            <div class="text-3xl font-serif text-navy font-semibold mb-1">100%</div>
            <div class="text-xs uppercase tracking-widest text-slate-500">Tripulación bilingüe</div>
          </div>
        </div>
      </section>

      <!-- Contact CTA -->
      <div class="bg-navy rounded-2xl p-6 lg:p-8 text-center text-white">
        <h2 class="text-xl lg:text-2xl text-white mb-2 font-serif">¿Listo para navegar con nosotros?</h2>
        <p class="text-white/70 text-base mb-6">Cuéntanos qué tienes en mente &mdash; te ayudamos a elegir el crucero ideal y resolvemos cualquier duda.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://wa.me/526241916997" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20c55e] text-white font-bold px-6 py-3 rounded-xl uppercase tracking-widest text-sm transition-colors">
            <i class="fa-brands fa-whatsapp text-lg"></i> WhatsApp
          </a>
          <a href="/es/contact/" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white font-bold px-6 py-3 rounded-xl uppercase tracking-widest text-sm transition-colors border border-white/30">
            <span class="material-symbols-outlined text-base">mail</span> Formulario de Contacto
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
  <FloatingCTA />
  <RezdyModal />
</BaseLayout>
