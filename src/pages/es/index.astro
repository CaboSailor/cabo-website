---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import RezdyModal from '../../components/RezdyModal.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import { Image } from 'astro:assets';

// Hero slides
import heroSlide1 from "../../assets/images/guests-on-sailboats/cabo-sailboat-guests-snorkeling-01.jpg";
import heroSlide2 from "../../assets/images/guests-on-yachts/cabo-yacht-charter-guests-01-copy.png";
import heroSlide3 from "../../assets/images/boats/sailing-38/cabo-sailing-38-el-arco-arch.png";
import heroSlide4 from "../../assets/images/bachelorette/cabo-bachelorette-party.jpg";

// Activity section images
import actPrivateSnorkeling from "../../assets/images/guests-on-sailboats/cabo-private-snorkeling-ocean-view.jpeg";
import actPrivateSunset from "../../assets/images/guests-on-yachts/cabo-private-sunset-cruise-guests.jpg";
import actWhaleWatching from "../../assets/images/whales/cabo-whale-watching-breaching.jpg";
import actBachelorette from "../../assets/images/bachelorette/cabo-bachelorette-party-el-arco.png";
import actSharedSnorkeling from "../../assets/images/guests-on-sailboats/cabo-sailboat-guests-snorkeling-02.jpg";
import actSharedSunset from "../../assets/images/guests-on-sailboats/cabo-shared-sunset-sailing.jpg";

// Fleet: Yacht 51'
import yacht51Img from "../../assets/images/boats/yacht-51/cabo-luxury-yacht-51-charter-v2.png";

// Fleet: Yacht 45'
import yacht45Img from "../../assets/images/boats/yacht-45/cabo-private-yacht-45-charter.png";

// Fleet: Yacht 42'
import yacht42_1 from "../../assets/images/boats/yacht-42/cabo-private-yacht-42-aerial.jpg";
import yacht42_2 from "../../assets/images/boats/yacht-42/cabo-private-yacht-42-bow.jpg";
import yacht42_3 from "../../assets/images/guests-on-yachts/cabo-yacht-guests-relaxing.jpg";
import yacht42_4 from "../../assets/images/boats/yacht-42/cabo-private-yacht-42-aerial-wide.jpg";

// Fleet: Sailing 42'
import sailing42_2 from "../../assets/images/guests-on-sailboats/cabo-sailing-guests-waving.jpg";
import sailing42_3 from "../../assets/images/boats/sailing-42/cabo-sailing-42-interior.png";
import sailing42_5 from "../../assets/images/guests-on-sailboats/cabo-sailing-42-guests-deck.jpg";

// Fleet: Sailing 38'
import sailing38_1 from "../../assets/images/boats/sailing-38/cabo-sailing-38-el-arco.png";
import sailing38_2 from "../../assets/images/boats/sailing-38/cabo-sailing-38-party-deck.png";
import sailing38_3 from "../../assets/images/boats/sailing-38/cabo-sailing-38-interior.png";
import sailing38_4 from "../../assets/images/guests-on-sailboats/cabo-sailing-38-guests-enjoying.jpg";

// Fleet: Shared Sailing
import sharedSailing1 from "../../assets/images/boats/sailing-42/cabo-sailing-42-sailing-view.jpg";
import sharedSailing2 from "../../assets/images/boats/sailing-42/cabo-sailing-42-aerial.jpg";
import sharedSailing3 from "../../assets/images/boats/sailing-42/cabo-sailing-42-exterior-01.jpg";

// Reviews background
import reviewsBg from "../../assets/images/boats/sailing-42/cabo-sailing-42-guests-on-deck.jpeg";

// Icons
import iconSnorkel from '../../assets/icons/snorkel1.png';
import iconPaddleboard from '../../assets/icons/paddle-board-clean.png';
---

<BaseLayout title="Yates y Veleros Privados en Cabo San Lucas | Cabo Sailing" description="Renta de yates y veleros privados en Cabo San Lucas — atardeceres, snorkel al Arco, ballenas y despedidas de soltera. Tripulación, bebidas y equipo incluidos." hreflangs={{ en: '/', es: '/es/' }}>

<Header variant="home" activePage="home" />


<main class="flex-1 w-full overflow-x-hidden pt-[72px]">

<!-- Hero Section -->
<div class="relative w-full h-[72vh] lg:h-[85vh] min-h-[560px] overflow-hidden" style="margin-bottom:-1px">
  <Image src={heroSlide1} alt="Luxury Yacht 51' in Cabo San Lucas" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-100 transition-opacity duration-1000" width={1920} height={1080} loading="eager" />
  <Image src={heroSlide2} alt="Luxury Yacht 51' cruising" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide3} alt="Sailing 38' at the Arch in Cabo San Lucas" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide4} alt="Cabo bachelorette party on a boat" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-transparent"></div>
  <div class="absolute inset-0 flex items-end lg:items-center px-6 lg:px-20 pb-24 lg:pb-0">
    <div class="max-w-3xl text-left">
      <h1 class="font-serif font-semibold text-white text-4xl sm:text-5xl lg:text-7xl leading-[1.08] drop-shadow-2xl">
        Veleros de Lujo y<br/>Cruceros en Yate en<br/><span style="color:#f5e0b8">Cabo San Lucas</span>
      </h1>
      <p class="text-white/85 text-sm lg:text-lg mt-4 max-w-xl leading-relaxed">Grupos pequenos. Servicio premium. Navegacion perfecta.</p>
      <!-- Review (inline on mobile, absolute on desktop) -->
      <div class="mt-6 lg:hidden">
        <div class="flex items-center gap-1 mb-2">
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
        </div>
        <p class="text-white text-lg font-semibold leading-snug">"Tripulacion increible, barco hermoso, vistas inolvidables."</p>
        <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
      </div>
    </div>
  </div>
  <!-- Review Card (desktop only) -->
  <div class="absolute bottom-10 left-10 z-10 max-w-[420px] hidden lg:block">
    <div class="flex items-center gap-1 mb-2">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-lg leading-snug">"Tripulacion increible, barco hermoso, vistas inolvidables."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
  </div>
  <!-- TripAdvisor Travelers' Choice -->
  <div class="absolute bottom-6 right-6 lg:bottom-10 lg:right-10 z-10 hidden md:block">
    <img src="https://static.tacdn.com/img2/travelers_choice/widgets/tchotel_2024_L.png" alt="TripAdvisor Travelers' Choice 2024" class="h-24 lg:h-32 w-auto drop-shadow-2xl opacity-70" />
  </div>
  <script is:inline>
    (function(){
      const slides = document.querySelectorAll('.hero-slide');
      let i = 0;
      setInterval(() => {
        slides[i].style.opacity = '0';
        i = (i + 1) % slides.length;
        slides[i].style.opacity = '1';
      }, 5000);
    })();
  </script>
</div>

<!-- Experience Heading -->
<div class="px-6 relative z-20 pt-8 mb-8 lg:max-w-[800px] lg:mx-auto text-center">
  <h2 class="text-xl md:text-2xl lg:text-3xl font-serif text-navy font-semibold leading-tight">Encuentra Tu Crucero Perfecto</h2>
  <p class="text-navy/60 text-sm mt-2 max-w-[400px] mx-auto">Privado o en grupo pequeno — disenado para comodidad, espacio y momentos inolvidables.</p>
  <div class="flex items-center justify-center gap-1 mt-6 bg-light-grey rounded-full p-1 max-w-[360px] mx-auto border border-border-light">
    <button id="toggle-private" onclick="document.getElementById('section-private').scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('toggle-private').classList.add('bg-navy','text-white','shadow-md');document.getElementById('toggle-private').classList.remove('text-navy/60');document.getElementById('toggle-shared').classList.remove('bg-navy','text-white','shadow-md');document.getElementById('toggle-shared').classList.add('text-navy/60')" class="flex-1 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all bg-navy text-white shadow-md">Cruceros Privados</button>
    <button id="toggle-shared" onclick="document.getElementById('section-shared').scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('toggle-shared').classList.add('bg-navy','text-white','shadow-md');document.getElementById('toggle-shared').classList.remove('text-navy/60');document.getElementById('toggle-private').classList.remove('bg-navy','text-white','shadow-md');document.getElementById('toggle-private').classList.add('text-navy/60')" class="flex-1 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all text-navy/60">Cruceros Compartidos</button>
  </div>
</div>

<!-- PRIVATE EXPERIENCES -->
<section id="section-private" class="pt-8 pb-16 lg:pt-12 lg:pb-24 bg-white scroll-mt-[80px]">
<div class="max-w-screen-2xl mx-auto px-6 lg:px-10 space-y-24 lg:space-y-40">

<!-- Activity 1: Private Snorkeling -->
<div data-activity="private-snorkeling" class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
  <div class="md:col-span-7 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Mas Popular</div>
    <div class="absolute top-6 right-6 z-30 bg-red-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">20% Off</div>
    <div class="aspect-[3/4] md:aspect-[16/10] overflow-hidden rounded-lg shadow-2xl">
      <Image src={actPrivateSnorkeling} alt="Private Snorkeling" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width={1200} height={750} />
    </div>
    <div class="absolute -bottom-6 right-2 md:-right-10 bg-navy p-8 md:p-12 max-w-[280px] md:max-w-xs shadow-2xl z-20 border-b-4 border-accent-gold rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-accent-gold-light font-serif-italic text-2xl md:text-3xl mb-4">Vive el Mar a Tu Manera</h3>
      <p class="text-sky-100 text-xs md:text-sm leading-relaxed">Bahias tranquilas, agua cristalina, sin multitudes — solo tu charter privado.</p>
    </div>
  </div>

  <div class="md:col-span-5 space-y-8 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-4xl lg:text-5xl font-serif-italic text-navy leading-tight">Crucero Privado de Snorkel <span class="text-2xl lg:text-3xl text-navy/60">(Yate o Velero)</span></h2>
      <p class="text-accent-gold/80 text-[11px] font-bold tracking-widest uppercase">Elegido por cientos de huespedes cada mes</p>
    </div>
    <p class="text-navy/70 text-base lg:text-lg leading-relaxed">Un crucero privado a los mejores puntos de snorkel de Cabo con tiempo para nadar, relajarse y disfrutar comida y bebidas a bordo.<br/>Perfecto para familias, parejas o grupos que buscan una experiencia divertida y flexible a su propio ritmo.<br/>Sin multitudes, mas tiempo en el agua y una tripulacion enfocada completamente en tu grupo.</p>
    <ul class="space-y-3 pt-2">
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Tu Propio Yate o Velero Privado – Sin multitudes, solo tu grupo en una embarcacion premium.</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Paisajes y Snorkel – Visita Land's End y el Arco, luego sumérgete en los mejores arrecifes de Cabo.</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Servicio Todo Incluido – Barra libre premium y comida local fresca incluida.</li>
    </ul>
    <div class="pt-6 space-y-4">
      <a href="/es/private-snorkeling" class="block text-center bg-transparent text-navy border border-navy w-full py-4 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">Mas Info</a>
    </div>
    <div class="md:hidden border-b border-border-light mt-8"></div>
  </div>
</div>

<!-- Activity 2: Private Sunset Cruise -->
<div data-activity="private-sunset" class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
  <div class="md:col-span-7 order-1 md:order-2 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl bg-opacity-80 backdrop-blur-sm">Premium</div>
    <div class="absolute top-6 right-6 z-30 bg-red-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">20% Off</div>
    <div class="aspect-[3/4] md:aspect-[16/10] overflow-hidden rounded-lg shadow-2xl">
      <Image src={actPrivateSunset} alt="Private Sunset Cruise" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width={1200} height={750} />
    </div>
    <div class="absolute -bottom-6 left-2 md:-left-10 bg-accent-gold p-8 md:p-12 max-w-[280px] md:max-w-xs shadow-2xl z-20 border-b-4 border-amber-300 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-white font-serif-italic text-2xl md:text-3xl mb-4">Magia del Atardecer</h3>
      <p class="text-amber-50 text-xs md:text-sm leading-relaxed">Disfruta una margarita helada mientras el cielo de Baja se transforma en un lienzo de oro y violeta.</p>
    </div>
  </div>

  <div class="md:col-span-5 order-2 md:order-1 space-y-8 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-4xl lg:text-5xl font-serif-italic text-navy leading-tight">Crucero Privado al Atardecer <span class="text-2xl lg:text-3xl text-navy/60">(Yate o Velero)</span></h2>
      <p class="text-accent-gold/80 text-[11px] font-bold tracking-widest uppercase">La opcion favorita para parejas</p>
    </div>
    <p class="text-navy/70 text-base lg:text-lg leading-relaxed">Un crucero privado nocturno pasando por el Arco de Cabo con bebidas, bocadillos y vistas inolvidables del atardecer.<br/>Ideal para parejas, celebraciones o cualquiera que busque una experiencia relajada y memorable.<br/>Mas intimo, mas suave y mucho menos concurrido que los tours tipicos de atardecer.</p>
    <ul class="space-y-3 pt-2">
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Yate o velero impecable y lujoso</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Servicio todo incluido — barra libre premium y bocadillos locales frescos</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Experiencia privada de atardecer — las vistas mas iconicas de Cabo, solo para ti</li>
    </ul>
    <div class="pt-6 space-y-4">
      <a href="/es/private-sunset" class="block text-center bg-transparent text-navy border border-navy w-full py-4 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">Mas Info</a>
    </div>
    <div class="md:hidden border-b border-border-light mt-8"></div>
  </div>
</div>

<!-- Activity 3: Whale Watching -->
<div data-activity="whale-watching" class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
  <div class="md:col-span-7 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Se Agota Rapido</div>
    <div class="absolute top-6 right-6 z-30 bg-red-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">20% Off</div>
    <div class="aspect-[3/4] md:aspect-[16/10] overflow-hidden rounded-lg shadow-2xl">
      <Image src={actWhaleWatching} alt="Whale Watching" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width={1200} height={750} />
    </div>
    <div class="absolute -bottom-6 right-2 md:-right-10 bg-teal-900 p-8 md:p-12 max-w-[280px] md:max-w-xs shadow-2xl z-20 border-b-4 border-teal-400 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-teal-200 font-serif-italic text-2xl md:text-3xl mb-4">Gigantes del Oceano</h3>
      <p class="text-teal-50/70 text-xs md:text-sm leading-relaxed">Un asiento de primera fila para la migracion mas majestuosa del planeta.</p>
    </div>
  </div>

  <div class="md:col-span-5 space-y-8 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-4xl lg:text-5xl font-serif-italic text-navy leading-tight">Crucero Privado de Avistamiento de Ballenas <span class="text-2xl lg:text-3xl text-navy/60">(Yate o Velero)</span></h2>
      <p class="text-accent-gold/80 text-[11px] font-bold tracking-widest uppercase">El mas vendido del mes pasado</p>
    </div>
    <p class="text-navy/70 text-base lg:text-lg leading-relaxed">Un crucero privado para ver las ballenas de Cabo de cerca, guiado por una tripulacion experimentada en su habitat natural.<br/>Perfecto para familias, parejas o grupos pequenos que buscan una experiencia de vida silvestre mas personal y comoda.<br/>Encuentros mas cercanos, sin multitudes y la flexibilidad de seguir a las ballenas a tu propio ritmo.</p>
    <ul class="space-y-3 pt-2">
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Tu propio yate o velero privado</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Encuentros cercanos con ballenas — vistas de primera fila en su habitat natural</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Experiencia todo incluido — bebidas, bocadillos y tripulacion experta</li>
    </ul>
    <div class="pt-6 space-y-4">
      <a href="/es/whale-watching" class="block text-center bg-transparent text-navy border border-navy w-full py-4 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">Mas Info</a>
    </div>
    <div class="md:hidden border-b border-border-light mt-8"></div>
  </div>
</div>

<!-- Activity 4: Bachelorette Party -->
<div data-activity="bachelorette-party" class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
  <div class="md:col-span-7 order-1 md:order-2 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Experiencia VIP</div>
    <div class="absolute top-6 right-6 z-30 bg-red-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">20% Off</div>
    <div class="aspect-[3/4] md:aspect-[16/10] overflow-hidden rounded-lg shadow-2xl">
      <Image src={actBachelorette} alt="Bachelorette Party" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width={1200} height={750} />
    </div>
    <div class="absolute -bottom-6 left-2 md:-left-10 bg-indigo-900 p-8 md:p-12 max-w-[280px] md:max-w-xs shadow-2xl z-20 border-b-4 border-pink-400 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-indigo-100 font-serif-italic text-2xl md:text-3xl mb-4">Fiesta Inolvidable</h3>
      <p class="text-indigo-200 text-xs md:text-sm leading-relaxed">Temas personalizados y cocteles para una celebracion que nunca olvidara.</p>
    </div>
  </div>

  <div class="md:col-span-5 order-2 md:order-1 space-y-8 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-4xl lg:text-5xl font-serif-italic text-navy leading-tight">Crucero Privado de Despedida de Soltera <span class="text-2xl lg:text-3xl text-navy/60">(Yate o Velero)</span></h2>
      <p class="text-accent-gold/80 text-[11px] font-bold tracking-widest uppercase">Expertos en eventos de confianza</p>
    </div>
    <p class="text-navy/70 text-base lg:text-lg leading-relaxed">Un crucero privado disenado para celebrar: musica, bebidas, excelentes vistas y mucho tiempo para relajarse y divertirse con tu grupo.<br/>Perfecto para despedidas de soltera que buscan una experiencia elegante, divertida y sin estres en el agua.<br/>Tu propio espacio, sin multitudes y una tripulacion que se encarga de todo para que puedas concentrarte en celebrar.</p>
    <ul class="space-y-3 pt-2">
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Yate o velero de lujo — hecho para celebrar</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Tu fiesta, a tu manera — musica, ambiente y momentos inolvidables</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-base lg:text-lg leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Todo incluido — barra libre, bocadillos y todo a bordo</li>
    </ul>
    <div class="pt-6 space-y-4">
      <a href="/es/bachelorette-party" class="block text-center bg-transparent text-navy border border-navy w-full py-4 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">Mas Info</a>
    </div>
  </div>
</div>

</div>
</section>

<!-- SHARED EXPERIENCES -->
