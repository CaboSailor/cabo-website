    <div class={`aspect-[4/3] md:aspect-[16/9] overflow-hidden rounded-lg shadow-2xl ${activityImages['private-sunset'].length > 1 ? 'activity-carousel' : ''} relative`}>
      {activityImages['private-sunset'].map((img, idx) => (
        <Image src={img} alt="Crucero Privado al Atardecer" class="activity-slide absolute inset-0 w-full h-full object-cover" style={`opacity:${idx === 0 ? 1 : 0};`} width={1200} height={750} />
      ))}
      {activityImages['private-sunset'].length > 1 && (
        <><button type="button" aria-label="Diapositiva anterior" class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_left</span></button>
        <button type="button" aria-label="Diapositiva siguiente" class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_right</span></button>
        <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2"></div>
        <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
          <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-2xl">arrow_back</span>
            <span class="text-[11px] uppercase tracking-widest font-bold">Desliza</span>
            <span class="material-symbols-outlined text-2xl">arrow_forward</span>
          </div>
        </div></>
      )}
    </div>
    <div class="absolute -bottom-6 left-2 md:-left-10 bg-accent-gold py-2 px-4 md:py-5 md:px-8 max-w-[260px] md:max-w-[280px] shadow-2xl z-20 border-b-4 border-amber-300 rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-white font-serif-italic text-xl md:text-3xl mb-0 md:mb-2">Magia del Atardecer</h3>
      <p class="text-amber-50 hidden md:block text-xs md:text-sm leading-relaxed">Disfruta una margarita helada mientras el cielo de Baja se transforma en un lienzo de oro y violeta.</p>
    </div>
  </div>

  <div class="md:col-span-5 order-2 md:order-1 space-y-2 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-3xl lg:text-4xl font-serif-italic text-navy leading-tight">Crucero Privado al Atardecer <span class="text-xl lg:text-2xl text-navy/70">(Yate o Velero)</span></h2>
