        <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
          <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-2xl">arrow_back</span>
            <span class="text-[11px] uppercase tracking-widest font-bold">Desliza</span>
            <span class="material-symbols-outlined text-2xl">arrow_forward</span>
          </div>
        </div></>
      )}
