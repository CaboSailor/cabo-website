---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import RezdyModal from '../../components/RezdyModal.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import CarouselImage from '../../components/CarouselImage.astro';
import { Image } from 'astro:assets';

// Hero slides
import heroSlide1 from "../../assets/images/guests-on-sailboats/luxury-sailboat-in-tropical-waters.png";
import heroSlide2 from "../../assets/images/guests-on-yachts/relaxing-day-on-a-luxury-boat.png";
import heroSlide3 from "../../assets/images/guests-on-sailboats/sailing-through-cabo's-vibrant-waters.png";
import heroSlide4 from "../../assets/images/guests-on-yachts/cabo-yacht-charter-guests-01-copy.png";

// Carousel config (mirror EN home)
import carouselConfig from "../../data/carousels.json";

// Reviews background
import reviewsBg from "../../assets/images/boats/sailing-42/cabo-sailing-42-guests-on-deck.webp";

// Glob all images so we can look them up by path from the JSON
const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/**/*.{jpg,jpeg,png,webp}', { eager: true });

function getImage(relativePath: string): ImageMetadata {
  const key = `../../assets/images/${relativePath}`;
  const mod = allImages[key];
  if (!mod) throw new Error(`Image not found: ${relativePath} (looked up as ${key})`);
  return mod.default;
}

function getImages(paths: (string | { src: string })[]): ImageMetadata[] {
  return paths.map((p) => getImage(typeof p === 'string' ? p : p.src));
}

const activityImages: Record<string, ImageMetadata[]> = {};
for (const [key, paths] of Object.entries(carouselConfig.activities)) {
  activityImages[key] = getImages(paths as string[]);
}
const fleetImages: Record<string, ImageMetadata[]> = {};
for (const [key, paths] of Object.entries(carouselConfig.fleet)) {
  fleetImages[key] = getImages(paths as string[]);
}
---

<BaseLayout title="Yates y Veleros Privados en Cabo San Lucas | Cabo Sailing" description="Renta de yates y veleros privados en Cabo San Lucas — atardeceres, snorkel al Arco, ballenas y despedidas de soltera. Tripulación, bebidas y equipo incluidos." ogImage="/og/home.jpg" ogImageAlt="Cabo Sailing luxury yacht in Cabo San Lucas" hreflangs={{ en: '/', es: '/es/' }}>

<Header variant="home" activePage="home" />


<main class="flex-1 w-full overflow-x-hidden pt-[72px]">

<!-- Hero Section -->
<div class="relative w-full h-[72vh] lg:h-[85vh] min-h-[560px] overflow-hidden" style="margin-bottom:-1px">
  <Image src={heroSlide1} alt="Velero de lujo en aguas tropicales" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-100 transition-opacity duration-1000" width={1920} height={1080} loading="eager" fetchpriority="high" />
  <Image src={heroSlide2} alt="Día relajante en un yate de lujo" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide3} alt="Navegando por las aguas vibrantes de Cabo" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <Image src={heroSlide4} alt="Invitados disfrutando de un charter de yate en Cabo" class="hero-slide absolute inset-0 w-full h-full object-cover block opacity-0 transition-opacity duration-1000" width={1920} height={1080} />
  <div class="absolute inset-0 bg-gradient-to-r from-black/15 via-black/30 to-transparent"></div>
  <div class="absolute inset-0 flex items-end lg:items-center px-6 lg:px-20 pb-24 lg:pb-0">
    <div class="max-w-3xl text-left">
      <h1 class="font-serif font-semibold text-white text-4xl sm:text-5xl lg:text-7xl leading-[1.08] drop-shadow-2xl">
        Cruceros de lujo en<br/>yates y veleros en<br/><span style="color:#f5e0b8">Cabo San Lucas</span>
      </h1>
      <p class="text-white/85 text-sm lg:text-lg mt-4 max-w-xl leading-relaxed">Grupos pequenos. Servicio premium. Navegacion perfecta.</p>
      <!-- Review (inline on mobile, absolute on desktop) -->
      <div class="mt-6 lg:hidden">
        <div class="flex items-center gap-1 mb-2">
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
          <span class="material-symbols-outlined text-gold filled text-xl">star</span>
        </div>
        <p class="text-white text-lg font-semibold leading-snug">"Tripulacion increible, barco hermoso, vistas inolvidables."</p>
        <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
      </div>
    </div>
  </div>
  <!-- Review Card (desktop only) -->
  <div class="absolute bottom-10 left-10 z-10 max-w-[420px] hidden lg:block">
    <div class="flex items-center gap-1 mb-2">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-lg leading-snug">"Tripulacion increible, barco hermoso, vistas inolvidables."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Rachel K. &mdash; Seattle, WA</p>
  </div>
  <!-- TripAdvisor Travelers' Choice -->
  <div class="absolute bottom-6 right-6 lg:bottom-10 lg:right-10 z-10 hidden md:block">
    <img src="https://static.tacdn.com/img2/travelers_choice/widgets/tchotel_2024_L.png" alt="TripAdvisor Travelers' Choice 2024" class="h-24 lg:h-32 w-auto drop-shadow-2xl opacity-70" />
  </div>
  <script is:inline>
    (function(){
      const slides = document.querySelectorAll('.hero-slide');
      let i = 0;
      setInterval(() => {
        slides[i].style.opacity = '0';
        i = (i + 1) % slides.length;
        slides[i].style.opacity = '1';
      }, 5000);
    })();
  </script>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest" data-max-discount="site">Ahorra hasta 40% off &mdash; Tiempo Limitado</p>
</div>

<!-- Experience Heading -->
<div class="px-6 relative z-20 pt-8 mb-8 lg:max-w-[800px] lg:mx-auto text-center">
  <h2 class="text-xl md:text-2xl lg:text-3xl font-serif text-navy font-semibold leading-tight">Encuentra Tu Crucero Perfecto</h2>
  <p class="text-navy/70 text-sm mt-2 max-w-[400px] mx-auto">Privado o en grupo pequeno — disenado para comodidad, espacio y momentos inolvidables.</p>
  <div class="flex items-center justify-center gap-1 mt-6 bg-light-grey rounded-full p-1 max-w-[360px] mx-auto border border-border-light">
    <button id="toggle-private" onclick="document.getElementById('section-private').scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('toggle-private').classList.add('bg-navy','text-white','shadow-md');document.getElementById('toggle-private').classList.remove('text-navy/70');document.getElementById('toggle-shared').classList.remove('bg-navy','text-white','shadow-md');document.getElementById('toggle-shared').classList.add('text-navy/70')" class="flex-1 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all bg-navy text-white shadow-md">Cruceros Privados</button>
    <button id="toggle-shared" onclick="document.getElementById('section-shared').scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('toggle-shared').classList.add('bg-navy','text-white','shadow-md');document.getElementById('toggle-shared').classList.remove('text-navy/70');document.getElementById('toggle-private').classList.remove('bg-navy','text-white','shadow-md');document.getElementById('toggle-private').classList.add('text-navy/70')" class="flex-1 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all text-navy/70">Cruceros en Velero</button>
  </div>
</div>

<!-- PRIVATE EXPERIENCES -->
<section id="section-private" class="pt-8 pb-16 lg:pt-12 lg:pb-24 bg-white scroll-mt-[80px]">
<div class="max-w-screen-2xl mx-auto px-6 lg:px-10 space-y-12 lg:space-y-20">

<!-- Activity 1: Private Snorkeling -->
<div data-activity="private-snorkeling" class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
  <div class="md:col-span-7 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold-dark text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Mas Popular</div>

    <div class={`aspect-[4/3] md:aspect-[16/9] overflow-hidden rounded-lg shadow-2xl ${activityImages['private-snorkeling'].length > 1 ? 'activity-carousel' : ''} relative`}>
