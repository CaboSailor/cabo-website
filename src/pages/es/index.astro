        <Image src={img} alt="Snorkel Privado" class="activity-slide absolute inset-0 w-full h-full object-cover" style={`opacity:${idx === 0 ? 1 : 0};`} width={1200} height={750} />
      ))}
      {activityImages['private-snorkeling'].length > 1 && (
        <><button type="button" aria-label="Diapositiva anterior" class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_left</span></button>
        <button type="button" aria-label="Diapositiva siguiente" class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_right</span></button>
        <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2"></div>
        <div class="swipe-hint md:hidden absolute inset-0 z-20 pointer-events-none flex items-center justify-center">
          <div class="bg-black/55 backdrop-blur-sm text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span class="material-symbols-outlined text-2xl">arrow_back</span>
            <span class="text-[11px] uppercase tracking-widest font-bold">Desliza</span>
            <span class="material-symbols-outlined text-2xl">arrow_forward</span>
          </div>
        </div></>
      )}
    </div>
    <div class="absolute -bottom-6 right-2 md:-right-10 bg-navy py-2 px-4 md:py-5 md:px-8 max-w-[260px] md:max-w-[280px] shadow-2xl z-20 border-b-4 border-accent-gold rounded-lg bg-opacity-80 backdrop-blur-sm">
      <h3 class="text-accent-gold-light font-serif-italic text-xl md:text-3xl mb-0 md:mb-2">Vive el Mar a Tu Manera</h3>
      <p class="text-sky-100 hidden md:block text-xs md:text-sm leading-relaxed">Bahias tranquilas, agua cristalina, sin multitudes, solo tu embarcación privada.</p>
    </div>
  </div>

  <div class="md:col-span-5 space-y-2 pt-4 md:pt-0">
    <div class="space-y-4">
      <h2 class="text-3xl lg:text-4xl font-serif-italic text-navy leading-tight">Crucero Privado de Snorkel <span class="text-xl lg:text-2xl text-navy/70">(Yate o Velero)</span></h2>
      <p class="text-accent-gold-dark text-[11px] font-bold tracking-widest uppercase">Elegido por cientos de huespedes cada mes</p>
      <p class="text-navy/70 text-sm font-medium flex items-center gap-1.5"><span class="material-symbols-outlined text-base">schedule</span> 3 Horas</p>
    </div>
    <p class="text-navy/70 text-sm lg:text-base leading-relaxed">Un crucero privado a los mejores puntos de snorkel de Cabo con tiempo para nadar, relajarse y disfrutar comida y bebidas a bordo.<br/>Perfecto para familias, parejas o grupos que buscan una experiencia divertida y flexible a su propio ritmo.<br/>Sin multitudes, mas tiempo en el agua y una tripulacion enfocada completamente en tu grupo.</p>
    <ul class="space-y-2">
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Tu Propio Yate o Velero Privado – Sin multitudes, solo tu grupo en una embarcacion premium.</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Paisajes y Snorkel – Visita Land's End y el Arco, luego sumérgete en los mejores arrecifes de Cabo.</li>
      <li class="flex items-start gap-3 text-navy/70 font-medium text-sm lg:text-base leading-relaxed"><span class="material-symbols-outlined text-accent-gold text-lg mt-1">check</span> Servicio Todo Incluido – Barra libre premium y comida local fresca incluida.</li>
    </ul>
    <div class="space-y-4">
      <a href="/es/tours/private-snorkeling/" class="block text-center bg-transparent text-navy border border-navy w-full py-3 rounded-lg font-bold tracking-widest text-sm hover:bg-navy/5 transition-all uppercase">Detalles Snorkel Privado</a>
