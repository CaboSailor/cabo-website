  </div>
</div>

<!-- Activity 3: Whale Watching -->
<div data-activity="whale-watching" class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
  <div class="md:col-span-7 relative group">
    <div class="absolute top-6 left-6 z-30 bg-accent-gold-dark text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-xl">Se Agota Rapido</div>

    <div class={`aspect-[4/3] md:aspect-[16/9] overflow-hidden rounded-lg shadow-2xl ${activityImages['whale-watching'].length > 1 ? 'activity-carousel' : ''} relative`}>
      {activityImages['whale-watching'].map((img, idx) => (
        <Image src={img} alt="Avistamiento de Ballenas" class="activity-slide absolute inset-0 w-full h-full object-cover" style={`opacity:${idx === 0 ? 1 : 0};`} width={1200} height={750} />
      ))}
      {activityImages['whale-watching'].length > 1 && (
        <><button type="button" aria-label="Diapositiva anterior" class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_left</span></button>
        <button type="button" aria-label="Diapositiva siguiente" class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 z-20 hidden md:flex items-center justify-center w-12 h-24 rounded-md text-white/60 hover:text-white/95 transition-all"><span class="material-symbols-outlined text-7xl font-light">chevron_right</span></button>
