  <style is:inline>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .material-symbols-outlined.filled { font-variation-settings: 'FILL' 1; }
    #highlights-toggle:checked ~ #highlights-content { max-height: 500px; margin-top: 1.5rem; opacity: 1; }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer { max-height: 200px; margin-top: 0.75rem; opacity: 1; }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
    .fleet-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: none;
      background: rgba(255,255,255,0.25);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      color: white;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
      padding: 0;
    }
    .fleet-arrow:hover { background: rgba(255,255,255,0.45); }
    .fleet-arrow.left { left: 10px; }
    .fleet-arrow.right { right: 10px; }
    .fleet-arrow .material-symbols-outlined { font-size: 20px; line-height: 1; }
  </style>

  <script is:inline>
    // Desktop carousel
    var dPage = 0;
    function scrollDReviews(dir) { dPage = Math.max(0, Math.min(1, dPage + dir)); updateDCarousel(); }
    function dCarouselTo(page) { dPage = page; updateDCarousel(); }
    function updateDCarousel() {
      document.getElementById('d-carousel').style.transform = 'translateX(-' + (dPage * 50) + '%)';
      [0,1].forEach(function(n) {
        document.getElementById('d-dot-'+n).className = 'w-2.5 h-2.5 rounded-full transition-all ' + (n===dPage ? 'bg-navy' : 'bg-border-light');
      });
    }

    // Fleet boat card arrow navigation
    function fleetNav(btn, dir) {
      var carousel = btn.parentElement.querySelector('.boat-carousel');
      if (!carousel) return;
      var slides = carousel.querySelectorAll('.boat-slide');
      var current = 0;
      slides.forEach(function(s, i) { if (s.style.opacity === '1' || s.classList.contains('opacity-100')) current = i; });
      slides[current].style.opacity = '0';
      slides[current].classList.remove('opacity-100');
      var next = (current + dir + slides.length) % slides.length;
      slides[next].style.opacity = '1';
    }

    function heroNav(btn, dir) {
      var wrap = btn.closest('.overflow-hidden').querySelector('.snap-x');
      if (!wrap) return;
      wrap.scrollBy({ left: dir * wrap.offsetWidth, behavior: 'smooth' });
    }
  </script>
</BaseLayout>
