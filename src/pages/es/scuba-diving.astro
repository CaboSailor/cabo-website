---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import { Image } from 'astro:assets';

// Hero / main images
import heroImg from "../../assets/images/scuba-diving/cabo-scuba-diving-underwater.jpg";
import scubaImg7 from "../../assets/images/scuba-diving/cabo-scuba-diving-reef.jpg";
import scubaImg9 from "../../assets/images/scuba-diving/cabo-scuba-diving-fish.jpg";
import scubaImg5 from "../../assets/images/scuba-diving/cabo-scuba-diving-coral.jpg";
import scubaImg17 from "../../assets/images/scuba-diving/cabo-scuba-diving-adventure.jpg";

// Boat images
import yacht51_9 from "../../assets/images/boats/yacht-51/cabo-luxury-yacht-51-ocean-view.jpg";
import yacht51_2 from "../../assets/images/boats/yacht-51/cabo-luxury-yacht-51-exterior-01.jpg";
import yacht51_7 from "../../assets/images/boats/yacht-51/cabo-luxury-yacht-51-exterior-03.jpg";
import yacht45_1 from "../../assets/images/boats/yacht-45/cabo-private-yacht-45-exterior-01.jpg";
import yacht45_5 from "../../assets/images/boats/yacht-45/cabo-private-yacht-45-exterior-03.jpg";
import yacht45_6 from "../../assets/images/boats/yacht-45/cabo-private-yacht-45-bow.jpg";
import yacht42_3 from "../../assets/images/boats/yacht-42/cabo-private-yacht-42-exterior-02.jpg";
import yacht42_2 from "../../assets/images/boats/yacht-42/cabo-private-yacht-42-exterior-01.jpg";
import yacht42_5 from "../../assets/images/boats/yacht-42/cabo-private-yacht-42-exterior-03.jpg";
import sailing42_10 from "../../assets/images/boats/sailing-42/cabo-sailing-42-exterior-01.jpg";
import sailing42_17 from "../../assets/images/boats/sailing-42/cabo-sailing-42-sailing-view.jpg";
import sailing42_12 from "../../assets/images/boats/sailing-42/cabo-sailing-42-exterior-02.jpg";

// Icons
import yachtIcon from "../../assets/icons/Yacht icon.png";
---

<BaseLayout title="Buceo Privado en Cabo San Lucas | Cabo Sailing" description="Tours privados de buceo a los mejores sitios de Cabo — Pelican Rock, Land's End, Santa María. Guías certificados PADI y equipo completo incluido." hreflangs={{ en: '/scuba-diving', es: '/es/scuba-diving' }}>
  <Header variant="subpage" activePage="scuba-diving" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- ========== HERO (Mobile) ========== -->
    <div class="relative w-full h-[45vh] lg:hidden overflow-hidden">
      <div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
        <div class="flex-shrink-0 w-full h-full snap-center relative">
          <Image alt="Dive boat with crew, turquoise water, Cabo cliffs" class="w-full h-full object-cover" src={heroImg} width={800} height={500} />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
        </div>
        <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Luxury Yacht 51'" class="w-full h-full object-cover" src={yacht51_9} width={800} height={500} /></div>
        <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Luxury Yacht 51'" class="w-full h-full object-cover" src={yacht51_2} width={800} height={500} /></div>
        <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Luxury Yacht 45'" class="w-full h-full object-cover" src={yacht45_1} width={800} height={500} /></div>
        <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Sailing Boat 42'" class="w-full h-full object-cover" src={sailing42_10} width={800} height={500} /></div>
      </div>
      <div class="absolute top-4 left-4 bg-gold text-white text-base font-bold px-3 py-1 rounded-full uppercase tracking-widest">Aventura Submarina</div>
      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
        <div class="max-w-[360px] mx-auto text-center">
          <div class="flex items-center justify-center gap-0.5 mb-1.5">
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
          </div>
          <p class="text-white text-base leading-snug">"Sitios de buceo increíbles y una tripulación de primera. Nos sentimos seguros todo el tiempo."</p>
          <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Tom R. &mdash; Miami, FL</p>
        </div>
      </div>
      <button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
      <button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
    </div>

    <!-- ========== MOBILE LAYOUT ========== -->
    <div class="lg:hidden relative z-10 -mt-4 px-5">
      <div class="bg-white rounded-3xl p-6 shadow-xl shadow-navy/5 border border-border-light">
        <nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
          <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span>Tours</span>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-navy font-semibold">Buceo</span>
        </nav>
        <div class="flex flex-col gap-1 mb-6">
          <div class="flex justify-between items-start">
            <h1 class="text-2xl text-navy leading-tight">Buceo en Cabo San Lucas</h1>
          </div>
          <p class="text-slate-400 text-sm font-medium flex items-center gap-1 mt-2 uppercase tracking-widest">
            <span class="material-symbols-outlined text-base">location_on</span> Land's End, Cabo San Lucas
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-light-grey rounded-2xl p-4 flex flex-col items-center text-center border border-border-light">
            <span class="material-symbols-outlined text-gold mb-2">schedule</span>
            <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Duración</p>
            <p class="text-base font-bold text-navy">4 Horas</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-4 flex flex-col items-center text-center border border-border-light">
            <span class="material-symbols-outlined text-gold mb-2">trending_down</span>
            <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Dificultad</p>
            <p class="text-base font-bold text-navy">Media-Alta</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-4 flex flex-col items-center text-center border border-border-light">
            <span class="material-symbols-outlined text-gold mb-2">scuba_diving</span>
            <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Buzos</p>
            <p class="text-base font-bold text-navy">Todos los Niveles</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-4 flex flex-col items-center text-center border border-border-light">
            <span class="material-symbols-outlined text-gold mb-2">event_available</span>
            <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Cancelación Gratuita</p>
            <p class="text-base font-bold text-navy">Hasta 24h</p>
          </div>
        </div>
        <div class="mt-6 pt-6 border-t border-border-light">
          <input class="hidden" id="highlights-toggle" type="checkbox"/>
          <label class="flex items-center justify-between cursor-pointer group" for="highlights-toggle">
            <div class="flex items-center gap-3">
              <div class="p-2 bg-navy/5 rounded-full"><span class="material-symbols-outlined text-navy text-xl">auto_awesome</span></div>
              <span class="text-base font-semibold text-navy">Aspectos Destacados del Tour</span>
            </div>
            <span class="material-symbols-outlined text-slate-300 chevron-icon transition-transform">chevron_right</span>
          </label>
          <div class="max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-in-out" id="highlights-content">
            <div class="space-y-4">
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">scuba_diving</span><div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Guías Certificados PADI</h4><p class="text-sm text-slate-500 leading-relaxed">Instructores expertos para todos los niveles.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">pets</span><div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Encuentros con Lobos Marinos</h4><p class="text-sm text-slate-500 leading-relaxed">Bucea junto a juguetones lobos marinos en Pelican Rock.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">visibility</span><div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Sin Experiencia Previa Necesaria</h4><p class="text-sm text-slate-500 leading-relaxed">Nuestros instructores PADI guían a principiantes en cada paso.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">inventory_2</span><div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Todo el Equipo Incluido</h4><p class="text-sm text-slate-500 leading-relaxed">Equipo completo de buceo, traje de neopreno y tanques incluidos.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">waves</span><div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Múltiples Sitios de Buceo</h4><p class="text-sm text-slate-500 leading-relaxed">Pelican Rock, Neptune's Finger, Land's End.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">photo_camera</span><div><h4 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Paraíso de Vida Marina</h4><p class="text-sm text-slate-500 leading-relaxed">Peces tropicales, rayas, morenas, caballitos de mar y más.</p></div></div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-8">
        <h3 class="text-lg text-navy mb-4">Sobre esta experiencia</h3>
        <p class="text-slate-500 leading-relaxed text-base"><span id="about-short">Una opción perfecta para grupos mixtos de buzos y snorkelers que quieren disfrutar un día juntos en el agua. Descubre el vibrante mundo submarino de Cabo San Lucas con nuestros tours guiados de buce</span><span id="about-full" class="hidden">o. Ya seas un buzo certificado o estés probando el buceo por primera vez, nuestros instructores certificados PADI garantizan una experiencia segura e inolvidable. Sumérgete en aguas cristalinas en algunos de los sitios de buceo más icónicos de Cabo y encuéntrate cara a cara con una increíble vida marina.</span><button id="about-read-more" onclick="document.getElementById('about-full').classList.remove('hidden');this.classList.add('hidden');" class="text-gold font-semibold ml-1 lg:hidden">Leer más</button></p>
      </div>
      <div class="mt-10">
        <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">Qué Incluye</h3></div>
        <div class="grid grid-cols-1 gap-5 pl-1">
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">2 Inmersiones Guiadas</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Equipo Completo de Buceo</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Instructor / Guía PADI</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Clase Introductoria</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Almuerzo y Barra</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Baño y Vestidor</span></div>
        </div>
        <div class="mt-6 bg-light-grey rounded-2xl p-5 border border-border-light space-y-4">
          <div class="flex items-center justify-between">
            <div><p class="text-base font-bold text-navy">Buzo Certificado (2 Inmersiones)</p><p class="text-sm text-slate-400">Guía PADI divemaster y equipo completo</p></div>
            <span class="text-base font-bold text-gold">$270 USD</span>
          </div>
          <div class="flex items-center justify-between">
            <div><p class="text-base font-bold text-navy">Buzo No Certificado (2 Inmersiones)</p><p class="text-sm text-slate-400">Instructor PADI, curso introductorio y equipo completo</p></div>
            <span class="text-base font-bold text-gold">$290 USD</span>
          </div>
        </div>
      </div>
      <div class="mt-10">
        <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">Qué Traer</h3></div>
        <div class="grid grid-cols-1 gap-5 pl-1">
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-gold text-[14px]">backpack</span></div><span class="text-slate-600 text-base font-medium">Traje de baño</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-gold text-[14px]">wb_sunny</span></div><span class="text-slate-600 text-base font-medium">Protector solar (biodegradable de preferencia)</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-gold text-[14px]">badge</span></div><span class="text-slate-600 text-base font-medium">Tarjeta de certificación (si eres buzo certificado)</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-gold text-[14px]">favorite</span></div><span class="text-slate-600 text-base font-medium">¡Espíritu aventurero!</span></div>
        </div>
      </div>

      <!-- Mobile Punto de Encuentro -->
      <div class="mt-10 bg-light-grey rounded-2xl p-5 border border-border-light">
        <div class="flex items-center gap-3 mb-4">
          <span class="material-symbols-outlined text-gold">pin_drop</span>
          <h3 class="text-base font-bold text-navy uppercase tracking-wider">Punto de Encuentro</h3>
        </div>
        <p class="text-base font-semibold text-navy mb-1">Cabo San Lucas Marina, Dock F</p>
        <p class="text-sm text-slate-500 leading-relaxed mb-4">Busca al equipo de Cabo Sailing con camisas polo negras con nuestro logo. Por favor llega 15 minutos antes de la salida.</p>
        <div class="flex items-center gap-2 text-sm text-slate-500">
          <span class="material-symbols-outlined text-gold text-base">schedule</span>
          <span class="font-semibold text-navy">SALIDAS: 9:00 AM y 12:30 PM DIARIO</span>
        </div>
      </div>

      <!-- Mobile: Elige Tu Barco -->
      <div class="mt-10">
        <div class="flex items-center gap-3 mb-2"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">Elige Tu Barco</h3></div>
        <div class="flex items-center gap-4 mb-4 mt-6">
          <Image src={yachtIcon} alt="Yacht" class="h-6 w-auto" style="filter: invert(55%) sepia(30%) saturate(500%) hue-rotate(10deg) brightness(85%);" width={24} height={24} />
          <h3 class="text-base font-serif text-navy">Yates</h3>
          <div class="flex-1 h-px bg-gradient-to-r from-gold/30 to-transparent"></div>
        </div>
        <div class="flex flex-col gap-5">
          <!-- Yacht 51' -->
          <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-51">
            <div class="h-[320px] w-full relative">
              <div class="boat-carousel relative w-full h-full">
                <Image alt="Luxury Yacht 51'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-100 transition-opacity duration-700" src={yacht51_9} width={800} height={500} />
                <Image alt="Luxury Yacht 51'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" src={yacht51_2} width={800} height={500} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
              <div class="absolute bottom-5 left-6">
                <h4 class="text-white text-lg lg:text-xl">Luxury Yacht 51'</h4>
                <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Hasta 20 Invitados</span></div>
              </div>
              <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Más Espacioso</div>
              <button class="fleet-arrow left" onclick="fleetNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
              <button class="fleet-arrow right" onclick="fleetNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
            </div>
            <div class="p-5">
              <a href="https://wa.me/526241916997?text=Hi%2C%20I'd%20like%20to%20book%20Scuba%20Diving%20on%20the%20Luxury%20Yacht%2051" target="_blank" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg">Reservar Ahora</a>
            </div>
          </div>
          <!-- Yacht 45' -->
          <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-45">
            <div class="h-[320px] w-full relative">
              <div class="boat-carousel relative w-full h-full">
                <Image alt="Luxury Yacht 45'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-100 transition-opacity duration-700" src={yacht45_1} width={800} height={500} />
                <Image alt="Luxury Yacht 45'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" src={yacht45_5} width={800} height={500} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
              <div class="absolute bottom-5 left-6">
                <h4 class="text-white text-lg lg:text-xl">Luxury Yacht 45'</h4>
                <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Hasta 12 Invitados</span></div>
              </div>
              <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Más Popular</div>
              <button class="fleet-arrow left" onclick="fleetNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
              <button class="fleet-arrow right" onclick="fleetNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
            </div>
            <div class="p-5">
              <a href="https://wa.me/526241916997?text=Hi%2C%20I'd%20like%20to%20book%20Scuba%20Diving%20on%20the%20Luxury%20Yacht%2045" target="_blank" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg">Reservar Ahora</a>
            </div>
          </div>
          <!-- Yacht 42' -->
          <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-42">
            <div class="h-[320px] w-full relative">
              <div class="boat-carousel relative w-full h-full">
                <Image alt="Luxury Yacht 42'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-100 transition-opacity duration-700" src={yacht42_3} width={800} height={500} />
                <Image alt="Luxury Yacht 42'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" src={yacht42_2} width={800} height={500} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
              <div class="absolute bottom-5 left-6">
                <h4 class="text-white text-lg lg:text-xl">Luxury Yacht 42'</h4>
                <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Hasta 18 Invitados</span></div>
              </div>
              <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Mejor Precio</div>
              <button class="fleet-arrow left" onclick="fleetNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
              <button class="fleet-arrow right" onclick="fleetNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
