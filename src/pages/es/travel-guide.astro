---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('travel-guide');
const esArticles = await getCollection('travel-guide-es');
const esSlugs = new Set(esArticles.map((a) => a.id));

const VALID_CATEGORIES = ['Activities', 'Attractions', 'Traveling to Cabo', 'Culture & Food'] as const;

const categoryMeta: Record<string, { id: string; icon: string; label: string; description: string }> = {
  'Activities': {
    id: 'activities',
    icon: 'surfing',
    label: 'Actividades',
    description: 'Snorkel, buceo, navegación, pesca y todo lo que puedes vivir en Cabo San Lucas.',
  },
  'Attractions': {
    id: 'attractions',
    icon: 'photo_camera',
    label: 'Atracciones',
    description: 'Desde Land\'s End hasta playas escondidas, monumentos históricos y lugares dignos de Instagram en Los Cabos.',
  },
  'Traveling to Cabo': {
    id: 'traveling',
    icon: 'flight',
    label: 'Viajando a Cabo',
    description: 'Vuelos, rutas en auto, presupuestos, seguridad y todo lo que necesitas para planear tu viaje.',
  },
  'Culture & Food': {
    id: 'culture',
    icon: 'restaurant',
    label: 'Cultura y Comida',
    description: 'Alta cocina, comida callejera, museos, vida nocturna y la vibrante cultura que hace especial a Cabo.',
  },
};

// Flag articles with unknown categories
const flagged = allArticles.filter(
  (a) => !VALID_CATEGORIES.includes(a.data.category as any)
);

// Group by category, sort alphabetically by title
const grouped = VALID_CATEGORIES.map((cat) => {
  const articles = allArticles
    .filter((a) => a.data.category === cat)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
  return { category: cat, articles, meta: categoryMeta[cat] };
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Guía de Viaje" }
  ]
});
---

<BaseLayout title="Guía de Viaje de Cabo San Lucas — Qué Hacer y Cuándo Ir" description="Guía de viaje de Cabo San Lucas: qué hacer, playas, temporada de ballenas, seguridad, el Arco y más — consejos locales de Cabo Sailing." ogImage="/og/travel-guide.jpg" ogImageAlt="The Arch of Cabo San Lucas" hreflangs={{ en: '/travel-guide', es: '/es/travel-guide' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="travel-guide" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Hero Section -->
    <div class="relative w-full h-[40vh] min-h-[300px] lg:h-[50vh]">
      <img alt="Tour de yate y snorkel en Cabo" class="w-full h-full object-cover" src="/images/blog/cabo-yacht-snorkeling-tour.jpg"/>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/25 via-navy/10 to-transparent"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-end z-10 text-center px-8 pb-10">
        <div class="flex flex-col items-center gap-3">
          <nav class="flex items-center gap-1.5 text-xs text-white/60 mb-2" aria-label="Breadcrumb">
            <a href="/es/" class="hover:text-white transition-colors">Inicio</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-white font-semibold">Guía de Viaje</span>
          </nav>
          <p class="text-white/80 text-xs uppercase tracking-[0.3em] font-bold">Tu Recurso Completo</p>
          <h1 class="text-3xl md:text-5xl font-serif text-white uppercase tracking-[0.15em] leading-tight drop-shadow-lg font-light">
            Guía de Viaje <span class="block font-script text-4xl md:text-5xl normal-case tracking-normal my-1">Blog</span>
          </h1>
          <div class="w-12 h-[1px] bg-accent-gold-light"></div>
          <p class="text-white/90 text-sm max-w-[400px] leading-relaxed">Actividades, atracciones, comida, cultura y todo lo que necesitas para el viaje perfecto a Cabo.</p>
        </div>
      </div>
    </div>

    <!-- Horizontal Sub-Menu -->
    <div class="sticky top-[60px] z-40 bg-white border-b border-border-light/50 shadow-sm">
      <div class="max-w-5xl mx-auto">
        <nav class="flex overflow-x-auto no-scrollbar">
          <a href="/es/travel-guide/" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-accent-gold text-navy transition-colors">Inicio</a>
          <a href="/es/travel-guide-activities/" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors">Actividades</a>
          <a href="/es/travel-guide-attractions/" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors">Atracciones</a>
          <a href="/es/travel-guide-traveling/" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Viajando a Cabo</a>
          <a href="/es/travel-guide-culture/" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Cultura y Comida</a>
        </nav>
      </div>
    </div>

    <!-- Intro -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto pt-10 pb-6">
      <p class="font-display text-warm-yellow text-base lg:text-lg font-medium leading-relaxed max-w-[600px] mx-auto text-center">
        Cabo es un impresionante destino costero con más de 300 días de sol, aguas cálidas y experiencias inolvidables. Ya sea que vengas por aventura, relajación o celebración — esta guía te tiene cubierto.
      </p>
    </div>

    <!-- Category Anchor Nav -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto pb-8">
      <div class="flex flex-wrap justify-center gap-3">
        {grouped.map(({ articles, meta }) => (
          <a href={`#${meta.id}`} class="inline-flex items-center gap-1.5 bg-white border border-border-light/60 text-navy text-sm font-bold px-4 py-2 rounded-full hover:border-accent-gold hover:text-accent-gold transition-colors shadow-sm">
            <span class="material-symbols-outlined text-base">{meta.icon}</span>
            {meta.label} <span class="text-navy/60 font-normal">({articles.length})</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Flagged Articles Warning -->
    {flagged.length > 0 && (
      <div class="px-6 lg:px-0 max-w-5xl mx-auto pb-8">
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-sm text-yellow-800">
          <strong>Aviso:</strong> {flagged.length} artículo(s) tienen una categoría desconocida y no se muestran:
          <ul class="mt-2 list-disc list-inside">
            {flagged.map((a) => (
              <li>{a.data.title} — categoría: "{a.data.category}"</li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <!-- Article Sections by Category -->
    {grouped.map(({ articles, meta }) => (
      <section id={meta.id} class="section-anchor px-6 lg:px-0 max-w-5xl mx-auto pb-16">
        <div class="flex items-center gap-3 mb-2">
          <span class="material-symbols-outlined text-accent-gold text-2xl">{meta.icon}</span>
          <h2 class="text-2xl lg:text-3xl font-serif text-navy font-semibold">{meta.label}</h2>
          <span class="text-navy/30 text-sm font-display">({articles.length})</span>
        </div>
        <p class="text-navy/60 text-sm lg:text-base leading-relaxed mb-8 max-w-2xl">{meta.description}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {articles.map((article) => {
            const excerpt = article.data.description.length > 150
              ? article.data.description.slice(0, 147) + '...'
              : article.data.description;
            return (
              <a href={esSlugs.has(article.id) ? `/es/travel-guide/${article.id}/` : `/travel-guide/${article.id}/`} class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
                <div class="h-[220px] lg:h-[240px] overflow-hidden">
                  <img alt={article.data.heroAlt} class="w-full h-full object-cover" src={article.data.heroImage} loading="lazy" />
                </div>
                <div class="p-5 lg:p-6">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">{meta.label}</span>
                    {article.data.relatedActivity && (
                      <span class="bg-navy/5 text-navy/70 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-navy/10">Reservar esta experiencia</span>
                    )}
                  </div>
                  <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">{article.data.title}</h3>
                  <p class="text-navy/70 text-sm leading-relaxed mb-4">{excerpt}</p>
                  <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Leer artículo <span class="material-symbols-outlined text-base">arrow_forward</span></div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))}

    <!-- CTA Section -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto mb-12">
      <div class="bg-navy rounded-[2rem] p-8 text-center">
        <h2 class="text-xl font-serif text-white mb-3 font-semibold">¿Listo para Vivir Cabo?</h2>
        <p class="text-white/70 text-sm mb-6 leading-relaxed">Reserva tu charter de velero, tour de snorkel o crucero al atardecer con nosotros. Haremos tu viaje a Cabo inolvidable.</p>
        <a href="https://wa.me/526241916997?text=hi%2C%20I'm%20sending%20you%20a%20message%20from%20cabosailing.com" target="_blank" class="inline-flex items-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-xl font-bold text-sm uppercase tracking-widest active:scale-95 transition-transform shadow-lg">
          <i class="fa-brands fa-whatsapp text-lg"></i> Escríbenos por WhatsApp
        </a>
        <div class="mt-4">
          <a href="tel:+526241438485" class="text-white/60 text-sm hover:text-white transition-colors">O llama al +52 624 143 8485</a>
        </div>
      </div>
    </div>

  </main>

  <Footer />
  <FloatingCTA />
</BaseLayout>

<style>
  .guide-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .guide-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.12);
  }
  .guide-card:active {
    transform: scale(0.98);
  }
  .section-anchor {
    scroll-margin-top: 120px;
  }
</style>
