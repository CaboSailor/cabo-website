---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import { Image } from 'astro:assets';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Guía de Viaje" }
  ]
});
---

<BaseLayout title="Guía de Viaje de Cabo San Lucas — Qué Hacer y Cuándo Ir" description="Guía de viaje de Cabo San Lucas: qué hacer, playas, temporada de ballenas, seguridad, el Arco y más — consejos locales de Cabo Sailing." ogImage="/og/travel-guide.jpg" ogImageAlt="The Arch of Cabo San Lucas" hreflangs={{ en: '/travel-guide', es: '/es/travel-guide' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="travel-guide" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Hero Section -->
    <div class="relative w-full h-[40vh] min-h-[300px] lg:h-[50vh]">
      <img alt="Vista aérea de la costa de Cabo San Lucas" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2019/10/morning-activities-cabo.jpg"/>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/40 to-transparent"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-end z-10 text-center px-8 pb-10">
        <div class="flex flex-col items-center gap-3">
          <nav class="flex items-center gap-1.5 text-xs text-white/60 mb-2" aria-label="Breadcrumb">
            <a href="/es/" class="hover:text-white transition-colors">Inicio</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-white font-semibold">Guia de Viaje</span>
          </nav>
          <p class="text-white/80 text-xs uppercase tracking-[0.3em] font-bold">Tu Recurso Completo</p>
          <h1 class="text-3xl md:text-5xl font-serif text-white uppercase tracking-[0.15em] leading-tight drop-shadow-lg font-light">
            Guia de Viaje <span class="block font-script text-4xl md:text-5xl normal-case tracking-normal my-1">Blog</span>
          </h1>
          <div class="w-12 h-[1px] bg-accent-gold-light"></div>
          <p class="text-white/90 text-sm max-w-[400px] leading-relaxed">Actividades, atracciones, comida, cultura y todo lo que necesitas para el viaje perfecto a Cabo.</p>
        </div>
      </div>
    </div>

    <!-- Horizontal Sub-Menu -->
    <div class="sticky top-[60px] z-40 bg-white border-b border-border-light/50 shadow-sm">
      <div class="max-w-5xl mx-auto">
        <nav class="flex overflow-x-auto no-scrollbar">
          <a href="/es/travel-guide" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-accent-gold text-navy transition-colors">Inicio</a>
          <a href="/es/travel-guide-activities" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/50 hover:text-navy hover:border-accent-gold/50 transition-colors">Actividades</a>
          <a href="/es/travel-guide-attractions" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/50 hover:text-navy hover:border-accent-gold/50 transition-colors">Atracciones</a>
          <a href="/es/travel-guide-traveling" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/50 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Viajando a Cabo</a>
          <a href="/es/travel-guide-culture" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/50 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Cultura y Comida</a>
        </nav>
      </div>
    </div>

    <!-- Intro -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto pt-10 pb-6">
      <p class="font-display text-warm-yellow text-base lg:text-lg font-medium leading-relaxed max-w-[600px] mx-auto text-center">
        Cabo es un impresionante destino costero con más de 300 días de sol, aguas cálidas y experiencias inolvidables. Ya sea que vengas por aventura, relajación o celebración — esta guía te tiene cubierto.
      </p>
    </div>

    <!-- Category Cards Grid -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto pb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 lg:gap-8">

        <!-- Activities Card -->
        <a href="/es/travel-guide-activities" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[260px] overflow-hidden">
            <img alt="Actividades divertidas en Cabo San Lucas" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-accent-gold text-lg">surfing</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy font-semibold">Actividades</h3>
            </div>
            <p class="text-navy/60 text-sm leading-relaxed mb-3">Pesca deportiva, navegación, tours en ATV, parasailing y más — descubre las actividades más emocionantes en Cabo San Lucas.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Explorar <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Attractions Card -->
        <a href="/es/travel-guide-attractions" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[260px] overflow-hidden">
            <img alt="Lugares turísticos de Baja California" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/02/baja-california-sur.png.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-accent-gold text-lg">photo_camera</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy font-semibold">Atracciones</h3>
            </div>
            <p class="text-navy/60 text-sm leading-relaxed mb-3">Desde Land's End hasta playas escondidas, monumentos históricos y lugares dignos de Instagram — los destinos imperdibles en Los Cabos.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Explorar <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Traveling to Cabo Card -->
        <a href="/es/travel-guide-traveling" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[260px] overflow-hidden">
            <img alt="Aeropuerto Internacional de Los Cabos" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2019/08/los-cabos-international-airport-featured-image.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-accent-gold text-lg">flight</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy font-semibold">Viajando a Cabo</h3>
            </div>
            <p class="text-navy/60 text-sm leading-relaxed mb-3">Vuelos, rutas en auto, mejor época para visitar y todo lo que necesitas para planificar tu viaje a Cabo San Lucas.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Explorar <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Culture & Food Card -->
        <a href="/es/travel-guide-culture" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[260px] overflow-hidden">
            <img alt="Comida tradicional mexicana en Cabo" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/10/cabofood-1080x675.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-accent-gold text-lg">restaurant</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy font-semibold">Cultura y Comida</h3>
            </div>
            <p class="text-navy/60 text-sm leading-relaxed mb-3">Alta cocina, comida callejera, museos, historia local y la vibrante cultura que hace de Cabo un lugar verdaderamente especial.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Explorar <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

      </div>
    </div>

    <!-- CTA Section -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto mb-12">
      <div class="bg-navy rounded-[2rem] p-8 text-center">
        <h2 class="text-xl font-serif text-white mb-3 font-semibold">¿Listo para Vivir Cabo?</h2>
        <p class="text-white/70 text-sm mb-6 leading-relaxed">Reserva tu charter de velero, tour de snorkel o crucero al atardecer con nosotros. Haremos tu viaje a Cabo inolvidable.</p>
        <a href="https://wa.me/526241916997?text=hi%2C%20I'm%20sending%20you%20a%20message%20from%20cabosailing.com" target="_blank" class="inline-flex items-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-xl font-bold text-sm uppercase tracking-widest active:scale-95 transition-transform shadow-lg">
          <i class="fa-brands fa-whatsapp text-lg"></i> Escríbenos por WhatsApp
        </a>
        <div class="mt-4">
          <a href="tel:+526241438485" class="text-white/60 text-sm hover:text-white transition-colors">O llama al +52 624 143 8485</a>
        </div>
      </div>
    </div>

  </main>

  <Footer />
  <FloatingCTA />
</BaseLayout>

<style>
  .guide-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .guide-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.12);
  }
  .guide-card:active {
    transform: scale(0.98);
  }
  .section-anchor {
    scroll-margin-top: 80px;
  }
  .submenu-active {
    color: #0a1d37;
    border-bottom-color: #b38e5d;
  }
</style>
