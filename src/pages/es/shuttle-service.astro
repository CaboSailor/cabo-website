---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import { Image } from 'astro:assets';

// Images
import vanImg from "../../assets/images/cabo-airport-shuttle-van.png";
import archImg from "../../assets/images/blog/the-famous-cabo-san-lucas-arch.jpg";
import sailing42_10 from "../../assets/images/boats/sailing-42/cabo-sailing-42-exterior-01.jpg";
import guestsImg from "../../assets/images/guests-on-sailboats/cabo-charter-guests-smiling.jpg";
import guestsYachtImg from "../../assets/images/guests-on-yachts/cabo-yacht-charter-guests-04.jpg";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Servicio de Transporte" }
  ]
});
---

<BaseLayout title="Transporte y Traslados al Aeropuerto en Los Cabos | Cabo Sailing" description="Servicio confiable de transporte y traslados al aeropuerto en Los Cabos. Vehículos con aire acondicionado, choferes bilingües y servicio puerta a puerta desde el aeropuerto SJD a Cabo San Lucas." hreflangs={{ en: '/shuttle-service', es: '/es/shuttle-service' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="shuttle" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- ========== MOBILE LAYOUT ========== -->
    <div class="lg:hidden">
      <div class="relative w-full h-[45vh] overflow-hidden">
        <div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
          <div class="flex-shrink-0 w-full h-full snap-center relative">
            <Image alt="Van de transporte de Cabo Sailing" class="w-full h-full object-cover" src={vanImg} width={800} height={500} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/40 to-transparent"></div>
            <div class="absolute bottom-12 left-0 right-0 px-6">
              <h1 class="text-3xl text-white mb-2 leading-tight font-serif">Transporte sin Complicaciones a tu Crucero y de Regreso</h1>
              <p class="text-white/80 text-base font-medium tracking-wide uppercase">Servicio Privado Puerta a Puerta</p>
            </div>
          </div>
          <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="El famoso Arco de Cabo San Lucas" class="w-full h-full object-cover" src={archImg} width={800} height={500} /></div>
          <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Velero 42 con invitados" class="w-full h-full object-cover" src={sailing42_10} width={800} height={500} /></div>
          <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Invitados felices en velero" class="w-full h-full object-cover" src={guestsImg} width={800} height={500} /></div>
          <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Invitados brindando en yate" class="w-full h-full object-cover" src={guestsYachtImg} width={800} height={500} /></div>
        </div>
        <button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
        <button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
      </div>
      <div class="px-5 -mt-8 relative z-10">
        <div class="bg-white rounded-3xl p-6 shadow-xl shadow-navy/5 border border-border-light">
          <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
            <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-navy font-semibold">Servicio de Transporte</span>
          </nav>
          <p class="text-navy font-bold text-center mb-6 leading-relaxed text-lg">¿Por qué usar nuestro servicio?</p>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-cabo-blue text-base">security</span>
              </div>
              <span class="text-base font-medium text-slate-600">¡La seguridad es nuestra prioridad #1!</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-cabo-blue text-base">language</span>
              </div>
              <span class="text-base font-medium text-slate-600">Choferes profesionales bilingües</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-cabo-blue text-base">payments</span>
              </div>
              <span class="text-base font-medium text-slate-600">Precios Competitivos</span>
            </div>
          </div>
        </div>
      </div>
      <div class="px-5 mt-8 space-y-3">
        <button class="w-full bg-cabo-yellow hover:bg-yellow-500 text-navy font-bold py-4 rounded-2xl shadow-md transition-all active:scale-[0.98] text-base uppercase tracking-wider">Formulario de Transporte al Aeropuerto</button>
        <button class="w-full bg-cabo-yellow hover:bg-yellow-500 text-navy font-bold py-4 rounded-2xl shadow-md transition-all active:scale-[0.98] text-base uppercase tracking-wider">Formulario de Recogida para Crucero</button>
      </div>

      <!-- MOBILE: Seamless Shuttle Section -->
      <div class="px-5 pt-8 pb-6">
        <div class="flex items-center gap-3 mb-4"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">Transporte sin Complicaciones a tu Crucero y de Regreso</h3></div>
        <Image src={vanImg} alt="Transporte de Cabo Sailing" class="w-full h-48 object-cover rounded-2xl mb-4" width={600} height={200} />
        <p class="text-base text-slate-500 leading-relaxed mb-3">Llegar a la marina para tu crucero en velero debería ser la parte más fácil de tu día. Nuestro transporte privado te recoge directamente en tu alojamiento y te lleva directo a la Marina de Cabo San Lucas — y te trae de regreso al terminar el crucero.</p>
        <p class="text-base text-slate-500 leading-relaxed">Sin esperar taxis, sin navegar calles desconocidas. Solo súbete, relájate y déjanos manejar el viaje para que te enfoques en la aventura que te espera.</p>
        <div class="flex gap-6 mt-6">
          <div><p class="text-xl font-bold text-navy font-serif">Todo el Día</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Disponible</p></div>
          <div class="w-px bg-border-light"></div>
          <div><p class="text-xl font-bold text-navy font-serif">Privado</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Vehículo</p></div>
          <div class="w-px bg-border-light"></div>
          <div><p class="text-xl font-bold text-navy font-serif">Puerta a Puerta</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Servicio</p></div>
        </div>
      </div>

      <!-- Mobile: Hotel & Residential -->
      <div class="mt-12 px-5">
        <div class="text-center mb-8">
          <h2 class="text-2xl text-navy mb-2">Servicio de transportación</h2>
          <p class="text-slate-500 text-sm px-4">Se puede reservar durante el proceso de reserva del crucero o por separado.</p>
        </div>
        <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
          <div class="bg-navy py-4 px-6 text-center">
            <h3 class="text-white text-sm font-bold uppercase tracking-widest">Traslados de Hotel y Residencial para Crucero</h3>
          </div>
          <div class="p-6 space-y-6">
            <div>
              <h4 class="text-navy text-sm font-bold uppercase mb-3 border-b border-slate-100 pb-2">Cabo San Lucas a Puente de Palmilla</h4>
              <div class="flex justify-between items-center text-base mb-2">
                <span class="text-slate-600">Sencillo (1-10 invitados)</span>
                <span class="font-bold text-navy">$70 USD</span>
              </div>
              <div class="flex justify-between items-center text-base">
                <span class="text-slate-600">Redondo (1-10 invitados)</span>
                <span class="font-bold text-navy">$120 USD</span>
              </div>
            </div>
            <div>
              <h4 class="text-navy text-sm font-bold uppercase mb-3 border-b border-slate-100 pb-2">Palmilla a Puerto Los Cabos</h4>
              <div class="flex justify-between items-center text-base mb-2">
                <span class="text-slate-600">Sencillo (1-10 invitados)</span>
                <span class="font-bold text-navy">$80 USD</span>
              </div>
              <div class="flex justify-between items-center text-base">
                <span class="text-slate-600">Redondo (1-10 invitados)</span>
                <span class="font-bold text-navy">$145 USD</span>
              </div>
            </div>
            <p class="text-base text-center text-slate-500 font-bold uppercase pt-2">Invitado extra (a partir del 11°): $10 USD por invitado</p>
          </div>
        </div>
      </div>

      <!-- Mobile: Airport Private Service -->
      <div class="mt-16 px-5">
        <div class="text-center mb-8">
          <h2 class="text-2xl text-navy mb-2">Servicio Privado al Aeropuerto</h2>
          <p class="text-slate-500 text-base uppercase tracking-[0.2em] font-bold">Traslados Oficiales</p>
        </div>
        <div class="space-y-6">
          <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
            <div class="bg-cabo-blue py-3 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Aeropuerto a San José del Cabo</h3>
            </div>
            <div class="p-6 text-center">
              <p class="text-slate-500 text-sm mb-2">A la zona hotelera y residencial de San José</p>
              <div class="flex justify-center items-baseline gap-1">
                <span class="text-navy font-bold text-3xl">$75</span>
                <span class="text-navy/60 text-base font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-500 mt-2 font-bold uppercase tracking-wider">1 a 10 Invitados</p>
            </div>
          </div>
          <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
            <div class="bg-cabo-orange py-3 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Aeropuerto a Puerto Los Cabos</h3>
            </div>
            <div class="p-6 text-center">
              <p class="text-slate-500 text-sm mb-2">Al área del Corredor de Los Cabos (entre SJD y CSL)</p>
              <div class="flex justify-center items-baseline gap-1">
                <span class="text-navy font-bold text-3xl">$95</span>
                <span class="text-navy/60 text-base font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-500 mt-2 font-bold uppercase tracking-wider">1 a 10 Invitados</p>
            </div>
          </div>
          <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
            <div class="bg-cabo-green py-3 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Aeropuerto al Área de Diamante</h3>
            </div>
            <div class="p-6 text-center">
              <p class="text-slate-500 text-sm mb-2">A la zona hotelera y residencial de Cabo San Lucas</p>
              <div class="flex justify-center items-baseline gap-1">
                <span class="text-navy font-bold text-3xl">$120</span>
                <span class="text-navy/60 text-base font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-500 mt-2 font-bold uppercase tracking-wider">1 a 10 Invitados</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile: CTA -->
      <div class="mt-16 px-5 py-12 bg-light-grey">
        <h3 class="text-center text-navy font-bold italic mb-8">¡Solicita el Servicio Ahora!</h3>
        <div class="space-y-3">
          <button class="w-full bg-cabo-yellow hover:bg-yellow-500 text-navy font-bold py-4 rounded-2xl shadow-md transition-all active:scale-[0.98] text-base uppercase tracking-wider">Formulario de Recogida para Crucero</button>
          <button class="w-full bg-white border border-border-light hover:bg-light-grey text-navy font-bold py-4 rounded-2xl shadow-md transition-all active:scale-[0.98] text-base uppercase tracking-wider">Formulario de Transporte al Aeropuerto</button>
        </div>
      </div>
    </div><!-- end mobile -->

    <!-- ========== DESKTOP LAYOUT ========== -->
    <div class="hidden lg:block">

      <!-- Hero Gallery -->
      <div class="max-w-[1400px] mx-auto px-10 pt-10">
        <div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
          <div class="col-span-2 row-span-2 rounded-2xl overflow-hidden relative">
            <Image alt="Van de transporte de Cabo Sailing" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={vanImg} width={1200} height={800} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent rounded-2xl"></div>
            <div class="absolute bottom-6 left-6">
              <span class="bg-cabo-blue text-white text-sm font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-3 inline-block">Servicio Puerta a Puerta</span>
              <h1 class="text-4xl text-white leading-tight">Transporte sin Complicaciones<br/>a tu Crucero y de Regreso</h1>
            </div>
          </div>
          <div class="rounded-2xl overflow-hidden"><Image alt="El famoso Arco de Cabo San Lucas" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={archImg} width={600} height={400} /></div>
          <div class="rounded-2xl overflow-hidden"><Image alt="Velero 42 con invitados" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={sailing42_10} width={600} height={400} /></div>
          <div class="rounded-2xl overflow-hidden"><Image alt="Invitados felices en velero" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={guestsImg} width={600} height={400} /></div>
          <div class="rounded-2xl overflow-hidden"><Image alt="Invitados brindando en yate" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={guestsYachtImg} width={600} height={400} /></div>
        </div>
      </div>

      <!-- Breadcrumb -->
      <div class="max-w-[1400px] mx-auto px-10 pt-8">
        <nav class="flex items-center gap-1.5 text-xs text-slate-500" aria-label="Breadcrumb">
          <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-navy font-semibold">Servicio de Transporte</span>
        </nav>
      </div>

      <!-- Why Choose Us -->
      <div class="max-w-[1400px] mx-auto px-10 py-16">
        <div class="grid grid-cols-3 gap-8 mb-16">
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">security</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Seguridad Primero</h3>
            <p class="text-slate-500 text-base">Vehículos con licencia y asegurados, con choferes profesionalmente capacitados. Tu seguridad es nuestra prioridad #1.</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">language</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Choferes Bilingües</h3>
            <p class="text-slate-500 text-base">Choferes profesionales que hablan inglés y español, y conocen Los Cabos a la perfección.</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">payments</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Precios Competitivos</h3>
            <p class="text-slate-500 text-base">Precios transparentes sin cargos ocultos. Reserva directo y ahorra comparado con los traslados del hotel.</p>
          </div>
        </div>

        <!-- About Section -->
        <div class="flex gap-16 items-center mb-20">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-6"><div class="w-1 h-8 bg-gold rounded-full"></div><h2 class="text-3xl text-navy">Transporte sin Complicaciones a tu Crucero y de Regreso</h2></div>
            <p class="text-slate-500 text-lg leading-relaxed mb-4">Llegar a la marina para tu crucero en velero debería ser la parte más fácil de tu día. Nuestro transporte privado te recoge directamente en tu alojamiento y te lleva directo a la Marina de Cabo San Lucas — y te trae de regreso al terminar el crucero.</p>
            <p class="text-slate-500 text-lg leading-relaxed mb-8">Sin esperar taxis, sin navegar calles desconocidas. Solo súbete, relájate y déjanos manejar el viaje para que te enfoques en la aventura que te espera.</p>
            <div class="flex gap-10">
              <div><p class="text-2xl font-bold text-navy font-serif">Todo el Día</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Disponible</p></div>
              <div class="w-px bg-border-light"></div>
              <div><p class="text-2xl font-bold text-navy font-serif">Privado</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Vehículo</p></div>
              <div class="w-px bg-border-light"></div>
              <div><p class="text-2xl font-bold text-navy font-serif">Puerta a Puerta</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Servicio</p></div>
            </div>
          </div>
          <div class="w-[400px] h-[300px] rounded-3xl overflow-hidden flex-shrink-0">
            <Image alt="Van de transporte de Cabo Sailing" class="w-full h-full object-cover" src={vanImg} width={400} height={300} />
          </div>
        </div>
      </div>

      <!-- Hotel & Residential Transfers -->
      <div class="bg-light-grey py-20">
        <div class="max-w-[1400px] mx-auto px-10">
          <div class="text-center mb-10">
            <h2 class="text-3xl text-navy mb-2">Servicio de transportación</h2>
            <p class="text-slate-500 text-base">Se puede reservar durante el proceso de reserva del crucero o por separado.</p>
          </div>
          <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm">
              <div class="bg-navy py-4 px-8 text-center">
                <h3 class="text-white text-sm font-bold uppercase tracking-widest">Traslados de Hotel y Residencial para Crucero</h3>
              </div>
              <div class="p-8">
                <div class="grid grid-cols-3 gap-8 text-center mb-6">
                  <div></div>
                  <div class="text-sm font-bold text-slate-500 uppercase tracking-widest">Sencillo</div>
                  <div class="text-sm font-bold text-slate-500 uppercase tracking-widest">Redondo</div>
                </div>
                <div class="grid grid-cols-3 gap-8 items-center py-4 border-b border-border-light">
                  <div class="text-navy font-bold">Cabo San Lucas a Puente de Palmilla</div>
                  <div class="text-center text-lg font-bold text-navy">$70 <span class="text-sm text-navy/60">USD</span></div>
                  <div class="text-center text-lg font-bold text-navy">$120 <span class="text-sm text-navy/60">USD</span></div>
                </div>
                <div class="grid grid-cols-3 gap-8 items-center py-4 border-b border-border-light">
                  <div class="text-navy font-bold">Palmilla a Puerto Los Cabos</div>
                  <div class="text-center text-lg font-bold text-navy">$80 <span class="text-sm text-navy/60">USD</span></div>
                  <div class="text-center text-lg font-bold text-navy">$145 <span class="text-sm text-navy/60">USD</span></div>
                </div>
                <p class="text-sm text-center text-slate-500 font-bold uppercase pt-6">Invitado extra (a partir del 11°): $10 USD por invitado</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="max-w-[1400px] mx-auto px-10 py-20">
        <div class="bg-navy rounded-3xl p-12 text-center">
          <h2 class="text-3xl text-white mb-3 font-serif">¿Listo para Reservar tu Traslado?</h2>
          <p class="text-white/70 text-lg mb-8 max-w-2xl mx-auto">Comienza tus vacaciones en Cabo sin estrés. Reserva hoy tu transportación privada.</p>
          <div class="flex justify-center gap-4">
            <button class="bg-cabo-yellow hover:bg-yellow-500 text-navy font-bold px-10 py-4 rounded-full uppercase tracking-widest text-sm transition-colors shadow-lg">Formulario de Recogida para Crucero</button>
            <button class="bg-white/20 text-white font-bold px-10 py-4 rounded-full uppercase tracking-widest text-sm hover:bg-white/30 transition-colors border border-white/40">Formulario de Transporte al Aeropuerto</button>
          </div>
        </div>
      </div>

      <!-- Airport Transfers -->
      <div class="max-w-[1400px] mx-auto px-10 pb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl text-navy mb-2">Servicio Privado al Aeropuerto</h2>
          <p class="text-slate-500 text-base uppercase tracking-[0.2em] font-bold">Traslados Oficiales</p>
        </div>
        <div class="grid grid-cols-3 gap-8">
          <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm hover:shadow-lg transition-shadow">
            <div class="bg-cabo-blue py-4 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Aeropuerto a San José del Cabo</h3>
            </div>
            <div class="p-8 text-center">
              <p class="text-slate-500 text-sm mb-4">A la zona hotelera y residencial de San José</p>
              <div class="flex justify-center items-baseline gap-1 mb-2">
                <span class="text-navy font-bold text-5xl">$75</span>
                <span class="text-navy/60 text-lg font-bold uppercase">USD</span>
              </div>
              <p class="text-base text-slate-500 font-bold uppercase tracking-wider">1 a 10 Invitados</p>
            </div>
          </div>
          <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm hover:shadow-lg transition-shadow">
            <div class="bg-cabo-orange py-4 px-6 text-center">
              <h3 class="text-white text-sm font-bold uppercase tracking-widest">Aeropuerto a Puerto Los Cabos</h3>
