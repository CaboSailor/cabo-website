---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import { Image } from 'astro:assets';

// Images
import vanDesertImg from "../../assets/images/blog/van-shuttle-in-the-desert.png";
import rocksImg from "../../assets/images/blog/relaxing-in-front-of-the-rocks.jpg";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cabosailing.com/es/" },
    { "@type": "ListItem", "position": 2, "name": "Servicio de Transporte" }
  ]
});

const faqs = [
  { q: "¿Cómo reservo el servicio de transporte?", a: "Durante el proceso de reserva se te preguntará si deseas incluir el servicio privado de transporte para tu crucero." },
  { q: "Solo quiero más información. ¿Cómo los contacto?", a: "Puedes hacer clic en el botón Contáctanos, enviarnos un mensaje por WhatsApp o llamarnos. Con gusto te ayudaremos a confirmar disponibilidad, precios y detalles del punto de recogida." },
  { q: "¿Puedo reservar mi crucero primero y decidir el transporte después?", a: "Por supuesto. Puedes reservar tu crucero primero y agregar el servicio de transporte más tarde, sujeto a disponibilidad." },
  { q: "¿Hasta dónde opera el servicio de transporte?", a: "Ofrecemos servicio de transporte en todo Cabo San Lucas y San José del Cabo. Para zonas más lejanas como East Cape, La Ribera, Pescadero o Todos Santos, con gusto te enviaremos una cotización personalizada." },
  { q: "¿El transporte es privado o compartido?", a: "Todos nuestros servicios de transporte son privados. La van está reservada únicamente para tu grupo." },
  { q: "¿Puedo reservar solo el viaje sencillo?", a: "Por supuesto. Puedes elegir viaje redondo o sencillo. Consulta la tabla de precios arriba para más detalles." },
  { q: "¿Pueden recoger a los invitados en varios lugares?", a: "En la mayoría de los casos, sí. Algunas rutas o combinaciones de recogida pueden requerir tiempo adicional o un cargo extra. Lo confirmaremos contigo antes de finalizar el servicio." },
  { q: "¿El chofer habla inglés?", a: "Sí. Nuestros choferes hablan inglés y español." },
  { q: "¿Qué tipo de van nos recogerá?", a: "Operamos vans Toyota modernas con aire acondicionado. Cada van tiene capacidad cómoda y segura para hasta 11 invitados." }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});
---

<BaseLayout title="Transporte y Traslados al Aeropuerto en Los Cabos | Cabo Sailing" description="Transporte y traslado privado al aeropuerto SJD en Los Cabos. Vehículos con AC, choferes bilingües, servicio puerta a puerta." hreflangs={{ en: '/shuttle-service', es: '/es/shuttle-service' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <Header variant="subpage" activePage="shuttle" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- ========== MOBILE LAYOUT ========== -->
    <div class="lg:hidden">
      <div class="relative w-full h-[45vh] overflow-hidden">
        <Image alt="Van de transporte de Cabo Sailing en el desierto" class="w-full h-full object-cover" src={vanDesertImg} width={800} height={500} />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/30 via-navy/10 to-transparent"></div>
        <div class="absolute bottom-12 left-0 right-0 px-6">
          <h1 class="text-3xl text-white mb-2 leading-tight font-serif">Transporte sin Complicaciones a tu Crucero y de Regreso</h1>
          <p class="text-white/80 text-base font-medium tracking-wide uppercase">Servicio Privado Puerta a Puerta</p>
        </div>
      </div>
      <div class="px-5 pt-5">
        <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
          <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-navy font-semibold">Servicio de Transporte</span>
        </nav>
        <p class="text-navy font-bold mb-4 text-lg">¿Por qué usar nuestro servicio?</p>
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-cabo-blue text-base">security</span>
            </div>
            <span class="text-base font-medium text-slate-600">¡La seguridad es nuestra prioridad #1!</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-cabo-blue text-base">language</span>
            </div>
            <span class="text-base font-medium text-slate-600">Choferes profesionales bilingües</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cabo-blue/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-cabo-blue text-base">payments</span>
            </div>
            <span class="text-base font-medium text-slate-600">Precios Competitivos</span>
          </div>
        </div>
      </div>

      <!-- MOBILE: Seamless Shuttle Section -->
      <div class="px-5 pt-8 pb-6">
        <div class="flex items-center gap-3 mb-4"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">Transporte sin Complicaciones a tu Crucero y de Regreso</h3></div>
        <Image src={rocksImg} alt="Invitados relajándose frente a las rocas" class="w-full h-48 object-cover rounded-2xl mb-4" width={600} height={200} />
        <p class="text-base text-slate-500 leading-relaxed mb-3">Llegar a la marina para tu crucero en velero debería ser la parte más fácil de tu día. Nuestro transporte privado te recoge directamente en tu alojamiento y te lleva directo a la Marina de Cabo San Lucas — y te trae de regreso al terminar el crucero.</p>
        <p class="text-base text-slate-500 leading-relaxed">Sin esperar taxis, sin navegar calles desconocidas. Solo súbete, relájate y déjanos manejar el viaje para que te enfoques en la aventura que te espera.</p>
        <div class="flex gap-6 mt-6">
          <div><p class="text-xl font-bold text-navy font-serif">Todo el Día</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Disponible</p></div>
          <div class="w-px bg-border-light"></div>
          <div><p class="text-xl font-bold text-navy font-serif">Privado</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Vehículo</p></div>
          <div class="w-px bg-border-light"></div>
          <div><p class="text-xl font-bold text-navy font-serif">Puerta a Puerta</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Servicio</p></div>
        </div>
      </div>

      <!-- Mobile: Hotel & Residential -->
      <div class="mt-12 px-5">
        <div class="text-center mb-8">
          <h2 class="text-2xl text-navy mb-2">Servicio de transportación</h2>
          <p class="text-slate-500 text-sm px-4">Se puede reservar durante el proceso de reserva del crucero o por separado.</p>
        </div>
        <div class="bg-white rounded-[2rem] overflow-hidden border border-border-light shadow-lg">
          <div class="bg-navy py-4 px-6 text-center">
            <h3 class="text-white text-sm font-bold uppercase tracking-widest">Traslados de Hotel y Residencial para Crucero</h3>
          </div>
          <div class="p-6 space-y-6">
            <div>
              <h4 class="text-navy text-sm font-bold uppercase mb-3 border-b border-slate-100 pb-2">Cabo San Lucas a Puente de Palmilla</h4>
              <div class="flex justify-between items-center text-base mb-2">
                <span class="text-slate-600">Sencillo (1-10 invitados)</span>
                <span class="font-bold text-navy">$70 USD</span>
              </div>
              <div class="flex justify-between items-center text-base">
                <span class="text-slate-600">Redondo (1-10 invitados)</span>
                <span class="font-bold text-navy">$120 USD</span>
              </div>
            </div>
            <div>
              <h4 class="text-navy text-sm font-bold uppercase mb-3 border-b border-slate-100 pb-2">Palmilla a Puerto Los Cabos</h4>
              <div class="flex justify-between items-center text-base mb-2">
                <span class="text-slate-600">Sencillo (1-10 invitados)</span>
                <span class="font-bold text-navy">$80 USD</span>
              </div>
              <div class="flex justify-between items-center text-base">
                <span class="text-slate-600">Redondo (1-10 invitados)</span>
                <span class="font-bold text-navy">$145 USD</span>
              </div>
            </div>
            <p class="text-base text-center text-slate-500 font-bold uppercase pt-2">Invitado extra (a partir del 11°): $10 USD por invitado</p>
          </div>
        </div>
      </div>

    </div><!-- end mobile -->

    <!-- ========== DESKTOP LAYOUT ========== -->
    <div class="hidden lg:block">

      <!-- Hero Gallery -->
      <div class="max-w-[1400px] mx-auto px-10 pt-6">
        <div class="rounded-2xl overflow-hidden relative h-[55vh]">
          <Image alt="Van de transporte de Cabo Sailing en el desierto" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={vanDesertImg} width={1400} height={800} />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent rounded-2xl"></div>
          <div class="absolute bottom-6 left-6">
            <span class="bg-cabo-blue text-white text-sm font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-3 inline-block">Servicio Puerta a Puerta</span>
            <h1 class="text-4xl text-white leading-tight">Transporte sin Complicaciones<br/>a tu Crucero y de Regreso</h1>
          </div>
        </div>
      </div>

      <!-- Breadcrumb -->
      <div class="max-w-[1400px] mx-auto px-10 pt-5">
        <nav class="flex items-center gap-1.5 text-xs text-slate-500" aria-label="Breadcrumb">
          <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-navy font-semibold">Servicio de Transporte</span>
        </nav>
      </div>

      <!-- Why Choose Us -->
      <div class="max-w-[1400px] mx-auto px-10 py-10">
        <div class="grid grid-cols-3 gap-6 mb-10">
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">security</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Seguridad Primero</h3>
            <p class="text-slate-500 text-base">Vehículos con licencia y asegurados, con choferes profesionalmente capacitados. Tu seguridad es nuestra prioridad #1.</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">language</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Choferes Bilingües</h3>
            <p class="text-slate-500 text-base">Choferes profesionales que hablan inglés y español, y conocen Los Cabos a la perfección.</p>
          </div>
          <div class="bg-light-grey rounded-2xl p-8 border border-border-light text-center">
            <div class="w-14 h-14 rounded-full bg-cabo-blue/10 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-cabo-blue text-2xl">payments</span>
            </div>
            <h3 class="text-navy font-bold text-lg mb-2">Precios Competitivos</h3>
            <p class="text-slate-500 text-base">Precios transparentes sin cargos ocultos. Reserva directo y ahorra comparado con los traslados del hotel.</p>
          </div>
        </div>

        <!-- About Section -->
        <div class="flex gap-12 items-center">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4"><div class="w-1 h-8 bg-gold rounded-full"></div><h2 class="text-3xl text-navy">Transporte sin Complicaciones a tu Crucero y de Regreso</h2></div>
            <p class="text-slate-500 text-lg leading-relaxed mb-4">Llegar a la marina para tu crucero en velero debería ser la parte más fácil de tu día. Nuestro transporte privado te recoge directamente en tu alojamiento y te lleva directo a la Marina de Cabo San Lucas — y te trae de regreso al terminar el crucero.</p>
            <p class="text-slate-500 text-lg leading-relaxed mb-6">Sin esperar taxis, sin navegar calles desconocidas. Solo súbete, relájate y déjanos manejar el viaje para que te enfoques en la aventura que te espera.</p>
            <div class="flex gap-10">
              <div><p class="text-2xl font-bold text-navy font-serif">Todo el Día</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Disponible</p></div>
              <div class="w-px bg-border-light"></div>
              <div><p class="text-2xl font-bold text-navy font-serif">Privado</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Vehículo</p></div>
              <div class="w-px bg-border-light"></div>
              <div><p class="text-2xl font-bold text-navy font-serif">Puerta a Puerta</p><p class="text-xs text-slate-500 uppercase tracking-widest font-bold mt-1">Servicio</p></div>
            </div>
          </div>
          <div class="w-[400px] h-[300px] rounded-3xl overflow-hidden flex-shrink-0">
            <Image alt="Invitados relajándose frente a las rocas" class="w-full h-full object-cover" src={rocksImg} width={400} height={300} />
          </div>
        </div>
      </div>

      <!-- Hotel & Residential Transfers -->
      <div class="bg-light-grey py-12">
        <div class="max-w-[1400px] mx-auto px-10">
          <div class="text-center mb-8">
            <h2 class="text-3xl text-navy mb-2">Servicio de transportación</h2>
            <p class="text-slate-500 text-base">Se puede reservar durante el proceso de reserva del crucero o por separado.</p>
          </div>
          <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-3xl overflow-hidden border border-border-light shadow-sm">
              <div class="bg-navy py-4 px-8 text-center">
                <h3 class="text-white text-sm font-bold uppercase tracking-widest">Traslados de Hotel y Residencial para Crucero</h3>
              </div>
              <div class="p-8">
                <div class="grid grid-cols-3 gap-8 text-center mb-6">
                  <div></div>
                  <div class="text-sm font-bold text-slate-500 uppercase tracking-widest">Sencillo</div>
                  <div class="text-sm font-bold text-slate-500 uppercase tracking-widest">Redondo</div>
                </div>
                <div class="grid grid-cols-3 gap-8 items-center py-4 border-b border-border-light">
                  <div class="text-navy font-bold">Cabo San Lucas a Puente de Palmilla</div>
                  <div class="text-center text-lg font-bold text-navy">$70 <span class="text-sm text-navy/60">USD</span></div>
                  <div class="text-center text-lg font-bold text-navy">$120 <span class="text-sm text-navy/60">USD</span></div>
                </div>
                <div class="grid grid-cols-3 gap-8 items-center py-4 border-b border-border-light">
                  <div class="text-navy font-bold">Palmilla a Puerto Los Cabos</div>
                  <div class="text-center text-lg font-bold text-navy">$80 <span class="text-sm text-navy/60">USD</span></div>
                  <div class="text-center text-lg font-bold text-navy">$145 <span class="text-sm text-navy/60">USD</span></div>
                </div>
                <p class="text-sm text-center text-slate-500 font-bold uppercase pt-6">Invitado extra (a partir del 11°): $10 USD por invitado</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div><!-- end desktop layout -->

    <!-- FAQ Section -->
    <section class="px-5 pt-12 pb-8 lg:max-w-4xl lg:mx-auto lg:px-10 lg:pt-12 lg:pb-8">
      <div class="text-center mb-8 lg:mb-12">
        <h2 class="text-2xl lg:text-3xl text-navy mb-2">Preguntas Frecuentes</h2>
        <p class="text-slate-500 text-base">Todo lo que necesitas saber sobre nuestro servicio de transporte.</p>
      </div>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-white border border-border-light rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 lg:p-6 cursor-pointer list-none">
              <span class="text-navy font-bold text-base lg:text-lg">{faq.q}</span>
              <span class="material-symbols-outlined text-cabo-blue flex-shrink-0 transition-transform duration-200 group-open:rotate-45">add</span>
            </summary>
            <div class="px-5 pb-5 lg:px-6 lg:pb-6 -mt-1">
              <p class="text-slate-500 text-base leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Guest Reviews Carousel -->
    <div class="px-5 pb-12 lg:max-w-[1400px] lg:mx-auto lg:px-10 lg:pt-4 lg:pb-12">
      <div class="flex items-center gap-3 mb-4 lg:mb-8"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg lg:text-3xl text-navy">Lo Que Dicen Nuestros Invitados</h3></div>
      <div class="relative">
        <div id="m-carousel" class="flex overflow-x-auto gap-4 lg:gap-6 no-scrollbar snap-x snap-mandatory pb-4 lg:overflow-hidden">
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"El chofer estaba en llegadas con un letrero con nuestro nombre, super fácil de encontrarlo. La van limpia y el aire ya estaba prendido. Después de un vuelo de 5 horas era justo lo que necesitábamos."</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-navy flex items-center justify-center text-white text-sm font-bold">PH</div><div><p class="text-sm font-bold text-navy">Patricia H.</p><p class="text-base text-slate-500">Dallas, TX</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Grupo de 8, reservamos ida y vuelta. Llegaron a tiempo en los dos viajes. Nuestro chofer nos dio varias recomendaciones de restaurantes camino al resort y uno terminó siendo nuestra comida favorita del viaje."</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center text-white text-sm font-bold">BN</div><div><p class="text-sm font-bold text-navy">Brian N.</p><p class="text-base text-slate-500">Chicago, IL</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Les mandé WhatsApp la noche anterior para confirmar y me contestaron en minutos. El chofer llegó temprano, conocía la ciudad, llegamos a la marina con tiempo de sobra. Cero estrés."</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-navy/70 flex items-center justify-center text-white text-sm font-bold">KL</div><div><p class="text-sm font-bold text-navy">Karen L.</p><p class="text-base text-slate-500">Los Angeles, CA</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Nuestro vuelo llegó como a las 11pm y el chofer seguía ahí esperándonos, sin mala cara. Tenía agua fría en la van. Trayecto fácil al hotel. Mucho mejor que andar buscando taxi a esa hora."</p>
            <div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-navy flex items-center justify-center text-white text-sm font-bold">MT</div><div><p class="text-sm font-bold text-navy">Mark T.</p><p class="text-base text-slate-500">New York, NY</p></div></div>
          </div>
          <div class="snap-center shrink-0 w-[85vw] sm:w-[420px] lg:w-[calc((100%-3rem)/3)] bg-light-grey rounded-2xl p-5 border border-border-light">
            <div class="flex items-center gap-1 mb-2"><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span><span class="material-symbols-outlined text-gold filled text-base">star</span></div>
            <p class="text-base text-slate-600 leading-relaxed italic mb-3">"Los usamos para llegar a la marina para nuestro tour de snorkel. Reservar por WhatsApp super fácil, sin descargar ninguna app. El chofer amable. Honestamente más fácil que cualquier Uber que he tomado."</p>
