  <Footer />
  <FloatingCTA />
  <RezdyModal />

  <style is:inline>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .material-symbols-outlined.filled { font-variation-settings: 'FILL' 1; }
  </style>

  <script is:inline>
    var shuttlePage = 0;
    function scrollShuttleReviews(dir) {
      shuttlePage = Math.max(0, Math.min(1, shuttlePage + dir));
      var container = document.getElementById('m-carousel');
      var card = container.children[0];
      var gap = 24;
      container.scrollTo({ left: (card.offsetWidth + gap) * 3 * shuttlePage, behavior: 'smooth' });
      document.querySelectorAll('.shuttle-review-dot').forEach(function(dot, i) {
        dot.className = 'shuttle-review-dot w-2.5 h-2.5 rounded-full transition-colors ' + (i === shuttlePage ? 'bg-navy' : 'bg-border-light');
      });
    }
    function goToShuttlePage(page) { shuttlePage = page; scrollShuttleReviews(0); }
  </script>
</BaseLayout>
