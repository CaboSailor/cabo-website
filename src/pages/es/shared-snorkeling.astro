---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import { Image } from 'astro:assets';

import img_4k_01_38_47_13_Still123 from "../../assets/images/guests-on-sailboats/cabo-sailboat-guests-snorkeling-01.jpg";
import img_4k_01_16_49_02_Still113 from "../../assets/images/guests-on-sailboats/cabo-sailboat-guests-snorkeling-02.jpg";
import Cabo_Sailing_1 from "../../assets/images/guests-on-sailboats/cabo-sailing-adventure-guests.jpg";
import snorkeling_8 from "../../assets/images/guests-on-sailboats/cabo-snorkeling-adventure.jpg";
import img_20_Sailing_42 from "../../assets/images/boats/sailing-42/cabo-sailing-42-deck-view.jpg";
import Cabo_Sailing_Snorkeling_17 from "../../assets/images/guests-on-sailboats/cabo-sailing-snorkeling-tour.jpg";
import img_10_Sailing_42 from "../../assets/images/boats/sailing-42/cabo-sailing-42-exterior-01.jpg";
import img_6_Sailing_38 from "../../assets/images/boats/sailing-38/cabo-sailing-38-exterior-02.jpg";
import img_17_Sailing_42 from "../../assets/images/boats/sailing-42/cabo-sailing-42-sailing-view.jpg";
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Tour de Snorkel Compartido en Cabo San Lucas | Cabo Sailing" description="Tour compartido de snorkel a los mejores arrecifes del Arco y Pelican Rock. Equipo, bebidas y snacks incluidos. Salidas diarias desde la marina." hreflangs={{ en: '/shared-snorkeling', es: '/es/shared-snorkeling' }}>
  <Header variant="subpage" activePage="tours" />


  <style is:inline type="text/tailwindcss">
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_4k_01_38_47_13_Still123} alt="Aerial view sailboat in turquoise water" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_4k_01_16_49_02_Still113} alt="Happy snorkelers with thumbs up" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={Cabo_Sailing_1} alt="Woman jumping off bow into turquoise water" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={snorkeling_8} alt="Group snorkeling in Cabo" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_20_Sailing_42} alt="Sailing boat at El Arco" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"Way better than the big group tours. Small boat, great crew, amazing snorkeling."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Chris &amp; Emma W. &mdash; San Diego, CA</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6 relative">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={img_4k_01_38_47_13_Still123} alt="Aerial view sailboat in turquoise water" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={img_4k_01_16_49_02_Still113} alt="Happy snorkelers with thumbs up" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={Cabo_Sailing_1} alt="Woman jumping off bow into turquoise water" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={snorkeling_8} alt="Group snorkeling in Cabo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={Cabo_Sailing_Snorkeling_17} alt="Underwater snorkeling with starfish" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"Way better than the big group tours. Small boat, great crew, amazing snorkeling."</p>
      <p class="text-navy/40 text-[10px] uppercase tracking-widest font-bold mt-2">Chris &amp; Emma W. &mdash; San Diego, CA</p>
    </div>
  </div>
</div>
</div>

<!-- DESKTOP: Two-column layout -->
<div class="hidden lg:flex max-w-[1400px] mx-auto px-10 gap-10 mt-10">
  <!-- Left column -->
  <div class="flex-1 min-w-0">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
      <a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span>Tours</span>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-navy font-semibold">Snorkel Compartido</span>
    </nav>
    <div class="mb-2">
      <h1 class="text-4xl text-navy leading-tight">Tour de Snorkel y Velero Compartido en Cabo</h1>
    </div>
    <p class="text-slate-500 text-base leading-relaxed mt-4">
      Unete a una aventura en velero con grupo pequeno a los lugares mas iconicos de Cabo — navega frente al Arco, haz snorkel en Pelican Rock y disfruta de barra libre y almuerzo a bordo.
    </p>
    <p class="text-slate-500 text-base leading-relaxed mt-3">
      Una forma relajada y social de disfrutar Cabo a un precio inigualable — nunca mas de 14 pasajeros a bordo.
    </p>

    <!-- Badges row -->
    <div class="flex gap-4 mt-8">
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">schedule</span>
        <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Duracion</p>
        <p class="text-base font-bold text-navy">3 Horas</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">sailing</span>
        <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Dificultad</p>
        <p class="text-base font-bold text-navy">Facil</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">family_restroom</span>
        <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Familia</p>
        <p class="text-base font-bold text-navy">Apto</p>
      </div>
      <div class="bg-light-grey rounded-2xl px-6 py-4 flex flex-col items-center text-center border border-border-light flex-1">
        <span class="material-symbols-outlined text-gold mb-2">event_available</span>
        <p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Cancelacion Gratuita</p>
        <p class="text-base font-bold text-navy">Hasta 24h</p>
      </div>
    </div>

    <!-- Sobre esta experiencia -->
    <div class="mt-10">
      <h3 class="text-2xl text-navy mb-4">Sobre esta experiencia</h3>
      <p class="text-slate-500 leading-relaxed text-base">
        Unete a nuestro popular tour de snorkel compartido y descubre la magia de Cabo San Lucas junto a otros aventureros. Visita el famoso Arco, haz snorkel entre peces tropicales en Pelican Rock y disfruta de barra libre y almuerzo a bordo — todo a un precio inigualable. Nuestra experimentada tripulacion bilingue se asegura de que todos tengan una experiencia segura, divertida e inolvidable en el agua.
      </p>

      <!-- La Experiencia timeline -->
      <div class="mt-8">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-1 h-6 bg-gold rounded-full"></div>
          <h4 class="text-sm font-bold text-navy uppercase tracking-widest">La Experiencia</h4>
        </div>
        <ol class="relative border-l-2 border-gold/30 ml-2 space-y-5 pl-6">
          <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-base">9:00 AM — Abordaje en la marina, las bebidas comienzan de inmediato</span></li>
          <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-base">Navega frente a Land's End — el Arco, la colonia de lobos marinos y formaciones rocosas</span></li>
          <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-base">Snorkel en Pelican Rock con peces tropicales, rayas y lobos marinos</span></li>
          <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-base">Disfruta del almuerzo y bebidas ilimitadas en cubierta</span></li>
          <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-base">12:00 PM — Regreso a la marina con nuevos amigos y grandes recuerdos</span></li>
        </ol>
        <p class="mt-5 text-slate-500 italic text-sm">Una aventura relajada y social en el agua — y un valor inigualable.</p>
      </div>
    </div>

    <!-- Que Incluye -->
    <div class="mt-10">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-6 bg-gold rounded-full"></div>
        <h3 class="text-2xl text-navy">Que Incluye</h3>
      </div>
      <div class="grid grid-cols-2 gap-5 pl-1">
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">local_bar</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Barra libre</span>
            <p class="text-slate-400 text-sm">Disfruta de bebidas refrescantes durante todo el crucero</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">restaurant</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Almuerzo ligero a bordo</span>
            <p class="text-slate-400 text-sm">Snacks frescos servidos despues del snorkel</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">scuba_diving</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Experiencia de snorkel</span>
            <p class="text-slate-400 text-sm">Equipo incluido — explora los mejores spots de Cabo</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">sailing</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Velero comodo</span>
            <p class="text-slate-400 text-sm">Navegacion suave con cupo limitado de pasajeros</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">dry_cleaning</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Toallas incluidas</span>
            <p class="text-slate-400 text-sm">Todo lo que necesitas para el agua</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">person</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Tripulacion bilingue experimentada</span>
            <p class="text-slate-400 text-sm">Amigable, profesional y enfocada en la seguridad</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Punto de Encuentro - desktop -->
    <div class="mt-12 bg-light-grey rounded-2xl p-8 border border-border-light max-w-[500px] ml-auto">
      <div class="flex items-center gap-3 mb-4">
        <span class="material-symbols-outlined text-gold text-2xl">pin_drop</span>
        <h3 class="text-lg font-bold text-navy uppercase tracking-wider">Punto de Encuentro</h3>
      </div>
      <p class="text-lg font-semibold text-navy mb-1">Cabo San Lucas Marina, IGY Marina, Dock F</p>
      <p class="text-sm text-slate-500 leading-relaxed mb-4">Busca al equipo de Cabo Sailing con polos negros y nuestro logo. Por favor llega 15 minutos antes de la salida.</p>
      <div class="flex items-center gap-2 text-sm text-slate-500">
        <span class="material-symbols-outlined text-gold text-base">schedule</span>
        <span class="font-semibold text-navy">SALIDAS: 9:00 AM DIARIO</span>
      </div>
    </div>
  </div>

  <!-- Right column - Calendar -->
  <div class="w-[380px] flex-shrink-0">
    <div class="sticky top-[90px] bg-white rounded-3xl shadow-xl shadow-navy/5 border border-border-light overflow-hidden">
      <div class="bg-gradient-to-br from-navy via-navy to-[#1a3a5c] p-6 text-center border-b-4 border-gold">
        <h3 class="text-white text-2xl font-heading tracking-wide">Reserva Tu Lugar</h3>
        <p class="text-white/70 text-sm mt-1">Lugares limitados — reserva hoy para asegurar tu fecha</p>
      </div>
      <!-- Boat card 38'-42' (no icons) -->
      <div class="p-5 pb-0">
        <div class="w-full bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5">
          <div class="h-[360px] w-full relative">
            <div class="boat-carousel relative w-full h-full">
              <Image src={img_10_Sailing_42} alt="Sailing Boat 38'-42'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-100 transition-opacity duration-700" width={800} height={500} />
              <Image src={img_6_Sailing_38} alt="Sailing Boat 38'-42'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" width={800} height={500} />
              <Image src={img_17_Sailing_42} alt="Sailing Boat 38'-42'" class="boat-slide w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-700" width={800} height={500} />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <h4 class="text-white text-lg font-heading">Sailing Boat 38'-42'</h4>
              <div class="flex items-center gap-2 text-white/90 text-xs mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-sm">group</span><span>Hasta 14 Pasajeros</span></div>
            </div>
            <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
            <button class="fleet-arrow left" onclick="fleetNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
            <button class="fleet-arrow right" onclick="fleetNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
          </div>
        </div>
      </div>
      <div class="p-5">
        <p class="text-center text-slate-500 text-sm mb-3">Selecciona una fecha para ver disponibilidad</p>
        <iframe seamless="" width="100%" height="800px" frameborder="0" class="rezdy" src="https://cabosailing.rezdy.com/productsCalendar/561442?iframe=true" style="border:none;"></iframe>
        <div class="mt-5 space-y-3">
          <div class="flex justify-between items-center py-2 border-b border-border-light">
            <span class="text-sm text-slate-500">Por persona</span>
            <div class="flex items-baseline gap-2">
              <span class="text-red-600 line-through decoration-2 text-sm font-semibold">$120</span>
              <span class="text-navy font-bold text-xl">$102</span>
            </div>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-slate-500">Duracion</span>
            <span class="text-navy font-semibold">3 Horas</span>
          </div>
        </div>
        <button onclick="document.getElementById('rezdy-modal-shared-snorkel').classList.remove('hidden')" class="block w-full bg-navy text-white font-bold text-sm py-4 rounded-2xl uppercase tracking-[0.15em] text-center shadow-lg mt-5 hover:bg-navy/90 transition-colors cursor-pointer">
          Ver Disponibilidad
        </button>
        <a href="https://wa.me/526241916997?text=Hi%2C%20I'd%20like%20to%20book%20the%20Shared%20Snorkeling%20Tour" target="_blank" class="block w-full bg-[#25D366] text-white font-bold text-sm py-4 rounded-2xl uppercase tracking-[0.15em] text-center shadow-lg mt-3 hover:bg-[#20bd5a] transition-colors">
          <i class="fa-brands fa-whatsapp text-lg mr-2" style="vertical-align:middle"></i> Reservar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>

<!-- MOBILE: Card layout -->
<div class="lg:hidden relative z-10 -mt-4 px-5">
<div class="bg-white rounded-3xl p-6 shadow-xl shadow-navy/5 border border-border-light">
<nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
<a href="/es/" class="hover:text-gold transition-colors">Inicio</a>
<span class="material-symbols-outlined text-[14px]">chevron_right</span>
<span>Tours</span>
<span class="material-symbols-outlined text-[14px]">chevron_right</span>
<span class="text-navy font-semibold">Snorkel Compartido</span>
</nav>
<div class="flex flex-col gap-1 mb-6">
<div>
<h1 class="text-2xl text-navy leading-tight">Tour de Snorkel y Velero Compartido en Cabo</h1>
</div>
<p class="text-slate-500 text-sm leading-relaxed mt-3">Unete a una aventura en velero con grupo pequeno — navega frente al Arco, haz snorkel en Pelican Rock y disfruta de barra libre y almuerzo a bordo.</p>
<p class="text-slate-500 text-sm leading-relaxed mt-2">Una forma relajada y social de disfrutar Cabo a un precio inigualable — nunca mas de 14 pasajeros a bordo.</p>
</div>
<div class="grid grid-cols-2 gap-4">
<div class="bg-light-grey rounded-2xl p-4 flex flex-col items-center text-center border border-border-light">
<span class="material-symbols-outlined text-gold mb-2">schedule</span>
<p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Duracion</p>
<p class="text-base font-bold text-navy">3 Horas</p>
</div>
<div class="bg-light-grey rounded-2xl p-4 flex flex-col items-center text-center border border-border-light">
<span class="material-symbols-outlined text-gold mb-2">sailing</span>
<p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Dificultad</p>
<p class="text-base font-bold text-navy">Facil</p>
</div>
<div class="bg-light-grey rounded-2xl p-4 flex flex-col items-center text-center border border-border-light">
<span class="material-symbols-outlined text-gold mb-2">family_restroom</span>
<p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Familia</p>
<p class="text-base font-bold text-navy">Apto</p>
</div>
<div class="bg-light-grey rounded-2xl p-4 flex flex-col items-center text-center border border-border-light">
<span class="material-symbols-outlined text-gold mb-2">event_available</span>
<p class="text-xs text-slate-400 uppercase font-bold tracking-widest mb-1">Cancelacion Gratuita</p>
<p class="text-base font-bold text-navy">Hasta 24h</p>
</div>
</div>

