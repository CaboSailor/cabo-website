---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';

// Hero
import heroImg from '../assets/images/guests-on-sailboats/sailing-near-cabos-rocky-coastline.png';

// 3 promo cards
import promoYacht from '../assets/images/guests-on-yachts/leisurely-yacht-ride-on-a-sunny-sea.png';
import promoPrivateSail from '../assets/images/guests-on-sailboats/relaxing-summer-sailboat-escape.png';
import promoSharedSail from '../assets/images/guests-on-sailboats/golden-hour-sailing-with-friends.png';

// Fleet (one image per boat — first frame from carousels.json)
import yacht51 from '../assets/images/boats/yacht-51/cabo-sailing-yacht-51-boat.png';
import yacht45 from '../assets/images/boats/yacht-45/cabo-private-yacht-45-charter.png';
import yacht42 from '../assets/images/boats/yacht-42/cabo-sailig-yacht-42-boat.png';
import sailing42 from '../assets/images/boats/sailing-42/cabo-sailing-42-sailing-view.png';
import sailing38 from '../assets/images/boats/sailing-38/cabo-sailing-38-home-boat.png';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Special Offers" }
  ]
});
---

<BaseLayout title="Special Offers | Cabo Sailing" description="Limited-time 30% off private yacht charters, private sailing cruises, and sailing trips in Cabo San Lucas. Premium service, small groups, all-inclusive pricing." hreflangs={{ en: '/special-offers', es: '/es/special-offers' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="special-offers" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Hero (wider than content column) -->
    <div class="max-w-[1075px] mx-auto px-5 lg:px-8 pt-10 lg:pt-16">
      <div class="relative rounded-2xl overflow-hidden">
        <Image src={heroImg} alt="Sailing near Cabo's rocky coastline" class="w-full h-auto" width={2048} height={1365} />
        <!-- Text overlay (sits lower, over the ocean for natural contrast) -->
        <div class="absolute inset-x-0 bottom-0 flex flex-col items-start px-5 sm:px-8 lg:px-12 xl:px-16 pb-10 sm:pb-16 lg:pb-[7.5rem] xl:pb-[9.5rem]">
          <p class="text-[10px] sm:text-xs xl:text-sm font-bold uppercase tracking-[0.2em] sm:tracking-[0.25em] text-white mb-1.5 sm:mb-3 [text-shadow:0_2px_8px_rgba(0,0,0,0.55)]">Limited&ndash;Time Savings</p>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl text-white font-serif mb-2 sm:mb-4 leading-tight [text-shadow:0_3px_14px_rgba(0,0,0,0.6)]">Special Offers</h1>
          <p class="text-white text-sm sm:text-base lg:text-lg xl:text-xl leading-relaxed max-w-xl [text-shadow:0_2px_10px_rgba(0,0,0,0.55)]">Lock in <strong class="text-white">up to 40% off</strong> our most-loved cruises</p>
        </div>
      </div>
    </div>

    <div class="max-w-[1100px] mx-auto px-5 lg:px-8 pt-6 lg:pt-8 pb-10 lg:pb-16">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">Special Offers</span>
      </nav>

      <!-- Short supporting copy under hero (title is on the image at all sizes) -->
      <p class="text-slate-500 text-base lg:text-lg leading-relaxed max-w-3xl mx-auto text-center mb-10">Same premium fleet, same five-star crew, lower price for a limited time.</p>

      <!-- 3 Promo Cards -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6 mb-14 lg:mb-20">

        <!-- Private Yacht -->
        <a href="/tours/private-snorkeling/" class="group relative block bg-white border border-border-light rounded-[2rem] overflow-hidden shadow-xl shadow-navy/5 transition-transform duration-300 hover:-translate-y-1">
          <div class="relative aspect-[4/5] overflow-hidden">
            <Image src={promoYacht} alt="Leisurely yacht ride on a sunny sea" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" width={1024} height={1280} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/25 via-navy/5 to-transparent"></div>

            <!-- Big 35% badge -->
            <div class="absolute top-4 left-4 bg-accent-gold text-white rounded-2xl px-4 py-2 lg:px-5 lg:py-3 shadow-2xl">
              <div class="flex items-baseline gap-1">
                <span class="font-serif font-bold text-3xl lg:text-4xl leading-none">35%</span>
                <span class="font-bold text-xs lg:text-sm uppercase tracking-widest">Off</span>
              </div>
            </div>

            <div class="absolute bottom-5 left-6 right-6">
              <h3 class="text-white text-2xl lg:text-3xl font-serif leading-tight mb-1">Private Yacht</h3>
              <p class="text-white/80 text-xs lg:text-sm uppercase tracking-widest font-semibold">Charter the whole boat</p>
            </div>
          </div>
          <div class="p-5 flex items-center justify-between">
            <span class="text-navy/70 text-sm">Up to 20 guests &middot; Crew &amp; bar included</span>
            <span class="material-symbols-outlined text-accent-gold transition-transform group-hover:translate-x-1">arrow_forward</span>
          </div>
        </a>

        <!-- Private Sailing -->
        <a href="/tours/private-sunset/" class="group relative block bg-white border border-border-light rounded-[2rem] overflow-hidden shadow-xl shadow-navy/5 transition-transform duration-300 hover:-translate-y-1">
          <div class="relative aspect-[4/5] overflow-hidden">
            <Image src={promoPrivateSail} alt="Relaxing summer sailboat escape" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" width={1024} height={1280} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/25 via-navy/5 to-transparent"></div>

            <div class="absolute top-4 left-4 bg-accent-gold text-white rounded-2xl px-4 py-2 lg:px-5 lg:py-3 shadow-2xl">
              <div class="flex items-baseline gap-1">
                <span class="font-serif font-bold text-3xl lg:text-4xl leading-none">40%</span>
                <span class="font-bold text-xs lg:text-sm uppercase tracking-widest">Off</span>
              </div>
            </div>

            <div class="absolute bottom-5 left-6 right-6">
              <h3 class="text-white text-2xl lg:text-3xl font-serif leading-tight mb-1">Private Sailing</h3>
              <p class="text-white/80 text-xs lg:text-sm uppercase tracking-widest font-semibold">Your group, your sailboat</p>
            </div>
          </div>
          <div class="p-5 flex items-center justify-between">
            <span class="text-navy/70 text-sm">Up to 14 guests &middot; True wind sailing</span>
            <span class="material-symbols-outlined text-accent-gold transition-transform group-hover:translate-x-1">arrow_forward</span>
          </div>
        </a>

        <!-- Sailing Cruise -->
        <a href="/tours/sunset-sailing/" class="group relative block bg-white border border-border-light rounded-[2rem] overflow-hidden shadow-xl shadow-navy/5 transition-transform duration-300 hover:-translate-y-1">
          <div class="relative aspect-[4/5] overflow-hidden">
            <Image src={promoSharedSail} alt="Golden hour sailing with friends" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" width={1024} height={1280} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/25 via-navy/5 to-transparent"></div>

            <div class="absolute top-4 left-4 bg-accent-gold text-white rounded-2xl px-4 py-2 lg:px-5 lg:py-3 shadow-2xl">
              <div class="flex items-baseline gap-1">
                <span class="font-serif font-bold text-3xl lg:text-4xl leading-none">40%</span>
                <span class="font-bold text-xs lg:text-sm uppercase tracking-widest">Off</span>
              </div>
            </div>

            <div class="absolute bottom-5 left-6 right-6">
              <h3 class="text-white text-2xl lg:text-3xl font-serif leading-tight mb-1">Sailing Cruise</h3>
              <p class="text-white/80 text-xs lg:text-sm uppercase tracking-widest font-semibold">Per-person pricing</p>
            </div>
          </div>
          <div class="p-5 flex items-center justify-between">
            <span class="text-navy/70 text-sm">Max 14 guests per tour</span>
            <span class="material-symbols-outlined text-accent-gold transition-transform group-hover:translate-x-1">arrow_forward</span>
          </div>
        </a>

      </section>

      <!-- Fleet (5 boats side-by-side) -->
      <section>
        <div class="flex items-center gap-4 mb-6">
          <h2 class="text-xl lg:text-2xl font-serif text-navy font-semibold">All boats &mdash; 35-40% off charter price</h2>
          <div class="flex-1 h-px bg-gradient-to-r from-gold/30 to-transparent"></div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">

          <!-- 51' Luxury Yacht -->
          <div class="bg-white border border-border-light rounded-2xl overflow-hidden shadow-lg shadow-navy/5" data-boat="yacht-51">
            <div class="relative aspect-[3/4] overflow-hidden">
              <Image src={yacht51} alt="Luxury Yacht 51' private charter in Cabo San Lucas" class="w-full h-full object-cover" style="transform: scale(1.1);" width={1023} height={1537} />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4">
                <h4 class="text-white text-sm lg:text-base font-semibold">Luxury Yacht 51'</h4>
                <div class="flex items-center gap-1 text-white/80 text-[10px] mt-0.5 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 20</span></div>
              </div>
              <div class="absolute top-3 right-3 bg-white text-navy font-bold text-xs px-2 py-1 rounded-lg shadow">-30%</div>
            </div>
            <div class="p-3 space-y-3">
              <div class="flex flex-col">
                <span class="text-accent-gold line-through decoration-2 text-xs font-semibold">$1,690</span>
                <div class="flex items-baseline gap-1">
                  <span class="text-slate-500 text-[10px] font-medium uppercase">from</span>
                  <span class="text-navy font-bold text-lg">$1,436</span>
                </div>
                <span class="text-slate-500 text-[10px] font-medium uppercase">/ 1&ndash;4 guests</span>
              </div>
              <button type="button" onclick="openRezdyModal('165509')" class="block w-full bg-navy text-white font-bold text-[10px] py-2.5 rounded-lg uppercase tracking-widest text-center shadow">Check Availability</button>
            </div>
          </div>

          <!-- 45' Luxury Yacht -->
          <div class="bg-white border border-border-light rounded-2xl overflow-hidden shadow-lg shadow-navy/5" data-boat="yacht-45">
            <div class="relative aspect-[3/4] overflow-hidden">
              <Image src={yacht45} alt="Luxury Yacht 45' private charter in Cabo San Lucas" class="w-full h-full object-cover" width={1023} height={1537} />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4">
                <h4 class="text-white text-sm lg:text-base font-semibold">Luxury Yacht 45'</h4>
                <div class="flex items-center gap-1 text-white/80 text-[10px] mt-0.5 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 12</span></div>
              </div>
              <div class="absolute top-3 right-3 bg-white text-navy font-bold text-xs px-2 py-1 rounded-lg shadow">-30%</div>
            </div>
            <div class="p-3 space-y-3">
              <div class="flex flex-col">
                <span class="text-accent-gold line-through decoration-2 text-xs font-semibold">$1,520</span>
                <div class="flex items-baseline gap-1">
                  <span class="text-slate-500 text-[10px] font-medium uppercase">from</span>
                  <span class="text-navy font-bold text-lg">$1,292</span>
                </div>
                <span class="text-slate-500 text-[10px] font-medium uppercase">/ 1&ndash;4 guests</span>
              </div>
              <button type="button" onclick="openRezdyModal('528988')" class="block w-full bg-navy text-white font-bold text-[10px] py-2.5 rounded-lg uppercase tracking-widest text-center shadow">Check Availability</button>
            </div>
          </div>

          <!-- 42' Luxury Yacht -->
          <div class="bg-white border border-border-light rounded-2xl overflow-hidden shadow-lg shadow-navy/5" data-boat="yacht-42">
            <div class="relative aspect-[3/4] overflow-hidden">
              <Image src={yacht42} alt="Luxury Yacht 42' private charter in Cabo San Lucas" class="w-full h-full object-cover" style="transform: scale(1.1);" width={1023} height={1537} />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4">
                <h4 class="text-white text-sm lg:text-base font-semibold">Luxury Yacht 42'</h4>
                <div class="flex items-center gap-1 text-white/80 text-[10px] mt-0.5 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 18</span></div>
              </div>
              <div class="absolute top-3 right-3 bg-white text-navy font-bold text-xs px-2 py-1 rounded-lg shadow">-30%</div>
            </div>
            <div class="p-3 space-y-3">
              <div class="flex flex-col">
                <span class="text-accent-gold line-through decoration-2 text-xs font-semibold">$1,350</span>
                <div class="flex items-baseline gap-1">
                  <span class="text-slate-500 text-[10px] font-medium uppercase">from</span>
                  <span class="text-navy font-bold text-lg">$1,148</span>
                </div>
                <span class="text-slate-500 text-[10px] font-medium uppercase">/ 1&ndash;4 guests</span>
              </div>
              <button type="button" onclick="openRezdyModal('168008')" class="block w-full bg-navy text-white font-bold text-[10px] py-2.5 rounded-lg uppercase tracking-widest text-center shadow">Check Availability</button>
            </div>
          </div>

          <!-- 42' Sailing Boat -->
          <div class="bg-white border border-border-light rounded-2xl overflow-hidden shadow-lg shadow-navy/5" data-boat="sailing-42">
            <div class="relative aspect-[3/4] overflow-hidden">
              <Image src={sailing42} alt="Sailing Boat 42' private charter in Cabo San Lucas" class="w-full h-full object-cover" style="transform: scale(1.1);" width={1024} height={1536} />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4">
                <h4 class="text-white text-sm lg:text-base font-semibold">Sailing Boat 42'</h4>
                <div class="flex items-center gap-1 text-white/80 text-[10px] mt-0.5 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 14</span></div>
              </div>
              <div class="absolute top-3 right-3 bg-white text-navy font-bold text-xs px-2 py-1 rounded-lg shadow">-30%</div>
            </div>
            <div class="p-3 space-y-3">
              <div class="flex flex-col">
                <span class="text-accent-gold line-through decoration-2 text-xs font-semibold">$1,090</span>
                <div class="flex items-baseline gap-1">
                  <span class="text-slate-500 text-[10px] font-medium uppercase">from</span>
                  <span class="text-navy font-bold text-lg">$927</span>
                </div>
                <span class="text-slate-500 text-[10px] font-medium uppercase">/ 1&ndash;4 guests</span>
              </div>
              <a href="https://wa.me/526241916997?text=Hi%2C%20I'd%20like%20to%20book%20the%20Sailing%20Boat%2042" target="_blank" class="block w-full bg-navy text-white font-bold text-[10px] py-2.5 rounded-lg uppercase tracking-widest text-center shadow">Check Availability</a>
            </div>
          </div>

          <!-- 38' Sailing Boat -->
          <div class="bg-white border border-border-light rounded-2xl overflow-hidden shadow-lg shadow-navy/5" data-boat="sailing-38">
            <div class="relative aspect-[3/4] overflow-hidden">
              <Image src={sailing38} alt="Sailing Boat 38' private charter in Cabo San Lucas" class="w-full h-full object-cover" style="transform: scale(1.1);" width={1024} height={1536} />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4">
                <h4 class="text-white text-sm lg:text-base font-semibold">Sailing Boat 38'</h4>
                <div class="flex items-center gap-1 text-white/80 text-[10px] mt-0.5 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 9</span></div>
              </div>
              <div class="absolute top-3 right-3 bg-white text-navy font-bold text-xs px-2 py-1 rounded-lg shadow">-30%</div>
            </div>
            <div class="p-3 space-y-3">
              <div class="flex flex-col">
                <span class="text-accent-gold line-through decoration-2 text-xs font-semibold">$825</span>
                <div class="flex items-baseline gap-1">
                  <span class="text-slate-500 text-[10px] font-medium uppercase">from</span>
                  <span class="text-navy font-bold text-lg">$701</span>
                </div>
                <span class="text-slate-500 text-[10px] font-medium uppercase">/ 1&ndash;4 guests</span>
              </div>
              <button type="button" onclick="openRezdyModal('165682')" class="block w-full bg-navy text-white font-bold text-[10px] py-2.5 rounded-lg uppercase tracking-widest text-center shadow">Check Availability</button>
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <Footer />
  <FloatingCTA />
  <RezdyModal />
</BaseLayout>
