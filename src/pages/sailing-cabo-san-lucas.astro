---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import CarouselImage from '../components/CarouselImage.astro';
import WhaleFlukeIcon from '../components/WhaleFlukeIcon.astro';
import Video from '../components/Video.astro';
import { Image, getImage } from 'astro:assets';

import sailingPosterSource from "../assets/images/guests-on-sailboats/luxury-sailboat-in-tropical-waters.png";

import heroSailingCoastline from "../assets/images/guests-on-sailboats/sailing-near-cabos-rocky-coastline.png";
import sailingCalmWaters from "../assets/images/guests-on-sailboats/sailing-on-the-calm-ocean-waters.png";
import goldenHourSailing from "../assets/images/guests-on-sailboats/golden-hour-sailing-with-friends.png";
import sailingHorizon from "../assets/images/guests-on-sailboats/sailing-into-the-sunny-horizon.png";
import sailingSnorkelTour from "../assets/images/guests-on-sailboats/cabo-sailing-snorkeling-tour.jpg";

import sailboatsPelicansRock from "../assets/images/blog/sailboats-passing-by-pelicans-rock.png";
import romanticKissSunset from "../assets/images/guests-on-sailboats/romantic-sailboat-kiss-at-sunset.png";
import sailingFamily from "../assets/images/guests-on-sailboats/family-fun-on-a-sunny-sailboat.png";
import sharedSunsetSailing from "../assets/images/guests-on-sailboats/cabo-shared-sunset-sailing.jpg";
import snorkelIcon from "../assets/icons/Snorkel 2.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Sailing in Cabo San Lucas — Sailboat Cruises & Private Charters",
  "description": "Real sailing in Cabo San Lucas — shared sailboat cruises from $102 per person and private sailing charters from $701. All-inclusive bar, food, snorkel gear, departing daily from Cabo Marina.",
  "touristType": "Couples, Families, Solo Travelers, Groups",
  "provider": {
    "@type": "TravelAgency",
    "@id": "https://cabosailing.com/#organization"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/sailing-cabo-san-lucas/",
    "priceCurrency": "USD",
    "lowPrice": "102",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Yacht Rentals", "item": "https://cabosailing.com/yacht-charter-cabo/" },
    { "@type": "ListItem", "position": 3, "name": "Sailing in Cabo San Lucas" }
  ]
});

const sailingPoster = await getImage({
  src: sailingPosterSource,
  width: 1280,
  format: 'webp',
  quality: 80,
});
const sailingPosterAbsUrl = new URL(sailingPoster.src, Astro.site).href;

const videoSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Real Sailing in Cabo San Lucas — Shared & Private Sailboat Cruises",
  "description": "Real sailing in Cabo San Lucas aboard our 38' and 42' sailboats. Shared cruises from $102 per person and private charters from $701 — departing daily from Cabo Marina.",
  "thumbnailUrl": sailingPosterAbsUrl,
  "uploadDate": "2026-05-24",
  "duration": "PT1M8S",
  "contentUrl": "https://www.youtube.com/watch?v=Zx7KO9vSCEs",
  "embedUrl": "https://www.youtube.com/embed/Zx7KO9vSCEs",
  "publisher": {
    "@type": "Organization",
    "name": "Cabo Sailing Ocean Adventures",
    "logo": { "@type": "ImageObject", "url": "https://cabosailing.com/og/home.jpg" }
  }
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Sailing in Cabo San Lucas — Sailboat Cruises | Cabo Sailing" description="Sailing in Cabo San Lucas — shared sailboat cruises from $102/person and private sailing charters from $701. Real sailing, all-inclusive, departing daily from Cabo Marina." ogImage="/og/sailing-cabo-san-lucas.jpg" ogImageAlt="Sailing in Cabo San Lucas — sailboat cruises and private charters" hreflangs={{ en: '/sailing-cabo-san-lucas', es: '/es/sailing-cabo-san-lucas' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <script slot="head" type="application/ld+json" set:html={videoSchema} />
  <Header variant="subpage" activePage="fleet" />

  <style is:inline>
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={heroSailingCoastline} alt="Sailing in Cabo San Lucas along the rocky coastline" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sailingCalmWaters} alt="Sailing on the calm ocean waters of Cabo San Lucas" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={goldenHourSailing} alt="Sunset sailing Cabo San Lucas — golden hour with friends" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sailingHorizon} alt="Sailing into the Cabo sunset horizon" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sailingSnorkelTour} alt="Snorkeling and sailing Cabo San Lucas — guests snorkeling from sailboat" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/20 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"The most magical evening of our Cabo trip. Sails up, sun setting, no engine noise — just the wind and the water."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Laura &amp; Mark T. &mdash; Vancouver, BC</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6 relative">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={heroSailingCoastline} alt="Sailing in Cabo San Lucas along the rocky coastline" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={sailingCalmWaters} alt="Sailing on the calm ocean waters of Cabo San Lucas" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={goldenHourSailing} alt="Sunset sailing Cabo San Lucas — golden hour with friends" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={sailingHorizon} alt="Sailing into the Cabo sunset horizon" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={sailingSnorkelTour} alt="Snorkeling and sailing Cabo San Lucas — guests snorkeling from sailboat" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"The most magical evening of our Cabo trip. Sails up, sun setting, no engine noise &mdash; just the wind and the water."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Laura &amp; Mark T. &mdash; Vancouver, BC</p>
    </div>
  </div>
</div>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold mt-4 lg:mt-6">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Save up to 40% off &mdash; Limited Time</p>
</div>

<!-- DESKTOP: Title + intro -->
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-10">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-gold transition-colors">Home</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a href="/yacht-charter-cabo/" class="hover:text-gold transition-colors">Yacht Rentals</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Sailing in Cabo San Lucas</span>
  </nav>
  <h1 class="text-4xl text-navy leading-tight">Sailing in Cabo San Lucas &mdash; Sailboat Cruises &amp; Private Charters</h1>
  <p class="text-slate-700 text-lg leading-relaxed mt-2">Real sailing on real sailboats &mdash; shared cruises with new friends or private charters where the boat is yours. All-inclusive, departing daily from Cabo Marina.</p>

  <!-- Icons row -->
  <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">schedule</span>
      <p class="text-sm font-semibold text-navy">3 Hours</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">wb_sunny</span>
      <p class="text-sm font-semibold text-navy">Morning, Midday &amp; Evening Departures</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">sailing</span>
      <p class="text-sm font-semibold text-navy">Real Sailing</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">groups</span>
      <p class="text-sm font-semibold text-navy">Up to 14 Guests</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">family_restroom</span>
      <p class="text-sm font-semibold text-navy">Family Friendly</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">local_bar</span>
      <p class="text-sm font-semibold text-navy">All-Inclusive</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">event_available</span>
      <p class="text-sm font-semibold text-navy">Free Cancellation</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-gold">pin_drop</span>
      <p class="text-sm font-semibold text-navy">Cabo Marina, Dock F</p>
    </div>
  </div>

  <!-- About this experience -->
  <div class="mt-12">
    <h3 class="text-2xl text-navy mb-4">About this experience</h3>
    <p class="text-slate-700 leading-relaxed text-base">
      Sailing in Cabo San Lucas is a different kind of day on the water. The engine is off. The sails are up. You hear the wind and the water, not a diesel. We operate Cabo&rsquo;s sailing fleet with three ways to come aboard &mdash; a shared sailboat cruise for solo travelers and small groups, and two private sailboats (42' and 38') for groups who want the whole boat. Every trip sails past Land&rsquo;s End and the Arch, snorkels at Pelican Rock, and includes an unlimited bar, fresh food, snorkel gear, towels, Bluetooth speakers, and a bilingual sailing crew. Three hours standard; extend by the hour for a longer day.
    </p>
  </div>
</div>

<!-- MOBILE: Title + intro -->
<div class="lg:hidden mt-6 px-5">
  <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-gold transition-colors">Home</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a href="/yacht-charter-cabo/" class="hover:text-gold transition-colors">Yacht Rentals</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-navy font-semibold">Sailing in Cabo</span>
  </nav>
  <h1 class="text-2xl text-navy leading-tight">Sailing in Cabo San Lucas &mdash; Sailboat Cruises &amp; Private Charters</h1>
  <p class="text-slate-700 text-base leading-relaxed mt-2">Real sailing on real sailboats &mdash; shared cruises with new friends or private charters where the boat is yours. All-inclusive, departing daily from Cabo Marina.</p>
</div>

<!-- MOBILE: Icons row -->
<div class="lg:hidden mt-5 px-5">
  <div class="grid grid-cols-2 gap-x-3 gap-y-3">
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">schedule</span><p class="text-xs font-semibold text-navy">3 Hours</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">wb_sunny</span><p class="text-xs font-semibold text-navy">Morning, Midday &amp; Evening Departures</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">sailing</span><p class="text-xs font-semibold text-navy">Real Sailing</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">groups</span><p class="text-xs font-semibold text-navy">Up to 14 Guests</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">family_restroom</span><p class="text-xs font-semibold text-navy">Family Friendly</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">local_bar</span><p class="text-xs font-semibold text-navy">All-Inclusive</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">event_available</span><p class="text-xs font-semibold text-navy">Free Cancellation</p></div>
    <div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gold text-lg">pin_drop</span><p class="text-xs font-semibold text-navy">Cabo Marina, Dock F</p></div>
  </div>
</div>

<!-- MOBILE: About -->
<div class="lg:hidden mt-8 px-5">
  <h3 class="text-lg text-navy mb-3">About this experience</h3>
  <p class="text-slate-700 leading-relaxed text-base">Sailing in Cabo San Lucas is a different kind of day on the water. The engine is off. The sails are up. You hear the wind and the water, not a diesel. We operate Cabo&rsquo;s sailing fleet with three ways to come aboard &mdash; a shared sailboat cruise for solo travelers and small groups, and two private sailboats (42' and 38') for groups who want the whole boat.</p>
</div>

<!-- ===== UNIQUE BLOCK #1: Why sail instead of motor ===== -->
<div class="mt-12 lg:max-w-[1400px] lg:mx-auto lg:px-10 px-5">
  <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-3xl text-navy">Why sail instead of motor</h2></div>
  <p class="text-slate-700 text-base lg:text-lg leading-relaxed mb-8 lg:max-w-3xl">A sailboat is not a motor yacht with a token mast. Cabo Sailing is a true sailing fleet &mdash; here&rsquo;s why guests choose us over a motor charter.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-light-grey rounded-2xl p-6 border border-border-light">
      <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center mb-4"><span class="material-symbols-outlined text-white text-2xl">volume_off</span></div>
      <h3 class="text-base font-bold text-navy mb-2">Quiet</h3>
      <p class="text-sm text-slate-600 leading-relaxed">No engine drone. Hear the ocean, the wind, and your group &mdash; the way Cabo was meant to be experienced.</p>
    </div>
    <div class="bg-light-grey rounded-2xl p-6 border border-border-light">
      <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center mb-4"><span class="material-symbols-outlined text-white text-2xl">eco</span></div>
      <h3 class="text-base font-bold text-navy mb-2">Eco-friendly</h3>
      <p class="text-sm text-slate-600 leading-relaxed">When wind cooperates, we sail under power alone. Zero emissions, zero noise, zero fuel.</p>
    </div>
    <div class="bg-light-grey rounded-2xl p-6 border border-border-light">
      <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center mb-4"><span class="material-symbols-outlined text-white text-2xl">sailing</span></div>
      <h3 class="text-base font-bold text-navy mb-2">Real sailing</h3>
      <p class="text-sm text-slate-600 leading-relaxed">Authentic sailboats and real sailing crews &mdash; not motorboats with token sails. The wind does the work.</p>
    </div>
    <div class="bg-light-grey rounded-2xl p-6 border border-border-light">
      <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center mb-4"><span class="material-symbols-outlined text-white text-2xl">favorite</span></div>
      <h3 class="text-base font-bold text-navy mb-2">Romantic</h3>
      <p class="text-sm text-slate-600 leading-relaxed">Slower pace, golden light, the boat heeling gently. Honeymoons, anniversaries, and quiet moments.</p>
    </div>
  </div>
</div>

<!-- ===== Promo video ===== -->
<section class="mt-14 px-5 lg:max-w-[1100px] lg:mx-auto lg:px-10">
  <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-3xl text-navy">See what sailing in Cabo really feels like</h2></div>
  <Video
    videoId="Zx7KO9vSCEs"
    title="Real Sailing in Cabo San Lucas — Shared & Private Sailboat Cruises"
    poster={sailingPoster.src}
  />
  <p class="text-sm text-slate-500 text-center mt-3 italic">Filmed aboard our 38' and 42' sailboats off Cabo San Lucas.</p>
</section>

<!-- ===== Choose your sailing experience ===== -->
<div id="choose-your-sailing" class="mt-14 lg:max-w-[1400px] lg:mx-auto lg:px-10 lg:py-8 px-5">
  <div class="flex items-center gap-3 mb-8"><div class="w-1 h-6 bg-gold rounded-full"></div><h2 class="text-lg lg:text-2xl text-navy">Choose your sailing experience</h2></div>

  <div class="flex flex-col gap-5 lg:grid lg:grid-cols-3 lg:max-w-[1100px] lg:mx-auto pb-8">
    <!-- Shared Sailing Cruise -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="shared-sailing">
      <CarouselImage type="boat" id="shared-sailing" alt="Shared sailing cruise in Cabo San Lucas — sailboat at sea">
        <div class="absolute inset-0 bg-gradient-to-t from-navy/25 via-navy/5 to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h3 class="text-white text-lg lg:text-xl">Shared Sailing Cruise</h3>
          <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Mixed group, up to 14</span></div>
        </div>
        <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Best Value</div>
        <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-15%</div>
      </CarouselImage>
      <div class="p-4 space-y-4">
        <p class="text-slate-700 text-sm italic text-center pb-3 border-b border-border-light/50">Social vibe &mdash; solo travelers &amp; small groups</p>
        <div class="flex justify-between items-end"><div class="flex flex-col"><span class="text-gold line-through decoration-2 text-[0.9rem] lg:text-[1.05rem] font-semibold">$120</span><div class="flex items-baseline gap-2"><span class="text-navy font-bold text-2xl">$102</span><span class="text-slate-500 text-[11px] font-medium uppercase">/ person</span></div></div><div class="flex flex-col items-end"><span class="text-slate-500 text-[11px] font-medium">Departures</span><span class="text-navy font-bold text-sm">9:00 AM daily</span></div></div>
        <button type="button" onclick="openRezdyModal('744011')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer">Check Availability</button>
      </div>
    </div>
    <!-- Private Sailing 42' -->
    <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="sailing-42">
      <CarouselImage type="boat" id="sailing-42" alt="Private Sailing 42' charter in Cabo San Lucas">
        <div class="absolute inset-0 bg-gradient-to-t from-navy/25 via-navy/5 to-transparent"></div>
        <div class="absolute bottom-5 left-6">
          <h3 class="text-white text-lg lg:text-xl">Private Sailing 42'</h3>
          <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Your group only, up to 14</span></div>
        </div>
        <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Most Popular</div>
        <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-15%</div>
      </CarouselImage>
