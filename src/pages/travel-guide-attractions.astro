---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Travel Guide", "item": "https://cabosailing.com/travel-guide/" },
    { "@type": "ListItem", "position": 3, "name": "Attractions" }
  ]
});
---

<BaseLayout title="Cabo San Lucas Attractions — Travel Guide | Cabo Sailing" description="The best sights and landmarks in Cabo San Lucas — the Arch, sea lions at Land's End, Lover's Beach, Todos Santos day trips and more. Local guides from Cabo Sailing.">
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="travel-guide" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Hero Section -->
    <div class="relative w-full h-[40vh] min-h-[300px] lg:h-[50vh]">
      <img alt="The Arch of Cabo San Lucas at sunset" class="w-full h-full object-cover" src="/images/travel-guide/snorkeling-5.jpg.webp"/>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/40 to-transparent"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-end z-10 text-center px-8 pb-10">
        <div class="flex flex-col items-center gap-3">
          <div class="flex items-center gap-2">
            <a href="/travel-guide" class="text-white/70 text-xs uppercase tracking-[0.2em] font-bold hover:text-white transition-colors">Travel Guide</a>
            <span class="text-white/40 text-xs">/</span>
            <span class="text-white text-xs uppercase tracking-[0.2em] font-bold">Attractions</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-serif text-white uppercase tracking-[0.15em] leading-tight drop-shadow-lg font-light">
            Attractions
          </h1>
          <div class="w-12 h-[1px] bg-accent-gold-light"></div>
          <p class="text-white/90 text-sm max-w-[400px] leading-relaxed">The Arch, sea lions, Lover's Beach, Todos Santos and the best sights to see in and around Cabo San Lucas.</p>
        </div>
      </div>
    </div>

    <!-- Horizontal Sub-Menu -->
    <div class="sticky top-[60px] z-40 bg-white border-b border-border-light/50 shadow-sm">
      <div class="max-w-5xl mx-auto">
        <nav class="flex overflow-x-auto no-scrollbar">
          <a href="/travel-guide" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors">Home</a>
          <a href="/travel-guide-activities" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors">Activities</a>
          <a href="/travel-guide-attractions" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-accent-gold text-navy transition-colors">Attractions</a>
          <a href="/travel-guide-traveling" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Traveling to Cabo</a>
          <a href="/travel-guide-culture" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Culture &amp; Food</a>
        </nav>
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto pt-10 pb-16">

      <p class="text-navy/60 text-base lg:text-lg leading-relaxed max-w-2xl mb-10">The best sights and landmarks in and around Cabo San Lucas &mdash; from iconic natural formations to charming day-trip towns. These guides help you decide what to see and how to get there.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">

        <!-- Article 1: Sea Lions -->
        <a href="/travel-guide/sea-lions-in-cabo" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Sea lions at Land's End in Cabo San Lucas" class="w-full h-full object-cover" src="/images/travel-guide/snorkeling-5.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Attractions</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Sea Lions in Cabo &mdash; Where to See Them Up Close</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">The famous colony at Land's End &mdash; best times, how to get there, safety rules, and what to expect on a boat tour.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 2: Todos Santos -->
        <a href="/travel-guide/todos-santos-true-mexican-oasis-near-cabo" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Colorful street in Todos Santos, Baja California Sur" class="w-full h-full object-cover" src="/images/travel-guide/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Attractions</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Todos Santos &mdash; Day Trip Guide to the Pueblo M&aacute;gico</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Art galleries, Hotel California, surf beaches, and farm-to-table dining &mdash; just one hour north of Cabo.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <a href="/travel-guide/whale-watching-tips" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Whale watching in Cabo San Lucas" class="w-full h-full object-cover" src="/images/travel-guide/cabo-san-lucas-whale-watchi.png"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Attractions</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Cabo Whale Watching Tips &mdash; A Complete Guide</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Best season, species to spot, what to pack, responsible viewing, and top lookout points.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

      </div>
    </div>

    <!-- CTA Section -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto mb-12">
      <div class="bg-navy rounded-[2rem] p-8 text-center">
        <h2 class="text-xl font-serif text-white mb-3 font-semibold">Ready to Experience Cabo?</h2>
        <p class="text-white/70 text-sm mb-6 leading-relaxed">Book your sailing charter, snorkeling tour, or sunset cruise with us. We'll make your Cabo trip unforgettable.</p>
        <a href="https://wa.me/526241916997?text=hi%2C%20I'm%20sending%20you%20a%20message%20from%20cabosailing.com" target="_blank" class="inline-flex items-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-xl font-bold text-sm uppercase tracking-widest active:scale-95 transition-transform shadow-lg">
          <i class="fa-brands fa-whatsapp text-lg"></i> Message Us on WhatsApp
        </a>
        <div class="mt-4">
          <a href="tel:+526241438485" class="text-white/60 text-sm hover:text-white transition-colors">Or call +52 624 143 8485</a>
        </div>
      </div>
    </div>

  </main>

  <Footer />
  <FloatingCTA />
</BaseLayout>

<style>
  .guide-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .guide-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.12);
  }
  .guide-card:active {
    transform: scale(0.98);
  }
</style>
