  "touristType": "Families, Snorkelers, Groups",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/private-snorkeling/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Private Snorkeling Tour" }
