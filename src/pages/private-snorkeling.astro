            <span class="material-symbols-outlined text-white text-[15px]">surfing</span>
          </div>
          <div><span class="text-slate-700 text-base font-semibold">Paddleboard &amp; water mat</span><p class="text-slate-700 text-sm mt-0.5">Available on yachts</p></div>
        </div>
        <div class="flex items-start gap-4">
