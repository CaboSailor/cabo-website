---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import CarouselImage from '../components/CarouselImage.astro';
import { Image } from 'astro:assets';

// Hero / main images
import { scubaDiving as heroImg } from "../data/tour-heroes";
import scubaImg7 from "../assets/images/scuba-diving/scuba-diving-adventure-in-tropical-waters.png";
import scubaImg9 from "../assets/images/scuba-diving/vibrant-tropical-school-of-fish-underwater.png";
import scubaImg5 from "../assets/images/scuba-diving/seal-and-divers-in-underwater-harmony.png";
import scubaImg17 from "../assets/images/scuba-diving/diver-through-vibrant-coral-reef-window.png";

// Boat images (carousel originals kept for hero/gallery)
import heroThumb1 from "../assets/images/scuba-diving/school-of-fish-in-clear-ocean.png";
import galleryLeft from "../assets/images/guests-on-sailboats/snorkeler-exploring-underwater-paradise.png";
import galleryRight from "../assets/images/scuba-diving/swirling-school-of-fish-in-blue-water.png";
import heroThumb2 from "../assets/images/guests-on-sailboats/snorkelers-enjoying-a-sunny-boat-ride.png";
import heroThumb3 from "../assets/images/guests-on-yachts/paddleboarding-adventure-on-a-sunny-beach.png";
import heroThumb4 from "../assets/images/guests-on-yachts/celebration-on-the-boat-at-sea.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Private Scuba Diving Charters in Cabo San Lucas",
  "description": "Private scuba diving charters to Cabo's top dive sites \u2014 Pelican Rock, Land's End, Santa Mar\u00eda. PADI guides, full gear and surface support included.",
  "touristType": "Divers, Adventure Seekers, Couples",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/scuba-diving/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Private Scuba Diving" }
  ]
});
---

<BaseLayout title="Private Scuba Diving Charters in Cabo San Lucas | Cabo Sailing" description="Private scuba diving charters to Cabo's top dive sites — Pelican Rock, Land's End, Santa María. PADI guides, full gear and surface support included." ogImage="/og/scuba-diving-sailboat.jpg" ogImageAlt="Scuba diving in Cabo San Lucas" hreflangs={{ en: '/scuba-diving', es: '/es/scuba-diving' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="scuba-diving" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- ========== HERO (Mobile) ========== -->
    <div class="relative w-full h-[45vh] lg:hidden overflow-hidden">
      <div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
        <div class="flex-shrink-0 w-full h-full snap-center relative">
          <Image alt="Dive boat with crew, turquoise water, Cabo cliffs" class="w-full h-full object-cover" src={heroImg} width={800} height={500} />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
        </div>
        <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="School of fish in blue water" class="w-full h-full object-cover" src={heroThumb1} width={800} height={500} /></div>
        <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Snorkelers on a sunny boat ride" class="w-full h-full object-cover" src={heroThumb2} width={800} height={500} /></div>
        <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Paddleboarding adventure on a sunny beach" class="w-full h-full object-cover" src={heroThumb3} width={800} height={500} /></div>
        <div class="flex-shrink-0 w-full h-full snap-center"><Image alt="Celebration on the boat at sea" class="w-full h-full object-cover" src={heroThumb4} width={800} height={500} /></div>
      </div>
      <div class="absolute top-4 left-4 bg-gold text-white text-base font-bold px-3 py-1 rounded-full uppercase tracking-widest">Underwater Adventure</div>
      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-5 px-4">
        <div class="max-w-[360px] mx-auto text-center">
          <div class="flex items-center justify-center gap-0.5 mb-1.5">
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
            <span class="material-symbols-outlined text-gold filled text-lg">star</span>
          </div>
          <p class="text-white text-base leading-snug">"Incredible dive spots and a top-notch crew. Felt safe the entire time."</p>
          <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Tom R. &mdash; Miami, FL</p>
        </div>
      </div>
      <button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
      <button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
    </div>

    <!-- Mobile discount banner -->
    <div class="lg:hidden w-full text-center py-3 px-4 shadow-md bg-gold">
      <p class="text-navy font-bold text-sm uppercase tracking-widest">Save up to 40% off &mdash; Limited Time</p>
    </div>

    <!-- ========== MOBILE LAYOUT ========== -->
    <div class="lg:hidden mt-6 px-5">
        <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold transition-colors">Home</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span>Tours</span>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-navy font-semibold">Scuba Diving</span>
        </nav>
        <div class="flex flex-col gap-1 mb-6">
          <div class="flex justify-between items-start">
            <h1 class="text-2xl text-navy leading-tight">Scuba Diving in Cabo San Lucas</h1>
          </div>
          <p class="text-slate-500 text-sm font-medium flex items-center gap-1 mt-2 uppercase tracking-widest">
            <span class="material-symbols-outlined text-base">location_on</span> Land's End, Cabo San Lucas
          </p>
        </div>
        <div class="grid grid-cols-2 gap-x-3 gap-y-3">
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-gold text-lg">schedule</span>
            <p class="text-xs font-semibold text-navy">4 Hours</p>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-gold text-lg">scuba_diving</span>
            <p class="text-xs font-semibold text-navy">Certified &amp; Non-Certified</p>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-gold text-lg">event_available</span>
            <p class="text-xs font-semibold text-navy">Flexible Cancellation</p>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-gold text-lg">sailing</span>
            <p class="text-xs font-semibold text-navy">Private yacht or sailboat</p>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-gold text-lg">pool</span>
            <p class="text-xs font-semibold text-navy">Scuba &amp; Snorkel tour</p>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-gold text-lg">pin_drop</span>
            <p class="text-xs font-semibold text-navy">Cabo San Lucas Reserve</p>
          </div>
        </div>
        <div class="mt-6 pt-6 border-t border-border-light">
          <input class="hidden" id="highlights-toggle" type="checkbox"/>
          <label class="flex items-center justify-between cursor-pointer group" for="highlights-toggle">
            <div class="flex items-center gap-3">
              <div class="p-2 bg-navy/5 rounded-full"><span class="material-symbols-outlined text-navy text-xl">auto_awesome</span></div>
              <span class="text-base font-semibold text-navy">Tour Highlights</span>
            </div>
            <span class="material-symbols-outlined text-slate-300 chevron-icon transition-transform">chevron_right</span>
          </label>
          <div class="max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-in-out" id="highlights-content">
            <div class="space-y-4">
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">scuba_diving</span><div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">PADI-Certified Guides</h3><p class="text-sm text-slate-500 leading-relaxed">Expert instructors for all skill levels.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">pets</span><div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Sea Lion Encounters</h3><p class="text-sm text-slate-500 leading-relaxed">Dive alongside playful sea lions at Pelican Rock.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">visibility</span><div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">No Previous Experience Needed</h3><p class="text-sm text-slate-500 leading-relaxed">Our PADI instructors guide beginners through every step.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">inventory_2</span><div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">All Equipment Included</h3><p class="text-sm text-slate-500 leading-relaxed">Full scuba gear, wetsuit, and tanks provided.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">waves</span><div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Multiple Dive Sites</h3><p class="text-sm text-slate-500 leading-relaxed">Pelican Rock, Neptune's Finger, Land's End.</p></div></div>
              <div class="flex items-start gap-3"><span class="material-symbols-outlined text-gold flex-shrink-0" style="font-size:20px">photo_camera</span><div><h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-1">Marine Life Paradise</h3><p class="text-sm text-slate-500 leading-relaxed">Tropical fish, rays, moray eels, seahorses &amp; more.</p></div></div>
            </div>
          </div>
        </div>
      <div class="mt-8">
        <h3 class="text-lg text-navy mb-4">About this experience</h3>
        <p class="text-slate-500 leading-relaxed text-base"><span id="about-short">A perfect choice for mixed groups of divers and snorkelers to enjoy a day on the water together, discover the vibrant underwater world of Cabo San Lucas with our guided scuba diving tours. Whether yo</span><span id="about-full" class="hidden">u're a certified diver or trying scuba for the first time, our PADI-certified instructors ensure a safe and unforgettable experience. Dive into crystal-clear waters at some of Cabo's most iconic dive sites and come face-to-face with incredible marine life.</span><button id="about-read-more" onclick="document.getElementById('about-full').classList.remove('hidden');this.classList.add('hidden');" class="text-gold font-semibold ml-1 lg:hidden">Read more</button></p>
      </div>
      <!-- Mobile: Select Your Boat -->
      <div class="mt-10">
        <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">Scroll our boats — find a perfect fit for your unique scuba diving experience</h3></div>
        <div class="flex flex-col gap-5">
          <!-- Yacht 51' -->
          <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-51">
            <CarouselImage type="boat" id="yacht-51" alt="Luxury Yacht 51' private scuba diving charter">
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
              <div class="absolute bottom-5 left-6">
                <h3 class="text-white text-lg lg:text-xl">Luxury Yacht 51'</h3>
                <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 20 Guests</span></div>
              </div>
              <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Most Spacious</div>
            </CarouselImage>
            <div class="p-5">
              <button type="button" onclick="openRezdyModal('165509')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer">Check Availability</button>
            </div>
          </div>
          <!-- Yacht 45' -->
          <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-45">
            <CarouselImage type="boat" id="yacht-45" alt="Luxury Yacht 45' private scuba diving charter" imgStyle="transform: none;">
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
              <div class="absolute bottom-5 left-6">
                <h3 class="text-white text-lg lg:text-xl">Luxury Yacht 45'</h3>
                <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 12 Guests</span></div>
              </div>
              <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Most Popular</div>
            </CarouselImage>
            <div class="p-5">
              <button type="button" onclick="openRezdyModal('528988')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer">Check Availability</button>
            </div>
          </div>
          <!-- Yacht 42' -->
          <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="yacht-42">
            <CarouselImage type="boat" id="yacht-42" alt="Luxury Yacht 42' private scuba diving charter">
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
              <div class="absolute bottom-5 left-6">
                <h3 class="text-white text-lg lg:text-xl">Luxury Yacht 42'</h3>
                <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 18 Guests</span></div>
              </div>
              <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Best Value</div>
            </CarouselImage>
            <div class="p-5">
              <button type="button" onclick="openRezdyModal('168008')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg cursor-pointer">Check Availability</button>
            </div>
          </div>
          <!-- Sailing 42' -->
          <div class="w-full bg-white border border-border-light rounded-[2.5rem] overflow-hidden shadow-xl shadow-navy/5" data-boat="sailing-42">
            <CarouselImage type="boat" id="sailing-42" alt="Sailing Boat 42' private scuba diving charter">
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent"></div>
              <div class="absolute bottom-5 left-6">
                <h3 class="text-white text-lg lg:text-xl">Sailing Boat 42'</h3>
                <div class="flex items-center gap-1 lg:gap-2 text-white/80 text-xs mt-0.5 lg:mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-xs">group</span><span>Up to 14 Guests</span></div>
              </div>
              <div class="absolute top-4 right-4 bg-gold text-white text-[10px] lg:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">Sailing Experience</div>
            </CarouselImage>
            <div class="p-5">
              <button type="button" onclick="openRezdyModal('642955','productsCalendar')" class="block w-full bg-navy text-white font-bold text-[11px] py-3.5 rounded-xl uppercase tracking-[0.15em] text-center shadow-lg">Check Availability</button>
            </div>
          </div>
        </div>
      </div>

      <!-- MOBILE: What's Included (after boats) -->
      <div class="mt-10">
        <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">What's Included</h3></div>
        <div class="grid grid-cols-1 gap-5 pl-1">
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">2 Guided Dives</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Full Scuba Equipment</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">PADI Instructor / Guide</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Introductory Class</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Lunch &amp; Bar</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-white text-[14px]">check</span></div><span class="text-slate-600 text-base font-medium">Bathroom &amp; Changing Area</span></div>
        </div>
        <div class="mt-6 bg-light-grey rounded-2xl p-5 border border-border-light space-y-4">
          <div class="border-b border-border-light pb-3">
            <p class="text-sm font-bold text-navy uppercase tracking-wider">Scuba Diving Add-on</p>
            <p class="text-sm text-slate-600 italic mt-1">Not included in charter price</p>
          </div>
          <div class="flex items-center justify-between">
            <div><p class="text-base font-bold text-navy">Certified Diver (2 Dives)</p><p class="text-sm text-slate-500">PADI divemaster guide &amp; full equipment</p></div>
            <span class="text-base font-bold text-gold">$270 USD</span>
          </div>
          <div class="flex items-center justify-between">
            <div><p class="text-base font-bold text-navy">Non-Certified Diver (2 Dives)</p><p class="text-sm text-slate-500">PADI instructor, intro course &amp; full equipment</p></div>
            <span class="text-base font-bold text-gold">$290 USD</span>
          </div>
        </div>
      </div>

      <!-- MOBILE: What to Bring (after boats) -->
      <div class="mt-10">
        <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">What to Bring</h3></div>
        <div class="grid grid-cols-1 gap-5 pl-1">
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-gold text-[14px]">backpack</span></div><span class="text-slate-600 text-base font-medium">Swimsuit</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-gold text-[14px]">wb_sunny</span></div><span class="text-slate-600 text-base font-medium">Sunscreen (reef-safe preferred)</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-gold text-[14px]">badge</span></div><span class="text-slate-600 text-base font-medium">Certification card (if certified diver)</span></div>
          <div class="flex items-center gap-4"><div class="w-6 h-6 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-gold text-[14px]">favorite</span></div><span class="text-slate-600 text-base font-medium">Sense of adventure!</span></div>
        </div>
      </div>

      <div class="mt-10 mb-6">
        <div class="flex items-center gap-3 mb-6"><div class="w-1 h-6 bg-gold rounded-full"></div><h3 class="text-lg text-navy">FAQ</h3></div>
        <div class="flex flex-col gap-4">
          <div class="faq-item border border-border-light rounded-2xl overflow-hidden bg-white">
            <input class="hidden" id="faq1" type="checkbox"/>
            <label class="flex items-center justify-between p-4 cursor-pointer" for="faq1">
              <span class="flex items-center gap-2 text-base font-semibold text-navy"><span class="material-symbols-outlined text-gold" style="font-size:18px">restaurant</span>Bar &amp; menu on board</span>
              <span class="material-symbols-outlined text-slate-300 faq-chevron transition-transform flex-shrink-0">expand_more</span>
            </label>
            <div class="faq-answer max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-in-out px-4 pb-4">
              <div class="text-sm text-slate-500 leading-relaxed space-y-3">
                <div><p class="font-semibold text-navy mb-1">Bar</p><p>Premium brands open bar includes red and white wine, margaritas, beer, rum, vodka, tequila, whiskey, juices, sodas, and bottled water.</p></div>
