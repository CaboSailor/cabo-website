---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import RezdyModal from '../components/RezdyModal.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('travel-guide');
allArticles.sort((a, b) => a.data.title.localeCompare(b.data.title));

const articlesByCategory = {
  'Activities': allArticles.filter(a => a.data.category === 'Activities'),
  'Attractions': allArticles.filter(a => a.data.category === 'Attractions'),
  'Traveling to Cabo': allArticles.filter(a => a.data.category === 'Traveling to Cabo'),
  'Culture & Food': allArticles.filter(a => a.data.category === 'Culture & Food'),
};

const categoryHubLinks: Record<string, string> = {
  'Activities': '/travel-guide-activities/',
  'Attractions': '/travel-guide-attractions/',
  'Traveling to Cabo': '/travel-guide-traveling/',
  'Culture & Food': '/travel-guide-culture/',
};

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Sitemap" }
  ]
});
---

<BaseLayout title="Sitemap | Cabo Sailing" description="Browse every page on Cabo Sailing — tours, shuttle service, travel guide articles, and policies." hreflangs={{ en: '/sitemap', es: '/es/sitemap' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-8 py-10 lg:py-16">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">Sitemap</span>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <h1 class="text-3xl lg:text-4xl text-navy font-serif mb-3">Sitemap</h1>
        <p class="text-slate-500 text-base lg:text-lg leading-relaxed">Every page on cabosailing.com, organized by section.</p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">

        <!-- Main Pages -->
        <section class="bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-7 bg-gold rounded-full"></div>
            <h2 class="text-xl text-navy">Main Pages</h2>
          </div>
          <ul class="space-y-2 text-base">
            <li><a href="/" class="text-slate-600 hover:text-accent-gold transition-colors">Home</a></li>
            <li><a href="/tours/" class="text-slate-600 hover:text-accent-gold transition-colors">Tours</a></li>
            <li><a href="/shuttle-service/" class="text-slate-600 hover:text-accent-gold transition-colors">Shuttle Service</a></li>
            <li><a href="/travel-guide/" class="text-slate-600 hover:text-accent-gold transition-colors">Travel Guide</a></li>
            <li><a href="/special-offers/" class="text-slate-600 hover:text-accent-gold transition-colors">Special Offers</a></li>
            <li><a href="/about-us/" class="text-slate-600 hover:text-accent-gold transition-colors">About Us</a></li>
            <li><a href="/contact/" class="text-slate-600 hover:text-accent-gold transition-colors">Contact</a></li>
          </ul>
        </section>

        <!-- Tours -->
        <section class="bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-7 bg-gold rounded-full"></div>
            <h2 class="text-xl text-navy">Tours &amp; Charters</h2>
          </div>
          <ul class="space-y-2 text-base">
            <li><a href="/private-snorkeling/" class="text-slate-600 hover:text-accent-gold transition-colors">Private Snorkeling</a></li>
            <li><a href="/shared-snorkeling/" class="text-slate-600 hover:text-accent-gold transition-colors">Shared Snorkeling</a></li>
            <li><a href="/private-sunset/" class="text-slate-600 hover:text-accent-gold transition-colors">Private Sunset</a></li>
            <li><a href="/shared-sunset/" class="text-slate-600 hover:text-accent-gold transition-colors">Shared Sunset</a></li>
            <li><a href="/whale-watching/" class="text-slate-600 hover:text-accent-gold transition-colors">Whale Watching</a></li>
            <li><a href="/scuba-diving/" class="text-slate-600 hover:text-accent-gold transition-colors">Scuba Diving</a></li>
            <li><a href="/bachelorette/" class="text-slate-600 hover:text-accent-gold transition-colors">Bachelorette Party</a></li>
          </ul>
        </section>

        <!-- Policies & Info -->
        <section class="bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-7 bg-gold rounded-full"></div>
            <h2 class="text-xl text-navy">Policies &amp; Info</h2>
          </div>
          <ul class="space-y-2 text-base">
            <li><a href="/policies/" class="text-slate-600 hover:text-accent-gold transition-colors">Reservations &amp; Cancelations</a></li>
            <li><a href="/sitemap/" class="text-slate-600 hover:text-accent-gold transition-colors">Sitemap</a></li>
          </ul>
        </section>

        <!-- Languages -->
        <section class="bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-7 bg-gold rounded-full"></div>
            <h2 class="text-xl text-navy">Languages</h2>
          </div>
          <ul class="space-y-2 text-base">
            <li><a href="/" class="text-slate-600 hover:text-accent-gold transition-colors">English</a></li>
            <li><a href="/es/" class="text-slate-600 hover:text-accent-gold transition-colors">Español</a></li>
          </ul>
        </section>

      </div>

      <!-- Travel Guide Articles -->
      <div class="mt-8 bg-white rounded-2xl border border-border-light shadow-sm p-6 lg:p-8">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h2 class="text-2xl text-navy">Travel Guide</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {Object.entries(articlesByCategory).map(([category, articles]) => (
            <div>
              <h3 class="text-sm font-bold text-navy uppercase tracking-widest mb-3 pb-2 border-b border-border-light">
                <a href={categoryHubLinks[category]} class="hover:text-accent-gold transition-colors">{category}</a>
              </h3>
              <ul class="space-y-2 text-base">
                {articles.map(article => (
                  <li><a href={`/travel-guide/${article.id}/`} class="text-slate-600 hover:text-accent-gold transition-colors">{article.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />
  <FloatingCTA />
  <RezdyModal />
</BaseLayout>
