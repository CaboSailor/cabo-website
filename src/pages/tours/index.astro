---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import CarouselImage from '../../components/CarouselImage.astro';
import YachtIcon from '../../components/YachtIcon.astro';

const sharedTours = [
  { href: '/tours/snorkeling-cruise/', id: 'snorkeling-cruise', label: 'Snorkeling Cruise', tagline: '3 hrs · group of up to 14', alt: 'Snorkeling Cruise tour in Cabo San Lucas' },
  { href: '/tours/sunset-sailing/',     id: 'sunset-sailing',     label: 'Sunset Sailing',     tagline: '2 hrs · group of up to 14', alt: 'Sunset Sailing cruise in Cabo San Lucas' },
];

const privateTours = [
  { href: '/tours/private-snorkeling/', id: 'private-snorkeling', label: 'Private Snorkeling',     tagline: 'Sailboat or yacht · your group only', alt: 'Private Snorkeling charter in Cabo San Lucas' },
  { href: '/tours/private-sunset/',     id: 'private-sunset',     label: 'Private Sunset',         tagline: 'Sailboat or yacht · your group only', alt: 'Private Sunset charter in Cabo San Lucas' },
  { href: '/tours/whale-watching/',     id: 'whale-watching',     label: 'Private Whale Watching', tagline: 'Dec–Apr · your group only',           alt: 'Private Whale Watching tour in Cabo San Lucas' },
  { href: '/tours/bachelorette/',       id: 'bachelorette-party', label: 'Bachelorette Party',     tagline: 'Decorated yacht · made for the bride', alt: 'Bachelorette Party charter in Cabo San Lucas' },
  { href: '/tours/scuba-diving/',       id: 'scuba-diving',       label: 'Scuba Diving',           tagline: 'PADI dive boat · all levels',          alt: 'Scuba Diving tour in Cabo San Lucas' },
];

const faqs = [
  {
    q: "What's the real difference between a group tour and a private charter?",
    a: "A group tour is a small-group sailing experience with a set departure time. You join other guests onboard one of our sailboats, with a maximum of 14 guests, plus open bar, food, crew, and a relaxed Cabo atmosphere.\n\nA private charter is reserved only for your group. You choose the date, time, boat style, and overall pace of the cruise — with more flexibility for the route, music, and special requests.\n\nBoth are great ways to enjoy Cabo from the water. Group sailing tours are easy, social, and relaxed. Private charters are more personal, flexible, and fully yours."
  },
  {
    q: "Sailboat or yacht — which should I pick?",
    a: "Both are beautiful ways to experience Cabo — it mostly depends on the style of cruise you have in mind.\n\nA sailboat offers a classic Cabo sailing feel: open air, quiet movement, ocean breeze, and a relaxed connection to the water.\n\nA yacht offers a spacious, luxurious lounge-style experience with comfortable seating areas, shaded space, indoor cabin access, and yacht amenities.\n\nChoose a sailboat for the sailing atmosphere. Choose a yacht for the luxury lounge experience. Either way, you'll enjoy Cabo's coastline, great service, and a memorable time on the water."
  },
  {
    q: "We've never been on a boat. Which tour is the easiest start?",
    a: "If you'd rather have full control of pace and stops, a private charter on a yacht is the smoothest option for first-timers.\n\nThat said, our 2-hour sunset sailing sail is the calmest and might offer a good entry point."
  },
  {
    q: "Are these cruises kid-friendly?",
    a: "Absolutely. All of our cruises are family-friendly, and kids of all ages usually love being out on the water.\n\nOur crew is friendly, patient, and highly accommodating with families. Whether you're joining a snorkeling cruise, sunset cruise, or private charter, we'll help make the experience comfortable and fun for both kids and adults.\n\nWe carry safety gear and life jackets for children of different ages and sizes, and our crew will help with anything needed before and during the cruise."
  },
  {
    q: "Will I get seasick? How rough does the water get?",
    a: "Most cruises take place close to shore and in confined bays where conditions are usually comfortable and enjoyable. Some days the ocean can be more active.\n\nIf you're sensitive to motion, we recommend eating lightly before boarding, staying hydrated, and considering motion-sickness medication before the cruise if you normally use it. Our crew also keeps an eye on conditions and will always choose the safest, most comfortable route available for the day."
  },
  {
    q: "What's included on the tour?",
    a: "All our tours include an open premium bar (beer, wine, margaritas, cocktails, sodas, water), food appropriate to the trip (snorkel menu, sunset menu, etc.), all snorkel gear when applicable, and an English-speaking crew. The full menu and bar list are on each tour page."
  },
  {
    q: "How far in advance should I book?",
    a: "For private charters in high season (December–April, plus US holiday weeks), aim for 2–4 weeks ahead — the popular dates sell out. Group sailing tours have more flexibility but the best time slots (sunset, weekends) still fill up. Off-season, a week or two is usually enough."
  },
  {
    q: "Do you offer hotel pickup or a shuttle to the marina?",
    a: "Yes. We offer private <a href=\"/shuttle-service/\" class=\"text-accent-gold font-semibold hover:underline\">shuttle service</a> to and from the marina, which can be added to your booking for a smooth door-to-door experience.\n\nAll cruises depart from IGY Marina in downtown Cabo San Lucas. If you prefer to arrive on your own, taxis and Ubers are also easy to use from most hotels in the Cabo area."
  },
  {
    q: "What happens if the weather cancels the tour?",
    a: "If we cancel because of weather or sea conditions, you get a full refund or a free reschedule — your choice. Cabo weather is reliable most of the year, so cancellations are rare outside of occasional September/October tropical activity."
  },
  {
    q: "How many people can each private charter fit?",
    a: "Our sailboats can host up to 14 guests, depending on the vessel and cruise type.\n\nOur yachts can host between 12 and 20 guests, depending on which yacht you choose.\n\nIf you're not sure which boat is the best fit, just send us your group size and the type of experience you're planning — we'll help match you with the right option."
  },
];

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours" }
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
});
---

<BaseLayout title="Tours — Cabo Sailing | Boat Tours in Cabo San Lucas" description="All boat tours in Cabo San Lucas — group snorkel & sunset sails, private charters on sailboats & yachts, whale watching, bachelorette parties & scuba. Compare and book." hreflangs={{ en: '/tours', es: '/es/tours' }}>
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <Header variant="subpage" activePage="tours" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Page heading -->
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 pt-8 lg:pt-12 pb-6 text-center">
      <nav class="flex items-center justify-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-navy font-semibold">Tours</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-serif text-navy mb-3">Our Tours</h1>
      <p class="text-slate-500 text-sm lg:text-base max-w-xl mx-auto">Two ways to sail Cabo — join a small group on a group tour, or have the whole boat to yourselves.</p>
    </div>

    <!-- Sailing Cruises -->
    <section class="max-w-[1100px] mx-auto px-5 lg:px-10 pt-4 lg:pt-6 pb-8 lg:pb-12">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-1 h-7 bg-gold rounded-full"></div>
        <h2 class="text-xl lg:text-2xl font-serif text-navy">Sailing Cruises</h2>
      </div>
      <p class="text-slate-500 text-sm lg:text-base mb-5 lg:mb-7 ml-4">Fixed schedule, set price per person, small group on a sailboat — the easy, social way to get on the water.</p>
      <div class="grid grid-cols-2 gap-4 lg:gap-6">
        {sharedTours.map((t) => (
          <a href={t.href} class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
            <CarouselImage type="activity" id={t.id} alt={t.alt} groupHoverZoom wrapperClass="relative h-[180px] lg:h-[240px] overflow-hidden w-full">
              <div class="absolute inset-0 bg-gradient-to-t from-navy/15 to-transparent"></div>
            </CarouselImage>
            <div class="p-4 text-center">
              <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">{t.label}</h3>
              <p class="text-xs lg:text-sm text-slate-500 mt-1">{t.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Private Tours -->
    <section class="max-w-[1100px] mx-auto px-5 lg:px-10 pt-2 lg:pt-4 pb-10 lg:pb-14">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-1 h-7 bg-gold rounded-full"></div>
        <h2 class="text-xl lg:text-2xl font-serif text-navy">Private Charters</h2>
      </div>
      <p class="text-slate-500 text-sm lg:text-base mb-5 lg:mb-7 ml-4">The whole boat is yours — pick your sailboat or yacht, your route, and your pace.</p>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
        {privateTours.map((t) => (
          <a href={t.href} class="group block rounded-2xl overflow-hidden shadow-lg border border-border-light bg-white">
            <CarouselImage type="activity" id={t.id} alt={t.alt} groupHoverZoom wrapperClass="relative h-[180px] lg:h-[220px] overflow-hidden w-full">
              <div class="absolute inset-0 bg-gradient-to-t from-navy/15 to-transparent"></div>
            </CarouselImage>
            <div class="p-4 text-center">
              <h3 class="text-sm lg:text-base font-bold text-navy group-hover:text-gold transition-colors">{t.label}</h3>
              <p class="text-xs lg:text-sm text-slate-500 mt-1">{t.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Choose your vessel -->
    <section class="bg-light-grey border-y border-border-light">
      <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-10 lg:py-14">
        <div class="text-center mb-6 lg:mb-8">
          <h2 class="text-xl lg:text-2xl font-serif text-navy mb-2">Sailboat or Yacht?</h2>
          <p class="text-slate-500 text-sm lg:text-base max-w-xl mx-auto">Every private charter starts with the same question. Here's the short version.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
          <a href="/sailing-cabo-san-lucas/" class="group bg-white rounded-2xl p-6 lg:p-7 border border-border-light shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="flex items-center gap-3 mb-3">
              <span class="material-symbols-outlined text-gold text-3xl">sailing</span>
              <h3 class="text-lg lg:text-xl font-serif text-navy">Sailboat</h3>
            </div>
            <p class="text-slate-600 text-sm lg:text-base leading-relaxed mb-4">Quiet, romantic, closer to the water. Best for couples, intimate groups, and anyone who wants real sails-up sailing.</p>
            <span class="text-accent-gold text-sm font-bold uppercase tracking-widest mt-auto group-hover:underline">See the sailboats <span class="material-symbols-outlined text-base align-middle">arrow_forward</span></span>
          </a>
          <a href="/yacht-charter-cabo/" class="group bg-white rounded-2xl p-6 lg:p-7 border border-border-light shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="flex items-center gap-3 mb-3">
              <YachtIcon class="text-gold text-3xl" />
              <h3 class="text-lg lg:text-xl font-serif text-navy">Yacht</h3>
            </div>
            <p class="text-slate-600 text-sm lg:text-base leading-relaxed mb-4">Wider decks, more shade, smoother ride. Best for bigger groups, families with kids or older guests, and anyone who wants the amenities of a full yacht.</p>
            <span class="text-accent-gold text-sm font-bold uppercase tracking-widest mt-auto group-hover:underline">See the yachts <span class="material-symbols-outlined text-base align-middle">arrow_forward</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-[900px] mx-auto px-5 lg:px-10 py-12 lg:py-16">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-1 h-7 bg-gold rounded-full"></div>
        <h2 class="text-xl lg:text-2xl font-serif text-navy">Before You Book — FAQ</h2>
      </div>
      <p class="text-slate-500 text-sm lg:text-base mb-6 lg:mb-8 ml-4">The questions guests ask most before picking a tour.</p>

      <div class="flex flex-col gap-3 lg:gap-4">
        {faqs.map((item, idx) => (
          <div class="faq-item border border-border-light rounded-2xl px-5 py-4 lg:px-6 lg:py-5 bg-white">
            <input class="hidden" id={`tfaq${idx + 1}`} type="checkbox" />
            <label class="flex items-start lg:items-center justify-between gap-3 cursor-pointer" for={`tfaq${idx + 1}`}>
              <span class="font-semibold text-navy text-sm lg:text-base">{item.q}</span>
              <span class="material-symbols-outlined text-slate-300 faq-chevron transition-transform flex-shrink-0">expand_more</span>
            </label>
            <div class="faq-answer max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-in-out">
              {item.a.split('\n\n').map((para, i) => (
                <p class={`text-sm lg:text-base text-slate-600 leading-relaxed ${i === 0 ? 'pt-3' : 'pt-2'}`} set:html={para} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <style is:global>
    .faq-item input:checked ~ .faq-answer { max-height: 1000px; opacity: 1; }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <Footer />
  <FloatingCTA />
</BaseLayout>
