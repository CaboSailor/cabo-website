---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import { Image } from 'astro:assets';

import { sharedSnorkeling as img_4k_01_38_47_13_Still123 } from "../../data/tour-heroes";
import thumb1 from "../../assets/images/guests-on-sailboats/snorkelers-enjoying-a-sunny-boat-ride.png";
import thumb2 from "../../assets/images/guests-on-sailboats/snorkeler-exploring-underwater-paradise.png";
import thumb3 from "../../assets/images/guests-on-sailboats/sunlit-boat-ride-by-the-ocean.png";
import thumb4 from "../../assets/images/guests-on-sailboats/sunshine-and-celebration-on-the-yacht.png";
import sailing42BoatCard from "../../assets/images/boats/sailing-42/cabosailing-sailiboat-42.png";
import pelicanRockImg from "../../assets/images/guests-on-sailboats/relaxing-sailboat-getaway-with-friends.png";
import sailboatsPelicansRock from "../../assets/images/blog/sailboats-passing-by-pelicans-rock.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Shared Snorkeling Tour in Cabo San Lucas",
  "description": "Shared snorkel tour to Cabo's best reefs — the Arch and Pelican Rock. Small group, all gear, drinks and snacks included. Daily departures.",
  "touristType": "Budget Travelers, Solo Travelers, Couples",
  "provider": {
    "@type": "TravelAgency",
    "@id": "https://cabosailing.com/#organization"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/tours/shared-snorkeling/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Shared Snorkeling Tour" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Shared Snorkeling Tour in Cabo — Small Group | Cabo Sailing" description="Shared snorkel tour to Cabo's best reefs — the Arch and Pelican Rock. Small group, all gear, drinks and snacks included. Daily departures." ogImage="/og/shared-snorkeling.jpg" ogImageAlt="Small-group snorkeling tour in Cabo San Lucas" hreflangs={{ en: '/tours/shared-snorkeling', es: '/es/tours/shared-snorkeling' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
<div class="lg:hidden relative w-full h-[45vh] overflow-hidden">
<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar">
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={img_4k_01_38_47_13_Still123} alt="Aerial view sailboat in turquoise water" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={thumb1} alt="Snorkelers enjoying a sunny boat ride" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={thumb2} alt="Snorkeler exploring underwater paradise" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={thumb3} alt="Sunlit boat ride by the ocean" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={thumb4} alt="Sunshine and celebration on the yacht" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/20 to-transparent pt-10 pb-5 px-4">
  <div class="max-w-[360px] mx-auto text-center">
    <div class="flex items-center justify-center gap-0.5 mb-1.5">
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
      <span class="material-symbols-outlined text-gold filled text-lg">star</span>
    </div>
    <p class="text-white text-base leading-snug">"Way better than the big group tours. Small boat, great crew, amazing snorkeling."</p>
    <p class="text-white/50 text-xs uppercase tracking-widest font-bold mt-2">Chris &amp; Emma W. &mdash; San Diego, CA</p>
  </div>
</div>
<button class="fleet-arrow left" onclick="heroNav(this,-1)"><span class="material-symbols-outlined">chevron_left</span></button>
<button class="fleet-arrow right" onclick="heroNav(this,1)"><span class="material-symbols-outlined">chevron_right</span></button>
</div>
<div class="hidden lg:block max-w-[1400px] mx-auto px-10 mt-6 relative">
<div class="grid grid-cols-4 grid-rows-2 gap-2 h-[55vh]">
<div class="col-span-2 row-span-2 rounded-2xl overflow-hidden"><Image src={img_4k_01_38_47_13_Still123} alt="Aerial view sailboat in turquoise water" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={thumb1} alt="Snorkelers enjoying a sunny boat ride" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={thumb2} alt="Snorkeler exploring underwater paradise" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={thumb3} alt="Sunlit boat ride by the ocean" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
<div class="rounded-2xl overflow-hidden"><Image src={thumb4} alt="Sunshine and celebration on the yacht" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" width={800} height={500} /></div>
</div>
<div class="mt-4 flex justify-center">
  <div class="max-w-[520px] flex items-start gap-4">
    <div class="flex-shrink-0 flex items-center gap-0.5 mt-0.5">
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
      <span class="material-symbols-outlined text-gold filled text-base">star</span>
    </div>
    <div>
      <p class="text-navy text-sm leading-snug">"Way better than the big group tours. Small boat, great crew, amazing snorkeling."</p>
      <p class="text-navy/60 text-[10px] uppercase tracking-widest font-bold mt-2">Chris &amp; Emma W. &mdash; San Diego, CA</p>
    </div>
  </div>
</div>
</div>

<!-- Discount banner -->
<div class="w-full text-center py-3 px-4 shadow-md bg-gold mt-4 lg:mt-6">
  <p class="text-navy font-bold text-sm lg:text-base uppercase tracking-widest">Save up to 40% off &mdash; Limited Time</p>
</div>

<!-- DESKTOP: Two-column layout -->
<div class="hidden lg:flex max-w-[1400px] mx-auto px-10 gap-10 mt-10">
  <!-- Left column -->
  <div class="flex-1 min-w-0">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gold transition-colors">Home</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/tours/" class="hover:text-gold transition-colors">Tours</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-navy font-semibold">Shared Snorkeling</span>
    </nav>
    <h1 class="text-3xl text-navy leading-tight">Cabo Sailing &amp; Shared Snorkeling</h1>
    <p class="text-slate-700 text-lg leading-relaxed mt-2">A small-group sailing adventure to Cabo's iconic Arch and Pelican Rock &mdash; never more than 14 guests onboard.</p>

    <!-- Icons row -->
    <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-4">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-gold">schedule</span>
        <p class="text-sm font-semibold text-navy">3 Hours</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-gold">groups</span>
        <p class="text-sm font-semibold text-navy">Small Group</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-gold">event_available</span>
        <p class="text-sm font-semibold text-navy">Free Cancellation</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-gold">family_restroom</span>
        <p class="text-sm font-semibold text-navy">Family Friendly</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-gold">local_offer</span>
        <p class="text-sm font-semibold text-navy">Great Value</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-gold">pin_drop</span>
        <p class="text-sm font-semibold text-navy">Cabo Marina, Dock F</p>
      </div>
      <div class="flex items-center gap-2 col-span-2">
        <span class="material-symbols-outlined text-gold">schedule</span>
        <p class="text-sm font-semibold text-navy">DEPARTURES 9:00 AM DAILY</p>
      </div>
    </div>

    <!-- About this experience -->
    <div class="mt-12">
      <h3 class="text-2xl text-navy mb-4">About this experience</h3>
      <p class="text-slate-700 leading-relaxed text-base">
        Join our popular shared snorkeling tour and discover the magic of Cabo San Lucas alongside fellow adventurers. Visit the famous Arch, snorkel alongside tropical fish at Pelican Rock, and enjoy a refreshing open bar and lunch onboard &mdash; all at an unbeatable price. Our experienced bilingual crew makes sure everyone has a safe, fun, and unforgettable time on the water.
      </p>
    </div>

    <!-- Suggested Itinerary timeline -->
    <div class="mt-10">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-1 h-6 bg-gold rounded-full"></div>
        <h3 class="text-sm font-bold text-navy uppercase tracking-widest">Suggested Itinerary</h3>
      </div>
      <ol class="relative border-l-2 border-gold/30 ml-2 space-y-5 pl-6">
        <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">1</span><span class="text-slate-600 text-base">9:00 AM &mdash; Board at the marina, drinks start flowing right away</span></li>
        <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">2</span><span class="text-slate-600 text-base">Sail past Land's End &mdash; the Arch, the sea lion colony, and rock formations</span></li>
        <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">3</span><span class="text-slate-600 text-base">Snorkel at Pelican Rock with tropical fish, rays, and sea lions</span></li>
        <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">4</span><span class="text-slate-600 text-base">Enjoy lunch and unlimited drinks on deck</span></li>
        <li class="relative"><span class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-navy text-white text-[11px] font-bold flex items-center justify-center">5</span><span class="text-slate-600 text-base">12:00 PM &mdash; Sail back to the marina with new friends and great memories</span></li>
      </ol>
      <p class="mt-5 text-slate-700 italic text-sm">A relaxed, social adventure on the water &mdash; and unbeatable value.</p>
    </div>

    <!-- What's Included -->
    <div class="mt-10">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-6 bg-gold rounded-full"></div>
        <h3 class="text-2xl text-navy">What's Included</h3>
      </div>
      <div class="grid grid-cols-2 gap-5 pl-1">
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">local_bar</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Open bar</span>
            <p class="text-slate-500 text-sm">Enjoy refreshing drinks throughout the cruise</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">restaurant</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Light lunch onboard</span>
            <p class="text-slate-500 text-sm">Fresh snacks served after snorkeling</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">scuba_diving</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Snorkeling experience</span>
            <p class="text-slate-500 text-sm">Gear included — explore Cabo's best spots</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">sailing</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Comfortable sailing yacht</span>
            <p class="text-slate-500 text-sm">Smooth ride with limited guests onboard</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">dry_cleaning</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Towels provided</span>
            <p class="text-slate-500 text-sm">Everything you need for the water</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-6 h-6 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-[14px]">person</span>
          </div>
          <div>
            <span class="text-slate-600 text-base font-medium">Experienced bilingual crew</span>
            <p class="text-slate-500 text-sm">Friendly, professional, and safety-focused</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Decorative image fills empty space below "What's Included" (desktop only) -->
    <div class="mt-10">
      <Image src={sailboatsPelicansRock} alt="Sailboats passing by Pelican Rock in Cabo San Lucas" class="w-full h-[500px] object-cover rounded-2xl" width={1208} height={1302} />
    </div>

  </div>

  <!-- Right column - Calendar -->
  <div class="w-[380px] flex-shrink-0">
    <div class="sticky top-[90px] bg-white rounded-3xl shadow-xl shadow-navy/5 border border-border-light overflow-hidden">
      <div class="bg-gradient-to-br from-navy via-navy to-[#1a3a5c] p-6 text-center border-b-4 border-gold">
        <h3 class="text-white text-2xl font-heading tracking-wide">Book Your Spot</h3>
        <p class="text-white/70 text-sm mt-1">Limited spots — book today to secure your date</p>
      </div>
      <!-- Boat card 38'-42' (no icons) -->
      <div class="p-5 pb-0">
        <div class="w-full bg-white border border-border-light rounded-2xl overflow-hidden shadow-md shadow-navy/5" data-boat="shared-sailing">
          <div class="h-[400px] w-full relative">
            <Image src={sailing42BoatCard} alt="Sailing Boat 38'-42'" class="w-full h-full object-cover object-center" width={1024} height={1536} format="png" quality={100} />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/15 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <h3 class="text-white text-lg font-heading">Sailing Boat 38'-42'</h3>
              <div class="flex items-center gap-2 text-white/90 text-xs mt-1 font-semibold uppercase tracking-wider"><span class="material-symbols-outlined text-gold text-sm">group</span><span>Up to 14 Guests</span></div>
            </div>
            <div class="absolute bottom-4 right-4 bg-white text-navy font-bold text-sm px-3 py-1.5 rounded-xl shadow-lg">-30%</div>
          </div>
        </div>
      </div>
      <div class="p-5">
        <p class="text-center text-slate-500 text-sm mb-1">Select a date to check availability</p>
        <p class="text-center mb-3"><span class="inline-block text-[11px] font-bold uppercase tracking-wider text-white bg-gold px-2.5 py-0.5 rounded-full">Discount Code: <span class="text-[13px] font-extrabold" data-promo-for="shared-snorkeling">Sail-30</span></span></p>
        <script defer type="text/javascript" src="https://cabosailing.rezdy.com/pluginJs" is:inline></script>
        <iframe seamless="" width="300px" height="1000px" frameborder="0" class="rezdy mx-auto block" src="https://cabosailing.rezdy.com/calendarWidget/744011?iframe=true"></iframe>
        <div class="mt-5 space-y-3" data-boat="shared-sailing">
          <div class="flex justify-between items-center py-2 border-b border-border-light">
            <span class="text-sm text-slate-500">Per person</span>
            <div class="flex items-baseline gap-2">
              <span class="text-gold line-through decoration-1 text-base font-semibold">$120</span>
              <span class="text-navy font-bold text-xl">$102</span>
            </div>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-sm text-slate-500">Duration</span>
            <span class="text-navy font-semibold">3 Hours</span>
          </div>
        </div>
        <button onclick="document.getElementById('rezdy-modal-shared-snorkel').classList.remove('hidden')" class="block w-full bg-navy text-white font-bold text-sm py-4 rounded-2xl uppercase tracking-[0.15em] text-center shadow-lg mt-5 hover:bg-navy/90 transition-colors cursor-pointer">
          Check Availability
        </button>
        <a href="https://wa.me/526241916997?text=Hi%2C%20I'd%20like%20to%20book%20the%20Shared%20Snorkeling%20Tour" target="_blank" class="block w-full bg-[#25D366] text-white font-bold text-sm py-4 rounded-2xl uppercase tracking-[0.15em] text-center shadow-lg mt-3 hover:bg-[#20bd5a] transition-colors">
          <i class="fa-brands fa-whatsapp text-lg mr-2" style="vertical-align:middle"></i> Book via WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>


