<div class="flex-shrink-0 w-full h-full snap-center"><Image src={goldenHourSailingWithFriends} alt="Golden hour sailing with friends" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={relaxingOnTheSailboatAtSea} alt="Relaxing on the sailboat at sea" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={relaxingSailboatRideInGoldenHour} alt="Relaxing sailboat ride in golden hour" class="w-full h-full object-cover" width={800} height={500} /></div>
<div class="flex-shrink-0 w-full h-full snap-center"><Image src={sunsetRelaxationOnASailboat} alt="Sunset relaxation on a sailboat" class="w-full h-full object-cover" width={800} height={500} /></div>
</div>
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/20 to-transparent pt-10 pb-5 px-4">
