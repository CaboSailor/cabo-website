---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import RezdyModal from '../../components/RezdyModal.astro';
import { Image } from 'astro:assets';

import { sharedSunset as img_31_03_25_Gil_airbnb_shoot_photos_35mm_226_topaz_sharpen_exposure } from "../../data/tour-heroes";
import sailboatRelaxationUnderGoldenHourSun from "../../assets/images/guests-on-sailboats/sailboat-relaxation-under-golden-hour-sun.png";
import goldenHourSailingWithFriends from "../../assets/images/guests-on-sailboats/golden-hour-sailing-with-friends.png";
import relaxingOnTheSailboatAtSea from "../../assets/images/guests-on-sailboats/relaxing-on-the-sailboat-at-sea.png";
import relaxingSailboatRideInGoldenHour from "../../assets/images/guests-on-sailboats/relaxing-sailboat-ride-in-golden-hour.png";
import sunsetRelaxationOnASailboat from "../../assets/images/guests-on-sailboats/sunset-relaxation-on-a-sailboat.png";
import cabosailingSailboat42 from "../../assets/images/boats/sailing-42/cabosailing-sailiboat-42.png";

const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Sunset Sailing in Cabo San Lucas",
  "description": "Small group sunset sailing cruise in Cabo San Lucas. Small group on a sailboat, open bar, snacks and views of the Arch. Daily departures from the marina.",
  "touristType": "Budget Travelers, Couples, Solo Travelers",
  "provider": {
    "@type": "TravelAgency",
    "@id": "https://cabosailing.com/#organization"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/tours/sunset-sailing/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Sunset Sailing" }
  ]
});
---

<BaseLayout bodyClass="bg-white font-body text-text-main antialiased min-h-screen flex flex-col relative" title="Sunset Sailing in Cabo — Small Group | Cabo Sailing" description="Small group sunset sailing cruise in Cabo San Lucas. Small group on a sailboat, open bar, snacks and views of the Arch. Daily departures from the marina." ogImage="/og/sunset-sailing.jpg" ogImageAlt="Sunset sailing cruise in Cabo San Lucas" hreflangs={{ en: '/tours/sunset-sailing', es: '/es/tours/sunset-sailing' }}>
  <script slot="head" type="application/ld+json" set:html={touristTripSchema} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="tours" />


  <style is:inline>
    #highlights-toggle:checked ~ #highlights-content {
      max-height: 500px; margin-top: 1.5rem; opacity: 1;
    }
    #highlights-toggle:checked ~ label .chevron-icon { transform: rotate(90deg); }
    .faq-item input:checked ~ .faq-answer {
      max-height: 800px; margin-top: 0.75rem; opacity: 1;
    }
    .faq-item input:checked ~ label .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

<!-- Hero Gallery -->
