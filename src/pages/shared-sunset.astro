const touristTripSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Shared Sunset Cruise in Cabo San Lucas",
  "description": "Shared sunset sailing cruise in Cabo San Lucas. Small group on a sailboat, open bar, snacks and views of the Arch. Daily departures from the marina.",
  "touristType": "Budget Travelers, Couples, Solo Travelers",
  "provider": {
    "@type": "TravelAgency",
    "name": "Cabo Sailing Ocean Adventures",
    "url": "https://cabosailing.com"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://cabosailing.com/shared-sunset/",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tours", "item": "https://cabosailing.com/tours/" },
    { "@type": "ListItem", "position": 3, "name": "Shared Sunset Cruise" }
