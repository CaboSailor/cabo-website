---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { Image } from 'astro:assets';

// Local images
import chilenoImg from "../assets/images/blog/chileno-bay-cabo-snorkeling.jpg";

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cabosailing.com/" },
    { "@type": "ListItem", "position": 2, "name": "Travel Guide", "item": "https://cabosailing.com/travel-guide/" },
    { "@type": "ListItem", "position": 3, "name": "Traveling to Cabo" }
  ]
});
---

<BaseLayout title="Traveling to Cabo San Lucas — Travel Guide | Cabo Sailing" description="Planning a trip to Cabo San Lucas? From passport requirements and the best time to visit, to getting around and what to expect — these guides cover everything you need to know before you go.">
  <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  <Header variant="subpage" activePage="travel-guide" />

  <main class="flex-1 w-full overflow-x-hidden pt-[60px] lg:pt-[72px]">

    <!-- Hero Section -->
    <div class="relative w-full h-[40vh] min-h-[300px] lg:h-[50vh]">
      <img alt="Traveling to Cabo San Lucas" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/40 to-transparent"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-end z-10 text-center px-8 pb-10">
        <div class="flex flex-col items-center gap-3">
          <div class="flex items-center gap-2">
            <a href="/travel-guide" class="text-white/70 text-xs uppercase tracking-[0.2em] font-bold hover:text-white transition-colors">Travel Guide</a>
            <span class="text-white/40 text-xs">/</span>
            <span class="text-white text-xs uppercase tracking-[0.2em] font-bold">Traveling to Cabo</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-serif text-white uppercase tracking-[0.15em] leading-tight drop-shadow-lg font-light">
            Traveling to Cabo
          </h1>
          <div class="w-12 h-[1px] bg-accent-gold-light"></div>
          <p class="text-white/90 text-sm max-w-[400px] leading-relaxed">Passport requirements, best time to visit, getting around, and everything you need to know before you go.</p>
        </div>
      </div>
    </div>

    <!-- Horizontal Sub-Menu -->
    <div class="sticky top-[60px] z-40 bg-white border-b border-border-light/50 shadow-sm">
      <div class="max-w-5xl mx-auto">
        <nav class="flex overflow-x-auto no-scrollbar">
          <a href="/travel-guide" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors">Home</a>
          <a href="/travel-guide-activities" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors">Activities</a>
          <a href="/travel-guide-attractions" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors">Attractions</a>
          <a href="/travel-guide-traveling" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-accent-gold text-navy transition-colors whitespace-nowrap">Traveling to Cabo</a>
          <a href="/travel-guide-culture" class="shrink-0 px-4 lg:px-6 py-3.5 text-sm font-bold uppercase tracking-widest border-b-2 border-transparent text-navy/70 hover:text-navy hover:border-accent-gold/50 transition-colors whitespace-nowrap">Culture &amp; Food</a>
        </nav>
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="px-6 lg:px-0 max-w-5xl mx-auto pt-10 pb-16">

      <p class="text-navy/60 text-base lg:text-lg leading-relaxed max-w-2xl mb-10">Planning a trip to Cabo San Lucas? From passport requirements and the best time to visit, to getting around and what to expect — these guides cover everything you need to know before you go.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">

        <!-- Article 1: Best Time to Visit -->
        <a href="/travel-guide/best-time" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <Image alt="Best Time to Visit Cabo San Lucas" class="w-full h-full object-cover" src={chilenoImg} />
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Best Time to Visit Cabo San Lucas</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Seasonal weather, whale watching, fishing, prices, and top activities — a complete month-by-month guide to planning your trip.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 2: Passport Requirements -->
        <a href="/travel-guide/do-you-need-a-passport-to-go-to-cabo-san-lucas" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Do You Need a Passport to Go to Cabo San Lucas?" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2019/08/los-cabos-international-airport-featured-image.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Do You Need a Passport to Go to Cabo San Lucas?</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Visa requirements, passport validity rules, cruise entry, and what travelers from the U.S., Canada, and Europe need to know.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 3: La Paz to Cabo -->
        <a href="/travel-guide/convenient-ways-to-get-from-la-paz-to-cabo-for-every-type-of-traveler" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="La Paz to Cabo San Lucas — 5 Ways to Get There" class="w-full h-full object-cover" src="/images/la-paz/la-paz-bcs.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">La Paz to Cabo San Lucas &mdash; 5 Ways to Get There</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Bus, shuttle, rental car, taxi, or private transfer. Distance, prices, timing, and the best option for each type of traveler.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 4: Is Cabo Worth It -->
        <a href="/travel-guide/is-cabo-worth-the-splurge-a-breakdown-of-value-vs-cost" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Is Cabo Worth It? Honest Value vs. Cost Breakdown" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Is Cabo Worth It? Honest Value vs. Cost Breakdown</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">What Cabo actually costs in 2026 &mdash; hotels, dining, activities, and how to decide if it fits your budget.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 5: Cruise Port -->
        <a href="/travel-guide/make-the-best-of-your-cabo-san-lucas-port-call" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Cabo San Lucas Cruise Port" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Cabo Cruise Port &mdash; Best Things to Do in One Day</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Maximize your hours ashore &mdash; tender logistics, top activities by time window, and the best lunch spots near the marina.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 6: Babymoon -->
        <a href="/travel-guide/babymooning-in-cabo" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Babymoon in Cabo San Lucas" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Babymoon in Cabo &mdash; Romantic Pre-Baby Getaway Guide</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Pregnancy-safe activities, best resorts for expecting couples, what to pack, and what to skip.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 7: Safety -->
        <a href="/travel-guide/is-cabo-safe" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Is Cabo San Lucas Safe?" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2019/08/los-cabos-international-airport-featured-image.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Is Cabo San Lucas Safe? What Travelers Should Know</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Travel advisories, practical safety tips, and why Cabo is one of Mexico's most welcoming tourist destinations.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 8: Drive from LA -->
        <a href="/travel-guide/drive-from-la-to-cabo-san-lucas" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Highway through the Baja California desert" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">LA to Cabo Drive &mdash; Complete Road Trip Guide</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Distance, border crossing, 3-day itinerary, insurance, road conditions, and overnight stops.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 9: Outfit Ideas -->
        <a href="/travel-guide/top-nine-outfit-ideas-for-your-cabo-vacation" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Cabo vacation outfit ideas" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">What to Wear in Cabo &mdash; 9 Outfit Ideas by Activity</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Outfits for beach, boat charters, dinners and nightlife. Fabrics, colors and what to leave at home.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 10: Cabo on a Budget -->
        <a href="/travel-guide/cabo-on-a-budget" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Street food in downtown Cabo San Lucas" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Cabo on a Budget &mdash; 2026 Guide to Doing Cabo for Less</h3>
            <p class="text-navy/70 text-sm leading-relaxed mb-4">Free activities, cheap eats, budget tours, and a sample day under $75/person.</p>
            <div class="inline-flex items-center gap-1 text-accent-gold text-sm font-bold uppercase tracking-widest">Read article <span class="material-symbols-outlined text-base">arrow_forward</span></div>
          </div>
        </a>

        <!-- Article 11: Senior Travelers -->
        <a href="/travel-guide/activities-for-senior-travelers-in-cabo" class="guide-card bg-white rounded-2xl overflow-hidden shadow-md border border-border-light/60 block">
          <div class="h-[220px] lg:h-[240px] overflow-hidden">
            <img alt="Senior couple on a sunset cruise in Cabo" class="w-full h-full object-cover" src="https://www.cabosailing.com/wp-content/uploads/2018/08/fun-activities-cabo.jpg.webp"/>
          </div>
          <div class="p-5 lg:p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-accent-gold/10 text-accent-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-widest border border-accent-gold/20">Traveling to Cabo</span>
            </div>
            <h3 class="text-lg font-serif text-navy font-semibold mb-2 leading-snug">Cabo for Seniors &mdash; Best Activities for Older Travelers</h3>
