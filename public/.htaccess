# =============================================================================
# 301 Redirects — Old WordPress URLs → new Astro site
# Source: migration/articles.json (128 ranked articles) + migration/redirects.json
# Strategy: every old URL maps to a specific new URL when one exists; unmapped
# articles go to the most relevant category hub (never the homepage).
#
# Category hubs:
#   /travel-guide-activities/   — things to do, tours, snorkeling sites, fishing, wildlife
#   /travel-guide-attractions/  — beaches, landmarks, neighborhoods, sights
#   /travel-guide-traveling/    — getting to Cabo, transport, lodging, planning
#   /travel-guide-culture/      — food, restaurants, nightlife, shopping, history
# =============================================================================

RewriteEngine On

# -----------------------------------------------------------------------------
# Staging noindex: only when served from new.cabosailing.com
# Belt-and-suspenders so the staging site can't leak into Google if Basic Auth
# is ever accidentally removed.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    SetEnvIfNoCase Host "new\.cabosailing\.com" IS_STAGING
    Header set X-Robots-Tag "noindex, nofollow" env=IS_STAGING
</IfModule>

# -----------------------------------------------------------------------------
# Canonical host: force non-www (matches astro.config.mjs site + sitemap)
# -----------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.cabosailing\.com$ [NC]
RewriteRule ^(.*)$ https://cabosailing.com/$1 [R=301,L]

# -----------------------------------------------------------------------------
# Custom 404 page
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# =============================================================================
# 1. MIGRATED ARTICLES — old URL → new /travel-guide/<slug>/
# =============================================================================

# Safety (two old URLs consolidated into one canonical article)
RewriteRule ^cabo-safety/?$ /travel-guide/is-cabo-safe/ [R=301,L]
